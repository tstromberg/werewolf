# Reopen the same encrypted data disk and require real applications again.
ok  unifi-mongodb-kept i=0; until python3 /usr/share/werewolf-mongodb/probe.py --retained; do i=$((i + 1)); [ $i -le 60 ] || exit 1; sleep 1; done
ok  unifi-rabbitmq-kept i=0; until python3 /usr/share/werewolf-rabbitmq/probe.py --retained; do i=$((i + 1)); [ $i -le 90 ] || exit 1; sleep 1; done
ok  unifi-core-ready i=0; until curl --max-time 2 -sf -o /dev/null http://127.0.0.1:11081/api/system; do i=$((i + 1)); [ $i -le 120 ] || exit 1; sleep 1; done
ok  unifi-network-ready i=0; until python3 /run/config/network-probe.py; do i=$((i + 1)); [ $i -le 120 ] || exit 1; sleep 1; done
ok  unifi-internal-listeners python3 /run/config/network-probe.py --private
ok  unifi-identity-kept python3 /run/config/persistence-probe.py --retained
ok  unifi-console curl --max-time 5 -ksf https://127.0.0.1/ | grep -q 'window.UNIFI_OS_MANIFEST.*UOSSERVER'
ok  unifi-service-state python3 /run/config/dbus-probe.py
ok  unifi-nginx-reload python3 /run/config/nginx-probe.py reload
