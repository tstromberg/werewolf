#!/usr/bin/env python3
"""Serve public images and issue bounded, contextual TPM permits on a trusted host."""
import argparse
import concurrent.futures
import fcntl
import hashlib
import http.client
import http.server
import json
import os
from pathlib import Path
import re
import shutil
import ssl
import subprocess
import sys
import tempfile
import threading
import time
from urllib.parse import parse_qs, urlsplit

HEX = r'[0-9a-f]{64}'
TAG = b'werewolf.boot/2\0'
FILES = {'root.erofs', 'vmlinuz', 'stage0.zst', 'cmdline', 'uki.efi'}
MAX_RECORDS = 4096
MAX_MACHINES = 64


def atomic(path, data):
    path = Path(path)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(temporary, path)
            descriptor = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        finally:
            temporary.unlink(missing_ok=True)


def run(args):
    return subprocess.run([str(arg) for arg in args], check=True, capture_output=True, timeout=60)


def file_digest(stream):
    digest = hashlib.sha256()
    for chunk in iter(lambda: stream.read(1 << 20), b''):
        digest.update(chunk)
    return digest.hexdigest()


def record(bundle):
    if len(bundle) != 432 or bundle[:16] != TAG:
        raise ValueError('invalid record')
    raw = bundle[:176]
    return {'machine': raw[16:48].hex(), 'previous': raw[48:80].hex(),
            'retained': raw[80:112].hex(), 'candidate': raw[112:144].hex(),
            'pcr': raw[144:176].hex(),
            'anchor': hashlib.sha256(raw[48:80] + hashlib.sha256(raw).digest()).hexdigest()}


class Publisher:
    def __init__(self, config):
        self.config = config
        self.authority = Path(config['authority']).resolve()
        self.public = Path(config['public']).resolve()
        self.records = self.authority / 'records'
        self.machine = record((self.authority / 'factory.permit').read_bytes())['machine']

    def permit(self, machine, candidate, previous, retained):
        for value in [machine, candidate, previous, retained]:
            if not re.fullmatch(HEX, value):
                raise ValueError('invalid identity')
        if machine != self.machine:
            raise ValueError('foreign machine')
        with (self.authority / 'issuer.lock').open('a+b') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            old_path = self.records / (previous + '.permit')
            run([self.config['howl'], '_boot-record', self.authority / 'permit.pub', old_path])
            old_bundle = old_path.read_bytes()
            old = record(old_bundle)
            if old['anchor'] != previous or old['machine'] != machine:
                raise ValueError('foreign state')
            if retained not in [old['retained'], old['candidate']]:
                raise ValueError('unsafe retirement')
            releases = json.loads((self.authority / 'releases.json').read_text())
            if candidate not in releases or retained not in releases:
                raise ValueError('unregistered release')
            if candidate == retained:
                raise ValueError('no candidate change')
            # A cut after NV extension resumes with the already authorized pair.
            if old['retained'] == retained and old['candidate'] == candidate:
                return old_bundle
            approved = json.loads((self.authority / 'approved.json').read_text())
            if candidate != approved['candidate']:
                raise ValueError('candidate is not the published update')
            raw = TAG + bytes.fromhex(machine + previous + retained + candidate + releases[retained])
            expected = record(raw + bytes(256))['anchor']
            cached = self.records / (expected + '.permit')
            if cached.exists():
                return cached.read_bytes()
            if sum(1 for _ in self.records.glob('*.permit')) >= MAX_RECORDS:
                raise ValueError('issuance limit')
            with tempfile.TemporaryDirectory(dir=self.authority) as temporary:
                work = Path(temporary)
                run([self.config['howl'], '_boot-permit', self.authority / 'permit.pub',
                     old_path, retained, candidate, releases[retained], work / 'state', work / 'message'])
                if (work / 'state').read_bytes() != raw:
                    raise ValueError('noncanonical transition')
                run(['openssl', 'dgst', '-sha256', '-sign', self.authority / 'permit.key',
                     '-out', work / 'signature', work / 'message'])
                run(['openssl', 'dgst', '-sha256', '-verify', self.authority / 'permit.pub',
                     '-signature', work / 'signature', work / 'message'])
                bundle = raw + (work / 'signature').read_bytes()
                record(bundle)
                atomic(cached, bundle)
                return bundle

    def artifact(self, route):
        parts = route.split('/')
        if len(parts) not in [3, 4] or parts[0] != '' or parts[1] != self.config['arch']:
            raise ValueError('invalid path')
        if len(parts) == 3:
            if parts[2] not in ['latest.json', 'latest.json.sig']:
                raise ValueError('invalid head')
        elif not re.fullmatch(HEX, parts[2]) or parts[3] not in FILES:
            raise ValueError('invalid artifact')
        path = self.public.joinpath(*parts[1:]).resolve(strict=True)
        if not path.is_relative_to(self.public) or not path.is_file():
            raise ValueError('invalid artifact')
        return path

    def for_machine(self, machine):
        if machine != self.machine:
            raise ValueError('foreign machine')
        return self


class Registry:
    """A shared listener dispatches to independently keyed machine issuers."""
    def __init__(self, config):
        self.directory = Path(config['registry'])

    def for_machine(self, machine):
        if not re.fullmatch(HEX, machine):
            raise ValueError('invalid machine')
        path = self.directory / (machine + '.json')
        if path.is_symlink() or path.stat().st_size > 65536:
            raise ValueError('invalid registration')
        issuer = Publisher(json.loads(path.read_text()))
        if issuer.machine != machine:
            raise ValueError('foreign registration')
        return issuer

    def artifact(self, route):
        # Each immutable channel has a shared public cache, independent of its issuers.
        registrations = sorted(self.directory.glob('*.json'))
        if len(registrations) > MAX_MACHINES:
            raise ValueError('registration limit')
        for path in registrations:
            if path.is_symlink() or path.stat().st_size > 65536:
                raise ValueError('invalid registration')
            config = json.loads(path.read_text())
            prefix = urlsplit(config['channel']).path.rstrip('/')
            if route.startswith(prefix + '/'):
                try:
                    return Publisher(config).artifact(route[len(prefix):])
                except FileNotFoundError:
                    continue
        raise ValueError('undeclared channel')


class Server(http.server.HTTPServer):
    def __init__(self, config):
        self.publisher = Registry(config) if config.get('registry') else Publisher(config)
        self.config = config
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=4)
        self.capacity = threading.BoundedSemaphore(8)
        super().__init__(('127.0.0.1', config['port']), Handler)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(config['certificate'], config['key'])
        # Defer TLS handshakes to bounded workers; a silent client cannot block accept.
        self.socket = context.wrap_socket(self.socket, server_side=True, do_handshake_on_connect=False)

    def process_request(self, request, client_address):
        if not self.capacity.acquire(blocking=False):
            self.shutdown_request(request)
            return
        self.pool.submit(self.handle, request, client_address)

    def handle(self, request, client_address):
        try:
            request.settimeout(10)
            request.do_handshake()
            self.finish_request(request, client_address)
        except (OSError, ValueError, ssl.SSLError):
            pass
        finally:
            self.shutdown_request(request)
            self.capacity.release()

    def server_close(self):
        super().server_close()
        self.pool.shutdown(wait=True)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = 'werewolf-publisher'
    sys_version = ''

    def log_message(self, *args):
        pass

    def do_GET(self):
        try:
            if len(self.path) > 1024 or '%' in self.path or '\\' in self.path:
                raise ValueError('invalid path')
            route = urlsplit(self.path)
            if route.scheme or route.netloc or route.fragment:
                raise ValueError('invalid path')
            if route.path == '/_health' and self.authorized():
                self.send_data(b'ready\n')
                return
            pattern = '/(aarch64|x86_64)/permits/(' + HEX + ')/(' + HEX + ')\\.permit'
            match = re.fullmatch(pattern, route.path)
            if match:
                query = parse_qs(route.query, strict_parsing=True, max_num_fields=2)
                if set(query) != {'from', 'retain'} or any(len(values) != 1 for values in query.values()):
                    raise ValueError('invalid context')
                arch, machine, candidate = match.groups()
                issuer = self.server.publisher.for_machine(machine)
                if issuer.config['arch'] != arch:
                    raise ValueError('foreign architecture')
                self.send_data(issuer.permit(machine, candidate, query['from'][0], query['retain'][0]))
                return
            if route.query:
                raise ValueError('unexpected query')
            path = self.server.publisher.artifact(route.path)
            with path.open('rb') as stream:
                self.send_response(200)
                self.send_header('Content-Length', str(os.fstat(stream.fileno()).st_size))
                self.end_headers()
                shutil.copyfileobj(stream, self.wfile, 64 << 10)
        except (ValueError, KeyError, FileNotFoundError) as error:
            if self.server.config.get('registry'):
                print(json.dumps({'event': 'refused', 'path': self.path,
                                  'error': type(error).__name__, 'detail': str(error)}), flush=True)
            self.send_error(404)
        except (OSError, subprocess.SubprocessError):
            self.send_error(503)

    def authorized(self):
        import hmac
        return hmac.compare_digest(self.headers.get('X-Werewolf-Control', ''), self.server.config['token'])

    def do_POST(self):
        if self.path != '/_stop' or not self.authorized():
            self.send_error(404)
            return
        self.send_data(b'stopping\n')
        threading.Thread(target=self.server.shutdown, daemon=True).start()

    def send_data(self, data):
        self.send_response(200)
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def control(config, stop=False):
    context = ssl.create_default_context(cafile=config['certificate'])
    connection = http.client.HTTPSConnection('127.0.0.1', config['port'], context=context, timeout=2)
    try:
        connection.request('POST' if stop else 'GET', '/_stop' if stop else '/_health',
                           headers={'X-Werewolf-Control': config['token']})
        response = connection.getresponse()
        return response.status == 200 and response.read(32) == (b'stopping\n' if stop else b'ready\n')
    finally:
        connection.close()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('action', choices=['start', 'serve', 'stop', 'publish'])
    parser.add_argument('config', type=Path)
    parser.add_argument('source', type=Path, nargs='?')
    args = parser.parse_args()
    os.umask(0o077)
    config = json.loads(args.config.read_text())
    if args.action == 'publish':
        publish(config, args.source)
        return
    if config.get('service'):
        service = Path(config['service'])
        registry = service / 'registry'
        machine = record((Path(config['authority']) / 'factory.permit').read_bytes())['machine']
        with (service / 'registration.lock').open('a+b') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            registration = registry / (machine + '.json')
            if args.action == 'start':
                if not registration.exists() and len(list(registry.glob('*.json'))) >= MAX_MACHINES:
                    raise ValueError('registration limit')
                if registration.exists() and json.loads(registration.read_text()) != config:
                    raise ValueError('conflicting machine registration')
                atomic(registration, json.dumps(config).encode())
            elif args.action == 'stop':
                registration.unlink(missing_ok=True)
                if any(registry.glob('*.json')):
                    return
            else:
                raise ValueError('a machine registration cannot serve directly')
            result = subprocess.run([sys.executable, str(Path(__file__).resolve()), args.action,
                                     str(service / 'publisher.json')], check=True)
            return
    if args.action == 'stop':
        try:
            if not control(config, True):
                return
            for _ in range(100):
                try:
                    if not control(config):
                        return
                except OSError:
                    return
                time.sleep(0.1)
        except OSError:
            return
        raise RuntimeError('publisher did not stop')
    if args.action == 'serve':
        with (Path(config['authority']) / 'publisher.lock').open('a+b') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with Server(config) as server:
                stopped = threading.Event()
                if config.get('refresh_seconds', 0) or config.get('registry'):
                    refresher = threading.Thread(target=refresh_loop, args=(config, stopped))
                    refresher.start()
                else:
                    refresher = None
                try:
                    server.serve_forever()
                finally:
                    stopped.set()
                    if refresher:
                        refresher.join()
        return
    try:
        if control(config):
            return
    except OSError:
        pass
    with (Path(config['authority']) / 'publisher.log').open('ab') as log:
        process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'serve', str(args.config.resolve())],
                                   stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(100):
        if process.poll() is not None:
            raise RuntimeError('publisher failed; see publisher.log')
        try:
            if control(config):
                return
        except OSError:
            pass
        time.sleep(0.05)
    process.terminate()
    process.wait(timeout=15)
    raise RuntimeError('publisher did not become ready')


def publish(config, source):
    authority = Path(config['authority'])
    manifest = source / 'prebuilt' / config['arch'] / 'latest.json'
    signature = manifest.with_name('latest.json.sig')
    with tempfile.TemporaryDirectory(dir=authority) as temporary:
        public_key = Path(temporary) / 'image.pub'
        public_key.write_bytes(run(['openssl', 'x509', '-in', config['image_certificate'],
                                    '-pubkey', '-noout']).stdout)
        run(['openssl', 'dgst', '-sha256', '-verify', public_key, '-signature', signature, manifest])
    image = json.loads(manifest.read_text())
    if image['channel'] != config['channel'] or image['arch'] != config['arch'] or not image['ipe']:
        raise ValueError('wrong image authority')
    root = Path(config['public']) / config['arch']
    root.mkdir(parents=True, exist_ok=True)
    with (root / 'publication.lock').open('a+b') as public_guard:
        fcntl.flock(public_guard, fcntl.LOCK_EX)
        receipt = root / 'accepted-head.json'
        previous = root / 'latest.json'
        if receipt.exists() or previous.exists():
            if receipt.exists():
                saved = json.loads(receipt.read_text())
                old_data = saved['head'].encode()
                old_signature = bytes.fromhex(saved['signature'])
            else:
                old_data = previous.read_bytes()
                old_signature = (root / 'latest.json.sig').read_bytes()
            if len(old_data) > 1048576 or len(old_signature) > 512:
                raise ValueError('invalid shared head receipt')
            with tempfile.TemporaryDirectory(dir=authority) as temporary:
                work = Path(temporary)
                public_key = work / 'image.pub'
                public_key.write_bytes(run(['openssl', 'x509', '-in', config['image_certificate'],
                                            '-pubkey', '-noout']).stdout)
                (work / 'head').write_bytes(old_data)
                (work / 'signature').write_bytes(old_signature)
                run(['openssl', 'dgst', '-sha256', '-verify', public_key,
                     '-signature', work / 'signature', work / 'head'])
            old = json.loads(old_data)
            if old['channel'] != config['channel'] or old['arch'] != config['arch']:
                raise ValueError('conflicting shared channel identity')
            if image['serial'] < old['serial'] or (image['serial'] == old['serial'] and image['build'] != old['build']):
                raise ValueError('publication would roll back the shared update head')
        identity = b'werewolf.release/2\0' + config['arch'].encode() + b'\0'
        for filename in ['root.erofs', 'vmlinuz', 'stage0.zst']:
            identity += bytes.fromhex(image['files'][filename]['sha256'])
        identity += bytes.fromhex(image['boot_context'])
        release = hashlib.sha256(identity).hexdigest()
        if (source / 'slot/release.id').read_bytes().hex() != release:
            raise ValueError('wrong release identity')
        pcr = (source / 'slot/pcr11').read_bytes().hex()
        if not re.fullmatch(HEX, pcr) or pcr == '0' * 64:
            raise ValueError('unmeasured image')
        target = root / image['build']
        if not re.fullmatch(HEX, image['build']):
            raise ValueError('wrong build identity')
        target.mkdir(parents=True, exist_ok=True)
        for filename, artifact in image['files'].items():
            if artifact is None:
                continue
            if filename not in FILES:
                raise ValueError('unknown artifact')
            original = manifest.parent / image['build'] / filename
            with original.open('rb') as stream:
                digest = file_digest(stream)
            if original.stat().st_size != artifact['size'] or digest != artifact['sha256']:
                raise ValueError('wrong image bytes')
            destination = target / filename
            if destination.exists():
                with destination.open('rb') as stream:
                    if file_digest(stream) != digest:
                        raise ValueError('immutable object collision')
            else:
                temporary = target / (filename + '.new')
                with original.open('rb') as incoming, temporary.open('xb') as outgoing:
                    shutil.copyfileobj(incoming, outgoing)
                    outgoing.flush()
                    os.fsync(outgoing.fileno())
                os.replace(temporary, destination)
        with (authority / 'issuer.lock').open('a+b') as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            mappings = authority / 'releases.json'
            releases = json.loads(mappings.read_text()) if mappings.exists() else {}
            if release in releases and releases[release] != pcr:
                raise ValueError('conflicting measurement')
            releases[release] = pcr
            approved_file = authority / 'approved.json'
            approved = json.loads(approved_file.read_text()) if approved_file.exists() else None
            if approved and (image['serial'] < approved['serial'] or
                             (image['serial'] == approved['serial'] and release != approved['candidate'])):
                raise ValueError('publication would roll back the update head')
            atomic(mappings, (json.dumps(releases) + '\n').encode())
            atomic(approved_file, (json.dumps({'candidate': release, 'serial': image['serial']}) + '\n').encode())
            atomic(receipt, json.dumps({'head': manifest.read_text(), 'signature': signature.read_bytes().hex()}).encode())
            atomic(root / 'latest.json.sig', signature.read_bytes())
            atomic(root / 'latest.json', manifest.read_bytes())

def refresh_targets(config):
    if not config.get('registry'):
        return [config] if config.get('refresh_seconds', 0) else []
    targets = []
    paths = sorted(Path(config['registry']).glob('*.json'))
    if len(paths) > MAX_MACHINES:
        raise ValueError('registration limit')
    for path in paths:
        if path.is_symlink() or path.stat().st_size > 65536:
            raise ValueError('invalid registration')
        entry = json.loads(path.read_text())
        if entry.get('refresh_seconds', 0):
            targets.append(entry)
    return targets


def refresh_loop(config, stopped):
    interval = config.get('refresh_seconds') or 300
    while not stopped.wait(interval):
        try:
            targets = refresh_targets(config)
        except (OSError, ValueError, KeyError):
            continue
        for target in targets:
            if stopped.is_set():
                return
            with (Path(target['authority']) / 'refresh-service.log').open('ab') as output:
                try:
                    process = subprocess.Popen([target['howl'], '_local-refresh', str(Path(target['authority']).parent)],
                                               stdin=subprocess.DEVNULL, stdout=output, stderr=output)
                    deadline = time.monotonic() + 900
                    while process.poll() is None:
                        if stopped.wait(1) or time.monotonic() >= deadline:
                            process.kill()
                            process.wait(timeout=10)
                            break
                except (OSError, subprocess.SubprocessError) as error:
                    output.write(('local-publisher: refresh failed: ' + str(type(error).__name__) + '\n').encode())


if __name__ == '__main__':
    main()
