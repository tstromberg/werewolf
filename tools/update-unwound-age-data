#!/usr/bin/env python3
"""Normalize reviewed PSL and IANA RDAP downloads for the unwound image.

Requires idna==3.20. Fetch the two official URLs separately, then pass the
downloaded files here. No network access occurs while generating image data.
"""

import argparse
import hashlib
import json
from pathlib import Path

import idna


PSL_URL = "https://publicsuffix.org/list/public_suffix_list.dat"
RDAP_URL = "https://data.iana.org/rdap/dns.json"
MARKERS = (
    "// ===BEGIN ICANN DOMAINS===",
    "// ===END ICANN DOMAINS===",
    "// ===BEGIN PRIVATE DOMAINS===",
    "// ===END PRIVATE DOMAINS===",
)


def psl_data(raw):
    lines = raw.decode("utf-8").splitlines()
    version = next((line[12:] for line in lines if line.startswith("// VERSION: ")), None)
    commit = next((line[11:] for line in lines if line.startswith("// COMMIT: ")), None)
    if not version or not commit:
        raise ValueError("PSL source version or commit is missing")
    if [line for line in lines if line in MARKERS] != list(MARKERS):
        raise ValueError("PSL section markers are missing or out of order")

    output = [
        "// This Source Code Form is subject to the terms of the Mozilla Public",
        "// License, v. 2.0. If a copy of the MPL was not distributed with this",
        "// file, You can obtain one at https://mozilla.org/MPL/2.0/.",
        "// Source: " + PSL_URL,
        "// VERSION: " + version,
        "// COMMIT: " + commit,
    ]
    section = False
    count = 0
    for line in lines:
        if line in MARKERS:
            section = line.startswith("// ===BEGIN")
            output.append(line)
            continue
        if not line or line.startswith("//"):
            continue
        if not section or line != line.strip():
            raise ValueError("unexpected PSL rule or whitespace: " + repr(line))
        prefix = "*." if line.startswith("*.") else "!" if line.startswith("!") else ""
        rule = line[len(prefix) :]
        if not rule or "*" in rule or "!" in rule:
            raise ValueError("malformed PSL rule: " + repr(line))
        name = idna.encode(rule, uts46=True, std3_rules=True).decode("ascii").lower()
        if len(name) > 253 or any(len(label) > 63 for label in name.split(".")):
            raise ValueError("PSL rule exceeds DNS limits: " + repr(line))
        output.append(prefix + name)
        count += 1
    return ("\n".join(output) + "\n").encode("ascii"), version, commit, count


def rdap_data(raw):
    data = json.loads(raw)
    if data.get("version") != "1.0" or not isinstance(data.get("publication"), str):
        raise ValueError("unexpected IANA RDAP bootstrap version")
    services = data.get("services")
    if not isinstance(services, list) or not services or len(services) > 4096:
        raise ValueError("invalid IANA RDAP services")
    for service in services:
        if (not isinstance(service, list) or len(service) != 2 or
                any(not isinstance(group, list) for group in service) or
                any(not isinstance(item, str) for group in service for item in group)):
            raise ValueError("invalid IANA RDAP service")
    return (json.dumps(data, ensure_ascii=True, separators=(",", ":")) + "\n").encode(), data["publication"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--psl", type=Path, required=True, help=PSL_URL)
    parser.add_argument("--rdap", type=Path, required=True, help=RDAP_URL)
    args = parser.parse_args()
    if idna.__version__ != "3.20":
        parser.error("requires idna==3.20")

    psl_raw = args.psl.read_bytes()
    rdap_raw = args.rdap.read_bytes()
    psl, version, commit, count = psl_data(psl_raw)
    rdap, publication = rdap_data(rdap_raw)
    output = Path(__file__).resolve().parent.parent / "cmd/unwound/data"
    metadata = {
        "psl": {"source": PSL_URL, "sha256": hashlib.sha256(psl_raw).hexdigest(),
                "version": version, "commit": commit, "rules": count},
        "rdap": {"source": RDAP_URL, "sha256": hashlib.sha256(rdap_raw).hexdigest(),
                 "publication": publication, "services": len(json.loads(rdap)["services"])},
        "normalizer": "idna 3.20, UTS #46, STD3",
    }
    output.mkdir(parents=True, exist_ok=True)
    (output / "public_suffix_list.ascii.dat").write_bytes(psl)
    (output / "rdap-dns.json").write_bytes(rdap)
    (output / "sources.json").write_text(json.dumps(metadata, indent=2) + "\n")


if __name__ == "__main__":
    main()
