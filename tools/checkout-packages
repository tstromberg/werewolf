#!/usr/bin/env python3
"""Provision CI's sibling package checkouts and verify their reviewed content pins."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
LOCK = ROOT / 'release/package-sources.json'


def context_dir(directory, name):
    if not re.fullmatch(r'[a-z0-9][a-z0-9+_.-]*', name) or name in {'.', '..'}:
        raise ValueError('invalid package context: ' + name)
    # Published pins can still reference the flat tree before the repository merge.
    flat = directory / name
    found = list(directory.glob('*/' + name + '/metadata.json'))
    if flat.is_dir() and not found:
        return flat
    if not flat.exists() and not found:
        raise ValueError('missing package context: ' + name)
    if flat.exists() or len(found) != 1:
        raise ValueError('ambiguous package context: ' + name)
    return found[0].parent


def digest(directory, contexts):
    value = hashlib.sha256()
    for context in sorted(contexts):
        root = context_dir(directory, context)
        if not root.is_dir():
            raise ValueError('missing package context: ' + str(root))
        for path in sorted(root.rglob('*')):
            if any(part in {'.git', '__pycache__'} for part in path.relative_to(root).parts):
                continue
            record = dict(context=context, path=str(path.relative_to(root)))
            if path.is_symlink():
                record['link'] = os.readlink(path)
            elif path.is_file():
                record.update(sha256=hashlib.sha256(path.read_bytes()).hexdigest(),
                              mode=path.stat().st_mode & 0o7777)
            else:
                continue
            value.update(json.dumps(record, sort_keys=True, separators=(',', ':')).encode() + b'\n')
    return value.hexdigest()


def checkout(source, directory):
    key = 'WEREWOLF_' + source['name'].replace('-', '_').upper()
    repository = os.environ.get(key + '_REPOSITORY') or source['repository']
    ref = os.environ.get(key + '_REF') or source['ref']
    if not directory.exists():
        if re.fullmatch(r'[0-9a-f]{40}', ref):
            subprocess.run(['git', 'init', '--quiet', str(directory)], check=True)
            subprocess.run(['git', '-C', directory, 'remote', 'add', 'origin', repository], check=True)
            subprocess.run(['git', '-C', directory, 'fetch', '--depth', '1', 'origin', ref], check=True)
            subprocess.run(['git', '-C', directory, 'checkout', '--detach', 'FETCH_HEAD'], check=True)
        else:
            subprocess.run(['git', 'clone', '--depth', '1', '--branch', ref, '--', repository, str(directory)], check=True)
        (directory / '.git/howl-package-source').touch()
    elif (directory / '.git/howl-package-source').is_file():
        if subprocess.check_output(['git', '-C', directory, 'status', '--porcelain']):
            raise ValueError('refusing to update modified checkout: ' + str(directory))
        subprocess.run(['git', '-C', directory, 'fetch', '--depth', '1', 'origin', ref], check=True)
        subprocess.run(['git', '-C', directory, 'checkout', '--detach', 'FETCH_HEAD'], check=True)
    # Existing user-managed trees are only checked, never reset or overwritten.


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='check existing sources without fetching')
    mode.add_argument('--pin', action='store_true', help='record reviewed local context changes')
    args = parser.parse_args()
    lock = json.loads(LOCK.read_text())
    if lock['format'] != 'werewolf-package-sources/1':
        raise ValueError('unknown package source lock format')
    for source in lock['sources']:
        if source['name'] != 'packages':
            raise ValueError('unknown sibling package repository')
        directory = ROOT.parent / source['name']
        if not args.check and not args.pin:
            checkout(source, directory)
        actual = digest(directory, source['contexts'])
        if args.pin:
            if subprocess.check_output(['git', '-C', directory, 'status', '--porcelain', '--', *[str(context_dir(directory, name).relative_to(directory)) for name in source['contexts']]]):
                raise ValueError('commit the reviewed package context changes before pinning: ' + str(directory))
            source['ref'] = subprocess.check_output(['git', '-C', directory, 'rev-parse', 'HEAD'], text=True).strip()
            source['sha256'] = actual
        elif actual != source['sha256']:
            raise ValueError('package source pin mismatch: %s; review the changes and run tools/checkout-packages --pin' % directory)
        print('%s: verified %d contexts (%s)' % (source['name'], len(source['contexts']), actual[:12]))
    if args.pin:
        LOCK.write_text(json.dumps(lock, indent=2, sort_keys=True) + '\n')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit('checkout-packages: ' + str(error))
