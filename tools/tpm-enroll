#!/usr/bin/env python3
"""Provision a fresh host-controlled TPM; retain reset credentials outside guests."""
import hashlib
import os
from pathlib import Path
import subprocess
import sys

public, factory, credentials, probe = [Path(arg).resolve() for arg in sys.argv[1:]]
os.umask(0o077)
credentials.mkdir(mode=0o700)  # Never overwrite credentials or silently reenroll.


def run(args):
    return subprocess.run([str(arg) for arg in args], cwd=credentials,
                          capture_output=True, check=True, timeout=30).stdout


raw = factory.read_bytes()
if len(raw) < 176 or raw[:16] != b'werewolf.boot/2\0' or raw[48:80] != bytes(32) or raw[80:112] != raw[112:144]:
    sys.exit('tpm-enroll: requires a signed initial factory pair')
index = '0x1500021'
handles = run(['tpm2_getcap', 'handles-nv-index']).decode()
if any(int(line.strip(' -\n'), 16) == int(index, 16) for line in handles.splitlines() if '0x' in line):
    sys.exit('tpm-enroll: index already exists; refusing to replace trust')
for filename, data in [('factory.state', raw[:176]), ('factory.sig', raw[176:]),
                       ('factory.id', raw[80:112]), ('factory.digest', hashlib.sha256(raw[:176]).digest()),
                       ('factory.anchor', hashlib.sha256(raw[48:80] + hashlib.sha256(raw[:176]).digest()).digest()),
                       ('qualifier', b'werewolf.boot/2')]:
    (credentials / filename).write_bytes(data)
run([probe, 'verify-pair', public, 'factory.state', 'factory.sig', 'factory.anchor', 'factory.id'])
for name, hierarchy in [('owner', 'o'), ('lockout', 'l')]:
    (credentials / (name + '.auth')).write_bytes(os.urandom(32))
    run(['tpm2_changeauth', '-c', hierarchy, 'file:' + name + '.auth'])
run(['tpm2_clearcontrol', '-C', 'l', '-P', 'file:lockout.auth', 's'])
run(['tpm2_loadexternal', '-G', 'rsa', '-C', 'o', '-a', 'sign|userwithauth',
     '-u', public, '-c', 'signer.ctx', '-n', 'signer.name'])
run(['tpm2_startauthsession', '-S', 'trial.ctx'])
run(['tpm2_policyauthorize', '-S', 'trial.ctx', '-n', 'signer.name',
     '-q', 'qualifier', '-L', 'authorize.policy'])
run(['tpm2_flushcontext', 'trial.ctx'])
run(['tpm2_flushcontext', '-t'])
run(['tpm2_nvdefine', index, '-C', 'o', '-P', 'file:owner.auth', '-s', '32', '-g', 'sha256',
     '-a', 'nt=extend|ownerwrite|policywrite|authread|no_da', '-L', 'authorize.policy'])
run(['tpm2_nvextend', index, '-C', 'o', '-P', 'file:owner.auth', '-i', 'factory.digest'])
run(['tpm2_nvread', index, '-s', '32', '-o', 'actual.anchor'])
if (credentials / 'actual.anchor').read_bytes() != (credentials / 'factory.anchor').read_bytes():
    sys.exit('tpm-enroll: factory anchor readback failed')
print('tpm-enroll: factory pair provisioned; reset credentials retained on host')
