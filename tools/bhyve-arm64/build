#!/usr/bin/env python3
"""Build pinned ARM64 bhyve/firmware privately; never install or elevate."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess

FREEBSD = '893c7c99b60dd500a1ad30de667713e2400de15a'
UBOOT = 'e37de002fac3895e8d0b60ae2015e17bb33e2b5b'
RELEASE = '15.1-RELEASE-p5'
RECIPE = Path(__file__).resolve().parent
GIT_ENV = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
               GIT_TERMINAL_PROMPT='0')


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            value.update(chunk)
    return value.hexdigest()


def run(args, **kwargs):
    print(shlex.join(map(str, args)), flush=True)
    if args[0] == 'git':
        kwargs.setdefault('env', GIT_ENV)
    return subprocess.run(list(map(str, args)), check=True, **kwargs)


def checkout(root, name, revision, cache):
    dest = root / name
    upstream = 'https://github.com/' + name + '.git'
    paths = ['Makefile', 'Makefile.inc1', 'Makefile.sys.inc', 'usr.sbin/Makefile.inc',
             'usr.sbin/bhyve', 'lib/Makefile.inc', 'lib/libfdt', 'sys', 'share/mk',
             'contrib/lib9p'] if name == 'freebsd/freebsd-src' else []
    if cache:
        # Archive the committed tree, never the cache's possibly patched worktree.
        dest.mkdir(parents=True)
        run(['git', 'init', dest])  # Isolate apply from a parent checkout, if any.
        archive = dest / 'source.tar'
        with archive.open('wb') as output:
            run(['git', '-C', cache, 'archive', revision, *paths], stdout=output)
        run(['tar', '-xf', archive, '-C', dest])
        archive.unlink()
    else:
        run(['git', 'init', dest])
        run(['git', '-C', dest, 'remote', 'add', 'origin', upstream])
        run(['git', '-C', dest, 'fetch', '--depth=1', '--filter=blob:none', 'origin', revision])
        if paths:
            run(['git', '-C', dest, 'sparse-checkout', 'set', '--skip-checks', *paths])
        run(['git', '-C', dest, 'checkout', '--detach', revision])
    actual = subprocess.check_output(['git', '-C', str(cache or dest), 'rev-parse', revision], text=True, env=GIT_ENV).strip()
    if actual != revision:
        raise RuntimeError('source revision mismatch')
    return dest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('output', type=Path, help='new, non-existing private build directory')
    parser.add_argument('--packages', required=True, type=Path, help='cache containing the locked .pkg files')
    parser.add_argument('--freebsd-cache', help='optional local git repository; its worktree is never modified')
    parser.add_argument('--uboot-cache', help='optional local git repository')
    parser.add_argument('--jobs', type=int, default=4)
    args = parser.parse_args()
    if platform.system() != 'FreeBSD' or platform.machine() not in ('arm64', 'aarch64') or platform.release() != RELEASE:
        parser.error('requires native FreeBSD ' + RELEASE + ' arm64 (source must match the host ABI)')
    if args.jobs < 1:
        parser.error('--jobs must be positive')
    expected = dict(line.split() for line in (RECIPE / 'packages.sha256').read_text().splitlines())
    packages = {}
    for path in args.packages.rglob('*.pkg'):
        value = digest(path)
        if value in expected:
            packages[value] = path.resolve()
    missing = expected.keys() - packages.keys()
    if missing:
        parser.error('missing pinned packages: ' + ', '.join(expected[key] for key in sorted(missing)))
    root = args.output.resolve()
    root.mkdir(mode=0o700)  # Refuse reuse, including an existing empty directory.
    deps, bins = root / 'deps', root / 'bin'
    deps.mkdir()
    bins.mkdir()
    for value in sorted(packages):
        run(['tar', '-xf', packages[value], '-C', deps])
    prefix = deps / 'usr/local'
    for alias, binary in [('sed', 'gsed'), ('date', 'gdate'), ('touch', 'gtouch')]:
        (bins / alias).symlink_to(prefix / 'bin' / binary)
    src = checkout(root, 'freebsd/freebsd-src', FREEBSD, args.freebsd_cache)
    uboot = checkout(root, 'u-boot/u-boot', UBOOT, args.uboot_cache)
    for source, patch in [(src, 'rtc.patch'), (uboot, 'u-boot.patch')]:
        run(['git', '-C', source, 'apply', '--check', RECIPE / patch])
        run(['git', '-C', source, 'apply', RECIPE / patch])
    run(['make', '-C', src / 'lib/libfdt', '-j' + str(args.jobs), 'all'])
    run(['make', '-C', src / 'usr.sbin/bhyve', '-j' + str(args.jobs), 'WITHOUT_BHYVE_SNAPSHOT=yes', 'all'])
    env = dict(os.environ, PATH=f'{bins}:{prefix}/bin:/usr/bin:/bin:/usr/local/bin',
               LD_LIBRARY_PATH=str(prefix / 'lib'), BISON_PKGDATADIR=str(prefix / 'share/bison'),
               M4=str(prefix / 'bin/gm4'), SHELL=str(prefix / 'bin/bash'),
               CONFIG_SHELL=str(prefix / 'bin/bash'), CROSS_COMPILE='aarch64-none-elf-',
               PYTHON='python3', SOURCE_DATE_EPOCH='1751846400')
    # Match the patched pinned checkout's version even when building an archive.
    # Otherwise setlocalversion embeds different strings for identical sources.
    release = 'UBOOTRELEASE=2025.07-g' + UBOOT[:12] + '-dirty'
    run(['gmake', 'HOSTCC=cc', release, 'bhyve_arm64_defconfig'], cwd=uboot, env=env)
    run(['gmake', '-j' + str(args.jobs), 'HOSTCC=cc', release, 'u-boot.bin'], cwd=uboot, env=env)
    artifacts = {}
    for name, source in [('bhyve', src / 'usr.sbin/bhyve/bhyve'),
                         ('u-boot.bin', uboot / 'u-boot.bin')]:
        shutil.copy2(source, root / name)
        artifacts[name] = digest(root / name)
    shutil.copy2(uboot / '.config', root / 'u-boot.config')
    manifest = dict(host=platform.uname()._asdict(), freebsd_commit=FREEBSD, uboot_commit=UBOOT,
                    ports_commit='3a7a1297a515552d4aef02f06cd5ee1a92ed4583',
                    patches={name: digest(RECIPE / name) for name in ('rtc.patch', 'u-boot.patch')},
                    packages=expected, artifacts=artifacts,
                    host_tools={name: subprocess.check_output([name, '--version'], text=True).splitlines()[0]
                                for name in ('cc', 'gmake', 'python3', 'git')},
                    installed=False, secure_boot=False)
    (root / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    (root / 'runtime.env').write_text(
        'export BHYVE_BINARY=' + shlex.quote(str(root / 'bhyve')) + '\n' +
        'export BHYVE_ARM64_FIRMWARE=' + shlex.quote(str(root / 'u-boot.bin')) + '\n')
    print('Built private runtime: ' + str(root / 'runtime.env'))


if __name__ == '__main__':
    main()
