#!/usr/bin/env python3
"""Own one bhyve TAP on an existing bridge; never reconfigure the host network."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys
import tempfile


def interface(name):
    return bool(re.fullmatch(r'[A-Za-z][A-Za-z0-9_.-]{0,14}', name))


def ifconfig(*args, change=False, missing=False):
    prefix = []
    if change and os.geteuid() != 0:
        elevate = shutil.which('doas') or shutil.which('sudo')
        if not elevate:
            raise ValueError('TAP setup needs root, doas or sudo')
        prefix = [elevate]
    result = subprocess.run(prefix + ['/sbin/ifconfig', *args], capture_output=True, text=True)
    if result.returncode:
        if missing and 'does not exist' in result.stderr:
            return None
        raise ValueError(result.stderr.strip() or 'ifconfig failed')
    return result.stdout


def bridge(wanted=None):
    bridges = ifconfig('-g', 'bridge').split()
    if wanted:
        if not interface(wanted) or wanted not in bridges:
            raise ValueError('not an existing bridge: ' + wanted)
        return wanted
    if len(bridges) != 1:
        raise ValueError('TAP needs one existing bridge; choose --bridge NAME, '
                         'or use --network slirp (no bridge is created automatically)')
    return bridges[0]


def owner_prefix(directory):
    return 'howl:' + hashlib.sha256(str(directory.resolve()).encode()).hexdigest()[:20] + ':'


def load(directory):
    try:
        state = json.loads((directory / 'bhyve-network.json').read_text())
    except FileNotFoundError:
        return None
    if (not isinstance(state, dict) or set(state) != {'mode', 'tap', 'bridge', 'owner'} or
            any(not isinstance(value, str) for value in state.values()) or state['mode'] != 'tap' or
            not re.fullmatch(r'tap[0-9]+', state['tap']) or not interface(state['bridge']) or
            not re.fullmatch(re.escape(owner_prefix(directory)) + r'[0-9a-f]{32}', state['owner'])):
        raise ValueError('invalid bhyve TAP ownership record; inspect it before changing networking')
    return state


def description(text):
    for line in text.splitlines():
        if line.strip().startswith('description: '):
            return line.strip().removeprefix('description: ')
    return None


def down(directory, expected=None):
    state = load(directory)
    if not state or expected is not None and expected != state['owner']:
        return
    current = ifconfig(state['tap'], missing=True)
    if current is not None:
        if description(current) != state['owner']:
            raise ValueError(state['tap'] + ': not this VM\'s TAP; leaving it untouched')
        ifconfig(state['tap'], 'destroy', change=True)
    (directory / 'bhyve-network.json').unlink(missing_ok=True)


def up(directory, wanted=None):
    selected = bridge(wanted)
    previous = load(directory)
    if previous:
        current = ifconfig(previous['tap'], missing=True)
        if current is not None and description(current) != previous['owner']:
            raise ValueError(previous['tap'] + ': not this VM\'s TAP; leaving it untouched')
        if current is not None and selected == previous['bridge']:
            # Reassert membership/up in case an operator detached the interface.
            members = [line.strip().split()[1] for line in ifconfig(selected).splitlines()
                       if line.strip().startswith('member: ')]
            if previous['tap'] not in members:
                ifconfig(selected, 'addm', previous['tap'], change=True)
            ifconfig(previous['tap'], 'up', change=True)
            return previous
        down(directory)
    tap = ifconfig('tap', 'create', change=True).strip()
    if not re.fullmatch(r'tap[0-9]+', tap):
        raise ValueError('ifconfig returned an unexpected new TAP name: ' + tap)
    state = dict(mode='tap', tap=tap, bridge=selected,
                 owner=owner_prefix(directory) + secrets.token_hex(16))
    temporary = None
    try:
        ifconfig(tap, 'description', state['owner'], 'up', change=True)
        ifconfig(selected, 'addm', tap, change=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=directory, prefix='.bhyve-network-',
                                         delete=False) as output:
            temporary = Path(output.name)
            json.dump(state, output)
            output.flush()
            os.fsync(output.fileno())
        temporary.replace(directory / 'bhyve-network.json')
    except BaseException:
        # This invocation allocated the interface; no pre-existing TAP is removed.
        ifconfig(tap, 'destroy', change=True)
        raise
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)
    return state


def main():
    if len(sys.argv) not in (3, 4) or sys.argv[1] not in ('up', 'down'):
        raise ValueError('usage: bhyve-network up DIR [BRIDGE] | down DIR [EXPECTED_OWNER]')
    operation, directory = sys.argv[1], Path(sys.argv[2]).resolve(strict=True)
    argument = sys.argv[3] if len(sys.argv) == 4 else None
    os.umask(0o077)
    descriptor = os.open(directory / 'bhyve-network.lock', os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(descriptor, 'w') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        if operation == 'up':
            print(json.dumps(up(directory, argument)))
        else:
            down(directory, argument)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit('bhyve-network: ' + str(error))
