#!/usr/bin/env python3
"""Provision tested public Secure Boot firmware and native enrollment tools; no build VM."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile

URL = ('https://ports.ubuntu.com/ubuntu-ports/pool/main/e/edk2/'
       'qemu-efi-aarch64_2024.02-2ubuntu0.10_all.deb')
PACKAGE_SHA = 'fad8e80e929cd00dae8c5c8e5dd3ec85f37d9a832eea776957e5e2cf86ef2ab5'
FILES = {
    'code.fd': ('AAVMF_CODE.secboot.fd', 'd37119b2c1173ecdc88d09c00848842fdf575899403b7549a5b51f06766c20d6'),
    'template.fd': ('AAVMF_VARS.fd', 'b3b855c5a80310168051164986855692d1bdb06e67619856177965cd87c6774f'),
}


def digest(path):
    with Path(path).open('rb') as stream:
        result = hashlib.sha256()
        for part in iter(lambda: stream.read(1 << 20), b''):
            result.update(part)
        return result.hexdigest()


def run(argv, **kwargs):
    return subprocess.run(list(map(str, argv)), check=True, stdout=sys.stderr, **kwargs)


def valid(directory):
    return all((directory / name).is_file() and not (directory / name).is_symlink() and
               (directory / name).stat().st_size == 64 << 20 and digest(directory / name) == sha
               for name, (_, sha) in FILES.items())


def provision(arch, requirements, cache):
    if arch != 'aarch64':
        raise ValueError('managed native firmware currently supports aarch64')
    requirements = Path(requirements).resolve()
    cache = Path(cache).resolve()
    os.umask(0o077)
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    identity = hashlib.sha256((digest(requirements) + PACKAGE_SHA + sys.version +
                              platform.machine()).encode()).hexdigest()
    target = cache / identity
    target.mkdir(mode=0o700, exist_ok=True)
    with (cache / 'native.lock').open('a+b') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        if not valid(target):
            with tempfile.TemporaryDirectory(prefix='public-firmware-', dir=target) as temporary:
                work = Path(temporary)
                package = work / 'firmware.deb'
                run(['curl', '--fail', '--location', '--retry', '3', '--proto', '=https',
                     '--tlsv1.2', URL, '-o', package])
                if package.stat().st_size != 4114848 or digest(package) != PACKAGE_SHA:
                    raise ValueError('public firmware package does not match the trusted pin')
                # Extract only the authenticated secure code and empty variable template.
                # The package's default/snakeoil trust and private sample keys never enter cache.
                data = work / 'data.tar.zst'
                with data.open('xb') as stream:
                    subprocess.run(['bsdtar', '-xOf', str(package), 'data.tar.zst'],
                                   check=True, stdout=stream)
                for name, (member, _) in FILES.items():
                    with (work / name).open('xb') as stream:
                        subprocess.run(['bsdtar', '-xOf', str(data), './usr/share/AAVMF/' + member],
                                       check=True, stdout=stream)
                if not valid(work):
                    raise ValueError('firmware code/template do not match the tested pair')
                for name in FILES:
                    os.replace(work / name, target / name)
        env = target / 'venv'
        marker = target / 'tools-complete'
        tool = env / 'bin/virt-fw-vars'
        if not marker.is_file() or not tool.is_file():
            if env.exists():
                shutil.rmtree(env)
            run([sys.executable, '-m', 'venv', env])
            run([env / 'bin/python', '-m', 'pip', 'install', '--disable-pip-version-check',
                 '--require-hashes', '--no-deps', '--only-binary=:all:', '-r', requirements])
            # The unused qemutest/cloud-password utility needs Linux crypt_r on Python 3.13+.
            # Install the complete pinned vars-tool dependency set without that optional utility.
            subprocess.run([tool, '--help'], check=True, stdout=subprocess.DEVNULL)
            marker.write_text(identity + '\n')
        return {name: str(target / name) for name in FILES} | {'tool': str(tool)}


if __name__ == '__main__':
    # Xcode still supplies Python 3.9. The pinned enrollment dependencies
    # need 3.10+, even when an older python3 appears first on PATH.
    if sys.version_info < (3, 10):
        for minor in range(14, 9, -1):
            python = shutil.which('python3.' + str(minor))
            if python:
                os.execv(python, [python, *sys.argv])
        print('howl: native firmware tools need Python 3.10+; run make install-deps', file=sys.stderr)
        sys.exit(1)
    try:
        arch, requirements, report = sys.argv[1:]
        cache = os.environ.get('WEREWOLF_FIRMWARE_CACHE', 'build/secure-cache/firmware')
        result = provision(arch, requirements, cache)
        Path(report).write_text(json.dumps(result) + '\n')
    except (OSError, ValueError, subprocess.SubprocessError):
        print('howl: native Secure Boot firmware preparation failed; no plain fallback', file=sys.stderr)
        sys.exit(1)
