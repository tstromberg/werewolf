#!/bin/sh
# pre-commit runs what every commit must pass: the unit tests in parallel,
# lint, and one machine, sshd (minimal with a login), built, booted and
# attacked once: an ssh login, every console check and a clean power-off.
# It takes half a minute when the programs are built, and a minute or so
# when a library changed and they are not. `make hooks` points git here
# (core.hooksPath). The other forms, the slot and the persist run
# (make -j check) take minutes even on a fast machine; run them before a
# push, as CI will.
set -eu
cd "$(git rev-parse --show-toplevel)"
n=$(getconf _NPROCESSORS_ONLN)
make -j"$n" test
make lint
make -j"$n" AGAIN_FORMS= check-sshd
