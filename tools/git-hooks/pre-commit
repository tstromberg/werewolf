#!/bin/sh
# pre-commit runs the unit tests, lint, and a small local howl boot.
# `make install-precommit` points git here (core.hooksPath). The other forms,
# the slot and the persist run (make -j check) take minutes; run them before
# a push, as CI will.
set -eu
cd "$(git rev-parse --show-toplevel)"
# Git fixtures create their own repositories, outside this hook's Git context.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
n=$(getconf _NPROCESSORS_ONLN)
make -j"$n" test
make lint
test/howl-run-smoke build/host/howl
