#!/bin/sh
# install-deps [-y] [apko] [zig] installs what building, booting and checking
# werewolf needs, on macOS, Debian, Ubuntu, Fedora, Arch, FreeBSD or NetBSD.
# The BSDs are experimental: no CI runs them. It shows what it will run and
# asks first; -y does not ask. With `apko`, `zig` or both, it installs only
# those, for jobs that need nothing else: resolving packages, or building a
# tool.
#
# Packages come from the system's package manager, run as root through doas
# or sudo (Homebrew's runs as the user). Tools a system lacks at the version
# the build needs come from upstream, pinned by version and sha256:
#   - apko and Zig, which a release's bytes depend on (docs/releases.md);
#   - melange, which builds the packages Wolfi does not ship (cmd/howl/melange.zig);
#   - crane, which pulls the OCI images a form bakes in (cmd/howl/oci.zig);
#   - Firecracker, on Linux (cmd/howl/firecracker.zig);
#   - erofs-utils, built from source where the system's is older than 1.9
#     or has no zstd (Homebrew's has none, so on macOS it is always built).
# The BSDs have no apko or crane release, so install-deps builds them with
# Go, pinned by Go's checksum database.
#
# It installs only what is missing or not the pinned version, so a second
# run installs nothing and takes a second. test/ci-setup runs it for CI.
#
# It is a shell script, not a Zig program, because it is what installs Zig.
# `make install-deps` runs it. On FreeBSD and NetBSD, whose make is not GNU
# make, run it directly and use gmake afterwards.
#
# Commands and package lists are split into words on purpose, with globbing
# off.
# shellcheck disable=SC2086
set -euf

apko_version=1.3.1
melange_version=0.61.4
# crane comes from go-containerregistry. howl pulls the images a form bakes
# in with it (cmd/howl/oci.zig). Homebrew packages it; Linux distributions
# do not.
crane_version=0.20.6
zig_version=0.17.0 # the Makefile's ZIG_VERSION
erofs_version=1.9.4
erofs_sha256=7d135aa2550326a5acf20f53c518aea5a8900015ce50700044e40f818c31dd80
# Firecracker, on Linux: howl create keeps machines on it where there is KVM
# (cmd/howl/firecracker.zig). No distribution packages it.
fc_version=1.17.0

die() {
	echo "install-deps: $*" >&2
	exit 1
}

# only lists the tools named, or is empty for everything.
yes='' only=''
for a; do
	case $a in
	-y) yes=1 ;;
	apko | zig) only="${only:+$only }$a" ;;
	*)
		echo "usage: install-deps [-y] [apko] [zig]" >&2
		exit 2
		;;
	esac
done

# wants TOOL reports whether to install TOOL: every tool, unless some were named.
wants() {
	case " $only " in
	"  " | *" $1 "*) return 0 ;;
	esac
	return 1
}

arch=$(uname -m)
case $arch in
amd64) arch=x86_64 ;;
arm64) arch=aarch64 ;;
esac

erofs_ok() { # mkfs.erofs is 1.9 or later, with zstd, as the Makefile insists
	v=$(mkfs.erofs --version 2>/dev/null | sed -n 's/.*erofs-utils) *//p')
	case $v in '' | 1.[0-8] | 1.[0-8].*) return 1 ;; esac
	{ mkfs.erofs --version; mkfs.erofs --help; } 2>&1 | grep -q 'available compressors:.*zstd'
}

apko_version() { # apko's version, as vX.Y.Z, or nothing
	apko version 2>/dev/null | sed -n 's/^GitVersion: *//p'
}

melange_version() { # melange's version, as X.Y.Z, or nothing
	melange version 2>/dev/null | sed -n 's/^GitVersion: *v*//p'
}

# Per system, set: its name; its package manager (pm) and the commands that
# refresh its index and install; the packages the build needs, and those
# apko or Zig alone needs; for upstream downloads, zos (the OS in Zig's
# release names) and the sha256 of each download; and the packages
# erofs-utils builds from, if it must be built, with the make and
# environment that build it and where it goes.
update='' zos='' zig_sha256='' apko_sha256='' melange_sha256='' apko_pkgs='' zig_pkgs='' erofs_deps='' erofs_env=''
mk='make' erofs_prefix=/usr/local
case $(uname -s) in
Darwin)
	command -v brew >/dev/null || die "needs Homebrew: https://brew.sh"
	[ "$(id -u)" != 0 ] || die "Homebrew will not run as root; run as yourself"
	system="macOS $(sw_vers -productVersion)"
	pm=brew
	install="brew install"
	pkgs="apko melange crane lima qemu zstd zig mtools e2fsprogs"
	apko_pkgs=apko
	zig_pkgs=zig
	# Homebrew's erofs-utils has no zstd, so build it into Homebrew's
	# prefix, which belongs to the user and is in PATH. Homebrew's own, if
	# installed, is unlinked first so the two do not fight over the names.
	b=$(brew --prefix)
	erofs_deps="autoconf automake libtool pkgconf lz4 zstd"
	erofs_env="CPPFLAGS=-I$b/include LDFLAGS=-L$b/lib"
	erofs_prefix=$b
	;;
Linux)
	[ -r /etc/os-release ] || die "no /etc/os-release: which Linux is this?"
	# shellcheck source=/dev/null
	. /etc/os-release
	system=${PRETTY_NAME:-Linux}
	zos=linux
	case $arch in
	x86_64)
		zig_sha256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
		apko_sha256=b8c39ff7e63864efa1296d36a95d3c56f750ef2ab41cdc6d7fad0ae6a483b604
		melange_sha256=3b864f61399ea05f402178c8e127bf9d46a9c5b2ff4965e59a07b40ce2d2d55f
		crane_sha256=c1d593d01551f2c9a3df5ca0a0be4385a839bd9b86d4a76e18d7b17d16559127
		fc_sha256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
		;;
	aarch64)
		zig_sha256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8
		apko_sha256=47ec5e9e66372629919598f5176b37e9e47a3be456b2c8c9541a891065123fbb
		melange_sha256=ca5f777f9011d0b024c7cc1032200ddb5f614d80f1aaa826f61205392bf985be
		crane_sha256=fc0515857bc38e4ddd2d37a5ab03fb5959449c7b2d4ad759bcc1174ac0cad91b
		fc_sha256=e351ebe4f7a16b5873bbd51005d2e6767103cff4d5ebc829df2d3f95a93e2256
		;;
	*) die "$arch is not supported: x86_64 or aarch64" ;;
	esac
	# Each system also gets python3's pip, for make lint's yamllint;
	# systemd-nspawn, for make check-native; and bubblewrap, melange's sandbox.
	case " ${ID:-} ${ID_LIKE:-} " in
	*" debian "* | *" ubuntu "*)
		case $arch in
		x86_64) qemu="qemu-system-x86 ovmf" ;;
		aarch64) qemu="qemu-system-arm qemu-efi-aarch64" ;;
		esac
		pm=apt
		# install waits for another apt to finish, such as a new machine's
		# first upgrade. update does not wait, so it is retried (retry).
		apt="env DEBIAN_FRONTEND=noninteractive apt-get -q -o DPkg::Lock::Timeout=600"
		update="$apt update"
		install="$apt install -y --no-install-recommends"
		pkgs="ca-certificates curl make xz-utils zstd libarchive-tools erofs-utils e2fsprogs mtools
			qemu-utils expect netcat-openbsd python3-pip systemd-container bubblewrap $qemu"
		apko_pkgs="ca-certificates curl"
		zig_pkgs="ca-certificates curl xz-utils"
		erofs_deps="autoconf automake libtool pkg-config gcc liblz4-dev libzstd-dev uuid-dev zlib1g-dev"
		;;
	*" fedora "*)
		case $arch in
		x86_64) qemu="qemu-system-x86 edk2-ovmf" ;;
		aarch64) qemu="qemu-system-aarch64 edk2-aarch64" ;;
		esac
		pm=dnf
		install="dnf install -y"
		pkgs="curl make xz zstd bsdtar erofs-utils e2fsprogs mtools qemu-img expect netcat
			python3-pip systemd-container bubblewrap $qemu"
		apko_pkgs=curl
		zig_pkgs="curl xz"
		erofs_deps="autoconf automake libtool pkgconf-pkg-config gcc lz4-devel libzstd-devel
			libuuid-devel zlib-devel"
		;;
	*" arch "*)
		case $arch in
		x86_64) qemu="qemu-system-x86 edk2-ovmf" ;;
		aarch64) qemu="qemu-system-aarch64" ;; # Arch Linux ARM packages no edk2
		esac
		pm=pacman
		# Arch installs only onto an up-to-date system, hence -Syu. Its
		# systemd includes systemd-nspawn.
		install="pacman -Syu --needed --noconfirm"
		pkgs="curl make xz zstd libarchive erofs-utils e2fsprogs mtools qemu-img expect openbsd-netcat
			python-pip bubblewrap $qemu"
		apko_pkgs=curl
		zig_pkgs="curl xz"
		erofs_deps="base-devel lz4 zstd util-linux-libs zlib"
		;;
	*) die "$system is not supported: Debian, Ubuntu, Fedora or Arch" ;;
	esac
	;;
FreeBSD)
	system="FreeBSD $(freebsd-version)"
	zos=freebsd
	case $arch in
	x86_64) zig_sha256=a314f1cc92d098bd39caf9e5607a0de2a8fd0d00064776cb3fd5b3bee38a67c9 ;;
	aarch64) zig_sha256=3cf53d07b3587a26727b196a6eb7918704b907d951520daa68e4e1820fc6f48e ;;
	*) die "$arch is not supported: amd64 or arm64" ;;
	esac
	pm=pkg
	# ASSUME_ALWAYS_YES also bootstraps pkg itself without asking.
	install="env ASSUME_ALWAYS_YES=yes pkg install"
	# Its base has bsdtar, nc, xz and zstd; ports have no erofs-utils.
	# howl create keeps machines on bhyve, which needs bhyve-firmware (its
	# UEFI firmware) and libslirp (its user-mode network).
	pkgs="gmake curl qemu-nox11 mtools e2fsprogs-core expect bhyve-firmware libslirp"
	apko_pkgs=''
	zig_pkgs=curl
	erofs_deps="autoconf automake libtool pkgconf liblz4 zstd"
	mk=gmake
	erofs_env="CPPFLAGS=-I/usr/local/include LDFLAGS=-L/usr/local/lib"
	;;
NetBSD)
	# Experimental, and amd64 only: NVMM, which accelerates QEMU, has no
	# arm64, and uname -m says evbarm there.
	system="NetBSD $(uname -r)"
	zos=netbsd
	case $arch in
	x86_64) zig_sha256=10f71cc89efbafc6e22447f23c44047d53c5d2061c82b1c32efd1ef55ea2d9b6 ;;
	*) die "$arch is not supported on NetBSD: amd64" ;;
	esac
	command -v pkgin >/dev/null || die "needs pkgin: pkg_add pkgin, as sysinst offers"
	pm=pkgin
	install="pkgin -y install"
	# Its base has nc and xz. Its tar is not bsdtar, so libarchive brings
	# that. pkgsrc has no erofs-utils.
	pkgs="gmake curl qemu mtools e2fsprogs tcl-expect libarchive zstd"
	apko_pkgs=''
	zig_pkgs=curl
	erofs_deps="autoconf automake libtool pkgconf lz4 zstd"
	mk=gmake
	# Each flag must be one word, since the list is split. The linker gets
	# -L and -R itself, so the libraries are found at run time too.
	erofs_env="CPPFLAGS=-I/usr/pkg/include LDFLAGS=-Wl,-L/usr/pkg/lib,-R/usr/pkg/lib"
	;;
*) die "$(uname -s) is not supported: macOS, Debian, Ubuntu, Fedora, Arch, FreeBSD or NetBSD" ;;
esac

# Work out what to do: the packages not installed, and upstream tools that
# are missing or not the pinned version.
need_apko='' need_melange='' need_crane='' need_zig='' need_erofs='' need_fc=''
if [ -n "$zos" ]; then
	! wants apko || [ "$(apko_version)" = "v$apko_version" ] || need_apko=yes
	! wants zig || [ "$(zig version 2>/dev/null)" = "$zig_version" ] || need_zig=yes
	[ -n "$only" ] || [ "$(crane version 2>/dev/null)" = "v$crane_version" ] || need_crane=yes
fi
if [ "$zos" = linux ] && [ -z "$only" ]; then
	[ "$(firecracker --version 2>/dev/null | head -n 1)" = "Firecracker v$fc_version" ] || need_fc=yes
	[ "$(melange_version)" = "$melange_version" ] || need_melange=yes
fi
[ -n "$only" ] || erofs_ok || need_erofs=yes
if [ -n "$only" ]; then
	pkgs=''
	! wants apko || pkgs=$apko_pkgs
	! wants zig || pkgs="$pkgs $zig_pkgs"
fi
case $pm in
pkg | pkgin) [ -z "$need_apko$need_crane" ] || pkgs="$pkgs go" ;; # go builds apko and crane
esac
case $pm in
apt) have=$(dpkg-query -W -f '${db:Status-Status} ${Package}\n' | sed -n 's/^installed //p') ;;
dnf) have=$(rpm -qa --qf '%{NAME}\n') ;;
pacman) have=$(pacman -Qq) ;;
pkg) have=$(! pkg -N >/dev/null 2>&1 || pkg query %n) ;;
pkgin) have=$(pkg_info | sed 's/-[0-9][^ ]* .*//') ;; # name-version  comment
brew) have=$(brew list --formula -1) ;;
esac
missing=''
for p in $pkgs; do
	printf '%s\n' "$have" | grep -qx "$p" || missing="$missing $p"
done

root=''
if [ -n "$zos" ] && [ "$(id -u)" != 0 ]; then
	if command -v doas >/dev/null; then
		root=doas
	elif command -v sudo >/dev/null; then
		root=sudo
	else
		die "needs doas or sudo, or root"
	fi
fi

show() { # show COMMAND...: on one line, indented
	printf ' '
	printf ' %s' "$@"
	echo
}

if [ -n "$missing$need_apko$need_melange$need_crane$need_zig$need_erofs$need_fc" ]; then
	echo "install-deps: on $system ($arch)${root:+, as root through $root}, this will:"
	echo
	if [ -n "$missing" ]; then
		[ -z "$update" ] || show $update
		show $install $missing
	fi
	case $need_apko$zos in
	yeslinux) echo "  install apko $apko_version from github.com/chainguard-dev/apko as /usr/local/bin/apko" ;;
	yesfreebsd | yesnetbsd) echo "  build apko $apko_version with go install, as /usr/local/bin/apko" ;;
	esac
	[ -z "$need_melange" ] ||
		echo "  install melange $melange_version from github.com/chainguard-dev/melange as /usr/local/bin/melange"
	case $need_crane$zos in
	yeslinux) echo "  install crane $crane_version from github.com/google/go-containerregistry as /usr/local/bin/crane" ;;
	yesfreebsd | yesnetbsd) echo "  build crane $crane_version with go install, as /usr/local/bin/crane" ;;
	esac
	[ -z "$need_zig" ] ||
		echo "  install zig $zig_version from ziglang.org in /usr/local/zig-$zig_version, linked as /usr/local/bin/zig"
	[ -z "$need_fc" ] ||
		echo "  install firecracker $fc_version from github.com/firecracker-microvm as /usr/local/bin/firecracker"
	if [ -n "$need_erofs" ]; then
		echo "  if mkfs.erofs is then older than 1.9 or has no zstd, build erofs-utils $erofs_version"
		show into $erofs_prefix, after: $install $erofs_deps
		[ "$pm" != brew ] || ! printf '%s\n' "$have" | grep -qx erofs-utils || show brew unlink erofs-utils
	fi
	if [ -n "$zos" ] && [ -z "$only" ]; then
		echo
		echo "  Lima is not installed; howl uses it only on a Mac, and runs machines here without it."
	fi
	echo
	if [ -z "$yes" ]; then
		printf 'Continue? [y/N] '
		read -r answer || answer=''
		case $answer in
		[yY]*) ;;
		*) die "nothing installed" ;;
		esac
	fi
fi

retry() { # retry TRIES COMMAND...: until it succeeds, ten seconds apart
	n=$1
	shift
	until "$@"; do
		n=$((n - 1))
		[ "$n" -gt 0 ] || return 1
		echo "install-deps: trying again in 10s: $*"
		sleep 10
	done
}

refresh() { # update the package index, for five minutes if another holds it
	[ -z "$update" ] || retry 30 $root $update || die "could not update the package index"
}

refreshed=''
if [ -n "$missing" ]; then
	refresh
	refreshed=yes
	$root $install $missing
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fetch() { # fetch URL SHA256 FILE
	echo "install-deps: fetching $1"
	curl -fsSL --retry 5 --retry-connrefused -o "$tmp/$3" "$1"
	if command -v sha256sum >/dev/null; then
		got=$(sha256sum "$tmp/$3")
	else
		got=$(sha256 -q "$tmp/$3") # FreeBSD's and NetBSD's: the sum alone
	fi
	[ "${got%% *}" = "$2" ] || die "$1: sha256 ${got%% *}, not $2"
}

if [ -n "$need_apko" ]; then
	case $zos in
	linux)
		go=$(echo "$arch" | sed 's/x86_64/amd64/;s/aarch64/arm64/')
		fetch "https://github.com/chainguard-dev/apko/releases/download/v$apko_version/apko_${apko_version}_linux_$go.tar.gz" \
			"$apko_sha256" apko.tar.gz
		tar -xzf "$tmp/apko.tar.gz" -C "$tmp" --strip-components=1 "apko_${apko_version}_linux_$go/apko"
		;;
	freebsd | netbsd)
		echo "install-deps: building apko $apko_version"
		retry 3 env GOBIN="$tmp" go install "chainguard.dev/apko@v$apko_version" || die "could not build apko"
		;;
	esac
	$root mkdir -p /usr/local/bin
	$root install -m 0755 "$tmp/apko" /usr/local/bin/apko
fi

if [ -n "$need_melange" ]; then
	go=$(echo "$arch" | sed 's/x86_64/amd64/;s/aarch64/arm64/')
	fetch "https://github.com/chainguard-dev/melange/releases/download/v$melange_version/melange_${melange_version}_linux_$go.tar.gz" \
		"$melange_sha256" melange.tar.gz
	tar -xzf "$tmp/melange.tar.gz" -C "$tmp" --strip-components=1 "melange_${melange_version}_linux_$go/melange"
	$root mkdir -p /usr/local/bin
	$root install -m 0755 "$tmp/melange" /usr/local/bin/melange
fi

if [ -n "$need_crane" ]; then
	case $zos in
	linux)
		cr=$(echo "$arch" | sed 's/aarch64/arm64/')
		fetch "https://github.com/google/go-containerregistry/releases/download/v$crane_version/go-containerregistry_Linux_$cr.tar.gz" \
			"$crane_sha256" crane.tar.gz
		tar -xzf "$tmp/crane.tar.gz" -C "$tmp" crane
		;;
	freebsd | netbsd)
		echo "install-deps: building crane $crane_version"
		retry 3 env GOBIN="$tmp" go install "github.com/google/go-containerregistry/cmd/crane@v$crane_version" ||
			die "could not build crane"
		;;
	esac
	$root mkdir -p /usr/local/bin
	$root install -m 0755 "$tmp/crane" /usr/local/bin/crane
fi

if [ -n "$need_zig" ]; then
	fetch "https://ziglang.org/download/$zig_version/zig-$arch-$zos-$zig_version.tar.xz" "$zig_sha256" zig.tar.xz
	mkdir "$tmp/zig"
	tar -xJf "$tmp/zig.tar.xz" -C "$tmp/zig" --strip-components=1
	$root rm -rf "/usr/local/zig-$zig_version"
	$root mkdir -p /usr/local/bin
	$root cp -R "$tmp/zig" "/usr/local/zig-$zig_version"
	$root ln -sf "/usr/local/zig-$zig_version/zig" /usr/local/bin/zig
fi

if [ -n "$need_fc" ]; then
	fetch "https://github.com/firecracker-microvm/firecracker/releases/download/v$fc_version/firecracker-v$fc_version-$arch.tgz" \
		"$fc_sha256" firecracker.tgz
	tar -xzf "$tmp/firecracker.tgz" -C "$tmp" "release-v$fc_version-$arch/firecracker-v$fc_version-$arch"
	$root mkdir -p /usr/local/bin
	$root install -m 0755 "$tmp/release-v$fc_version-$arch/firecracker-v$fc_version-$arch" /usr/local/bin/firecracker
fi

hash -r
if [ -n "$need_erofs" ] && ! erofs_ok; then
	echo "install-deps: building erofs-utils $erofs_version"
	[ -n "$refreshed" ] || refresh
	$root $install $erofs_deps
	[ "$pm" != brew ] || ! printf '%s\n' "$have" | grep -qx erofs-utils || brew unlink erofs-utils
	fetch "https://github.com/erofs/erofs-utils/archive/refs/tags/v$erofs_version.tar.gz" "$erofs_sha256" erofs.tar.gz
	tar -xzf "$tmp/erofs.tar.gz" -C "$tmp"
	# Build in zstd, which the root is made with, and lz4, which the kernel
	# always reads. Leave out image fetching (curl, OpenSSL, libxml2), which
	# werewolf never uses.
	(cd "$tmp/erofs-utils-$erofs_version" && ./autogen.sh &&
		env $erofs_env ./configure -q --prefix="$erofs_prefix" --disable-lzma --enable-lz4 --with-libzstd \
			--without-libcurl --without-openssl --without-libxml2 --disable-fuse &&
		$mk -s -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || getconf NPROCESSORS_ONLN)") >"$tmp/erofs.log" 2>&1 ||
		{ cat "$tmp/erofs.log" >&2; die "could not build erofs-utils $erofs_version"; }
	$root $mk -s -C "$tmp/erofs-utils-$erofs_version" install >/dev/null
	hash -r
fi

# Check what the build will find, whether or not this run installed it.
in_path() { # in_path TOOL [DIR]: why TOOL is not what was installed in DIR
	echo "$1 is $(command -v "$1" || echo missing): is ${2:-/usr/local}/bin first in PATH?"
}
if wants apko; then
	if [ -n "$zos" ]; then
		[ "$(apko_version)" = "v$apko_version" ] || die "$(in_path apko)"
	else
		command -v apko >/dev/null || die "no apko"
	fi
fi
! wants zig || [ "$(zig version 2>/dev/null)" = "$zig_version" ] || die "$(in_path zig)"
if [ -n "$only" ]; then
	! wants apko || echo "install-deps: apko $(apko_version)"
	! wants zig || echo "install-deps: zig $(zig version)"
	exit 0
fi
erofs_ok || die "$(in_path mkfs.erofs "$erofs_prefix")"
[ "$zos" != linux ] || [ "$(melange_version)" = "$melange_version" ] || die "$(in_path melange)"
echo "install-deps: apko $(apko_version), zig $(zig version), $(mkfs.erofs --version | head -n 1)," \
	"$(qemu-system-"$arch" --version | head -n 1)"
if [ -e /dev/kvm ] && [ ! -w /dev/kvm ]; then
	echo "install-deps: /dev/kvm is not yours, so QEMU will emulate, slowly: join its group, then log in again"
fi
case $pm in
pkg)
	[ -e /dev/vmmctl ] ||
		echo "install-deps: vmm is not loaded, so howl create boots under QEMU, emulated, and keeps nothing: kldload vmm; sysrc kld_list+=vmm keeps it loaded"
	;;
pkgin)
	if [ ! -e /dev/nvmm ]; then
		echo "install-deps: NVMM is not loaded, so QEMU will emulate, slowly: modload nvmm; nvmm in /etc/modules.conf loads it at boot"
	elif [ ! -w /dev/nvmm ]; then
		echo "install-deps: /dev/nvmm is not yours, so QEMU will emulate, slowly: join group nvmm, then log in again"
	fi
	;;
esac
