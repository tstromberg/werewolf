#!/usr/bin/env python3
"""Build and cache pinned local IPE test kernels and measured stubs on a trusted host."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile

STUB_SOURCES = ['boot/stub-source', 'tools/build-tpm-stub', 'boot/tpm-stub.melange.yaml']
KERNEL_SOURCES = ['boot/kernel-build', 'tools/test-kernel']


def digest(path):
    with Path(path).open('rb') as stream:
        value = hashlib.sha256()
        for part in iter(lambda: stream.read(1 << 20), b''):
            value.update(part)
        return value.hexdigest()


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def phase(short, name):
    print('howl: phase ' + short + ': ' + name, file=sys.stderr, flush=True)


def fingerprint(arch, files):
    value = hashlib.sha256(arch.encode())
    for name, path in sorted(files.items()):
        value.update(name.encode() + b'\0' + bytes.fromhex(digest(path)))
    return value.hexdigest()


def package_pins(path, arch):
    packages = json.loads(Path(path).read_text())['contents']['packages']
    selected = [p for p in packages if p['architecture'] == arch]
    if not selected or len({p['name'] for p in selected}) != len(selected):
        raise ValueError('missing or duplicate packages in protected input lock')
    return [p['name'] + '=' + p['version'] for p in selected]


def stub_files(tree):
    files = {name: tree / name for name in STUB_SOURCES}
    if snapshot := os.environ.get('WEREWOLF_PROTECTED_INPUTS'):
        files['stub-packages'] = Path(snapshot) / 'stub-builder.lock.json'
    return files


def test_kernel(tree, arch, cert, output):
    """Build linux-werewolf with IPE trusting cert; tools/test-kernel passes no secrets on."""
    if platform.system() == 'Linux' and platform.machine() != arch or \
            platform.system() == 'Darwin' and arch != 'aarch64':
        raise ValueError('test kernels build natively: on Linux of their architecture or an arm64 Mac')
    if platform.system() == 'Darwin' and not all(Path(os.environ.get(name, '')).is_file()
                                                 for name in ['QEMU_KERNEL_IMAGE', 'QEMU_BASE_INITRAMFS']):
        raise ValueError('Melange QEMU requires a stock bootstrap kernel and initramfs')
    run(['sh', tree / 'tools/test-kernel', arch, cert, output])


def melange(tree, cache, arch, output):
    """Build the measured stub with Melange: QEMU on macOS, bubblewrap on Linux."""
    phase('stub-builder', 'Preparing the EFI stub build environment')
    runner = 'qemu' if platform.system() == 'Darwin' else 'bubblewrap'
    recipe = 'boot/tpm-stub.melange.yaml'
    with tempfile.TemporaryDirectory(prefix='melange-public-', dir=output.parent) as temporary:
        work = Path(temporary)
        source = work / 'source'
        source.mkdir()
        for name in STUB_SOURCES:
            target = source / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(tree / name, target)
        # No private signing paths, PEM secrets or caller key directories enter the runner.
        env = {name: os.environ[name] for name in ['PATH', 'HOME', 'LANG', 'SSL_CERT_FILE',
               'QEMU_KERNEL_IMAGE', 'QEMU_BASE_INITRAMFS'] if name in os.environ}
        if runner == 'qemu' and not all(name in env and Path(env[name]).is_file()
                   for name in ['QEMU_KERNEL_IMAGE', 'QEMU_BASE_INITRAMFS']):
            raise ValueError('Melange QEMU requires a stock bootstrap kernel and initramfs')
        scratch = work / 'scratch'
        scratch.mkdir()
        env.update(TMPDIR=str(scratch), QEMU_DISKS_PATH=str(scratch), SOURCE_DATE_EPOCH='0')
        pins = []
        if snapshot := os.environ.get('WEREWOLF_PROTECTED_INPUTS'):
            for pin in package_pins(Path(snapshot) / 'stub-builder.lock.json', arch):
                pins.extend(['--package-append', pin])
        run(['melange', 'build', source / recipe, '--runner', runner, '--arch', arch,
             '--source-dir', source, '--out-dir', work / 'packages', '--cache-dir', cache / 'melange-cache',
             '--cpu', os.environ.get('MELANGE_CPU', str(max(1, (os.cpu_count() or 2) // 2))),
             '--memory', os.environ.get('MELANGE_MEMORY', '8Gi'), '--disk', '24Gi',
             '--generate-index=false', *pins], env=env)
        apk = work / 'packages' / arch / 'werewolf-tpm-stub-build-0.1.0-r0.apk'
        destination = output.with_name(output.name + '.new')
        phase('stub-collect', 'Collecting the measured EFI stub build output')
        try:
            with destination.open('xb') as stream:
                run(['bsdtar', '-xzOf', apk, 'usr/share/werewolf-build/linux.efi.stub'], stdout=stream)
                stream.flush()
                os.fsync(stream.fileno())
            if not destination.stat().st_size:
                raise ValueError('Melange output is missing its required artifact')
            destination.replace(output)
        finally:
            destination.unlink(missing_ok=True)


def helper(tree, output):
    """Build the measured stub in the arm64 Mac's Lima build helper."""
    vm = os.environ.get('WEREWOLF_BUILD_VM', 'werewolf-build-26.04')
    phase('build-helper', 'Preparing the Linux build helper')
    run(['python3', tree / 'build-helper', vm, tree / 'boot/build-helper.yaml'])
    # This is a trusted build helper, never the secured workload VM.
    remote = subprocess.check_output(['limactl', 'shell', vm, 'mktemp', '-d',
                                      '/var/tmp/ww-prerequisites.XXXXXXXX'], text=True).strip()
    if not remote.startswith('/var/tmp/ww-prerequisites.') or '/' in remote[len('/var/tmp/ww-prerequisites.'):]:
        raise ValueError('unexpected helper temporary directory')
    try:
        phase('build-inputs', 'Copying public EFI stub inputs to the Linux build helper')
        run(['limactl', 'shell', vm, 'mkdir', '-p', remote + '/boot', remote + '/tools'])
        for name in ['boot/stub-source', 'tools/build-tpm-stub']:
            run(['limactl', 'copy', tree / name, vm + ':' + remote + '/' + name])
        run(['limactl', 'shell', vm, 'sh', remote + '/tools/build-tpm-stub', remote + '/stub'])
        phase('stub-collect', 'Collecting the measured EFI stub')
        run(['limactl', 'copy', vm + ':' + remote + '/stub/linux.efi.stub', output])
    finally:
        run(['limactl', 'shell', vm, 'rm', '-rf', '--', remote])


def stub(tree, cache, arch, output):
    if platform.system() == 'Linux' or (platform.system() == 'Darwin' and not os.environ.get('WEREWOLF_BUILD_VM')):
        melange(tree, cache, arch, output)
    elif platform.system() == 'Darwin' and arch == 'aarch64':
        helper(tree, output)
    else:
        raise ValueError('managed prerequisites require native Linux or an arm64 Mac build helper')


def cached(directory, pin, name, make):
    """directory/name, made by make(path) unless a verified earlier build of pin is there."""
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not valid(directory, pin, {name}):
        make(directory / name)
        complete(directory, pin, [name])
    return directory / name


def valid(directory, expected, outputs=None):
    outputs = outputs or {'rootfs.tar', 'linux.efi.stub'}
    try:
        saved = json.loads((directory / 'complete.json').read_text())
        return saved['inputs'] == expected and set(saved['outputs']) == outputs and all(
            not (directory / name).is_symlink() and digest(directory / name) == sha
            for name, sha in saved['outputs'].items()
        )
    except (OSError, ValueError, KeyError, TypeError):
        return False


def identity(directory):
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    key, cert = directory / 'policy.key', directory / 'policy.crt'
    marker = directory / 'identity.sha256'
    if marker.exists() and (not key.exists() or not cert.exists()):
        raise ValueError('existing policy identity is missing; restore it instead of rotating trust')
    if key.exists() != cert.exists():
        raise ValueError('partial policy identity; inspect it before replacing trust')
    if not key.exists():
        # Keep unfinished identity private and never rotate an existing signer implicitly.
        with tempfile.TemporaryDirectory(dir=directory) as scratch:
            temporary = Path(scratch)
            run(['openssl', 'req', '-newkey', 'rsa:4096', '-nodes', '-x509', '-sha256',
                 '-days', '3650', '-subj', '/CN=werewolf-local-ipe',
                 '-keyout', temporary / 'policy.key', '-out', temporary / 'policy.crt'])
            os.rename(temporary / 'policy.key', key)
            os.rename(temporary / 'policy.crt', cert)
    if key.stat().st_mode & 0o777 != 0o600:
        raise ValueError('policy key must have private permissions')
    run(['openssl', 'x509', '-checkend', '86400', '-noout', '-in', cert])
    public_key = subprocess.check_output(['openssl', 'pkey', '-in', str(key), '-pubout'])
    public_cert = subprocess.check_output(['openssl', 'x509', '-in', str(cert), '-pubkey', '-noout'])
    if public_key != public_cert:
        raise ValueError('policy key does not match certificate')
    wanted = digest(cert) + '\n'
    if marker.exists():
        if marker.read_text() != wanted:
            raise ValueError('policy identity changed; restore the enrolled certificate')
    else:
        with marker.open('x') as output:
            output.write(wanted)
            output.flush()
            os.fsync(output.fileno())
    return key, cert


def build(tree, cache, arch, cert):
    """The test kernel and stub, each cached by its own inputs, so a change to one keeps the other."""
    phase('security-cache', 'Checking cached kernel and EFI stub')
    kernel_files = dict({name: tree / name for name in KERNEL_SOURCES}, certificate=cert)
    stubs = stub_files(tree)
    expected = fingerprint(arch, kernel_files | stubs)
    target = cache / arch / expected
    if valid(target, expected):
        return target
    kernel_pin, stub_pin = fingerprint(arch, kernel_files), fingerprint(arch, stubs)
    kernel = cached(cache / arch / ('test-kernel-' + kernel_pin), kernel_pin, 'rootfs.tar',
                    lambda path: test_kernel(tree, arch, cert, path))
    efi = cached(cache / arch / ('stub-' + stub_pin), stub_pin, 'linux.efi.stub',
                 lambda path: stub(tree, cache, arch, path))
    phase('security-cache', 'Saving verified kernel and EFI stub')
    target.mkdir(mode=0o700, parents=True, exist_ok=True)
    copy_cached(kernel, target / 'rootfs.tar')
    copy_cached(efi, target / 'linux.efi.stub')
    complete(target, expected, ['rootfs.tar', 'linux.efi.stub'])
    return target


def copy_cached(source, destination):
    temporary = destination.with_name(destination.name + '.new')
    temporary.unlink(missing_ok=True)
    try:
        try:
            os.link(source, temporary)
        except OSError:
            shutil.copyfile(source, temporary)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def complete(target, expected, names):
    outputs = {name: digest(target / name) for name in names}
    temporary = target / 'complete.json.new'
    temporary.write_text(json.dumps({'inputs': expected, 'outputs': outputs}) + '\n')
    temporary.replace(target / 'complete.json')


def main():
    operation, source, destination, arch, report, signing = sys.argv[1:]
    tree, cache = Path(source).resolve(), Path(destination).resolve()
    os.umask(0o077)
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (cache / 'build.lock').open('a+b') as guard:
        phase('security-lock', 'Waiting for the security input build lock')
        fcntl.flock(guard, fcntl.LOCK_EX)
        phase('security-cache', 'Checking cached security inputs')
        if operation == 'stub':
            pin = fingerprint(arch, stub_files(tree))
            efi = cached(cache / arch / ('stub-' + pin), pin, 'linux.efi.stub',
                         lambda path: stub(tree, cache, arch, path))
            Path(report).write_text(json.dumps({'stub': str(efi)}) + '\n')
            return
        if operation != 'all':
            raise ValueError('unknown operation')
        phase('policy-identity', 'Checking the local IPE signing identity')
        key, cert = identity(Path(signing))
        target = build(tree, cache, arch, cert)
        Path(report).write_text(json.dumps({
            'kernel': str(target / 'rootfs.tar'), 'stub': str(target / 'linux.efi.stub'),
            'key': str(key), 'cert': str(cert),
        }) + '\n')


if __name__ == '__main__':
    main()
