#!/usr/bin/env python3
"""Build and cache pinned local IPE kernels and measured stubs on a trusted host."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile


def digest(path):
    with Path(path).open('rb') as stream:
        value = hashlib.sha256()
        for part in iter(lambda: stream.read(1 << 20), b''):
            value.update(part)
        return value.hexdigest()


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def fingerprint(arch, files):
    value = hashlib.sha256(arch.encode())
    for name, path in sorted(files.items()):
        value.update(name.encode() + b'\0' + bytes.fromhex(digest(path)))
    return value.hexdigest()


def sign_kernel(tree, source, key, cert, output):
    run(['python3', tree / 'tools/sign-kernel', source, key, cert, output])


def melange(tree, cache, arch, output, kind, base=None, cert=None):
    """Stage public inputs for Melange QEMU on macOS or bubblewrap on Linux."""
    runner = 'qemu' if platform.system() == 'Darwin' else 'bubblewrap'
    package = 'werewolf-ipe-build' if kind == 'kernel' else 'werewolf-tpm-stub-build'
    recipe = 'boot/ipe-kernel.melange.yaml' if kind == 'kernel' else 'boot/tpm-stub.melange.yaml'
    artifact = 'rootfs.tar' if kind == 'kernel' else 'linux.efi.stub'
    source_names = ['boot/kernel-source', 'boot/build-kernel', 'boot/ipe-boot.policy'] if kind == 'kernel' else ['boot/stub-source', 'tools/build-tpm-stub']
    with tempfile.TemporaryDirectory(prefix='melange-public-', dir=output.parent) as temporary:
        work = Path(temporary)
        source = work / 'source'
        source.mkdir()
        for name in source_names + [recipe]:
            target = source / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(tree / name, target)
        if kind == 'kernel':
            shutil.copyfile(base, source / 'base.tar')
            shutil.copyfile(cert, source / 'policy.crt')
        # No private signing paths, PEM secrets or caller key directories enter the runner.
        env = {name: os.environ[name] for name in ['PATH', 'HOME', 'LANG', 'SSL_CERT_FILE',
               'QEMU_KERNEL_IMAGE', 'QEMU_BASE_INITRAMFS'] if name in os.environ}
        if runner == 'qemu' and not all(name in env and Path(env[name]).is_file()
                   for name in ['QEMU_KERNEL_IMAGE', 'QEMU_BASE_INITRAMFS']):
            raise ValueError('Melange QEMU requires a stock bootstrap kernel and initramfs')
        scratch = work / 'scratch'
        scratch.mkdir()
        env.update(TMPDIR=str(scratch), QEMU_DISKS_PATH=str(scratch), SOURCE_DATE_EPOCH='0')
        run(['melange', 'build', source / recipe, '--runner', runner, '--arch', arch,
             '--source-dir', source, '--out-dir', work / 'packages', '--cache-dir', cache / 'melange-cache',
             '--cpu', os.environ.get('MELANGE_CPU', str(max(1, (os.cpu_count() or 2) // 2))),
             '--memory', os.environ.get('MELANGE_MEMORY', '8Gi'), '--disk', '24Gi',
             '--generate-index=false'], env=env)
        apk = work / 'packages' / arch / (package + '-0.1.0-r0.apk')
        destination = output.with_name(output.name + '.new')
        try:
            with destination.open('xb') as stream:
                run(['bsdtar', '-xzOf', apk, 'usr/share/werewolf-build/' + artifact], stdout=stream)
                stream.flush()
                os.fsync(stream.fileno())
            if not destination.stat().st_size:
                raise ValueError('Melange output is missing its required artifact')
            destination.replace(output)
        finally:
            destination.unlink(missing_ok=True)


def valid(directory, expected, outputs=None):
    outputs = outputs or {'rootfs.tar', 'linux.efi.stub'}
    try:
        saved = json.loads((directory / 'complete.json').read_text())
        return saved['inputs'] == expected and set(saved['outputs']) == outputs and all(
            not (directory / name).is_symlink() and digest(directory / name) == sha
            for name, sha in saved['outputs'].items()
        )
    except (OSError, ValueError, KeyError, TypeError):
        return False


def identity(directory):
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    key, cert = directory / 'policy.key', directory / 'policy.crt'
    marker = directory / 'identity.sha256'
    if marker.exists() and (not key.exists() or not cert.exists()):
        raise ValueError('existing policy identity is missing; restore it instead of rotating trust')
    if key.exists() != cert.exists():
        raise ValueError('partial policy identity; inspect it before replacing trust')
    if not key.exists():
        # Keep unfinished identity private and never rotate an existing signer implicitly.
        with tempfile.TemporaryDirectory(dir=directory) as scratch:
            temporary = Path(scratch)
            run(['openssl', 'req', '-newkey', 'rsa:4096', '-nodes', '-x509', '-sha256',
                 '-days', '3650', '-subj', '/CN=werewolf-local-ipe',
                 '-keyout', temporary / 'policy.key', '-out', temporary / 'policy.crt'])
            os.rename(temporary / 'policy.key', key)
            os.rename(temporary / 'policy.crt', cert)
    if key.stat().st_mode & 0o777 != 0o600:
        raise ValueError('policy key must have private permissions')
    run(['openssl', 'x509', '-checkend', '86400', '-noout', '-in', cert])
    public_key = subprocess.check_output(['openssl', 'pkey', '-in', str(key), '-pubout'])
    public_cert = subprocess.check_output(['openssl', 'x509', '-in', str(cert), '-pubkey', '-noout'])
    if public_key != public_cert:
        raise ValueError('policy key does not match certificate')
    wanted = digest(cert) + '\n'
    if marker.exists():
        if marker.read_text() != wanted:
            raise ValueError('policy identity changed; restore the enrolled certificate')
    else:
        with marker.open('x') as output:
            output.write(wanted)
            output.flush()
            os.fsync(output.fileno())
    return key, cert


def build(tree, cache, arch, base, key, cert):
    files = {name: tree / name for name in [
        'boot/kernel-source', 'boot/build-kernel', 'boot/ipe-boot.policy',
        'boot/stub-source', 'tools/build-tpm-stub',
        'boot/ipe-kernel.melange.yaml', 'boot/tpm-stub.melange.yaml',
        'tools/sign-kernel',
    ]}
    files.update(base=base, certificate=cert)
    expected = fingerprint(arch, files)
    target = cache / arch / expected
    target.mkdir(mode=0o700, parents=True, exist_ok=True)
    kernel_files = {name: path for name, path in files.items()
                    if name in ['boot/kernel-source', 'boot/build-kernel', 'boot/ipe-boot.policy',
                                'boot/ipe-kernel.melange.yaml', 'base', 'certificate']}
    stub_files = {name: path for name, path in files.items()
                  if name in ['boot/stub-source', 'tools/build-tpm-stub', 'boot/tpm-stub.melange.yaml']}
    compiled_pin = fingerprint(arch, kernel_files)
    kernel_pin = fingerprint(arch, dict(kernel_files, **{'tools/sign-kernel': files['tools/sign-kernel']}))
    stub_pin = fingerprint(arch, stub_files)
    compiled_cache = cache / arch / ('compiled-' + compiled_pin)
    kernel_cache = cache / arch / ('kernel-' + kernel_pin)
    stub_cache = cache / arch / ('stub-' + stub_pin)
    if valid(target, expected):
        # Adopt existing successful builds; changing cache layout must not trigger compilation.
        for part, pin, artifact in [(kernel_cache, kernel_pin, 'rootfs.tar'),
                                    (stub_cache, stub_pin, 'linux.efi.stub')]:
            if not (part / 'complete.json').exists():
                part.mkdir(mode=0o700, parents=True, exist_ok=True)
                copy_cached(target / artifact, part / artifact)
                complete(part, pin, [artifact])
        return target
    kernel_cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    stub_cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    need_kernel = not valid(kernel_cache, kernel_pin, {'rootfs.tar'})
    need_stub = not valid(stub_cache, stub_pin, {'linux.efi.stub'})
    if not need_kernel and not need_stub:
        copy_cached(kernel_cache / 'rootfs.tar', target / 'rootfs.tar')
        copy_cached(stub_cache / 'linux.efi.stub', target / 'linux.efi.stub')
        complete(target, expected, ['rootfs.tar', 'linux.efi.stub'])
        return target
    compiled_cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    need_compile = need_kernel and not valid(compiled_cache, compiled_pin, {'unsigned.tar'})

    def finish_kernel():
        complete(compiled_cache, compiled_pin, ['unsigned.tar'])
        sign_kernel(tree, compiled_cache / 'unsigned.tar', key, cert, kernel_cache / 'rootfs.tar')
        complete(kernel_cache, kernel_pin, ['rootfs.tar'])

    if need_kernel and not need_compile:
        finish_kernel()
    if platform.system() == 'Linux' and platform.machine() != arch:
        raise ValueError('native kernel build architecture differs')
    if platform.system() == 'Linux' or (platform.system() == 'Darwin' and not os.environ.get('WEREWOLF_BUILD_VM')):
        if need_compile:
            melange(tree, cache, arch, compiled_cache / 'unsigned.tar', 'kernel', base, cert)
            finish_kernel()
        if need_stub:
            melange(tree, cache, arch, stub_cache / 'linux.efi.stub', 'stub')
            complete(stub_cache, stub_pin, ['linux.efi.stub'])
    elif platform.system() == 'Darwin' and arch == 'aarch64':
        vm = os.environ.get('WEREWOLF_BUILD_VM', 'werewolf-build-26.04')
        run(['python3', tree / 'build-helper', vm, tree / 'boot/build-helper.yaml'])
        # This is a trusted build helper, never the secured workload VM.
        reply = subprocess.check_output(['limactl', 'shell', vm, 'mktemp', '-d',
                                         '/var/tmp/ww-prerequisites.XXXXXXXX'], text=True).strip()
        if not reply.startswith('/var/tmp/ww-prerequisites.') or '/' in reply[len('/var/tmp/ww-prerequisites.'):]:
            raise ValueError('unexpected helper temporary directory')
        remote = reply
        try:
            run(['limactl', 'shell', vm, 'mkdir', '-p', remote + '/boot', remote + '/tools'])
            public_files = dict(kernel_files if need_compile else {})
            if need_stub:
                public_files.update(stub_files)
            for name in public_files:
                destination = remote + '/' + (name if name.startswith(('boot/', 'tools/')) else
                                               'base.tar' if name == 'base' else 'policy.crt')
                run(['limactl', 'copy', public_files[name], vm + ':' + destination])
            # Source archives and compiled modules are public; private keys stay on the host.
            if need_compile:
                run(['limactl', 'shell', vm, 'sh', remote + '/boot/build-kernel',
                     remote + '/base.tar', remote + '/policy.crt', '-', remote + '/kernel'])
                run(['limactl', 'copy', vm + ':' + remote + '/kernel/rootfs.tar', compiled_cache / 'unsigned.tar'])
                finish_kernel()
            if need_stub:
                run(['limactl', 'shell', vm, 'sh', remote + '/tools/build-tpm-stub', remote + '/stub'])
                run(['limactl', 'copy', vm + ':' + remote + '/stub/linux.efi.stub', stub_cache / 'linux.efi.stub'])
                complete(stub_cache, stub_pin, ['linux.efi.stub'])
        finally:
            run(['limactl', 'shell', vm, 'rm', '-rf', '--', remote])
    else:
        raise ValueError('managed prerequisites require native Linux or an arm64 Mac build helper')
    copy_cached(kernel_cache / 'rootfs.tar', target / 'rootfs.tar')
    copy_cached(stub_cache / 'linux.efi.stub', target / 'linux.efi.stub')
    complete(target, expected, ['rootfs.tar', 'linux.efi.stub'])
    return target


def copy_cached(source, destination):
    temporary = destination.with_name(destination.name + '.new')
    temporary.unlink(missing_ok=True)
    try:
        try:
            os.link(source, temporary)
        except OSError:
            shutil.copyfile(source, temporary)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def complete(target, expected, names):
    outputs = {name: digest(target / name) for name in names}
    temporary = target / 'complete.json.new'
    temporary.write_text(json.dumps({'inputs': expected, 'outputs': outputs}) + '\n')
    temporary.replace(target / 'complete.json')


def main():
    operation, source, destination, arch, base, report = sys.argv[1:]
    tree, cache, base = Path(source).resolve(), Path(destination).resolve(), Path(base).resolve()
    os.umask(0o077)
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (cache / 'build.lock').open('a+b') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        if operation == 'stub':
            expected = fingerprint(arch, {name: tree / name for name in ['boot/stub-source', 'tools/build-tpm-stub', 'boot/tpm-stub.melange.yaml']})
            target = cache / arch / ('stub-' + expected)
            target.mkdir(mode=0o700, parents=True, exist_ok=True)
            if not valid(target, expected, {'linux.efi.stub'}):
                if platform.system() == 'Linux' or (platform.system() == 'Darwin' and not os.environ.get('WEREWOLF_BUILD_VM')):
                    melange(tree, cache, arch, target / 'linux.efi.stub', 'stub')
                else:
                    vm = os.environ.get('WEREWOLF_BUILD_VM', 'werewolf-build-26.04')
                    run(['python3', tree / 'build-helper', vm, tree / 'boot/build-helper.yaml'])
                    remote = subprocess.check_output(['limactl', 'shell', vm, 'mktemp', '-d', '/var/tmp/ww-prerequisites.XXXXXXXX'], text=True).strip()
                    if not remote.startswith('/var/tmp/ww-prerequisites.') or '/' in remote[len('/var/tmp/ww-prerequisites.'):]:
                        raise ValueError('unexpected helper temporary directory')
                    try:
                        run(['limactl', 'shell', vm, 'mkdir', '-p', remote + '/boot', remote + '/tools'])
                        for name in ['boot/stub-source', 'tools/build-tpm-stub']:
                            run(['limactl', 'copy', tree / name, vm + ':' + remote + '/' + name])
                        run(['limactl', 'shell', vm, 'sh', remote + '/tools/build-tpm-stub', remote + '/stub'])
                        run(['limactl', 'copy', vm + ':' + remote + '/stub/linux.efi.stub', target / 'linux.efi.stub'])
                    finally:
                        run(['limactl', 'shell', vm, 'rm', '-rf', '--', remote])
                (target / 'complete.json').write_text(json.dumps({'inputs': expected, 'outputs': {'linux.efi.stub': digest(target / 'linux.efi.stub')}}) + '\n')
            Path(report).write_text(json.dumps({'stub': str(target / 'linux.efi.stub')}) + '\n')
            return
        if operation != 'all':
            raise ValueError('unknown operation')
        key, cert = identity(cache / 'signing')
        target = build(tree, cache, arch, base, key, cert)
        Path(report).write_text(json.dumps({
            'kernel': str(target / 'rootfs.tar'), 'stub': str(target / 'linux.efi.stub'),
            'key': str(key), 'cert': str(cert),
        }) + '\n')


if __name__ == '__main__':
    main()
