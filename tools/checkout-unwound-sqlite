#!/usr/bin/env python3
"""Fetch the pinned SQLite amalgamation for Unwound's static age worker."""

import argparse
import hashlib
from pathlib import Path
import sys
from urllib.request import urlopen
from zipfile import ZipFile
from io import BytesIO


VERSION = "3540100"
URL = f"https://www.sqlite.org/2026/sqlite-amalgamation-{VERSION}.zip"
SHA3_256 = "92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30"
OUTPUT = Path(__file__).resolve().parent.parent / "out/third-party" / f"sqlite-{VERSION}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archive", type=Path, help="use a local downloaded archive")
    args = parser.parse_args()
    if args.archive:
        archive = args.archive.read_bytes()
    else:
        with urlopen(URL, timeout=30) as response:
            archive = response.read(4 << 20)
            if response.read(1):
                raise ValueError("SQLite archive exceeds four MiB")
    if hashlib.sha3_256(archive).hexdigest() != SHA3_256:
        raise ValueError("SQLite archive SHA3-256 does not match the reviewed pin")
    with ZipFile(BytesIO(archive)) as source:
        files = {}
        for name in ("sqlite3.c", "sqlite3.h"):
            member = f"sqlite-amalgamation-{VERSION}/{name}"
            files[name] = source.read(member)
    if b'#define SQLITE_VERSION        "3.54.1"' not in files["sqlite3.h"]:
        raise ValueError("unexpected SQLite version")
    OUTPUT.mkdir(parents=True, exist_ok=True)
    for name, body in files.items():
        (OUTPUT / name).write_bytes(body)
    print(f"SQLite 3.54.1: verified {SHA3_256[:12]} into {OUTPUT}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        sys.exit(f"checkout-unwound-sqlite: {error}")
