#!/bin/sh
# Public build inputs only. Unlike Alpine's stub, this measures the signed UKI.
set -eu
[ "$#" = 1 ] || { echo 'usage: tools/build-tpm-stub OUT' >&2; exit 2; }
[ "$(uname -s)" = Linux ] || { echo 'build-tpm-stub: run on Linux, including a Lima helper' >&2; exit 1; }
case $(uname -m) in
aarch64) efi=aa64 ;;
x86_64) efi=x64 ;;
*) echo 'build-tpm-stub: unsupported architecture' >&2; exit 1 ;;
esac
root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
. "$root/boot/stub-source"
mkdir -p "$1"
out=$(realpath "$1")
archive=$out/systemd-$version.tar.gz
if [ ! -f "$archive" ]; then
    curl --fail --location --proto '=https' --tlsv1.2 "$url" -o "$archive.new"
    mv "$archive.new" "$archive"
fi
printf '%s  %s\n' "$sha256" "$archive" | sha256sum -c -
[ -d "$out/systemd-$version" ] || tar -xf "$archive" -C "$out"
meson setup "$out/obj" "$out/systemd-$version" --reconfigure \
    -Dmode=release -Dtpm=true -Dbootloader=enabled -Defi-stub-extra-sections=3000 \
    -Dtests=false -Dman=disabled -Dhtml=disabled -Dtranslations=false \
    -Dsysusers=false -Dtmpfiles=false -Dfirstboot=false -Duserdb=false -Dinstall-tests=false
meson compile -C "$out/obj" systemd-boot
cp "$out/obj/src/boot/linux$efi.efi.stub" "$out/linux.efi.stub.new"
mv "$out/linux.efi.stub.new" "$out/linux.efi.stub"
echo "build-tpm-stub: $out/linux.efi.stub"
