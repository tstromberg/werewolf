#!/bin/sh
# mkdisk builds werewolf's own boot disk from a slot
# (docs/design/native-boot.md).
#
#   boot/mkdisk ARCH BOOT_ROOTFS GPT SLOT_DIR OUT SIZE_MIB [ARG...]
#
# BOOT_ROOTFS is boot/boot.yaml's rootfs, which holds systemd-boot. GPT is
# boot/gpt.zig, built for this host. SLOT_DIR holds vmlinuz, stage0.zst,
# root.erofs, and cmdline, the kernel arguments the image asks for
# (Makefile, KERNEL_ARGS). OUT becomes a sparse disk of SIZE_MIB MiB:
#
#   GPT    fixed disk and partition GUIDs (boot/gpt.zig)
#   1      EFI system partition, FAT32, 256 MiB: systemd-boot at the
#          removable-media path, its loader.conf, slot a's entry, and
#          /werewolf/a/vmlinuz and stage0.zst
#   2      ext4, the rest: /werewolf/a/root.erofs; init adds /werewolf/data,
#          which is /data
#
# Each ARG is added to the kernel command line, such as werewolf.mac= for
# `make demo`; updates carry them over. The command line has no address, so
# the machine asks DHCP. Every GUID, UUID, serial number and time is fixed,
# so the same slot gives the same disk.
#
# The kernel prints to every console named. Userland prints to the last one
# that exists, which becomes /dev/console, or, if none does, to the first
# console the kernel registered. That must be the serial port, which every
# cloud records and QEMU's -nographic shows. On x86_64 it is ttyS0
# everywhere. On aarch64 it is ttyAMA0 on GCP, Azure, Hetzner and QEMU, and
# ttyS0 on AWS Graviton. The kernel finds ttyAMA0 by itself, from the port
# the firmware describes in its ACPI SPCR table. It does not find Graviton's
# 16550, whose console then shows the firmware's banner and nothing after.
# So aarch64 names ttyS0, which registers only where there is a 16550, and
# then hvc0, last, so /dev/console is the virtio console where there is one
# (Lima's vz, which has no serial port). aarch64 names no tty0: registered
# first, it would take /dev/console wherever the named ports are missing.
# An ARG of console=hvc0 makes /dev/console the virtio console on x86_64 too.
#
# mkdisk runs on macOS and Linux. It needs mtools (mformat, mmd, mcopy) and
# e2fsprogs' mke2fs and debugfs. On macOS these are Homebrew's, which keeps
# them off the PATH, so mkdisk searches its prefix too.
set -eu

[ $# -ge 6 ] || {
	echo "usage: boot/mkdisk ARCH BOOT_ROOTFS GPT SLOT_DIR OUT SIZE_MIB [ARG...]" >&2
	exit 2
}
arch=$1 boot_rootfs=$2 gpt=$3 slot=$4 out=$5 size_mib=$6
shift 6
case $arch in
aarch64) efi=systemd-bootaa64.efi boot=BOOTAA64.EFI console='console=ttyS0,115200 console=hvc0' ;;
x86_64) efi=systemd-bootx64.efi boot=BOOTX64.EFI console='console=tty0 console=hvc0 console=ttyS0,115200' ;;
*)
	echo "boot/mkdisk: $arch is not supported" >&2
	exit 2
	;;
esac
[ -f "$slot/cmdline" ] || {
	echo "boot/mkdisk: $slot has no cmdline, the image's kernel arguments (make slot)" >&2
	exit 1
}
# The image's kernel arguments go on the loader entry's options line. Allow
# only plain characters, with no newline to start another line, as bite does.
args=$(cat "$slot/cmdline")
case $args in *[!A-Za-z0-9_.,=\ -]*)
	echo "boot/mkdisk: $slot/cmdline holds more than kernel arguments" >&2
	exit 1
	;;
esac
for p in /opt/homebrew/opt/e2fsprogs/sbin /usr/local/opt/e2fsprogs/sbin; do
	[ -d "$p" ] && PATH=$p:$PATH
done
for t in mformat mmd mcopy mke2fs debugfs; do
	command -v "$t" >/dev/null || {
		echo "boot/mkdisk: no $t; on macOS, brew install mtools e2fsprogs" >&2
		exit 1
	}
done

# Fixed identities. blkid reports the EFI partition's serial number as its
# UUID, 57E1-F000.
esp_mib=256
esp_serial=57E1F000
esp_uuid=57E1-F000
root_uuid=57e1f000-77e2-4b0f-8a3c-0000000000a0
# Stop mtools' and mke2fs's clocks at FAT's first day.
export SOURCE_DATE_EPOCH=315532800 E2FSPROGS_FAKE_TIME=315532800 MTOOLS_SKIP_CHECK=1 TZ=UTC

# Sectors, as boot/gpt.zig lays them out: the EFI partition starts at 1 MiB,
# and the root follows it up to 1 MiB short of the end.
esp_first=2048
root_first=$((esp_first + esp_mib * 2048))
root_sectors=$((size_mib * 2048 - root_first - 2048))

w=$out.d
rm -rf "$w" "$out"
mkdir -p "$w/esp/EFI/BOOT" "$w/esp/loader/entries" "$w/esp/werewolf/a" "$w/root/werewolf/a"
"$gpt" "$out" "$size_mib" "$esp_mib"

# --- the EFI partition --------------------------------------------------------
tar -xOf "$boot_rootfs" "usr/lib/systemd/boot/efi/$efi" >"$w/esp/EFI/BOOT/$boot"
# No menu, and no editing the command line from the console.
cat >"$w/esp/loader/loader.conf" <<EOF
timeout 0
editor no
auto-entries no
auto-firmware no
EOF
# Slot a is good from the start, so it has no try count. Its version is older
# than any update's, so the first update's slot sorts ahead of it.
cat >"$w/esp/loader/entries/werewolf-a.conf" <<EOF
title werewolf a
sort-key werewolf
version 19800101T000000Z
linux /werewolf/a/vmlinuz
initrd /werewolf/a/stage0.zst
options $console init=/init panic=10 softlockup_panic=1 $args werewolf.victim=$root_uuid:/werewolf werewolf.esp=$esp_uuid${*:+ $*} werewolf.slot=a
EOF
cp "$slot/vmlinuz" "$slot/stage0.zst" "$w/esp/werewolf/a/"
find "$w/esp" -exec touch -t 198001010000 {} +

esp="$out@@$((esp_first * 512))"
mformat -i "$esp" -F -T $((esp_mib * 2048)) -h 64 -s 32 -N "$esp_serial" -v ESP ::
(cd "$w/esp" && find . -mindepth 1 -type d | sed 's|^\./||' | sort) | while read -r d; do
	mmd -i "$esp" "::/$d"
done
(cd "$w/esp" && find . -type f | sed 's|^\./||' | sort) | while read -r f; do
	mcopy -m -i "$esp" "$w/esp/$f" "::/$f"
done

# --- the root partition -------------------------------------------------------
cp "$slot/root.erofs" "$w/root/werewolf/a/"
chmod -R u=rwX,go=rX "$w/root"
chmod 0700 "$w/root/werewolf"
# Turn off orphan_file (e2fsprogs 1.47's default). ext4 reads all 512 of its
# blocks, one at a time, at every mount, and stage0 mounts this disk on every
# boot. On a cloud's network disk that cost 543 reads and 0.21 s, against 48
# reads without it. The orphan list in the superblock serves instead.
mke2fs -q -F -t ext4 -b 4096 -L werewolf -U "$root_uuid" -O ^orphan_file \
	-E "offset=$((root_first * 512)),hash_seed=$root_uuid,root_owner=0:0" \
	-d "$w/root" "$out" $((root_sectors / 8))
# mke2fs -d keeps the builder's owners and times, so make them root's and
# 1980's. A file left with the builder's uid would belong to whichever user
# has that uid on the machine.
(cd "$w/root" && find . -mindepth 1 | sed 's|^\.||') | while read -r p; do
	for f in uid gid; do echo "sif $p $f 0"; done
	for f in atime ctime mtime crtime; do echo "sif $p $f $E2FSPROGS_FAKE_TIME"; done
done >"$w/debugfs.cmds"
debugfs -w -f "$w/debugfs.cmds" "$out?offset=$((root_first * 512))" >/dev/null 2>"$w/debugfs.err" || {
	cat "$w/debugfs.err" >&2
	exit 1
}
rm -rf "$w"
echo "boot/mkdisk: $out ($arch, $size_mib MiB, EFI $esp_uuid, root $root_uuid)"
