---
extends: default

ignore:
  - build/
  - config/
  - dist/
  - out/
  # Rendered as a Go template before Authelia reads it.
  - forms/authelia/rootfs/etc/authelia/configuration.yml
  # Upstream's Suricata configuration is kept intact; it has nonstandard indentation.
  - forms/suricata/rootfs/usr/share/suricata/suricata.yaml

rules:
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  comments: disable
  comments-indentation: disable
  document-start: disable
  line-length:
    level: warning
    max: 160
    allow-non-breakable-inline-mappings: true
  truthy: disable
