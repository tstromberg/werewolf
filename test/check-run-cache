#!/usr/bin/env python3
"""Measure repeated protected runs; assert no build, reboot or authority replacement.

--build enrolls a bundle signed with the caller's keys, kept in a private
XDG_DATA_HOME here, never the caller's own."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from publisher_transport import connection as publisher_connection

howl, kernel, key, cert, stub, output = sys.argv[1:]
howl, kernel, key, cert, stub = [str(Path(p).resolve()) for p in (howl, kernel, key, cert, stub)]
work = Path(output).resolve()
work.mkdir(mode=0o700, parents=True, exist_ok=False)
os.umask(0o077)
machine = Path('build/machines/werewolf-run')
if machine.exists():
    raise RuntimeError('run-cache requires an isolated checkout without an existing werewolf-run')
lima_home = tempfile.mkdtemp(prefix='ww-run-cache-', dir='/tmp')
env = dict(os.environ, LIMA_HOME=lima_home, XDG_DATA_HOME=str(work / 'data'),
           WEREWOLF_IPE_KERNEL=kernel, WEREWOLF_IPE_KEY=key,
           WEREWOLF_IPE_CRT=cert, UKI_STUB=stub, PYTHONDONTWRITEBYTECODE='1')
for name in ('WEREWOLF_BOOT_KEY', 'WEREWOLF_BOOT_CRT', 'WEREWOLF_BUILD_VM', 'SECUREBOOT_DIR'):
    env.pop(name, None)
commands = work / 'commands.jsonl'
commands.touch()
tools = work / 'bin'
tools.mkdir()
builders = ('apko', 'melange', 'openssl', 'osslsigncode', 'zig', 'mkfs.erofs',
            'zstd', 'mformat', 'mcopy', 'mke2fs', 'make', 'gmake', 'bsdtar', 'qemu-system-aarch64')
for name in (*builders, 'limactl'):
    actual = shutil.which(name)
    if not actual:
        continue
    wrapper = tools / name
    wrapper.write_text('''#!/usr/bin/env python3
import json, os, sys
with open(''' + repr(str(commands)) + ''', 'a') as stream:
    stream.write(json.dumps([os.path.basename(sys.argv[0]), *sys.argv[1:]]) + '\\n')
os.execv(''' + repr(actual) + ''', [''' + repr(actual) + ''', *sys.argv[1:]])
''')
    wrapper.chmod(0o755)
ssh_key = work / 'ssh.key'
actual_ssh = shutil.which('ssh')
ssh = tools / 'ssh'
ssh.write_text('#!/usr/bin/env python3\nimport os,sys\nos.execv(' + repr(actual_ssh) + ', ' +
               repr([actual_ssh, '-F', '/dev/null', '-o', 'BatchMode=yes', '-o',
                     'IdentitiesOnly=yes', '-i', str(ssh_key)]) + ' + sys.argv[1:])\n')
ssh.chmod(0o755)
env['PATH'] = str(tools) + os.pathsep + env['PATH']


def run(argv, label, timeout=600):
    began = time.monotonic()
    result = subprocess.run(list(map(str, argv)), env=env, capture_output=True, timeout=timeout)
    (work / (label + '.log')).write_bytes(result.stdout + result.stderr)
    if result.returncode:
        raise RuntimeError(label + ': ' + result.stderr.decode(errors='replace')[-2000:])
    return result.stdout, time.monotonic() - began


def status(previous=None):
    until = time.monotonic() + 180
    while time.monotonic() < until:
        try:
            reply, _ = run([howl, 'ssh', '--', '/usr/bin/ab-status'], 'status', 10)
            value = json.loads(reply)
            if value['committed'] and value['boot_id'] != previous:
                if not all(value[field] for field in ('secure_boot', 'ipe', 'verified_root', 'rollback_protected')):
                    raise RuntimeError('missing guest protection')
                return value
        except (RuntimeError, ValueError, subprocess.TimeoutExpired):
            pass
        time.sleep(1)
    raise RuntimeError('protected guest did not become ready')


def authority():
    config = json.loads((machine / 'authority/publisher.json').read_text())
    files = [machine / 'boot.crt', work / 'data/howl/keys/boot/aarch64/boot.key', Path(config['key'])]
    files += [machine / 'authority' / name for name in (
        'permit.key', 'credentials/owner.auth', 'credentials/lockout.auth',
        'factory.permit', 'transport.bundle', 'image-inputs')]
    return {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in files}


def operations():
    return [json.loads(line) for line in commands.read_text().splitlines()]


def assert_no_build(entries, live):
    # Resume still authenticates the cached inputs.  Certificate parsing and
    # signature verification are security checks, not rebuild work.
    def builds(entry):
        if entry[0] == 'openssl' and entry[1:2] == ['x509']:
            return False
        if entry[0] == 'osslsigncode' and entry[1:2] == ['verify']:
            return False
        return entry[0] in builders and (live or entry[0] != 'qemu-system-aarch64')

    unexpected = [entry for entry in entries if builds(entry)]
    if live:
        unexpected += [entry for entry in entries if entry[0] == 'limactl' and entry[1] != 'list']
    if unexpected:
        raise RuntimeError('cached run repeated work: ' + repr(unexpected))


try:
    run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', ssh_key], 'ssh-key')
    form = work / 'form'
    overlay = form / 'rootfs/usr/bin'
    overlay.mkdir(parents=True)
    (form / 'form.yaml').write_text('base: playground\nweaknesses:' +
        Path('forms/playground/form.yaml').read_text().split('weaknesses:', 1)[1])
    label = form / 'rootfs/usr/share/werewolf/ab-release'
    label.parent.mkdir(parents=True)
    label.write_text('A\n')
    run(['zig', 'build-exe', '-O', 'ReleaseSafe', '-fPIE', '-target', 'aarch64-linux-musl',
         '--dep', 'cmdline', '--dep', 'ipe', '--dep', 'tpm', '-Mroot=test/ab-status.zig',
         '--dep', 'network', '-Mcmdline=lib/cmdline.zig', '-Mnetwork=lib/network.zig',
         '-Mipe=lib/ipe.zig', '--dep', 'apk', '-Mtpm=lib/tpm.zig', '--dep', 'package',
         '-Mapk=lib/apk.zig', '-Mpackage=lib/package.zig', '-femit-bin=' + str(overlay / 'ab-status')], 'probe')
    for path in form.rglob('*'):
        path.chmod(0o755 if path.is_dir() or path.name == 'ab-status' else 0o644)
    args = [howl, 'run', '--build', '--with', form, '--yes', '--root-keys', str(ssh_key) + '.pub']
    _, cold = run(args, 'first')
    initial = status()
    print('pass: protected first boot', flush=True)
    private = authority()
    repeats = []
    for i in range(3):
        before = len(operations())
        reply, elapsed = run(args, 'repeat-' + str(i))
        assert_no_build(operations()[before:], live=True)
        if b'unchanged' not in reply or status()['boot_id'] != initial['boot_id']:
            raise RuntimeError('cached run restarted the guest')
        if authority() != private:
            raise RuntimeError('cached run replaced enrollment or signing authority')
        repeats.append(elapsed)
        print('pass: unchanged run %.3fs, no builders or reboot' % elapsed, flush=True)
    (work / 'repeat-results.json').write_text(json.dumps({
        'cold_seconds': cold, 'repeat_seconds': repeats,
    }, indent=2) + '\n')
    publisher = machine / 'authority/local-publisher'
    config_file = machine / 'authority/publisher.json'
    run(['python3', publisher, 'stop', config_file], 'publisher-stop')
    before = len(operations())
    _, recovered = run(args, 'publisher-recover')
    assert_no_build(operations()[before:], live=True)
    # The machine is registered with the host's one shared publisher.
    config = json.loads((Path(json.loads(config_file.read_text())['service']) / 'publisher.json').read_text())
    connection = publisher_connection(config, timeout=5)
    try:
        connection.request('GET', '/_health', headers={'X-Werewolf-Control': config['token']})
        response = connection.getresponse()
        if response.status != 200 or response.read(32) != b'ready\n':
            raise RuntimeError('cached run did not recover the host publisher')
    finally:
        connection.close()
    if authority() != private or status()['boot_id'] != initial['boot_id']:
        raise RuntimeError('publisher recovery changed the protected machine')
    print('pass: publisher recovery without rebuild or guest restart', flush=True)
    run([howl, 'stop'], 'stop')
    before = len(operations())
    _, resumed = run(args, 'resume')
    assert_no_build(operations()[before:], live=False)
    restarted = status(initial['boot_id'])
    if authority() != private or restarted['tpm_anchor'] != initial['tpm_anchor']:
        raise RuntimeError('resume replaced authority or TPM authorization')
    result = {'cold_seconds': cold, 'repeat_seconds': repeats, 'resume_seconds': resumed,
              'publisher_recovery_seconds': recovered,
              'unchanged_boot_id': initial['boot_id'], 'tpm_anchor': initial['tpm_anchor'],
              'no_builds_on_repeat_or_resume': True}
    (work / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps(result), flush=True)
finally:
    if machine.exists():
        console = Path(lima_home) / 'werewolf-run/serial.log'
        if console.exists():
            shutil.copyfile(console, work / 'console.log')
        result = subprocess.run([howl, 'delete', 'werewolf-run', '--on', 'lima'],
                                env=env, capture_output=True, timeout=120)
        (work / 'cleanup.log').write_bytes(result.stdout + result.stderr)
    if not machine.exists() and not (Path(lima_home) / 'werewolf-run').exists():
        shutil.rmtree(lima_home)
    ssh_key.unlink(missing_ok=True)
    shutil.rmtree(work / 'data', ignore_errors=True)
