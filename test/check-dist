#!/usr/bin/env python3
"""Boot the actual release disk, enrolling its signed boot identity when present."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def firmware_arguments(argv, arch, enrolled):
    # Replace generic firmware rather than adding a second flash bank.
    result = []
    i = 0
    while i < len(argv):
        flag = argv[i]
        if flag in ['-bios', '-drive'] and i + 1 < len(argv):
            if flag == '-bios' or 'if=pflash' in argv[i + 1].split(','):
                i += 2
                continue
        result.append(flag)
        if flag == '-M':
            if i + 1 == len(argv):
                raise ValueError('machine argument missing')
            result.append('virt' if arch == 'aarch64' else 'q35,smm=on')
            i += 2
            continue
        i += 1
    result += ['-drive', 'if=pflash,format=raw,unit=0,readonly=on,file=' + str(enrolled / 'code.fd'),
               '-drive', 'if=pflash,format=raw,unit=1,' +
               ('readonly=on,' if arch == 'aarch64' else '') + 'file=' + str(enrolled / 'vars.fd')]
    if arch == 'x86_64':
        result += ['-global', 'driver=cfi.pflash01,property=secure,value=on']
    return result


def authenticated_artifacts(manifest, directory, prefix):
    for name in ['disk.qcow2', 'uki', 'boot.crt']:
        record = manifest['files'][name]
        source = directory / (prefix + '-' + name)
        digest = hashlib.sha256()
        with source.open('rb') as stream:
            for part in iter(lambda: stream.read(1 << 20), b''):
                digest.update(part)
        if source.stat().st_size != record['size'] or digest.hexdigest() != record['sha256']:
            raise ValueError('release artifact mismatch: ' + name)


def main(argv):
    arch, form = os.environ['ARCH'], os.environ['FORM']
    if arch not in ['aarch64', 'x86_64']:
        raise ValueError('unsupported release architecture')
    directory, work = Path(os.environ['DIST']), Path(os.environ['CHECK'])
    work.mkdir(parents=True, exist_ok=True)
    prefix = form + '-' + arch
    disk = directory / (prefix + '-disk.qcow2')
    manifest = json.loads((directory / (prefix + '.json')).read_text())
    cert = directory / (prefix + '-boot.crt')
    if 'boot.crt' in manifest['files'] or 'uki' in manifest['files'] or cert.exists():
        authenticated_artifacts(manifest, directory, prefix)
        subprocess.run(['sh', 'tools/verify-boot-disk', arch, str(disk), str(cert), str(work)], check=True)
        enrolled = work / 'dist-enrolled'
        subprocess.run(['sh', 'tools/enroll-boot', arch, str(cert), str(enrolled)], check=True)
        argv = firmware_arguments(argv, arch, enrolled)
    else:
        if not os.environ.get('FIRMWARE'):
            raise ValueError('missing UEFI firmware')
        if arch == 'x86_64':
            shutil.copyfile(os.environ['UEFI_VARS'], os.environ['UEFI_VARS_COPY'])
    os.execv('test/boot', ['test/boot', 'dist-' + form, '-', str(work / 'dist.log'),
                         *argv, '-drive', 'file=' + str(disk) + ',format=qcow2,if=virtio'])


if __name__ == '__main__':
    main(sys.argv[1:])
