# prod on GCP, whose metadata server first holds a good config and then,
# from the second request, one naming a person (test/metadata.zig, people):
# the cloud-metadata service polls every minute and makes the account.

ok  services-up      i=0; while sv status /etc/sv/* | grep -qE 'want up|^fail'; do i=$((i + 1)); [ $i -le 30 ] || break; sleep 1; done; sleep 2; ! sv status /etc/sv/* | grep -qE 'want up|^fail'
ok  hostname         [ "$(hostname)" = cloud-check ]
ok  root-key         grep -q 'werewolf-check-key' /run/werewolf/keys/root
ok  poller-up        sv status /etc/sv/cloud-metadata | grep -q '^run:'
ok  people-arrive    i=0; until grep -q '^tom:x:' /etc/passwd; do i=$((i + 1)); [ $i -le 150 ] || { echo "no tom after 150 s"; exit 1; }; sleep 1; done; grep -q '^tom:x:[0-9]*:[0-9]*::/data/home/tom:' /etc/passwd && grep -q tom@yubikey /run/werewolf/keys/tom && grep -q tom@yubikey /run/werewolf/keys/root && grep -q werewolf-check-key /run/werewolf/keys/root && [ -d /data/home/tom ] && [ "$(cat /run/werewolf/people)" = tom ]
ok  people-reserved  grep -qx 'p tom 654612137 654612137' /data/.werewolf/identities && [ "$(stat -c '%u:%g:%a' /data/home/tom)" = 654612137:654612137:700 ]
# The parser and fetcher hold no capabilities. The root account publisher
# retains CHOWN alone, with an empty network and no identity-switching calls.
ok  poller-separated  parent=$(cat /etc/sv/cloud-metadata/supervise/pid); [ "$parent" -gt 1 ] || exit 1; awk '/^Uid:/ {u=$2} /^CapEff:/ {e=$2} /^CapBnd:/ {b=$2} /^NoNewPrivs:/ {n=$2} /^Seccomp:/ {s=$2} END {exit !(u == 0 && e == "0000000000000001" && b == e && n == 1 && s == 2)}' /proc/$parent/status || exit 1; parser=0; fetcher=0; for d in /proc/[0-9]*; do awk -v p=$parent '/^PPid:/ {exit $2 != p}' "$d/status" 2>/dev/null || continue; u=$(awk '/^Uid:/ {print $2}' "$d/status"); case $u in 74) parser=1;; 68) fetcher=1;; *) exit 1;; esac; awk '/^CapEff:/ {e=$2} /^CapBnd:/ {b=$2} /^NoNewPrivs:/ {n=$2} /^Seccomp:/ {s=$2} END {exit !(e == "0000000000000000" && b == e && n == 1 && s == 2)}' "$d/status" || exit 1; done; [ "$parser" = 1 ] && [ "$fetcher" = 1 ]
# The publisher's death must kill both workers; the new publisher must retain
# the applied account generation and restore the service without root workers.
ok  poller-restarts  parent=$(cat /etc/sv/cloud-metadata/supervise/pid); children=$(for d in /proc/[0-9]*; do awk -v p=$parent '/^PPid:/ {exit $2 != p}' "$d/status" 2>/dev/null && echo ${d#/proc/}; done); [ -n "$children" ] && kill -KILL $parent || exit 1; i=0; while :; do next=$(cat /etc/sv/cloud-metadata/supervise/pid); [ "$next" -gt 1 ] && [ "$next" != "$parent" ] && break; i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done; for p in $children; do i=0; while [ -d /proc/$p ]; do i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done; done; grep -q '^tom:x:' /etc/passwd && grep -q tom@yubikey /run/werewolf/keys/root
