#!/usr/bin/env python3
"""Prove Lima QEMU enrollment and VZ refusal of a Secure Boot-required release."""
import hashlib
import json
import os
import pathlib
import platform
import shlex
import subprocess
import sys
import tempfile
import time

if platform.system() != 'Darwin' or platform.machine() != 'arm64':
    sys.exit('check-lima-secureboot requires an arm64 Mac')
disk, enrolled, work = [pathlib.Path(p).resolve() for p in sys.argv[1:]]
work.mkdir(parents=True, exist_ok=True, mode=0o700)
env = dict(os.environ)
variables = enrolled / 'vars.fd'
before = hashlib.sha256(variables.read_bytes()).digest()


def boot(backend):
    name = 'secureboot-' + backend
    config = {'vmType': backend, 'plain': True, 'arch': 'aarch64', 'cpus': 2,
              'memory': '1GiB', 'mounts': [], 'containerd': {'system': False, 'user': False},
              'images': [{'location': str(disk), 'arch': 'aarch64'}]}
    current = env.copy()
    if backend == 'qemu':
        config['firmware'] = {'images': [{'location': str(enrolled / 'code.fd'),
                                         'arch': 'aarch64', 'vmType': 'qemu'}]}
        drive = 'if=pflash,format=raw,unit=1,readonly=on,file=' + str(variables).replace(',', ',,')
        current['QEMU_SYSTEM_AARCH64'] = 'qemu-system-aarch64 -drive ' + shlex.quote(drive)
    template = work / (backend + '.yaml')
    template.write_text(json.dumps(config))
    client = None
    seen = b''
    with (work / (backend + '-host.log')).open('wb') as log:
        try:
            client = subprocess.Popen(['limactl', 'start', '--tty=false', '--name=' + name,
                                       str(template)], env=current, stdout=log, stderr=log)
            deadline = time.monotonic() + 120
            while time.monotonic() < deadline:
                seen = b''.join(p.read_bytes() for p in (pathlib.Path(env['LIMA_HOME']) / name).glob('serial*.log'))
                if backend == 'vz' and b'Secure Boot required outside setup mode' in seen:
                    assert b'handing over to runit' not in seen
                    break
                if backend == 'qemu':
                    assert b'Kernel panic' not in seen
                    if b'posture: fail=' in seen and b'"unexpected":[]' in seen:
                        assert b'Secure Boot enforced outside setup mode' in seen
                        assert b"Secure Boot admits only this image's signer" in seen
                        assert b'native UKI selected slot a' in seen and b'verified (root hash' in seen
                        break
                if client.poll() is not None and client.returncode != 0:
                    raise RuntimeError('Lima failed; see ' + str(work / (backend + '-host.log')))
                time.sleep(0.5)
            else:
                raise RuntimeError('missing firmware outcome: ' + backend)
        finally:
            (work / (backend + '-console.log')).write_bytes(seen)
            subprocess.run(['limactl', 'delete', '--force', name], env=current,
                           stdout=log, stderr=log, check=True)
            if client is not None:
                if client.poll() is None:
                    client.terminate()
                client.wait(timeout=30)


with tempfile.TemporaryDirectory(prefix='ww-sb-lima-', dir='/tmp') as state:
    # Keep Lima's socket paths below macOS's 104-byte Unix path limit.
    env['LIMA_HOME'] = state
    boot('qemu')
    assert hashlib.sha256(variables.read_bytes()).digest() == before
    boot('vz')
print('pass   lima-secureboot: QEMU enforces immutable enrollment; VZ refuses required Secure Boot')
