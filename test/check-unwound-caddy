#!/usr/bin/env python3
"""Run Caddy's staging-ACME lookup through the composed Caddy DNS policy.

Usage: python3 test/check-unwound-caddy FENCE UNWOUND POLICY DOMAIN
Linux root and an installed caddy are required. The resolver and Caddy run in
private namespaces. The fixture never connects to the public ACME service.
"""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


source = Path(__file__).with_name('check-unwound')
loader = importlib.machinery.SourceFileLoader('check_unwound', str(source))
spec = importlib.util.spec_from_loader(loader.name, loader)
base = importlib.util.module_from_spec(spec)
loader.exec_module(base)


def pilot(client, work):
    del client
    policy = base.POLICY
    match = re.search(r'^lookup (\d+) \* A AAAA$', policy, re.M)
    assert match, 'Caddy needs a screened A/AAAA grant'
    uid = int(match.group(1))
    name = os.environ['CADDY_DNS_DOMAIN']
    config = work / 'Caddyfile'
    config.write_text('''{
    admin off
    auto_https disable_redirects
    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}
''' + name + ''':8443 {
    respond "dns pilot"
}
''')
    data = work / 'caddy-data'
    data.mkdir(mode=0o777)
    data.chmod(0o777)
    caddy_log = work / 'caddy.log'
    with caddy_log.open('w') as err:
        caddy = subprocess.Popen(
            ['/usr/bin/caddy', 'run', '--config', str(config), '--adapter', 'caddyfile'],
            env={**os.environ, 'HOME': str(data), 'XDG_DATA_HOME': str(data),
                 'XDG_CONFIG_HOME': str(data)},
            stdout=err, stderr=err,
            preexec_fn=lambda: os.setuid(uid),
        )
        try:
            deadline = time.monotonic() + 25
            while time.monotonic() < deadline:
                audit = (work / 'audit').read_text()
                if any('"uid":' + str(uid) in line and '"event":"query"' in line
                       for line in audit.splitlines()):
                    time.sleep(2)
                    break
                if caddy.poll() is not None:
                    raise AssertionError('Caddy exited: ' + caddy_log.read_text())
                time.sleep(0.2)
            else:
                raise AssertionError('Caddy made no DNS query: ' + caddy_log.read_text())
        finally:
            caddy.terminate()
            caddy.wait(timeout=5)
    queries = [json.loads(line.split(': ', 1)[1]) for line in
               (work / 'audit').read_text().splitlines() if ': {' in line]
    queries = [q for q in queries if q.get('event') == 'query' and q.get('uid') == uid]
    assert queries, 'no Caddy DNS audit'
    refused = [q for q in queries if q.get('decision') == 'deny']
    assert not refused, refused
    kinds = {q.get('type') for q in queries}
    assert {'A', 'AAAA'} <= kinds, queries
    names = sorted({q['name'] for q in queries})
    print('check-unwound-caddy: screened Caddy A/AAAA allowed: ' + ', '.join(names))


def main():
    if len(sys.argv) == 7 and sys.argv[1] == '--inside':
        _, _, fence, unwound, parent_net, policy_path, domain = sys.argv
        base.POLICY = Path(policy_path).read_text()
        os.environ['CADDY_DNS_DOMAIN'] = domain
        base.checks = pilot
        base.inside(fence, unwound, parent_net)
    elif len(sys.argv) == 5:
        if sys.platform != 'linux' or os.geteuid() != 0:
            sys.exit('check-unwound-caddy needs Linux root for private namespaces')
        fence, unwound, policy_path, domain = (str(Path(arg).resolve()) if i < 3 else arg
                                                for i, arg in enumerate(sys.argv[1:]))
        base.run(['unshare', '--net', '--mount', '--fork', sys.executable,
                  str(Path(__file__).resolve()), '--inside', fence, unwound,
                  os.readlink('/proc/self/ns/net'), policy_path, domain])
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
