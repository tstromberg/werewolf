# A changed cloud key reuses the reserved person and retained mode 0700 home.
ok  services-up      i=0; while sv status /etc/sv/* | grep -qE 'want up|^fail'; do i=$((i + 1)); [ $i -le 30 ] || break; sleep 1; done; ! sv status /etc/sv/* | grep -qE 'want up|^fail'
ok  initial-key      cp /run/werewolf/cloud/config.tar /tmp/reapply-before.tar && mkdir /data/.werewolf/identities.new && grep -q tom@yubikey /run/werewolf/keys/tom && [ "$(stat -c '%u:%g:%a' /data/home/tom)" = 654612137:654612137:700 ]
ok  key-reapplied    i=0; while cmp -s /tmp/reapply-before.tar /run/werewolf/cloud/config.tar; do i=$((i + 1)); [ $i -le 150 ] || exit 1; sleep 1; done; grep -q tom@spare /run/werewolf/keys/tom && ! grep -q tom@yubikey /run/werewolf/keys/tom && grep -q tom@spare /run/werewolf/keys/root && ! grep -q tom@yubikey /run/werewolf/keys/root && [ -d /data/.werewolf/identities.new ]
ok  identity-reused  grep -q '^tom:x:654612137:654612137::/data/home/tom:/bin/mksh$' /etc/passwd && grep -q '^tom:\*:' /etc/shadow && grep -qx 'p tom 654612137 654612137' /data/.werewolf/identities && [ "$(stat -c '%u:%g:%a' /data/home/tom)" = 654612137:654612137:700 ]
