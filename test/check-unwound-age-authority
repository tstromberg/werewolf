#!/usr/bin/env python3
"""Exercise the early age writer and root's read-only mount view in Linux.

Usage: sudo python3 test/check-unwound-age-authority AGE_BINARY
"""
import errno
import os
from pathlib import Path
import socket
import sqlite3
import struct
import subprocess
import sys
import time
import zlib


def run(*args):
    subprocess.run(args, check=True, stdout=subprocess.DEVNULL)


def blocked(path, action):
    try:
        action()
    except OSError as error:
        assert error.errno == errno.EROFS, (path, error)
    else:
        raise AssertionError(f'root modified {path}')


def inside(binary):
    live = os.environ.get('AGE_LIVE') == '1'
    ca = Path('/etc/ssl/certs/ca-certificates.crt').read_bytes() if live else None
    run('mount', '--make-rprivate', '/')
    Path('/data').mkdir(exist_ok=True)
    for path in ('/run', '/usr/share', '/data') + (('/etc',) if live else ()):
        run('mount', '-t', 'tmpfs', 'tmpfs', path)
    if live:
        Path('/etc/ssl/certs').mkdir(parents=True)
        Path('/etc/ssl/certs/ca-certificates.crt').write_bytes(ca)
        Path('/etc/resolv.conf').write_text('nameserver 127.0.0.53\n')
    Path('/usr/share/werewolf').mkdir()
    policy = 'lookup 2002 * A AAAA\n'
    Path('/usr/share/werewolf/net').write_text(policy)
    db_dir = Path('/data/svc/unwound-age')
    db_dir.mkdir(parents=True)
    now = int(time.time())
    db = sqlite3.connect(db_dir / 'age.db')
    schema = Path(__file__).resolve().parents[1] / 'cmd/unwound/age.sql'
    db.executescript(schema.read_text())
    db.execute('PRAGMA journal_mode=WAL')
    if not live:
        db.execute('''INSERT INTO domain_age
            (domain,source,status,registered_at,effective_at,fetched_at,
             retry_after,last_used_at,psl_generation,bootstrap_generation)
            VALUES (?,?,?,?,?,?,?,?,?,?)''',
            ('example.com', 'rdap', 'valid', 946684800, 946684800,
             now, now + 7 * 86400, now, 'fixture', 'fixture'))
    db.commit()
    db.close()
    os.chown(db_dir, 55, 55)
    os.chmod(db_dir, 0o700)
    for entry in db_dir.iterdir():
        os.chown(entry, 55, 55)
    Path('/run/werewolf-age').mkdir()
    Path('/run/werewolf/network').mkdir(parents=True)
    parent, child = socket.socketpair()

    def control_fd():
        os.dup2(child.fileno(), 3)

    worker = subprocess.Popen([binary], pass_fds=(3, child.fileno()),
                              preexec_fn=control_fd, stderr=subprocess.PIPE)
    child.close()
    mounted = []
    try:
        parent.settimeout(10)
        assert parent.recv(1) == b'R', worker.stderr.read().decode()
        for path in (str(db_dir), '/run/werewolf-age'):
            run('mount', '--bind', path, path)
            run('mount', '-o', 'remount,bind,ro,nosuid,nodev,noexec,nosymfollow', path)
            mounted.append(path)
        parent.sendall(b'G')
        blocked(db_dir / 'age.db', lambda: open(db_dir / 'age.db', 'wb'))
        blocked('/run/werewolf-age/age.sock',
                lambda: os.unlink('/run/werewolf-age/age.sock'))
        request_name = b'a.example.com'
        request = struct.pack('!BBBBQHHHIB', 1, 0, 0, 0, 42, 7, 1, 1,
                              zlib.crc32(policy.encode()), len(request_name)) + request_name
        with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as client:
            client.settimeout(13)
            client.connect('/run/werewolf-age/age.sock')
            client.sendall(request)
            response = client.recv(300)
        assert response[:4] == bytes([1, 2, 1, 11]), response
        assert struct.unpack('!Q', response[4:12])[0] == 42, response
        assert response[12:] == b'example.com', response
        if live:
            evidence = sqlite3.connect(f'file:{db_dir}/age.db?mode=ro', uri=True)
            assert evidence.execute('SELECT source,status FROM domain_age WHERE domain=?',
                                    ('example.com',)).fetchone() == ('rdap', 'valid')
            trigger = evidence.execute('SELECT request_id,dns_id,qname,qtype,transport,'
                                       'source_label,service_uid,policy_namespace '
                                       'FROM age_check WHERE domain=?',
                                       ('example.com',)).fetchone()
            assert trigger == (42, 7, 'a.example.com', 1, 'udp', '127.53.0.1', 2002,
                               'uid:2002'), trigger
            evidence.close()
        print('age authority: mature evidence, exact trigger and root read-only views pass')
    finally:
        worker.kill()
        worker.wait(timeout=5)
        parent.close()
        for path in reversed(mounted):
            run('umount', path)


if __name__ == '__main__':
    if os.geteuid() != 0 or sys.platform != 'linux':
        sys.exit('check-unwound-age-authority requires root on Linux')
    if len(sys.argv) == 3 and sys.argv[1] == '--inside':
        inside(sys.argv[2])
    elif len(sys.argv) == 2:
        binary = str(Path(sys.argv[1]).resolve())
        subprocess.run(['unshare', '--mount', '--fork', sys.executable,
                        str(Path(__file__).resolve()), '--inside', binary], check=True)
    else:
        sys.exit(__doc__)
