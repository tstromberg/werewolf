#!/bin/sh
# A bastion with an ordinary login and one permitted forwarding destination.
set -eu
check=$1 form_tool=$2 provider=$3
dir=$check/bastion-check
mkdir -p "$check" && rm -rf "$dir" && mkdir -p "$dir/test"
test/keys "$dir" "$provider"
cp forms/bastion/test/tests.yaml "$dir/test/tests.yaml"
{
	echo 'base: bastion'
	echo 'users:'
	echo '  check:'
	echo "    keys: [\"$(cut -d' ' -f1,2 "$dir-sk-key.pub")\"]"
	echo 'bastion:'
	echo '  destinations: [127.0.0.1:22]'
	echo 'weaknesses:'
	"$form_tool" excuses bastion | sed 's/^\([^ ]*\) \(.*\)/  \1: "\2"/'
} >"$dir/form.yaml"
