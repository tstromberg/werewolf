class Payload(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.base = self.root / 'base'
        self.test = self.root / 'native-test-base'
        for root in (self.base, self.test):
            for name in ('etc/sv/postgres/service', 'etc/werewolf/allow/jit',
                         'usr/share/werewolf/etc/passwd', 'usr/share/werewolf/etc/group'):
                native.write(root / 'ro' / name, name + '\n')
            for name in ('pledge', 'net', 'weaknesses'):
                native.write(root / 'meta/usr/share/werewolf' / name, name + '\n')
            self.archive(root / 'rootfs.tar', {'usr/bin/postgres': b'production database'})
            overlay = {'usr/lib/werewolf/init': b'production init'}
            if root == self.test:
                self.archive(root / 'rootfs.tar', {'usr/bin/postgres': b'production database',
                                                  'usr/bin/psql': b'client',
                                                  'usr/lib/werewolf/sh-shim': b'command shim'})
                overlay['usr/lib/werewolf/test-postgres-policy'] = b'test driver'
            self.archive(root / 'overlay.tar', overlay)

    def archive(self, path, files):
        with tarfile.open(path, 'w') as archive:
            for name, data in files.items():
                info = tarfile.TarInfo(name)
                info.size = len(data)
                archive.addfile(info, io.BytesIO(data))

    def compare(self, **env):
        plan = native.read_plan('postgresql')
        with patch.dict(os.environ, BUILD=str(self.root), **env), contextlib.redirect_stdout(io.StringIO()), \
                patch.object(native, 'boot_plan', return_value=plan):
            native.compare('base', 'aarch64')

    def test_client_addition(self):
        self.archive(self.test / 'rootfs.tar', {'usr/bin/postgres': b'production database',
            'usr/bin/psql': b'client', 'usr/lib/werewolf/sh-shim': b'command shim'})
        self.compare()

    def test_missing_client_is_rejected_before_boot(self):
        self.archive(self.test / 'rootfs.tar', {'usr/bin/postgres': b'production database'})
        with self.assertRaisesRegex(ValueError, 'client missing from image: /usr/bin/psql'):
            self.compare()

    def test_only_declared_driver_runtime_grants_can_be_added(self):
        plan = native.read_plan('postgresql')
        plan['drivers'][0]['allow'] = ['python:native']
        namespace = plan['drivers'][0]['name']
        grant = 'etc/runtime-hardening/allow/' + namespace + '/python/native'
        files = {'usr/lib/werewolf/init': b'production init', grant: b'',
                 'usr/lib/werewolf/test-postgres-policy': b'test driver'}
        self.archive(self.test / 'overlay.tar', files)
        with patch.object(native, 'read_plan', return_value=plan):
            self.compare()
            for changed in ({**files, grant: b'unexpected content'},
                            {**files, 'etc/runtime-hardening/allow/all/python/native': b''}):
                self.archive(self.test / 'overlay.tar', changed)
                with self.assertRaises(ValueError):
                    self.compare()

    def test_explicit_ipe_variant_paths(self):
        before, after = self.root / 'base-ipe', self.root / 'native-test-base-ipe'
        self.base.rename(before)
        self.test.rename(after)
        self.compare(PRODUCTION_OUT=str(before), TEST_OUT=str(after))
        (after / 'ro/etc/sv/postgres/service').write_text('weakened')
        with self.assertRaisesRegex(ValueError, 'production etc/sv'):
            self.compare(PRODUCTION_OUT=str(before), TEST_OUT=str(after))

    def test_added_library_cannot_replace_a_production_command_alias(self):
        for root in (self.base, self.test):
            with tarfile.open(root / 'rootfs.tar', 'a') as output:
                directory = tarfile.TarInfo('usr/bin')
                directory.type, directory.mode = tarfile.DIRTYPE, 0o755
                output.addfile(directory)
                item = tarfile.TarInfo('usr/bin/clear')
                if root == self.base:
                    item.type, item.mode, item.linkname = tarfile.SYMTYPE, 0o777, '/bin/busybox'
                    output.addfile(item)
                else:
                    item.size, item.mode = 7, 0o755
                    output.addfile(item, io.BytesIO(b'ncurses'))
        with self.assertRaisesRegex(ValueError, 'runtime file: usr/bin/clear'):
            self.compare()
        generated = self.root / 'clients'
        native.command_links(self.base, generated)
        self.assertEqual(os.readlink(generated / 'usr/bin/clear'), '/bin/busybox')
        with tarfile.open(self.test / 'overlay.tar', 'a') as output:
            directory = tarfile.TarInfo('usr/bin')
            directory.type, directory.mode = tarfile.DIRTYPE, 0o755
            output.addfile(directory)
            item = tarfile.TarInfo('usr/bin/clear')
            item.type, item.mode, item.linkname = tarfile.SYMTYPE, 0o755, '/bin/busybox'
            output.addfile(item)
        self.compare()
        for uid, target in ((123, '/bin/busybox'), (0, '/usr/bin/changed')):
            with tarfile.open(self.test / 'overlay.tar', 'a') as output:
                item.uid, item.linkname = uid, target
                output.addfile(item)
            with self.assertRaisesRegex(ValueError, 'runtime file: usr/bin/clear'):
                self.compare()

    def test_runtime_change_hidden_by_overlay_is_still_refused(self):
        with tarfile.open(self.test / 'overlay.tar', 'a') as output:
            item = tarfile.TarInfo('usr/bin/postgres')
            item.size = 7
            output.addfile(item, io.BytesIO(b'changed'))
        with self.assertRaisesRegex(ValueError, 'runtime file: usr/bin/postgres'):
            self.compare()

    def test_replaced_runtime_or_overlay_refused(self):
        for archive, files in [('rootfs.tar', {'usr/bin/postgres': b'changed server'}),
                               ('overlay.tar', {'usr/lib/werewolf/init': b'changed init'})]:
            with self.subTest(archive=archive):
                original = (self.test / archive).read_bytes()
                self.archive(self.test / archive, files)
                with self.assertRaises(ValueError):
                    self.compare()
                (self.test / archive).write_bytes(original)

    def test_service_or_identity_or_seal_change_refused(self):
        for name in ('ro/etc/sv/postgres/service', 'ro/usr/share/werewolf/etc/passwd',
                     'meta/usr/share/werewolf/pledge'):
            with self.subTest(name=name):
                path = self.test / name
                original = path.read_bytes()
                path.write_bytes(b'weakened')
                with self.assertRaises(ValueError):
                    self.compare()
                path.write_bytes(original)

    def test_shell_addition_refused(self):
        for shell in ('bin/sh', 'bin/ash', 'usr/bin/dash', 'usr/bin/busybox'):
            with self.subTest(shell=shell):
                self.archive(self.test / 'rootfs.tar', {'usr/bin/postgres': b'production database', shell: b'shell'})
                with self.assertRaises(ValueError):
                    self.compare()

    def test_added_runtime_configuration_refused(self):
        self.archive(self.test / 'overlay.tar', {
            'usr/lib/werewolf/init': b'production init',
            'etc/postgresql/conf.d/test.conf': b'changed behavior without replacing a file',
        })
        with self.assertRaisesRegex(ValueError, 'added runtime overlay'):
            self.compare()

    def test_owner_and_directory_permissions_preserved(self):
        def archive(path, uid, mode):
            with tarfile.open(path, 'w') as output:
                directory = tarfile.TarInfo('usr')
                directory.type = tarfile.DIRTYPE
                directory.mode = mode
                output.addfile(directory)
                executable = tarfile.TarInfo('usr/bin/postgres')
                executable.uid = uid
                executable.size = 1
                output.addfile(executable, io.BytesIO(b'x'))
        archive(self.base / 'rootfs.tar', 0, 0o755)
        for uid, mode in ((123, 0o755), (0, 0o777)):
            with self.subTest(uid=uid, mode=mode):
                archive(self.test / 'rootfs.tar', uid, mode)
                with self.assertRaises(ValueError):
                    self.compare()


class RunIdentity(unittest.TestCase):
    def serial_run(self, reformat=False, update=False, rotate_key=False):
        plan = native.read_plan('postgresql')
        with tempfile.TemporaryDirectory() as temp:
            root = Path(temp)
            images = root / 'build'
            paths = dict(kernel=images / 'vmlinuz',
                         image=images / 'native-test-postgresql/initramfs.zst',
                         production_image=images / 'postgresql/initramfs.zst',
                         plan=root / 'forms/postgresql/test/native.json')
            for path in paths.values():
                native.write(path, 'original')
            fixture = root / 'forms/postgresql/test/config-again'
            if update:
                native.write(fixture, 'host configuration update')
            updates = []

            def boot(*args, **kwargs):
                config = root / 'check/postgresql-native/config'
                if Path(args[0]) == fixture.relative_to(root):
                    updates.append('updated')
                    native.write(config / 'updated', 'new config')
                    if rotate_key:
                        (config / 'data.key').write_bytes(b'wrong key')
                    return
                if str(args[0]) != 'test/boot':
                    return
                context = json.loads((config / 'tests/context').read_text())
                self.assertEqual(context['timeout_seconds'], plan['timeout_seconds'])
                self.assertEqual(kwargs['env']['CONSOLE_TIMEOUT'], str(plan['timeout_seconds'] + 30))
                if update:
                    verify = context['phase'] == 'verify'
                    self.assertEqual((config / 'updated').exists(), verify)
                    self.assertEqual(updates, ['updated'] if verify else [])
                    disk = config.parent / 'data.img'
                    with disk.open('r+b') as data:
                        if verify:
                            self.assertEqual(data.read(9), b'kept data')
                        else:
                            data.write(b'kept data')
                records = []
                for driver in plan['drivers']:
                    records.extend(dict(event='case', suite=driver['name'], case=name,
                                        status='pass', **context) for name in driver['cases'][context['phase']])
                    records.append(dict(event='driver', suite=driver['name'], status='pass', **context))
                records.append(dict(event='complete', status='pass', **context))
                transcript = '\r\r\n'.join('werewolf-test: ' + json.dumps(r) for r in records) + '\r\r\n'
                transcript = transcript.replace('werewolf-test: {',
                    'werewolf-test: {[ 16.429304] audit: type=1302 denied\r\r\n', 1)
                if reformat and context['phase'] == 'verify':
                    transcript += 'werewolf: making LUKS2 on /dev/vda\n'
                Path(args[3]).write_bytes(transcript.encode())

            cwd = Path.cwd()
            try:
                os.chdir(root)
                with patch.object(native, 'boot_plan', return_value=plan), \
                        patch.object(native, 'call', side_effect=boot), \
                        patch.dict(os.environ, OUT=str(paths['image'].parent),
                                   PRODUCTION_OUT=str(paths['production_image'].parent),
                                   CHECK=str(root / 'check'), HOWL='howl',
                                   KERNEL=str(paths['kernel']), CMDLINE='test'):
                    if reformat or rotate_key:
                        with self.assertRaisesRegex(ValueError, 'data key' if rotate_key else 'reformatted'):
                            native.run('postgresql', 'x86_64', [])
                        self.assertFalse((root / 'check/postgresql-native/results.json').exists())
                        return
                    native.run('postgresql', 'x86_64', [])
                report = json.loads((root / 'check/postgresql-native/results.json').read_text())
                self.assertEqual([phase['cases'] for phase in report['phases']], [15, 14])
                if update:
                    self.assertEqual(report['verify_config'], native.digest(fixture))
            finally:
                os.chdir(cwd)

    def test_serial_carriage_returns_survive_until_console_cleaning(self):
        self.serial_run()

    def test_reformatting_cannot_pass_even_with_successful_case_records(self):
        self.serial_run(reformat=True)

    def test_update_fixture_runs_once_before_verify_on_the_same_data_disk(self):
        self.serial_run(update=True)

    def test_update_fixture_cannot_replace_the_data_key(self):
        self.serial_run(update=True, rotate_key=True)

    def test_concurrent_input_change_cannot_write_success_report(self):
        plan = native.read_plan('postgresql')
        for changed in ('kernel', 'image', 'production_image', 'plan', 'platform_plan',
                        'platform_driver', 'seed_config', 'verify_config'):
            with self.subTest(changed=changed), tempfile.TemporaryDirectory() as temp:
