class IterationInputs(unittest.TestCase):
    def test_reuses_driver_edits_but_refreshes_image_changes(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            generated = root / 'generated'
            plan = root / 'forms/example/test/native.json'
            driver = plan.with_name('driver.zig')
            library = root / 'lib/sandbox.zig'
            kernel = root / 'build/lock/kernel.lock.json'
            for path in (plan, driver, library, kernel, generated / 'form.yaml'):
                native.write(path, 'original')
            with patch.object(iteration, 'ROOT', root), \
                    patch.object(iteration, 'call', return_value=type('Dirs', (), {'stdout': 'forms/example\n'})()):
                fingerprint = lambda: iteration.fingerprint('example', plan, generated)
                original = fingerprint()
                driver.write_text('updated test client')
                self.assertEqual(original, fingerprint())
                for path in (library, kernel, plan):
                    path.write_text('updated image input')
                    self.assertNotEqual(original, fingerprint(), str(path))
                    path.write_text('original')
                mode = library.stat().st_mode & 0o7777
                library.chmod(mode ^ 0o100)
                self.assertNotEqual(original, fingerprint())

    def test_first_build_records_resolved_locks(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            work = root / 'work'
            machine = root / 'machine'
            generated = root / 'generated'
            lock = root / 'build/lock/kernel.lock.json'

            def build(argv, **kwargs):
                if argv[0] == 'howl':
                    native.write(lock, 'resolved kernel')
                return type('Dirs', (), {'stdout': ''})()

            with patch.object(iteration, 'ROOT', root), \
                    patch.object(iteration, 'call', side_effect=build), \
                    patch.object(iteration, 'running', return_value=False), \
                    patch.object(iteration, 'config_for', return_value=work / 'config'):
                plan = root / 'forms/example/test/native.json'
                before = iteration.fingerprint('example', plan, generated)
                state = iteration.ensure('howl', 'example', 'aarch64', work,
                                         generated, machine, before, False)
                after = iteration.fingerprint('example', plan, generated)
                self.assertNotEqual(before, after)
                self.assertEqual(after, state['fingerprint'])


class Protocol(unittest.TestCase):
    def test_console_completion_waits_for_the_whole_record(self):
        record = 'werewolf-test: {"event":"complete","run":"abc","phase":"seed","status":"pass"}'
        for ending in ('\n', '\r\n', '\r\r\n'):
            line = record + ending
            for end in range(len(line)):
                self.assertIsNone(re.search(native.COMPLETION, line[:end]))
            self.assertIsNotNone(re.search(native.COMPLETION, line))

    def setUp(self):
        self.plan = native.read_plan('postgresql')
        self.context = dict(run='a' * 32, phase='seed')
        self.records = []
        for d in self.plan['drivers']:
            self.records.extend(dict(event='case', suite=d['name'], case=name, status='pass', **self.context)
                                for name in d['cases']['seed'])
            self.records.append(dict(event='driver', suite=d['name'], status='pass', **self.context))
        self.records.append(dict(event='complete', status='pass', **self.context))

    def validate(self, records):
        return native.validate('other service: ready\n' + '\n'.join('werewolf-test: ' + json.dumps(r) for r in records),
                               self.plan, self.context)

    def test_complete(self):
        self.assertEqual(self.validate(self.records), 12)

    def test_kernel_interleaving_inside_and_after_json(self):
        lines = ['werewolf-test: ' + json.dumps(r) + '\r\n' for r in self.records]
        for index in (0, len(lines) - 1):
            for offset in (25, len(lines[index]) - 2):
                with self.subTest(index=index, offset=offset):
                    interrupted = list(lines)
                    line = interrupted[index]
                    interrupted[index] = line[:offset] + '[ 16.429304] audit: type=1302 denied\r\n' + line[offset:]
                    self.assertEqual(native.validate(''.join(interrupted), self.plan, self.context), 12)

    def test_non_kernel_trailing_data_still_fails(self):
        lines = ['werewolf-test: ' + json.dumps(r) for r in self.records]
        lines[0] += 'unexpected output'
        with self.assertRaises(ValueError):
            native.validate('\n'.join(lines), self.plan, self.context)

    def test_one_driver_iteration(self):
        name = 'test-postgres'
        records = [r for r in self.records if r.get('suite') == name or r.get('event') == 'complete']
        text = 'other service: ready\n' + '\n'.join('werewolf-test: ' + json.dumps(r) for r in records)
        self.assertEqual(native.validate(text, self.plan, self.context, only_driver=name), 6)
        with self.assertRaises(ValueError):
            native.validate(text, self.plan, self.context, only_driver='missing')

    def test_iteration_rejects_other_driver_records(self):
        name = 'test-postgres'
        records = [r for r in self.records if r.get('suite') == name or r.get('event') == 'complete']
        foreign = next(r for r in self.records if r.get('event') == 'driver' and r.get('suite') != name)
        records.insert(-1, foreign)
        text = '\n'.join('werewolf-test: ' + json.dumps(r) for r in records)
        with self.assertRaises(ValueError):
            native.validate(text, self.plan, self.context, only_driver=name)

    def test_missing_or_duplicate(self):
        for i in range(len(self.records)):
            with self.subTest(i=i):
                with self.assertRaises(ValueError):
                    self.validate(self.records[:i] + self.records[i + 1:])
                with self.assertRaises(ValueError):
                    self.validate(self.records[:i] + [self.records[i]] + self.records[i:])

    def test_failed_wrong_run_wrong_phase_unknown_case(self):
        for key, value in [('status', 'fail'), ('run', 'b' * 32), ('phase', 'verify'), ('case', 'invented')]:
            with self.subTest(key=key):
                records = copy.deepcopy(self.records)
                records[0][key] = value
                with self.assertRaises(ValueError):
                    self.validate(records)

    def test_driver_failure_is_not_hidden_by_passed_assertions(self):
        records = copy.deepcopy(self.records)
        records[-2]['status'] = 'fail'
        with self.assertRaises(ValueError):
            self.validate(records)

    def test_no_completion_or_completion_without_assertions(self):
        for records in ([], self.records[:-1], self.records[-1:], self.records + self.records[:1]):
            with self.assertRaises(ValueError):
                self.validate(records)

    def test_malformed_record(self):
        for raw in ('{', 'x' * 4097, 'null', '[]'):
            with self.subTest(raw=raw[:30]):
                with self.assertRaises(ValueError):
                    native.validate('werewolf-test: ' + raw, self.plan, self.context)


class Plans(unittest.TestCase):
    def test_generated_form_preserves_real_check_budget_and_weaknesses(self):
        with tempfile.TemporaryDirectory() as temp:
            generated = Path(temp) / 'native-test-greenbone'
            native.write(generated / 'form.yaml', native.form_config('greenbone', native.read_plan('greenbone')))
            for verb, rest in [('check', ['memory']), ('weaknesses', [])]:
                expected = native.call('build/host/form', verb, 'greenbone', *rest, capture_output=True).stdout
                actual = native.call('build/host/form', verb, generated, *rest, capture_output=True).stdout
                self.assertEqual(actual, expected)

    def test_greenbone_keeps_legacy_and_uses_existing_oci_accounts(self):
        plan = native.read_plan('greenbone')
        self.assertTrue(plan['legacy'])
        self.assertEqual(plan['packages'], ['postgresql-17-client'])
        self.assertEqual(next(d for d in plan['drivers'] if d['mode'] == 'manager')['user'], '_oci-gvmd')

    def test_config_cannot_replace_context_or_read_arbitrary_host_files(self):
        original = native.read_plan('greenbone')
        for config in ({'context': '/run/config/gvmd/admin-password'},
                       {'password': '/etc/shadow'}, {'password': '/run/config/../secret'},
                       {'password\nrun': '/run/config/gvmd/admin-password'}):
            plan = copy.deepcopy(original)
            plan['drivers'][0]['config'] = config
            with patch.object(Path, 'read_text', return_value=json.dumps(plan)):
                with self.assertRaises(ValueError):
                    native.read_plan('greenbone')

    def test_root_driver_and_invalid_legacy_flag_refused(self):
        for change in ('root', 'legacy'):
            plan = native.read_plan('greenbone')
            if change == 'root':
                plan['drivers'][0]['user'] = 'root'
            else:
                plan['legacy'] = 'false'
            with patch.object(Path, 'read_text', return_value=json.dumps(plan)):
                with self.assertRaises(ValueError):
                    native.read_plan('greenbone')

    def test_test_groups_are_explicit_named_non_root_groups(self):
        for groups in ('_oci-openvas', ['root'], ['_oci-openvas', '_oci-openvas'], [['nested']], ['bad\ngroup']):
            plan = native.read_plan('greenbone')
            plan['drivers'][0]['groups'] = groups
            with patch.object(Path, 'read_text', return_value=json.dumps(plan)):
                with self.assertRaises(ValueError):
                    native.read_plan('greenbone')

    def test_tcp_grants_are_single_valid_ports(self):
        for port in ('tcp/0', 'tcp/65536', 'tcp/any', 'tcp/443 public', 'udp/53'):
            plan = native.read_plan('greenbone')
            plan['drivers'][0]['connect'] = [port]
            with patch.object(Path, 'read_text', return_value=json.dumps(plan)):
                with self.assertRaises(ValueError):
                    native.read_plan('greenbone')


class Payload(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.base = self.root / 'base'
        self.test = self.root / 'native-test-base'
        for root in (self.base, self.test):
            for name in ('etc/sv/postgres/service', 'etc/werewolf/allow/jit',
                         'usr/share/werewolf/etc/passwd', 'usr/share/werewolf/etc/group'):
                native.write(root / 'ro' / name, name + '\n')
            for name in ('pledge', 'net', 'weaknesses'):
                native.write(root / 'meta/usr/share/werewolf' / name, name + '\n')
            self.archive(root / 'rootfs.tar', {'usr/bin/postgres': b'production database'})
            self.archive(root / 'overlay.tar', {'usr/lib/werewolf/init': b'production init'})

    def archive(self, path, files):
        with tarfile.open(path, 'w') as archive:
            for name, data in files.items():
                info = tarfile.TarInfo(name)
                info.size = len(data)
                archive.addfile(info, io.BytesIO(data))

    def compare(self, **env):
        plan = native.read_plan('postgresql')
        with patch.dict(os.environ, BUILD=str(self.root), **env), contextlib.redirect_stdout(io.StringIO()), \
                patch.object(native, 'read_plan', return_value=plan):
            native.compare('base', 'aarch64')

    def test_client_addition(self):
        self.archive(self.test / 'rootfs.tar', {'usr/bin/postgres': b'production database', 'usr/bin/psql': b'client'})
        self.compare()

    def test_explicit_ipe_variant_paths(self):
        before, after = self.root / 'base-ipe', self.root / 'native-test-base-ipe'
        self.base.rename(before)
        self.test.rename(after)
        self.compare(PRODUCTION_OUT=str(before), TEST_OUT=str(after))
        (after / 'ro/etc/sv/postgres/service').write_text('weakened')
        with self.assertRaisesRegex(ValueError, 'production etc/sv'):
            self.compare(PRODUCTION_OUT=str(before), TEST_OUT=str(after))

    def test_replaced_runtime_or_overlay_refused(self):
        for archive, files in [('rootfs.tar', {'usr/bin/postgres': b'changed server'}),
                               ('overlay.tar', {'usr/lib/werewolf/init': b'changed init'})]:
            with self.subTest(archive=archive):
                original = (self.test / archive).read_bytes()
                self.archive(self.test / archive, files)
                with self.assertRaises(ValueError):
                    self.compare()
                (self.test / archive).write_bytes(original)

    def test_service_or_identity_or_seal_change_refused(self):
        for name in ('ro/etc/sv/postgres/service', 'ro/usr/share/werewolf/etc/passwd',
                     'meta/usr/share/werewolf/pledge'):
            with self.subTest(name=name):
                path = self.test / name
                original = path.read_bytes()
                path.write_bytes(b'weakened')
                with self.assertRaises(ValueError):
                    self.compare()
                path.write_bytes(original)

    def test_shell_addition_refused(self):
        for shell in ('bin/sh', 'bin/ash', 'usr/bin/dash', 'usr/bin/busybox'):
            with self.subTest(shell=shell):
                self.archive(self.test / 'rootfs.tar', {'usr/bin/postgres': b'production database', shell: b'shell'})
                with self.assertRaises(ValueError):
                    self.compare()

    def test_added_runtime_configuration_refused(self):
        self.archive(self.test / 'overlay.tar', {
            'usr/lib/werewolf/init': b'production init',
            'etc/postgresql/conf.d/test.conf': b'changed behavior without replacing a file',
        })
        with self.assertRaisesRegex(ValueError, 'added runtime overlay'):
            self.compare()

    def test_owner_and_directory_permissions_preserved(self):
        def archive(path, uid, mode):
            with tarfile.open(path, 'w') as output:
                directory = tarfile.TarInfo('usr')
                directory.type = tarfile.DIRTYPE
                directory.mode = mode
                output.addfile(directory)
                executable = tarfile.TarInfo('usr/bin/postgres')
                executable.uid = uid
                executable.size = 1
                output.addfile(executable, io.BytesIO(b'x'))
        archive(self.base / 'rootfs.tar', 0, 0o755)
        for uid, mode in ((123, 0o755), (0, 0o777)):
            with self.subTest(uid=uid, mode=mode):
                archive(self.test / 'rootfs.tar', uid, mode)
                with self.assertRaises(ValueError):
                    self.compare()


class RunIdentity(unittest.TestCase):
    def test_concurrent_input_change_cannot_write_success_report(self):
        plan = native.read_plan('postgresql')
        for changed in ('kernel', 'image', 'production_image', 'plan'):
            with self.subTest(changed=changed), tempfile.TemporaryDirectory() as temp:
                root = Path(temp)
                images = root / 'build'
                paths = dict(kernel=images / 'vmlinuz',
                             image=images / 'native-test-postgresql/initramfs.zst',
                             production_image=images / 'postgresql-ipe/initramfs.zst',
                             plan=root / 'forms/postgresql/test/native.json')
                for path in paths.values():
                    native.write(path, 'original')

                def boot(*args, **kwargs):
                    if str(args[0]) == 'test/boot':
                        paths[changed].write_text('replaced during boot')

                cwd = Path.cwd()
                try:
                    os.chdir(root)
                    with patch.object(native, 'read_plan', return_value=plan), \
                            patch.object(native, 'call', side_effect=boot), \
                            patch.dict(os.environ, OUT=str(paths['image'].parent),
                                       PRODUCTION_OUT=str(paths['production_image'].parent),
                                       CHECK=str(root / 'check'), HOWL='howl',
                                       KERNEL=str(paths['kernel']), CMDLINE='test'):
                        with self.assertRaisesRegex(ValueError, 'inputs changed'):
                            native.run('postgresql', 'aarch64', [])
                    self.assertFalse((root / 'check/postgresql-native/results.json').exists())
                finally:
                    os.chdir(cwd)


