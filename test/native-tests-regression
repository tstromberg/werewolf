    def test_boot_checks_and_restart_follow_declared_readiness(self):
        application = native.read_plan('gatus')
        ready = copy.deepcopy(application['drivers'][0])
        ready.update(name='test-ready', readiness=True, cases={'seed': ['ready'], 'verify': ['ready']})
        application['drivers'].insert(0, ready)
        with patch.object(native, 'read_plan', return_value=application): plan = native.boot_plan('gatus')
        self.assertEqual([driver['name'] for driver in plan['drivers']],
                         ['test-ready', 'test-platform', 'test-lifecycle', 'test-gatus'])
        self.assertEqual(plan['drivers'][1]['cases'], native.boot_plan('gatus')['drivers'][0]['cases'])
        context = dict(run='a' * 32, phase='seed')
        def transcript(drivers):
            records = []
            for driver in drivers:
                records.extend(dict(event='case', suite=driver['name'], case=case,
                                    status='pass', **context) for case in driver['cases']['seed'])
                records.append(dict(event='driver', suite=driver['name'], status='pass', **context))
            records.append(dict(event='complete', status='pass', **context))
            return '\n'.join('werewolf-test: ' + json.dumps(record) for record in records)
        native.validate(transcript(plan['drivers']), plan, context)
        with self.assertRaisesRegex(ValueError, 'out of order'):
            native.validate(transcript([plan['drivers'][1], plan['drivers'][0],
                                        plan['drivers'][2], plan['drivers'][3]]), plan, context)
        with self.assertRaisesRegex(ValueError, 'out of order'):
            native.validate(transcript([plan['drivers'][0], plan['drivers'][2],
                                        plan['drivers'][1], plan['drivers'][3]]), plan, context)

    def test_reboot_does_not_claim_seed_only_lifecycle_checks(self):
        plan = native.boot_plan('gatus')
        context = dict(run='a' * 32, phase='verify')
        records = []
        for driver in plan['drivers']:
            if not driver['cases']['verify']: continue
            records.extend(dict(event='case', suite=driver['name'], case=case,
                                status='pass', **context) for case in driver['cases']['verify'])
            records.append(dict(event='driver', suite=driver['name'], status='pass', **context))
        records.append(dict(event='complete', status='pass', **context))
        native.validate('\n'.join('werewolf-test: ' + json.dumps(record) for record in records), plan, context)


