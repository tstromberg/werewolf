class PlatformPlan(unittest.TestCase):
    def test_retained_shell_checks_cannot_be_silently_disabled(self):
        plan = native.read_plan('gatus')
        self.assertFalse(plan['legacy'])
        for filename in ('checks', 'checks-again'):
            with tempfile.TemporaryDirectory() as temporary:
                root = Path(temporary)
                (root / filename).write_text('ok retained true\n')
                with patch.object(native, 'plan_path', return_value=root / 'tests.yaml'), \
                        patch('probe_plan.load', return_value=copy.deepcopy(plan)):
                    self.assertTrue(native.read_plan('gatus')['legacy'])

    def test_foundation_iteration_refuses_before_creating_a_vm(self):
        with patch.object(iteration, 'local_arch', return_value='aarch64'), \
                patch.object(iteration.sys, 'argv', ['native-iterate', 'howl', 'minimal', 'aarch64', 'ensure', 'seed']), \
                patch.object(iteration, 'ensure') as start:
            with self.assertRaisesRegex(ValueError, 'shared boot checks'): iteration.main()
