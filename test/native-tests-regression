class ConsoleTransport(unittest.TestCase):
    def boot(self, poweroff, fragment=False, console_timeout=300):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            qemu = root / 'qemu'
            qemu.write_text('''#!/usr/bin/env python3
import os, select, sys, time, tty
if '--version' in sys.argv:
    print('fake QEMU for console transport regression')
    sys.exit(0)
tty.setraw(0)
def send(data):
    os.write(1, data)
def until(ending):
    data = b''
    while not data.endswith(ending):
        part = os.read(0, 1)
        if not part:
            sys.exit(1)
        data += part
    return data
send(b'handing over to runit\\nposture: fail= pass=100 skip=0 COMPLETE\\n')
if sys.argv[2] not in ('whole', 'missing'):
    if sys.argv[2] == 'fragment': time.sleep(.2)
    send(b'werewolf-test: {"event":"complete","status":"pass"}\\r')
    time.sleep(.2)
    assert not select.select([0], [], [], 0)[0], 'host advanced before the newline'
    send(b'\\r\\n')
until(b'\\x01c')
send(b'(qemu) ')
assert until(b'\\r') == b'system_powerdown\\r'
send(b'(qemu) ')
until(b'\\x01c')
send(b'power button on\\r')
time.sleep(.01)
# Serial devices can split a UTF-8 character across reads. On macOS,
# Expect's text decoder mistakes a partial character for EOF and sends HUP.
for _ in range(30):
    for byte in b'\\xe2\\x96\\xa1':
        send(bytes([byte]))
        time.sleep(.001)
if sys.argv[1] == 'poweroff':
    send(b'\\nreboot: Power down\\n')
time.sleep(.01)
''')
            qemu.chmod(0o700)
            checks = root / 'checks'
            checks.write_text('seen complete ' + (native.COMPLETION if fragment else 'COMPLETE') + '\n')
            log = root / 'console.log'
            env = dict(os.environ, POSTURE_KNOWN='', SSH_PORT='', GITEA_PORT='',
                       CONSOLE_TIMEOUT=str(console_timeout))
            result = subprocess.run(['test/boot', 'serial-utf8', str(checks), str(log),
                                     str(qemu), 'poweroff' if poweroff else 'exit',
                                     'fragment' if fragment is True else fragment or 'whole'],
                                    env=env, capture_output=True, timeout=10)
            return result, log.read_bytes()

    def test_completion_fragment_does_not_gain_a_synthetic_newline(self):
        for mode in ('fragment', 'immediate'):
            with self.subTest(mode=mode):
                result, log = self.boot(True, fragment=mode)
                self.assertEqual(result.returncode, 0, result.stdout.decode(errors='replace'))
                records = [line.split('werewolf-test: ', 1)[1]
                           for line in native.console_clean(log).decode().splitlines()
                           if 'werewolf-test: ' in line]
                self.assertEqual([json.loads(line) for line in records],
                                 [dict(event='complete', status='pass')])

    def test_fragmented_utf8_survives_until_real_poweroff(self):
        result, log = self.boot(True)
        self.assertEqual(result.returncode, 0, (result.stdout + result.stderr).decode(errors='replace'))
        self.assertIn(b'\xe2\x96\xa1' * 30, log)
        self.assertIn(b'reboot: Power down', log)

    def test_console_collection_obeys_the_explicit_budget(self):
        result, log = self.boot(True, fragment='missing', console_timeout=1)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'FAIL', result.stdout)
        self.assertIn(b'complete', result.stdout)
        self.assertIn(b'reboot: Power down', log)

    def test_successful_exit_without_poweroff_is_still_rejected(self):
        result, _ = self.boot(False)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(b'QEMU ended without the kernel powering off', result.stdout)


class RepeatedChecks(unittest.TestCase):
    def test_keeps_native_failure_logs_before_the_next_run(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            command = root / 'run'
            command.write_text("""#!/bin/sh
n=$(cat "$1/count" 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" >"$1/count"
if [ "$n" -eq 3 ]; then echo "build failed"; exit 1; fi
mkdir -p "$1/sample-native"
echo "seed $n" >"$1/sample-native/seed.log"
echo "verify $n" >"$1/sample-native/verify.log"
echo "result $n"
[ "$n" -ne 1 ]
""")
            command.chmod(0o700)
            result = subprocess.run(['test/check-one', '3', str(root), 'sample',
                                     str(command), str(root)], capture_output=True, text=True)
            self.assertEqual(result.returncode, 1)
            self.assertIn('2 of 3 boots failed', result.stdout)
            self.assertEqual((root / 'count').read_text(), '3\n')
            self.assertEqual((root / 'sample-one-1.out').read_text(), 'result 1\n')
            for phase in ('seed', 'verify'):
                self.assertEqual((root / 'sample-one-1' / (phase + '.log')).read_text(),
                                 phase + ' 1\n')
                self.assertFalse((root / 'sample-one-3' / (phase + '.log')).exists())


