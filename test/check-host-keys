#!/usr/bin/env python3
"""Kernel interleaving must not change persistent SSH fingerprint comparisons."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

for changed in (False, True):
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        (root / 'test').mkdir()
        (root / 'form/test').mkdir(parents=True)
        (root / 'check').mkdir()
        for name in ('check-form', 'cloud-console'):
            shutil.copyfile('test/' + name, root / 'test' / name)
        for name in ('checks', 'checks-again'):
            (root / 'test' / name).touch()
        howl = root / 'howl'
        howl.write_text('#!/bin/sh\nexit 0\n')
        howl.chmod(0o700)
        boot = root / 'test/boot'
        boot.write_text('''#!/usr/bin/env python3
import os,sys
from pathlib import Path
fingerprint='abc123'
if sys.argv[1].endswith('-again'):
    fingerprint='changed' if os.environ['CHANGED']=='1' else 'abc[    1.551356] audit: denied\\r\\n123'
record='{"event":"host-key","key":"/run/svc/sshd/host-key","fingerprint":"SHA256:'+fingerprint+'","detail":"kept in /data"}\\n'
Path(sys.argv[3]).write_text(record)
''')
        boot.chmod(0o700)
        env = dict(os.environ, FORM='fixture', FORM_REF='fixture', FORM_DIR=str(root / 'form'),
                   CHECK=str(root / 'check'), HOWL=str(howl), AGAIN='1', SSH_PORT='',
                   CMDLINE='', KERNEL='/unused', OUT='/unused', CHANGED=str(int(changed)))
        result = subprocess.run(['sh', 'test/check-form', 'unused-qemu'], cwd=root, env=env,
                                capture_output=True, text=True, timeout=15)
        assert (result.returncode != 0) == changed, result.stdout + result.stderr
        if changed:
            assert 'host key not kept' in result.stdout, result.stdout + result.stderr
print('check-host-keys: interleaving preserves fingerprints; changed keys still fail')
