#!/usr/bin/env python3
"""Exercise the real host protocol, reply correlation and QEMU storage faults."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import platform
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader('owner_client', 'tools/owner-control')
spec = importlib.util.spec_from_loader(loader.name, loader)
owner = importlib.util.module_from_spec(spec)
loader.exec_module(owner)
from owner_qmp import StorageFault, command
HOWL = str(Path(sys.argv.pop(1) if len(sys.argv) > 1 else 'build/host/howl').resolve())


class OwnerControl(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='ww-owner-test-', dir='/tmp')
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)

    def server(self, respond):
        path = self.root / 'owner.sock'
        listener = socket.socket(socket.AF_UNIX)
        listener.bind(str(path))
        listener.listen(1)
        self.addCleanup(listener.close)
        failures = []
        def serve():
            try:
                connection, _ = listener.accept()
                with connection:
                    packet = bytearray()
                    while not packet.endswith(b'\n'):
                        packet.extend(connection.recv(128))
                    identity, operation = packet.decode().strip().split(' ', 1)
                    respond(connection, identity, operation)
            except Exception as error:
                failures.append(error)
        thread = threading.Thread(target=serve, daemon=True)
        thread.start()
        self.addCleanup(thread.join, 5)
        return path, failures

    def test_only_the_matching_response_can_complete_an_operation(self):
        def respond(connection, identity, operation):
            self.assertEqual('status', operation)
            for item in (b'partial old frame\n',
                         json.dumps(dict(id='0' * 16, ok=True)).encode() + b'\n',
                         json.dumps(dict(id=identity, ok=True, format='werewolf-owner-status/1')).encode() + b'\n'):
                connection.sendall(item)
        path, failures = self.server(respond)
        self.assertEqual('werewolf-owner-status/1', owner.request(path, 'status', 5)['format'])
        self.assertEqual([], failures)

    def test_refusal_and_nonboolean_success_are_errors(self):
        for flag in (False, 1):
            with self.subTest(flag=flag):
                path, failures = self.server(lambda connection, identity, _: connection.sendall(
                    json.dumps(dict(id=identity, ok=flag, error='ImageRolledBack')).encode() + b'\n'))
                with self.assertRaisesRegex(ValueError, 'ImageRolledBack'):
                    owner.request(path, 'try', 5)
                self.assertEqual([], failures)
                path.unlink()

    def test_commands_cannot_select_paths_or_shell_commands(self):
        with patch.object(owner.socket, 'socket') as connect:
            for operation in ('sh', 'try /data/file', 'status extra', 'check\ntry',
                              'try ' + 'g' * 64, 'try ' + 'a' * 65):
                with self.assertRaises(ValueError):
                    owner.request(self.root / 'missing', operation)
            connect.assert_not_called()

    def test_response_limit_and_disconnect_fail_closed(self):
        path, failures = self.server(lambda connection, *_: connection.sendall(b'x' * (owner.LIMIT + 1)))
        with self.assertRaisesRegex(ValueError, 'oversized'):
            owner.request(path, 'status', 5)
        self.assertEqual([], failures)

    def test_killing_the_cli_closes_its_connection_without_an_orphan_helper(self):
        machine = self.root / 'build/machines/werewolf-run'
        machine.mkdir(parents=True)
        listener = socket.socket(socket.AF_UNIX)
        listener.bind(str(machine / 'owner.sock'))
        listener.listen(1)
        connected, closed = threading.Event(), threading.Event()
        def serve():
            connection, _ = listener.accept()
            with connection:
                connection.settimeout(5)
                connection.recv(128)
                connected.set()
                if connection.recv(1) == b'':
                    closed.set()
        thread = threading.Thread(target=serve, daemon=True)
        thread.start()
        process = subprocess.Popen([HOWL, 'owner', 'status'], cwd=self.root,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            self.assertTrue(connected.wait(5))
            process.kill()
            process.wait(timeout=5)
            self.assertTrue(closed.wait(3), 'an orphan helper retained the owner socket')
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
            listener.close()
            thread.join(6)

    def test_qemu_fault_returns_write_errors_and_restores_the_same_disk(self):
        arch = {'arm64': 'aarch64', 'amd64': 'x86_64'}.get(platform.machine(), platform.machine())
        qemu = shutil.which('qemu-system-' + arch)
        self.assertIsNotNone(qemu)
        disk, qmp = self.root / 'disk.raw', self.root / 'qmp'
        disk.write_bytes(bytes(1 << 20))
        with (self.root / 'qemu.log').open('wb') as log:
            process = subprocess.Popen([qemu, '-M', 'none', '-display', 'none', '-qmp',
                'unix:' + str(qmp) + ',server=on,wait=off', '-drive',
                'file=' + str(disk) + ',format=raw,if=none,node-name=disk-root'],
                stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
            try:
                for _ in range(100):
                    if qmp.exists() or process.poll() is not None:
                        break
                    time.sleep(.05)
                fault = StorageFault(qmp, disk)
                command(qmp, 'human-monitor-command', {'command-line': 'qemu-io disk-root "write -P 0x5a 0 512"'})
                self.assertEqual(bytes(512), disk.read_bytes()[:512])
                fault.restore()
                command(qmp, 'human-monitor-command', {'command-line': 'qemu-io disk-root "write -P 0xa5 0 512"'})
                self.assertEqual(bytes([0xa5]) * 512, disk.read_bytes()[:512])
            finally:
                if process.poll() is None:
                    command(qmp, 'quit')
                process.wait(timeout=10)
        self.assertIn('Input/output error', (self.root / 'qemu.log').read_text())


if __name__ == '__main__':
    unittest.main()
