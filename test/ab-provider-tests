#!/usr/bin/env python3
"""Failure paths must clean owned resources and leave other VMs alone."""
import subprocess
import tempfile
from pathlib import Path
from unittest.mock import patch
from ab_providers import Provider
import ab_build

with tempfile.TemporaryDirectory(prefix='ww-ab-unit-') as temporary:
    root = Path(temporary)
    public = root / 'ssh.pub'
    public.write_text('ssh-ed25519 disposable-fixture\n')
    fixture = {'ssh_key': str(root / 'ssh'), 'kernel': 'kernel', 'key': 'signer',
               'cert': 'public', 'channel': 'https://127.0.0.1/image',
               'initial_serial': '20261012T000000Z', 'mode': 'plain', 'arch': 'x86_64'}

    inputs = ['howl', root / 'form', 'x86_64', 'kernel', 'ipe.key', 'ipe.crt',
              root / 'fixture-build', 'https://127.0.0.1/image', '20261012T000000Z']
    protected, output = ab_build.arguments(*inputs, 'boot.key', 'boot.crt', 'permit.pub')
    assert protected[1] == '_build' and protected[-2:] == ['prebuilt', 'qcow2']
    assert '--boot-native' in protected and '--tpm-pub' in protected
    assert not any(flag.startswith('--disable') for flag in protected)
    secure, _ = ab_build.arguments(*inputs, 'boot.key', 'boot.crt')
    assert '--disable=tpm' in secure
    plain, _ = ab_build.arguments(*inputs)
    assert '--disable=secureboot,tpm' in plain
    native, app_output = ab_build.arguments(
        *inputs, 'boot.key', 'boot.crt', app=root / 'app', goals=('prebuilt', 'disk'),
        disk_args='werewolf.ip=10.0.2.15/24')
    assert '--disable=tpm' in native and '--boot-native' in native
    assert native[-2:] == ['prebuilt', 'disk'] and app_output.name == 'form-app-ipe'
    assert native[native.index('--disk-args') + 1] == 'werewolf.ip=10.0.2.15/24'
    (output / 'slot').mkdir(parents=True)
    for name in ['vmlinuz', 'stage0.zst', 'root.erofs', 'cmdline', 'uki.efi']:
        (output / 'slot' / name).write_bytes(b'public artifact')
    (output / 'disk.qcow2').write_bytes(b'public disk')
    (output / 'boot.key').write_bytes(b'private signing key')
    destination = root / 'export'
    ab_build.export(output, root / 'form', 'x86_64', destination)
    assert len(list(destination.iterdir())) == 6
    assert all(b'private signing key' not in path.read_bytes() for path in destination.iterdir())

    for arch in ('x86_64', 'aarch64'):
        work = root / ('bhyve-' + arch)
        work.mkdir()
        vm = Provider('bhyve', dict(fixture, arch=arch, disk='fixture.qcow2'), work, 'howl')
        launches = []

        def fake_run(args, **kwargs):
            if 'input' in kwargs:
                launches.append(kwargs['input'])
            return subprocess.CompletedProcess(args, 0, '123\n', '')

        vm.run = fake_run
        vm.remote_command = lambda *args, **kwargs: subprocess.CompletedProcess(
            [], 0, '/tmp/ww-ab.unit\n', '')
        vm.start_remote()
        launch = launches[0]
        assert '3,virtio-blk,/tmp/ww-ab.unit/disk.img' in launch
        assert '4,virtio-blk,/tmp/ww-ab.unit/config.tar,ro' in launch
        if arch == 'aarch64':
            assert '-o console=stdio' in launch and 'u-boot-bhyve-arm64/u-boot.bin' in launch
            assert '1,lpc' not in launch and '-H' not in launch and '-l com1' not in launch
        else:
            assert '-H -w -u' in launch and '1,lpc' in launch and '-l com1,stdio' in launch
        vm.fixture['mode'], vm.fixture['arch'] = 'secure', 'aarch64'
        try:
            vm.start_remote()
        except RuntimeError as error:
            assert 'arm64 bhyve Secure Boot' in str(error)
        else:
            raise AssertionError('accepted unsupported ARM64 Secure Boot')

    def machine(kind, suffix):
        work = root / suffix
        work.mkdir()
        return Provider(kind, fixture, work, 'howl')

    disk = root / 'fixture-disk'
    disk.write_bytes(b'fixture')
    for arch in ('x86_64', 'aarch64'):
        qemu = machine('qemu', 'qemu-' + arch)
        qemu.fixture = dict(fixture, arch=arch, mode='secure', disk=str(disk))

        def enroll(directory):
            directory.mkdir()
            (directory / 'vars.fd').write_bytes(b'variables')

        qemu.enroll = enroll
        with patch('ab_providers.port', return_value=23456), \
                patch('ab_providers.subprocess.Popen') as launch:
            qemu.start_qemu()
        args = launch.call_args.args[0]
        assert args[args.index('virtio-rng-pci') - 1] == '-device'

    with patch.dict('os.environ', {'BHYVE_BINARY': '/var/tmp/rtc-test/bhyve',
                                  'BHYVE_ARM64_FIRMWARE': '/var/tmp/firmware-test/u-boot.bin',
                                  'BHYVE_TAP': 'tap7',
                                  'BHYVE_TEST_IP': '192.0.2.2/30',
                                  'BHYVE_TEST_GW': '192.0.2.1'}):
        tap = machine('bhyve', 'bhyve-tap')
    launches = []
    tap.run = fake_run
    tap.remote_command = lambda *args, **kwargs: subprocess.CompletedProcess(
        [], 0, '/tmp/ww-ab.unit\n', '')
    tap.fixture = dict(fixture, disk='fixture.qcow2', arch='aarch64')
    tap.start_remote()
    assert '/var/tmp/rtc-test/bhyve' in launches[0]
    assert 'bootrom=/var/tmp/firmware-test/u-boot.bin' in launches[0]
    assert '2,virtio-net,tap7' in launches[0] and 'hostfwd=' not in launches[0]
    assert '192.0.2.2:22' in tap.proxy
    assert (tap.config / 'network').read_text() == (
        'werewolf.ip=192.0.2.2/30 werewolf.gw=192.0.2.1 werewolf.dns=192.0.2.1\n')
    calls = []
    tap.console = lambda: ''
    tap.remote_command = lambda args, **kwargs: calls.append(args)
    tap.stop()
    assert not any('ifconfig' in args for args in calls), 'caller owns TAP cleanup'
    with patch.dict('os.environ', {'BHYVE_LAUNCH': 'howl', 'BHYVE_BRIDGE': 'bridge7',
                                  'BHYVE_TEST_IP': '192.0.2.2/30',
                                  'BHYVE_TEST_GW': '192.0.2.1'}):
        normal = machine('bhyve', 'bhyve-normal')
    normal.remote, normal.remote_dir = 'test-host', '/tmp/ww-ab.normal'
    calls = []
    normal.run = lambda args, **kwargs: subprocess.CompletedProcess(args, 0, '', '')
    normal.remote_command = lambda args, **kwargs: calls.append(args)
    normal.start_bhyve_howl()
    assert normal.bhyve_machine.endswith('/build/machines/' + normal.name)
    launch = calls[-1][-1]
    assert './howl-freebsd create ' in launch and '--bridge bridge7' in launch
    assert '_bhyve' not in launch and 'BHYVE_BINARY=bhyve' not in launch
    assert '192.0.2.2:22' in normal.proxy
    normal.console = lambda: ''
    normal.stop()
    assert any('./howl-freebsd delete ' in str(args) for args in calls)
    assert not any('bhyvectl' in args for args in calls), 'normal launch uses normal cleanup'
    calls.clear()
    normal.remote_howl = lambda *args: (_ for _ in ()).throw(RuntimeError('stop failed'))
    try:
        normal.stop()
    except RuntimeError as error:
        assert 'retained /tmp/ww-ab.normal' in str(error)
    else:
        raise AssertionError('lost failed normal-launch cleanup')
    assert not any('rm' in args for args in calls), 'retain disk when normal cleanup fails'
    for number, env in enumerate([{'BHYVE_TAP': 'tap7,slirp'},
                                 {'BHYVE_BINARY': 'relative/bhyve'},
                                 {'BHYVE_ARM64_FIRMWARE': 'relative/u-boot.bin'},
                                 {'BHYVE_ARM64_FIRMWARE': '/firmware,extra'},
                                 {'BHYVE_ARM64_FIRMWARE': '/firmware\nextra'}]):
        with patch.dict('os.environ', env):
            try:
                machine('bhyve', 'bhyve-invalid-' + str(number))
            except RuntimeError:
                pass
            else:
                raise AssertionError('accepted invalid bhyve override')

    cloud = machine('gcp', 'cloud')
    cloud.cloud_created, cloud.image = True, 'owned-image'
    calls = []
    cloud.console = lambda: ''

    def failed_delete(args, **kwargs):
        calls.append(args)
        raise RuntimeError('injected instance deletion failure')

    cloud.run = failed_delete
    cloud.delete_image = lambda: calls.append(['delete-owned-image'])
    try:
        cloud.stop()
    except RuntimeError as error:
        assert 'injected instance deletion failure' in str(error)
    else:
        raise AssertionError('cleanup failure was swallowed')
    assert calls == [['howl', 'delete', cloud.name, '--on', 'gcp'], ['delete-owned-image']]

    remote = machine('firecracker', 'remote')
    remote.remote_command = lambda *args, **kwargs: subprocess.CompletedProcess([], 0, '/tmp/other-owner\n', '')
    try:
        remote.start_remote()
    except RuntimeError as error:
        assert 'invalid remote private directory' in str(error)
    else:
        raise AssertionError('accepted an unowned cleanup path')
    assert remote.remote_dir is None
    remote.stop()

    collision = machine('firecracker', 'tap-collision')
    collision.remote_dir, collision.tap = '/tmp/ww-ab.unit', 'existing-tap'
    collision.console = lambda: ''
    calls = []

    def owned_cleanup(args, **kwargs):
        calls.append(args)
        return subprocess.CompletedProcess(args, 0, '', '')

    collision.remote_command = owned_cleanup
    collision.stop()
    assert not any(args[2:5] == ['ip', 'link', 'delete'] for args in calls)
    assert calls[-1] == ['doas', '-n', 'rm', '-rf', '/tmp/ww-ab.unit']

    proxmox = machine('proxmox', 'proxmox')
    proxmox.vmid = '100'
    calls = []

    def other_vm(args, **kwargs):
        calls.append(args)
        return subprocess.CompletedProcess(args, 0, 'name: another-owner\n', '')

    proxmox.remote_command = other_vm
    try:
        proxmox.delete_proxmox()
    except RuntimeError as error:
        assert 'different owner/name' in str(error)
    else:
        raise AssertionError('accepted another owner’s VM for deletion')
    assert calls == [['qm', 'config', '100']]

print('pass   provider-ab cleanup: deletion failures, unowned paths and mismatched VM ownership')
