#!/bin/sh
# check-metadata QEMU... boots prod ten ways behind a stand-in metadata
# server (test/cloud-boot, make check-metadata): a good config on GCP, AWS,
# Hetzner and Azure taken, changed at the cloud and taken again, a hostile
# one refused whole, and no cloud, or Hyper-V that is not Azure, never
# asked. A boot that takes a config is judged inside by
# test/scenarios/metadata, which knows it by the hostname the config gives.
# arm64 guests have SMBIOS only under UEFI, so FIRMWARE, edk2, is needed
# there. QEMU... is the machine, without a network; make passes CHECK_ENV
# (Makefile), ARCH, FIRMWARE and PRODUCTION_OUT. METADATA_CASE selects the
# boots of one hostname, such as cloud-retired, or one boot by name.
set -u
[ "$ARCH" != aarch64 ] || [ -n "$FIRMWARE" ] ||
	{ echo "FAIL   metadata           no UEFI firmware for arm64 (edk2-aarch64-code.fd)"; exit 1; }
failed=0
selected=0
meta() { # meta PROVIDER PAYLOAD HOSTNAME QEMU...
	name=meta-$1-$(echo "$2" | tr '>@' '--') provider=$1 payload=$2 hostname=$3
	shift 3
	case ${METADATA_CASE:-$hostname} in "$hostname" | "$name") ;; *) return 0 ;; esac
	selected=$((selected + 1))
	test/cloud-boot "$name" "$provider" "$payload" "$hostname" "$FIRMWARE" "$@" || failed=1
}
meta gcp good cloud-check "$@"
meta aws good cloud-check "$@"
meta hetzner good cloud-check "$@"
meta azure good cloud-check "$@"
meta gcp hostile - "$@"
meta gcp "good>people@1" cloud-poll "$@"
meta gcp "people>people2@1" cloud-reapply "$@"
meta gcp "people>good@1" cloud-retired "$@"
meta none good - "$@"
meta hyperv good - "$@"
[ "$selected" -gt 0 ] || { echo "check-metadata: no case matches $METADATA_CASE" >&2; exit 2; }
exit $failed
