#!/usr/bin/env python3
"""Check published form dependencies and local recipe snapshots without network."""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
FORM = ROOT / 'build/host/form'
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / 'release'))
loader = importlib.machinery.SourceFileLoader('package_images_tested', str(ROOT / 'release/form-images'))
spec = importlib.util.spec_from_loader(loader.name, loader)
images = importlib.util.module_from_spec(spec)
loader.exec_module(images)


class Consumers(unittest.TestCase):
    def query(self, *args):
        return subprocess.check_output([str(FORM), *args], cwd=ROOT, text=True).splitlines()

    def test_built_in_recipes_stay_in_the_forms_tree(self):
        for declaration in sorted((ROOT / 'forms').glob('*/form.yaml')):
            with self.subTest(form=declaration.parent.name):
                for recipe in self.query('recipes', declaration.parent.name):
                    path = (ROOT / recipe).resolve()
                    self.assertTrue(path.is_relative_to(ROOT / 'forms'), recipe)
                    self.assertTrue(path.is_file(), recipe)

    def test_plex_and_pi_hole_publish_their_package_dependencies(self):
        packaged = self.query('packaged')
        for name, wanted in [('plex', {'musl-werewolf', 'plexmediaserver', 'caddy'}),
                             ('pi-hole', {'pihole-curl'})]:
            with self.subTest(form=name):
                self.assertEqual([], self.query('recipes', name))
                self.assertTrue(wanted <= set(self.query('list', name, 'packages')))
                self.assertTrue(wanted <= set(self.query('depends', name)))
                self.assertIn(name, packaged)

    def test_ci_does_not_require_a_sibling_package_checkout(self):
        for workflow in (ROOT / '.github/workflows').glob('*.yml'):
            with self.subTest(workflow=workflow.name):
                text = workflow.read_text()
                self.assertNotIn('tools/checkout-packages', text)
                self.assertNotIn('release/package-sources.json', text)
                self.assertNotIn('WEREWOLF_PACKAGES_REF', text)


class LocalRecipeSnapshots(unittest.TestCase):
    def test_patch_bytes_modes_and_removal_change_identity(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            recipe = root / 'recipe.yaml'
            recipe.write_text('package: original\n')
            patch = root / 'port.patch'
            patch.write_text('original patch\n')
            original = images.recipe_identity([str(recipe)])
            old = patch.stat()
            patch.write_text('modified patch\n')
            os.utime(patch, ns=(old.st_atime_ns, old.st_mtime_ns))
            changed = images.recipe_identity([str(recipe)])
            self.assertNotEqual(original, changed)
            patch.chmod(0o755)
            executable = images.recipe_identity([str(recipe)])
            self.assertNotEqual(changed, executable)
            patch.unlink()
            self.assertNotEqual(executable, images.recipe_identity([str(recipe)]))

    def test_missing_context_fails(self):
        with tempfile.TemporaryDirectory() as directory:
            with self.assertRaisesRegex(ValueError, 'missing recipe context'):
                images.recipe_identity([str(Path(directory) / 'missing/recipe.yaml')])


if __name__ == '__main__':
    unittest.main()
