# The demo's third boot, after its second lost its power
# (test/checks-persist-again): PostgreSQL recovers, keeps its cluster, and
# starts though the last boot's lock is left behind; the page finds both
# earlier boots' postures, so it has stored three or more.

seen    cluster-kept      pg-init: keeping the cluster in /data/svc/postgres/data
seen    three-boots-kept  status-page: \{"time":"[^"]*","event":"database","kept":"posture","boots":([3-9]|[1-9][0-9]+)[,}]
unseen  cluster-made      pg-init: making the cluster
unseen  cluster-gone      pg-init: the cluster in /data/svc/postgres/data is gone
unseen  data-lost         "error":"DataLost"
unseen  postgres-down     leash: \{"event":"down","service":"postgres"
ok  services-up      i=0; while sv status /etc/sv/* | grep -qE 'want up|^fail'; do i=$((i + 1)); [ $i -le 30 ] || break; sleep 1; done; sleep 2; ! sv status /etc/sv/* | grep -E 'want up|^fail'
