# People: init makes each an account from the config's users file.
ok  people-accounts  grep -q '^tom:x:654612137:654612137::/data/home/tom:/bin/ash$' /etc/passwd && grep -q '^ann:x:88825308:88825308::/data/home/ann:/bin/ash$' /etc/passwd && grep -q '^tom:\*:' /etc/shadow && grep -q '^tom:x:654612137:$' /etc/group
ok  people-homes     [ "$(stat -c '%u:%g:%a' /data/home/tom)" = 654612137:654612137:700 ] && [ "$(stat -c '%u:%g:%a' /data/home/ann)" = 88825308:88825308:700 ]
ok  people-keys      [ "$(stat -c '%u:%a' /run/werewolf/keys/tom)" = 654612137:600 ] && grep -q 'tom@yubikey$' /run/werewolf/keys/tom && grep -q 'ann@laptop$' /run/werewolf/keys/ann && ! grep -q ann@laptop /run/werewolf/keys/tom
ok  people-admin     grep -q 'tom@yubikey$' /run/werewolf/keys/root && ! grep -q 'ann@laptop' /run/werewolf/keys/root && [ "$(stat -c '%u:%a' /run/werewolf/keys/root)" = 0:600 ]
ok  people-ledger    [ "$(stat -c '%u:%g:%a' /data/.werewolf)" = 0:0:700 ] && [ "$(stat -c '%u:%g:%a' /data/.werewolf/identities)" = 0:0:600 ] && grep -qx 'p tom 654612137 654612137' /data/.werewolf/identities && grep -qx 'p ann 88825308 88825308' /data/.werewolf/identities
