#!/usr/bin/env python3
"""Issue a private machine's factory pair and two test retirement permits."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import struct
import sys

fixture_file, private, public, probe, uki = [Path(arg).resolve() for arg in sys.argv[1:]]
fixture = json.loads(fixture_file.read_text())
root = fixture_file.parent
destination = root / 'tpm'
destination.mkdir(mode=0o700)
os.umask(0o077)
machine = os.urandom(32)


def run(args):
    subprocess.run([str(arg) for arg in args], check=True, capture_output=True, timeout=60)


def sha(raw):
    return hashlib.sha256(raw).digest()


def anchor(raw):
    return sha(raw[48:80] + sha(raw))


ids, pcrs = {}, {}
for label, image in fixture['releases'].items():
    core = b'werewolf.release/2\0' + image['arch'].encode() + b'\0'
    for filename in ['root.erofs', 'vmlinuz', 'stage0.zst']:
        core += bytes.fromhex(image['files'][filename]['sha256'])
    core += bytes.fromhex(image['boot_context'])
    ids[label] = sha(core)
    binary = next((root / ('release-' + label)).glob('*-uki'))
    run([uki, '--pcr11', binary, destination / (label + '.pcr')])
    pcrs[label] = (destination / (label + '.pcr')).read_bytes()
    (destination / (label + '.id')).write_bytes(ids[label])
states = {}
for label, previous, retained, candidate in [('aa', None, 'A', 'A'), ('ab', 'aa', 'A', 'B'),
                                           ('bc', 'ab', 'B', 'bad')]:
    before = anchor(states[previous]) if previous else bytes(32)
    raw = b'werewolf.boot/2\0' + machine + before + ids[retained] + ids[candidate] + pcrs[retained]
    states[label] = raw
    state = destination / (label + '.state')
    state.write_bytes(raw)
    if previous:
        run([probe, 'transition', destination / (previous + '.state'), state,
             destination / (retained + '.id'), destination / (retained + '.pcr')])
    message = destination / (label + '.message')
    signature = destination / (label + '.sig')
    run([probe, 'permit-pair', public, state, message])
    run(['openssl', 'dgst', '-sha256', '-sign', private, '-out', signature, message])
    bundle = raw + signature.read_bytes()
    (destination / (label + '.permit')).write_bytes(bundle)
    if previous:
        path = destination / 'permits' / machine.hex()
        path.mkdir(parents=True, exist_ok=True)
        (path / (ids[candidate].hex() + '.permit')).write_bytes(bundle)
info = {'machine': machine.hex(), 'ids': {name: raw.hex() for name, raw in ids.items()},
        'pcrs': {name: raw.hex() for name, raw in pcrs.items()},
        'anchors': {name: anchor(raw).hex() for name, raw in states.items()}, 'public': str(public)}
(destination / 'machine.json').write_text(json.dumps(info, indent=2) + '\n')
# B remains authorized after retirement, so its measurement-disabled stub tests
# measurement enforcement independently of the retired-A refusal.
factory = next((root / 'release-B').glob('*-uki')).read_bytes()
pe = struct.unpack_from('<I', factory, 0x3c)[0]
table = pe + 24 + struct.unpack_from('<H', factory, pe + 20)[0]
arguments = []
for index in range(struct.unpack_from('<H', factory, pe + 6)[0]):
    header = table + index * 40
    name = factory[header:header + 8].rstrip(b'\0').decode()
    if name not in ['.linux', '.initrd', '.cmdline']:
        continue
    size = struct.unpack_from('<I', factory, header + 8)[0]
    offset = struct.unpack_from('<I', factory, header + 20)[0]
    payload = destination / ('unmeasured' + name)
    payload.write_bytes(factory[offset:offset + size])
    arguments.append(name + '=' + str(payload))
unsigned = destination / 'unmeasured.unsigned'
run([uki, Path('out/tools/stubs') / fixture['arch'] / 'linux.efi.stub', unsigned, *arguments])
run(['osslsigncode', 'sign', '-certs', fixture['boot_cert'], '-key', fixture['boot_key'],
     '-in', unsigned, '-out', destination / 'unmeasured.efi'])
unsigned.unlink()
for argument in arguments:
    Path(argument.split('=', 1)[1]).unlink()
print('pass   tpm-fixture: signed factory pair, A/B and B/C permits; no guest signing keys')
