#!/usr/bin/env python3
"""Publication deduplication follows source, package bytes and trust, not timestamps."""
import copy
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import tempfile
import unittest

loader = importlib.machinery.SourceFileLoader('protected_inputs', 'release/protected-inputs')
spec = importlib.util.spec_from_loader(loader.name, loader)
inputs = importlib.util.module_from_spec(spec)
loader.exec_module(inputs)
loader = importlib.machinery.SourceFileLoader('protected_builder', 'tools/local-prerequisites')
spec = importlib.util.spec_from_loader(loader.name, loader)
builder = importlib.util.module_from_spec(spec)
loader.exec_module(builder)


class Inputs(unittest.TestCase):
    def setUp(self):
        self.lock = dict(config=dict(name='/runner/one/config.yaml'), contents=dict(
            keyring=[dict(content='trusted public key')], packages=[
                dict(name='libc', version='1-r0', architecture='x86_64', url='https://repo/libc.apk', checksum='first'),
                dict(name='shell', version='2-r0', architecture='x86_64', url='https://repo/shell.apk', checksum='second')]))

    def digest(self, lock=None, source='source'):
        return inputs.identity(source, 'x86_64', {'form.lock.json': lock or self.lock})

    def test_resolver_paths_and_package_order_do_not_create_releases(self):
        other = copy.deepcopy(self.lock)
        other['config']['name'] = '/runner/two/config.yaml'
        other['contents']['packages'].reverse()
        self.assertEqual(self.digest(), self.digest(other))

    def test_changed_source_package_bytes_versions_and_trust_require_publication(self):
        self.assertNotEqual(self.digest(), self.digest(source='updated source'))
        for field in ('version', 'checksum', 'url'):
            other = copy.deepcopy(self.lock)
            other['contents']['packages'][0][field] += '-changed'
            self.assertNotEqual(self.digest(), self.digest(other))
        other = copy.deepcopy(self.lock)
        other['contents']['keyring'][0]['content'] = 'new public key'
        self.assertNotEqual(self.digest(), self.digest(other))

    def test_foreign_architecture_cannot_be_an_empty_successful_snapshot(self):
        with self.assertRaisesRegex(ValueError, 'empty package snapshot'):
            inputs.identity('source', 'aarch64', {'form': self.lock})

    def test_documentation_cannot_invalidate_published_image_inputs(self):
        code = b'100644 blob code\tcmd/init/init.zig\0'
        docs = b'100644 blob docs\tcmd/init/README.md\0'
        changed = b'100644 blob edited\tcmd/init/README.md\0'
        self.assertEqual(inputs.source_identity(code), inputs.source_identity(code + docs))
        self.assertEqual(inputs.source_identity(code + docs), inputs.source_identity(code + changed))
        self.assertNotEqual(inputs.source_identity(code), inputs.source_identity(code.replace(b'code', b'updated')))
        shipped = b'100644 blob shipped\tforms/demo/rootfs/usr/share/help.md\0'
        self.assertNotEqual(inputs.source_identity(code), inputs.source_identity(code + shipped))

    def test_builder_pins_exact_versions_and_refuses_missing_or_duplicate_packages(self):
        with tempfile.TemporaryDirectory() as temporary:
            path = Path(temporary) / 'builder.lock.json'
            path.write_text(json.dumps(self.lock))
            self.assertEqual(['libc=1-r0', 'shell=2-r0'], builder.package_pins(path, 'x86_64'))
            with self.assertRaises(ValueError):
                builder.package_pins(path, 'aarch64')
            self.lock['contents']['packages'].append(self.lock['contents']['packages'][0])
            path.write_text(json.dumps(self.lock))
            with self.assertRaises(ValueError):
                builder.package_pins(path, 'x86_64')


if __name__ == '__main__':
    unittest.main()
