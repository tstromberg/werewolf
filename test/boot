#!/usr/bin/env expect
# boot NAME CHECKS LOG QEMU...
#
# Boot a werewolf image with the QEMU command given, which must set
# -no-reboot (so a panic ends the run) and -nographic (QEMU's monitor on the
# console). Judge the machine's posture line, which its posture service
# prints once the services settle: the checks that fail must be exactly
# those in POSTURE_KNOWN (the form's line of test/posture-known), no more and
# no fewer. Then run each check in CHECKS (see test/checks) as root on the
# console, which needs werewolf.debug=1 and a shell, and power the machine
# off. A machine with no shell is judged from its console instead: CHECKS
# is - (its posture line alone), or a file of console lines (seen NAME
# REGEX, which must appear; unseen NAME REGEX, which must not; see
# test/console-demo), and QEMU ends from its monitor. A file may hold both,
# for a machine with a shell whose services speak on the console
# (test/checks-persist-again). Exit 0 only if it
# booted, its posture and every check came out as expected, and, with a
# shell, it shut down cleanly (or, with POWER_CUT set, lost its power).
#
# Nothing waits a fixed time: each step waits for what it needs to see, up
# to a limit. Each check's output is fenced by a marker its own echo cannot
# match, so the shell typing the command back is never mistaken for its
# result. The whole console goes to LOG.

if {[llength $argv] < 4} {
	puts stderr "usage: boot NAME CHECKS LOG QEMU..."
	exit 2
}
lassign $argv name checks log
set qemu [lrange $argv 3 end]

log_user 0
# Opened here, unbuffered, so the console seen so far can be read back.
set log_chan [open $log w]
fconfigure $log_chan -buffering none
log_file -a -open $log_chan
set failed 0

# The host, first in the log, and in every failure.
set accel [lindex $qemu [expr {[lsearch -exact $qemu -accel] + 1}]]
if {[lsearch -exact $qemu -accel] < 0} { set accel default }
catch {exec uname -srm} uname
catch {exec [lindex $qemu 0] --version} qemu_version
catch {exec getconf _NPROCESSORS_ONLN} cpus
catch {exec uptime} up
regexp {load averages?: *([^\n]*)} $up -> load
if {![info exists load]} { set load ? }
set host "$uname; [lindex [split $qemu_version \n] 0]; accel $accel; $cpus CPUs; load $load"
puts $log_chan "werewolf-check: host $host"

# CHECKS' console lines (seen, unseen), judged first, and whether it has
# shell checks (ok, gap) too, which need the console's shell.
set console {}
set shell 0
if {$checks ne "-"} {
	set f [open $checks]
	while {[gets $f line] >= 0} {
		if {[regexp {^(seen|unseen)\s+(\S+)\s+(.+)$} $line -> kind check re]} { lappend console [list $kind $check $re] }
		if {[regexp {^(ok|gap)\s} $line]} { set shell 1 }
	}
	close $f
}

proc say {status what {detail ""}} {
	global name
	send_user [format "%-6s %-18s %s\n" $status $name $what]
	if {$detail ne ""} {
		foreach line [split [string trim $detail] "\n"] {
			send_user "         | [string trimright $line]\n"
		}
	}
}

# What the machine was doing when it failed, from its console: the last
# line of werewolf's own progress, and the first thing the kernel said was
# wrong. With the host's stamp, so a failure on one host and not another
# shows why at a glance.
proc diagnosis {} {
	global log host
	set f [open $log]
	set text [string map [list "\r" ""] [read $f]]
	close $f
	set d ""
	set progress [regexp -all -inline {(?:stage0|werewolf|modload|fence|slot-keep|leash|pg-init|dhcp-client|cloud-metadata): [^\[\n]*} $text]
	if {[llength $progress]} { append d "last progress: [string trim [lindex $progress end]]\n" }
	foreach re {
		{Kernel panic[^\n]*}
		{rcu: INFO: [^\n]*}
		{rcu: [^\n]*Possible timer handling issue[^\n]*}
		{INFO: task [^\n]*blocked for more than[^\n]*}
		{watchdog: BUG: soft lockup[^\n]*}
		{BUG: [^\n]*}
		{Unable to handle kernel[^\n]*}
		{Internal error: [^\n]*}
	} {
		if {[regexp -- $re $text line]} { append d "kernel: [string trim $line]\n" }
	}
	append d "host: $host"
	return $d
}

# A machine that stopped answering: the state of each virtual CPU, from
# QEMU's monitor, into the log (a CPU parked in WFI that never wakes is the
# hypervisor's fault, not the guest's), then QEMU ends.
proc cpu_dump {} {
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { return }
	foreach cmd {"info cpus" "info registers -a"} {
		send "$cmd\r"
		expect -timeout 10 "(qemu)" {} timeout { return }
	}
	send "quit\r"
	expect -timeout 10 eof {} timeout {}
}

proc give_up {what {hung 0}} {
	global log
	if {$hung} { cpu_dump }
	say FAIL $what "[diagnosis]\nsee $log"
	exit 1
}

# TCG, without KVM or HVF, boots in tens of seconds, not one. BOOT_TIMEOUT
# shortens the wait, to see a hang sooner when debugging one.
set timeout [expr {[info exists env(BOOT_TIMEOUT)] ? $env(BOOT_TIMEOUT) : 300}]
spawn -noecho {*}$qemu

proc panicked {} {
	global expect_out
	# The rest of the panic, for the log, then say why.
	set why $expect_out(0,string)
	expect -timeout 2 eof {} timeout {}
	give_up "boot: $why"
}

expect {
	"handing over to runit" {}
	-re {Kernel panic[^\r\n]*|stage0: [^\r\n]*panicking} panicked
	timeout { give_up "boot: no handover to runit in $timeout s" 1 }
	eof { give_up "boot: QEMU exited" }
}

# Before the shell, so no check's output can swallow the line.
expect {
	-re {posture: fail=([^ ]*) pass=([0-9]+) skip=([0-9]+) } {
		set got $expect_out(1,string)
		set passed $expect_out(2,string)
	}
	-re {Kernel panic[^\r\n]*} panicked
	timeout { give_up "posture: no posture line in $timeout s" 1 }
	eof { give_up "posture: QEMU exited" }
}
set known [lsort -unique [regexp -all -inline {[^\s,]+} [expr {[info exists env(POSTURE_KNOWN)] ? $env(POSTURE_KNOWN) : ""}]]]
set got [lsort -unique [split $got ,]]
# ?ID: may fail or not, as the host decides (test/posture-known).
set maybe {}
set sure {}
foreach id $known {
	if {[string index $id 0] eq "?"} { lappend maybe [string range $id 1 end] } else { lappend sure $id }
}
set new {}
foreach id $got { if {$id ni $sure && $id ni $maybe} { lappend new $id } }
set closed {}
foreach id $sure { if {$id ni $got} { lappend closed $id } }
if {$passed < 20} {
	say FAIL posture "only $passed checks passed; did posture run?"
	incr failed
} elseif {[llength $new] || [llength $closed]} {
	set detail ""
	if {[llength $new]} { append detail "failing, not known: [join $new]\n" }
	if {[llength $closed]} { append detail "known, now passing: [join $closed]; take it out of test/posture-known, and update the docs\n" }
	say FAIL posture $detail
	incr failed
} else {
	say ok posture
}

# Run a command on the host while the console is read, so QEMU, whose
# console would otherwise fill and stall it, keeps the machine answering.
# The command runs in the background, its output and exit status to files,
# and only the console is watched: one process to expect from, so the end
# of the command is never taken for the end of QEMU. Returns its exit
# status and output.
proc host {cmd} {
	global log
	set out $log.host
	file delete -force $out $out.rc
	set quoted ""
	foreach a $cmd { append quoted " '" [string map {' '\''} $a] "'" }
	exec sh -c "$quoted </dev/null >'$out' 2>&1; echo \$? >'$out.rc'" &
	set deadline [expr {[clock seconds] + 60}]
	while {![file exists $out.rc] && [clock seconds] < $deadline} {
		expect {
			-timeout 1
			-re ".+" {}
			timeout {}
			eof { give_up "QEMU exited" }
		}
	}
	set status 124
	if {[file exists $out.rc]} {
		set f [open $out.rc]
		set status [string trim [read $f]]
		close $f
	}
	set text ""
	if {[file exists $out]} {
		set f [open $out]
		set text [read $f]
		close $f
	}
	file delete -force $out $out.rc
	return [list $status $text]
}

# A machine that serves ssh, from the host, as an operator would: root's key
# from the config logs in; a session cannot forward a port, which would
# carry traffic past fence; and passwords are not offered at all. In that
# order, since sshd holds a failed login against its source for a while.
if {[info exists env(SSH_PORT)] && $env(SSH_PORT) ne ""} {
	set ssh [list ssh -p $env(SSH_PORT) -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
		-o BatchMode=yes -o ConnectTimeout=10 -o LogLevel=ERROR -o IdentitiesOnly=yes]
	set key [list -i $env(SSH_KEY)]
	set in 0
	for {set i 0} {$i < 30 && !$in} {incr i} {
		lassign [host [list {*}$ssh {*}$key root@127.0.0.1 id -u]] status out
		if {$status == 0 && [string trim $out] eq "0"} { set in 1 } else { after 1000 }
	}
	if {$in} { say ok ssh-login } else { say FAIL ssh-login "root's key did not log in:\n$out"; incr failed }
	lassign [host [list {*}$ssh {*}$key -o ExitOnForwardFailure=yes -R 127.0.0.1:0:127.0.0.1:22 root@127.0.0.1 true]] status out
	if {$status != 0 && [string match "*forwarding failed*" $out]} {
		say ok ssh-no-forwarding
	} else {
		say FAIL ssh-no-forwarding "a session could forward a port:\n$out"
		incr failed
	}
	lassign [host [list {*}$ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive root@127.0.0.1 true]] status out
	if {$status != 0 && [string match "*Permission denied (publickey)*" $out]} {
		say ok ssh-keys-only
	} else {
		say FAIL ssh-keys-only "something but a key was offered:\n$out"
		incr failed
	}
}

# By what the machine's console says: each seen line, waited
# for up to five minutes while the console is read, and no unseen line.
if {[llength $console]} {
	set deadline [expr {[clock seconds] + 300}]
	while 1 {
		set f [open $log]
		set text [string map [list "\r" ""] [read $f]]
		close $f
		set missing 0
		foreach c $console {
			lassign $c kind check re
			if {$kind eq "seen" && ![regexp -- $re $text]} { incr missing }
		}
		if {!$missing || [clock seconds] > $deadline} { break }
		expect {
			-timeout 2
			-re ".+" {}
			timeout {}
			eof { give_up "console: QEMU exited" }
		}
	}
	foreach c $console {
		lassign $c kind check re
		set found [regexp -- $re $text]
		if {$kind eq "seen" && $found} {
			say ok $check
		} elseif {$kind eq "unseen" && !$found} {
			say ok $check
		} elseif {$kind eq "seen"} {
			say FAIL $check "not on the console in 300 s: $re"
			incr failed
		} else {
			regexp -- "\[^\n\]*(?:$re)\[^\n\]*" $text line
			say FAIL $check "on the console: $line"
			incr failed
		}
	}
}

if {!$shell} {
	# No shell to power off from, and on arm64 no power button either (its
	# device tree's gpio-keys, which linux-virt lacks): QEMU's monitor
	# (Ctrl-A c) ends the run. Forms with a shell test the shutdown.
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { give_up "shutdown: no QEMU monitor" }
	send "quit\r"
	expect -timeout 30 eof {} timeout { give_up "shutdown: QEMU did not quit" }
	wait
	if {$failed} { exit 1 }
	say pass "all checks"
	exit 0
}

# The console's getty starts a moment after runit; type until a shell answers.
set ready 0
for {set i 0} {$i < 60 && !$ready} {incr i} {
	send "echo RE''ADY\r"
	expect {
		-timeout 2
		"READY" { set ready 1 }
		timeout {}
		eof { give_up "console: QEMU exited" }
	}
}
if {!$ready} { give_up "console: no root shell; is werewolf.debug=1 set?" 1 }

set f [open $checks]
while {[gets $f line] >= 0} {
	if {![regexp {^(ok|gap)\s+(\S+)\s+(.+)$} $line -> kind check cmd]} { continue }
	send "( $cmd ) 2>&1; printf '\\n@@%s=%d\\n' $check \$?\r"
	expect {
		-timeout 180
		-re "@@$check=(\[0-9]+)" { set rc $expect_out(1,string); set out $expect_out(buffer) }
		timeout { set rc timeout; set out "no answer in 180 s" }
		eof { give_up "$check: QEMU exited" }
	}
	if {$kind eq "ok" && $rc eq "0"} {
		say ok $check
	} elseif {$kind eq "gap" && $rc ne "0" && $rc ne "timeout"} {
		say gap $check
	} elseif {$kind eq "gap" && $rc eq "0"} {
		say FAIL $check "this gap has closed: make it ok in test/checks, and update docs/security.md"
		incr failed
	} else {
		say FAIL $check "exit $rc; console:\n$out"
		incr failed
	}
}
close $f

if {[info exists env(POWER_CUT)] && $env(POWER_CUT) ne ""} {
	# POWER_CUT: the power goes, as a reset or a host's hard stop takes it,
	# for what the next boot must find (QEMU's monitor, Ctrl-A c).
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { give_up "power cut: no QEMU monitor" }
	send "quit\r"
	expect -timeout 30 eof {} timeout { give_up "power cut: QEMU did not quit" }
	wait
	say ok power-cut
} else {
	send "poweroff\r"
	expect {
		-timeout 120
		eof {}
		timeout { give_up "shutdown: still running after 120 s" }
	}
	lassign [wait] pid spawn_id os_error status
	if {$status != 0} { give_up "shutdown: QEMU exited $status" }
}

if {$failed} { exit 1 }
say pass "all checks"
