#!/usr/bin/env expect
# boot NAME CHECKS LOG QEMU...
#
# Boot a werewolf image with the QEMU command given, which must set
# -no-reboot (so a panic ends the run) and -nographic (QEMU's monitor on the
# console). Judge the machine's posture line, which its posture service
# prints once the services settle: the checks that fail must be exactly
# those in POSTURE_KNOWN (the form's weaknesses, and test/posture-known's
# lines for every DEV=1 build and the architecture), no more and
# no fewer. Then run each check in CHECKS (see test/checks) as root on the
# console, which needs werewolf.debug=1 and a shell, and power the machine
# off. A machine with no shell is judged from its console instead: CHECKS
# is - (its posture line alone), or a file of console lines (seen NAME
# REGEX, which must appear; unseen NAME REGEX, which must not; see
# forms/demo/test/console), and QEMU ends from its monitor. A file may hold both,
# for a machine with a shell whose services speak on the console
# (test/checks-persist-again). Exit 0 only if it
# booted, its posture and every check came out as expected, and, with a
# shell, it shut down cleanly (or, with POWER_CUT set, lost its power).
#
# Nothing waits a fixed time: each step waits for what it needs to see, up
# to a limit. Each check's output is fenced by a marker its own echo cannot
# match, so the shell typing the command back is never mistaken for its
# result. The whole console goes to LOG.

if {[llength $argv] < 4} {
	puts stderr "usage: boot NAME CHECKS LOG QEMU..."
	exit 2
}
lassign $argv name checks log
set qemu [lrange $argv 3 end]

log_user 0
# Opened here, unbuffered, so the console seen so far can be read back.
set log_chan [open $log w]
fconfigure $log_chan -buffering none
log_file -a -open $log_chan
set failed 0

# The host, first in the log, and in every failure.
set accel [lindex $qemu [expr {[lsearch -exact $qemu -accel] + 1}]]
if {[lsearch -exact $qemu -accel] < 0} { set accel default }
catch {exec uname -srm} uname
catch {exec [lindex $qemu 0] --version} qemu_version
catch {exec getconf _NPROCESSORS_ONLN} cpus
catch {exec uptime} up
regexp {load averages?: *([^\n]*)} $up -> load
if {![info exists load]} { set load ? }
set host "$uname; [lindex [split $qemu_version \n] 0]; accel $accel; $cpus CPUs; load $load"
puts $log_chan "werewolf-check: host $host"

# CHECKS' console lines (seen, unseen), judged first, and whether it has
# shell checks (ok, gap) too, which need the console's shell.
set console {}
set shell 0
if {$checks ne "-"} {
	set f [open $checks]
	while {[gets $f line] >= 0} {
		if {[regexp {^(seen|unseen)\s+(\S+)\s+(.+)$} $line -> kind check re]} { lappend console [list $kind $check $re] }
		if {[regexp {^(ok|gap)\s} $line]} { set shell 1 }
	}
	close $f
}

proc say {status what {detail ""}} {
	global name
	send_user [format "%-6s %-18s %s\n" $status $name $what]
	if {$detail ne ""} {
		foreach line [split [string trim $detail] "\n"] {
			send_user "         | [string trimright $line]\n"
		}
	}
}

# What the machine was doing when it failed, from its console: the last
# line of werewolf's own progress, and the first thing the kernel said was
# wrong. With the host's stamp, so a failure on one host and not another
# shows why at a glance.
proc diagnosis {} {
	global log host
	set f [open $log]
	set text [string map [list "\r" ""] [read $f]]
	close $f
	set d ""
	set progress [regexp -all -inline {(?:stage0|werewolf|modload|fence|slot-keep|leash|pg-init|dhcp-client|cloud-metadata): [^\[\n]*} $text]
	if {[llength $progress]} { append d "last progress: [string trim [lindex $progress end]]\n" }
	foreach re {
		{Kernel panic[^\n]*}
		{rcu: INFO: [^\n]*}
		{rcu: [^\n]*Possible timer handling issue[^\n]*}
		{INFO: task [^\n]*blocked for more than[^\n]*}
		{watchdog: BUG: soft lockup[^\n]*}
		{BUG: [^\n]*}
		{Unable to handle kernel[^\n]*}
		{Internal error: [^\n]*}
	} {
		if {[regexp -- $re $text line]} { append d "kernel: [string trim $line]\n" }
	}
	append d "host: $host"
	return $d
}

# A machine that stopped answering: the state of each virtual CPU, from
# QEMU's monitor, into the log (a CPU parked in WFI that never wakes is the
# hypervisor's fault, not the guest's), then QEMU ends.
proc cpu_dump {} {
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { return }
	foreach cmd {"info cpus" "info registers -a"} {
		send "$cmd\r"
		expect -timeout 10 "(qemu)" {} timeout { return }
	}
	send "quit\r"
	expect -timeout 10 eof {} timeout {}
}

proc give_up {what {hung 0}} {
	global log
	if {$hung} { cpu_dump }
	say FAIL $what "[diagnosis]\nsee $log"
	exit 1
}

# TCG, without KVM or HVF, boots in tens of seconds, not one. BOOT_TIMEOUT
# shortens the wait, to see a hang sooner when debugging one.
set timeout [expr {[info exists env(BOOT_TIMEOUT)] ? $env(BOOT_TIMEOUT) : 300}]
spawn -noecho {*}$qemu

proc panicked {} {
	global expect_out
	# The rest of the panic, for the log, then say why.
	set why $expect_out(0,string)
	expect -timeout 2 eof {} timeout {}
	give_up "boot: $why"
}

expect {
	"handing over to runit" {}
	-re {Kernel panic[^\r\n]*|stage0: [^\r\n]*panicking} panicked
	timeout { give_up "boot: no handover to runit in $timeout s" 1 }
	eof { give_up "boot: QEMU exited" }
}

# Before the shell, so no check's output can swallow the line. After the
# handover the console carries the kernel's notices too (cmd/init), and a
# record can land inside the posture line: "posture: fail= p[ 8.48] audit:
# ...\nass=82". So what the console says is gathered as it comes, whole
# kernel records are taken out of it, and the line is looked for in what
# remains. A panic is a kernel record, so it is looked for before.
#
# On x86_64 under KVM, a boot whose posture line a record cut this way has
# every time stopped there: the rest of the line reached the console only
# once the monitor was spoken to, 300 s on, as if the UART's transmitter
# waited on an interrupt it never got (every such log; none passed). A
# byte sent to the machine raises its receive interrupt, which also
# drains the transmitter, so one is sent after a while with no line, and
# the log says so: a boot that needs it is still a boot to look into.
set seen ""
set deadline [expr {[clock seconds] + $timeout}]
set poke [expr {[clock seconds] + 20}]
while 1 {
	set now [clock seconds]
	if {$now >= $deadline} { give_up "posture: no posture line in $timeout s" 1 }
	if {$poke > 0 && $now >= $poke} {
		set poke 0
		puts $log_chan "\nwerewolf-check: no posture line after 20 s; sending a carriage return"
		send "\r"
	}
	expect {
		-timeout [expr {min($deadline, $poke > 0 ? $poke : $deadline) - $now}]
		-re {.+} { append seen $expect_out(0,string) }
		timeout {}
		eof { give_up "posture: QEMU exited" }
	}
	if {[regexp {Kernel panic[^\r\n]*} $seen why]} {
		expect -timeout 2 eof {} timeout {}
		give_up "boot: $why"
	}
	regsub -all {\[ *[0-9]+\.[0-9]+\] [^\n]*\n} $seen {} clean
	if {[regexp {posture: fail=([^ ]*) pass=([0-9]+) skip=([0-9]+) } $clean -> got passed]} break
	# The tail is enough: the line itself, and a record cut short at its end.
	set seen [string range $seen end-65535 end]
}
set known [lsort -unique [regexp -all -inline {[^\s,]+} [expr {[info exists env(POSTURE_KNOWN)] ? $env(POSTURE_KNOWN) : ""}]]]
set got [lsort -unique [split $got ,]]
# ?ID: may fail or not, as the host decides (test/posture-known).
set maybe {}
set sure {}
foreach id $known {
	if {[string index $id 0] eq "?"} { lappend maybe [string range $id 1 end] } else { lappend sure $id }
}
set new {}
foreach id $got { if {$id ni $sure && $id ni $maybe} { lappend new $id } }
set closed {}
foreach id $sure { if {$id ni $got} { lappend closed $id } }
if {$passed < 20} {
	say FAIL posture "only $passed checks passed; did posture run?"
	incr failed
} elseif {[llength $new] || [llength $closed]} {
	set detail ""
	if {[llength $new]} { append detail "failing, not known: [join $new]\n" }
	if {[llength $closed]} { append detail "known, now passing: [join $closed]; take it out of the form's weaknesses (or test/posture-known), and update the docs\n" }
	say FAIL posture $detail
	incr failed
} else {
	say ok posture
}

# Run a command on the host while the console is read, so QEMU, whose
# console would otherwise fill and stall it, keeps the machine answering.
# The command runs in the background, its output and exit status to files,
# and only the console is watched: one process to expect from, so the end
# of the command is never taken for the end of QEMU. Returns its exit
# status and output.
proc host {cmd} {
	global log
	set out $log.host
	file delete -force $out $out.rc $out.rc.tmp
	set quoted ""
	foreach a $cmd { append quoted " '" [string map {' '\''} $a] "'" }
	# The status is renamed into place, so $out.rc exists only once it is
	# whole: a redirection makes the file before echo writes to it.
	exec sh -c "$quoted </dev/null >'$out' 2>&1; echo \$? >'$out.rc.tmp'; mv '$out.rc.tmp' '$out.rc'" &
	set deadline [expr {[clock seconds] + 60}]
	while {![file exists $out.rc] && [clock seconds] < $deadline} {
		expect {
			-timeout 1
			-re ".+" {}
			timeout {}
			eof { give_up "QEMU exited" }
		}
	}
	set status 124
	if {[file exists $out.rc]} {
		set f [open $out.rc]
		set status [string trim [read $f]]
		close $f
	}
	set text ""
	if {[file exists $out]} {
		set f [open $out]
		set text [read $f]
		close $f
	}
	file delete -force $out $out.rc
	return [list $status $text]
}

# A machine that serves ssh, from the host, as an operator would: root's key
# from the config logs in; a session cannot forward a port, which would
# carry traffic past fence; and passwords are not offered at all. In that
# order, since sshd holds a failed login against its source for a while.
# Root's key is a security key's, made with the software one (make's
# TEST_SK); where sshd takes security keys alone (the form does not excuse
# network-ssh-security-keys), root's other key, a file, is refused last,
# with publickey the only method left.
if {[info exists env(SSH_PORT)] && $env(SSH_PORT) ne ""} {
	set level ERROR
	if {[info exists env(SSH_MODE)] && ([string match "bastion*" $env(SSH_MODE)] || $env(SSH_MODE) eq "sftpgo" || $env(SSH_MODE) eq "gitea")} { set level DEBUG1 }
	set ssh [list ssh -F /dev/null -p $env(SSH_PORT) -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
		-o BatchMode=yes -o ConnectTimeout=10 -o LogLevel=$level -o IdentitiesOnly=yes]
	set key [list -i $env(SSH_KEY)]
	# sshd's login: the security key's, where make made one.
	set login $key
	if {[info exists env(SSH_SK_KEY)] && [file exists $env(SSH_SK_KEY)]} {
		lappend ssh -o SecurityKeyProvider=$env(SSH_SK_PROVIDER)
		set login [list -i $env(SSH_SK_KEY)]
	}
	set sk_only [expr {[lsearch -regexp $known {^\??network-ssh-security-keys$}] < 0}]
	# The key file refused, as USER, where sshd takes security keys alone.
	proc refused {check user args} {
		global ssh key failed
		lassign [host [list {*}$ssh {*}$key {*}$args $user@127.0.0.1 true]] status out
		if {$status != 0 && [string match "*Permission denied (publickey)*" $out]} {
			say ok $check
		} else {
			say FAIL $check "a key file was not refused, or something but a key was offered:\n$out"
			incr failed
		}
	}
	if {[info exists env(SSH_MODE)] && $env(SSH_MODE) eq "gitea"} {
		# A git user, from the host: a repository made and the run's key
		# added through the API as the administrator gitea-init made;
		# cloned over Gitea's SSH, a commit pushed, and the branch there;
		# a command that is not git's, a remote forward, a password and a
		# non-post-quantum exchange refused.
		set api http://127.0.0.1:$env(GITEA_PORT)/api/v1
		set auth admin:werewolf-check-pass
		set in 0
		for {set i 0} {$i < 60 && !$in} {incr i} {
			lassign [host [list curl -sS -m 10 -u $auth -H {Content-Type: application/json} \
				-d {{"name":"check","private":true,"default_branch":"main"}} $api/user/repos]] status out
			# A second boot finds the first's repository kept on /data.
			if {$status == 0 && ([string match "*\"full_name\":\"admin/check\"*" $out] ||
				[string match "*same name already exists*" $out])} { set in 1 } else { after 1000 }
		}
		if {$in} { say ok gitea-repo-made } else { say FAIL gitea-repo-made $out; incr failed }
		set f [open $env(SSH_KEY).pub]; set pub [string trim [read $f]]; close $f
		lassign [host [list curl -sS -m 10 -u $auth -H {Content-Type: application/json} \
			-d "{\"title\":\"check\",\"key\":\"$pub\"}" $api/user/keys]] status out
		if {$status == 0 && ([string match "*\"title\":\"check\"*" $out] || [string match "*has been used*" $out])} {
			say ok gitea-key-added
		} else { say FAIL gitea-key-added $out; incr failed }
		set work [file join [file dirname $log] gitea-clone]
		file delete -force $work
		set gitssh "ssh -F /dev/null -p $env(SSH_PORT) -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o IdentitiesOnly=yes -i [file normalize $env(SSH_KEY)]"
		set pushed 0
		for {set i 0} {$i < 20 && !$pushed} {incr i} {
			lassign [host [list env GIT_SSH_COMMAND=$gitssh git clone -q ssh://git@127.0.0.1:$env(SSH_PORT)/admin/check.git $work]] status out
			if {$status == 0} { set pushed 1 } else { after 2000 }
		}
		if {$pushed} {
			set f [open [file join $work README] w]; puts $f "werewolf check"; close $f
			lassign [host [list env GIT_SSH_COMMAND=$gitssh GIT_AUTHOR_NAME=check GIT_AUTHOR_EMAIL=check@example.test \
				GIT_COMMITTER_NAME=check GIT_COMMITTER_EMAIL=check@example.test git -C $work add README]] s1 o1
			lassign [host [list env GIT_AUTHOR_NAME=check GIT_AUTHOR_EMAIL=check@example.test GIT_COMMITTER_NAME=check \
				GIT_COMMITTER_EMAIL=check@example.test git -C $work commit -q -m check]] s2 o2
			lassign [host [list env GIT_SSH_COMMAND=$gitssh git -C $work push -q -u origin HEAD:main]] status out
			if {$status != 0} { set pushed 0; append out "\n$o1\n$o2" }
		}
		if {$pushed} { say ok gitea-push } else { say FAIL gitea-push $out; incr failed }
		foreach {check args pattern} {
			gitea-no-command {git@127.0.0.1 id} {*error:*}
			gitea-no-remote {-o ExitOnForwardFailure=yes -R 127.0.0.1:0:127.0.0.1:22 git@127.0.0.1 true} {*}
			gitea-pq-required {-o KexAlgorithms=curve25519-sha256 git@127.0.0.1 true} {*no matching key exchange method*}
		} {
			lassign [host [list {*}$ssh {*}$key {*}$args]] status out
			if {$status != 0 && [string match $pattern $out] && ![string match "*uid=*" $out]} {
				say ok $check
			} else { say FAIL $check $out; incr failed }
		}
		lassign [host [list {*}$ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive git@127.0.0.1 true]] status out
		if {$status != 0 && [string match "*Permission denied (publickey)*" $out]} {
			say ok gitea-keys-only
		} else { say FAIL gitea-keys-only $out; incr failed }
	} elseif {[info exists env(SSH_MODE)] && $env(SSH_MODE) eq "sftpgo"} {
		# An SFTP user, from the host: files go up and come back as they
		# went; a shell or command is refused; so are a password, a remote
		# forward, and a key exchange that is not post-quantum.
		set up [file join [file dirname $log] sftpgo-upload]
		set f [open $up w]; puts $f "werewolf check"; close $f
		set batch [file join [file dirname $log] sftpgo-batch]
		set f [open $batch w]
		puts $f "put $up werewolf-check\nls -l\nget werewolf-check $up.back"
		close $f
		set in 0
		for {set i 0} {$i < 30 && !$in} {incr i} {
			lassign [host [list sftp -F /dev/null -P $env(SSH_PORT) -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
				-o BatchMode=yes -o ConnectTimeout=10 -o IdentitiesOnly=yes {*}$key -b $batch check@127.0.0.1]] status out
			if {$status == 0 && [file exists $up.back]} { set in 1 } else { after 1000 }
		}
		if {$in && [string match "*werewolf check*" [exec cat $up.back]]} { say ok sftp-round-trip } else { say FAIL sftp-round-trip $out; incr failed }
		foreach {check args pattern} {
			sftp-no-session {check@127.0.0.1 true} {*}
			sftp-no-remote {-o ExitOnForwardFailure=yes -R 127.0.0.1:0:127.0.0.1:22 check@127.0.0.1 true} {*}
			sftp-pq-required {-o KexAlgorithms=curve25519-sha256 check@127.0.0.1 true} {*no matching key exchange method*}
		} {
			lassign [host [list {*}$ssh {*}$key {*}$args]] status out
			if {$status != 0 && [string match $pattern $out]} {
				say ok $check
			} else { say FAIL $check $out; incr failed }
		}
		lassign [host [list {*}$ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive check@127.0.0.1 true]] status out
		if {$status != 0 && [string match "*Permission denied (publickey)*" $out]} {
			say ok sftp-keys-only
		} else { say FAIL sftp-keys-only $out; incr failed }
	} elseif {[info exists env(SSH_MODE)] && [string match "bastion*" $env(SSH_MODE)]} {
		# make check-bastion's form: root's security key is user check's,
		# who reaches 127.0.0.1:22 alone; 127.0.0.2:22 is user narrow's,
		# in the bastion's PermitOpen, never check's.
		lassign [host [list {*}$ssh {*}$login -W 127.0.0.1:22 bastion@127.0.0.1]] status out
		if {$status == 0 && [string match "*SSH-2.0-OpenSSH*" $out]} {
			say ok bastion-permitted-destination
		} else { say FAIL bastion-permitted-destination $out; incr failed }
		foreach {check args pattern} {
			bastion-no-session {bastion@127.0.0.1 true} {*open failed*}
			bastion-no-destination {-W 127.0.0.3:22 bastion@127.0.0.1} {*administratively prohibited*}
			bastion-not-anothers-destination {-W 127.0.0.2:22 bastion@127.0.0.1} {*administratively prohibited*}
			bastion-no-remote {-o ExitOnForwardFailure=yes -R 127.0.0.1:0:127.0.0.1:22 bastion@127.0.0.1 true} {*forwarding failed*}
			bastion-pq-required {-o KexAlgorithms=curve25519-sha256 bastion@127.0.0.1 true} {*no matching key exchange method*}
		} {
			lassign [host [list {*}$ssh {*}$login {*}$args]] status out
			if {$status != 0 && [string match $pattern $out]} {
				say ok $check
			} else { say FAIL $check $out; incr failed }
		}
		if {$sk_only} { refused bastion-security-keys-only bastion }
	} else {
	set in 0
	for {set i 0} {$i < 30 && !$in} {incr i} {
		lassign [host [list {*}$ssh {*}$login root@127.0.0.1 id -u]] status out
		# The last line: ssh may say first that it asked for a touch.
		if {$status == 0 && [lindex [split [string trim $out] \n] end] eq "0"} { set in 1 } else { after 1000 }
	}
	if {$in} { say ok ssh-login } else { say FAIL ssh-login "root's key did not log in:\n$out"; incr failed }
	lassign [host [list {*}$ssh {*}$login -o ExitOnForwardFailure=yes -R 127.0.0.1:0:127.0.0.1:22 root@127.0.0.1 true]] status out
	if {$status != 0 && [string match "*forwarding failed*" $out]} {
		say ok ssh-no-forwarding
	} else {
		say FAIL ssh-no-forwarding "a session could forward a port:\n$out"
		incr failed
	}
	if {$sk_only} {
		# One failed login, not two: sshd holds the first against the second.
		refused ssh-security-keys-only root
	} else {
		lassign [host [list {*}$ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive root@127.0.0.1 true]] status out
		if {$status != 0 && [string match "*Permission denied (publickey)*" $out]} {
			say ok ssh-keys-only
		} else {
			say FAIL ssh-keys-only "something but a key was offered:\n$out"
			incr failed
		}
	}
}
}

# By what the machine's console says: each seen line, waited
# for up to five minutes while the console is read, and no unseen line.
if {[llength $console]} {
	set deadline [expr {[clock seconds] + 300}]
	while 1 {
		set f [open $log]
		set text [string map [list "\r" ""] [read $f]]
		close $f
		set missing 0
		foreach c $console {
			lassign $c kind check re
			if {$kind eq "seen" && ![regexp -- $re $text]} { incr missing }
		}
		if {!$missing || [clock seconds] > $deadline} { break }
		expect {
			-timeout 2
			-re ".+" {}
			timeout {}
			eof { give_up "console: QEMU exited" }
		}
	}
	foreach c $console {
		lassign $c kind check re
		set found [regexp -- $re $text]
		if {$kind eq "seen" && $found} {
			say ok $check
		} elseif {$kind eq "unseen" && !$found} {
			say ok $check
		} elseif {$kind eq "seen"} {
			say FAIL $check "not on the console in 300 s: $re"
			incr failed
		} else {
			regexp -- "\[^\n\]*(?:$re)\[^\n\]*" $text line
			say FAIL $check "on the console: $line"
			incr failed
		}
	}
}

if {!$shell} {
	# No shell to power off from: the power button, as a hypervisor presses
	# it (ACPI on x86_64; on arm64 the device tree's GPIO line, which
	# power-button reads itself). QEMU's monitor (Ctrl-A c) presses it, and
	# the machine must stop its services and power off, which ends QEMU.
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { give_up "shutdown: no QEMU monitor" }
	send "system_powerdown\r"
	expect -timeout 10 "(qemu)" {} timeout {}
	send "\001c"
	expect {
		-timeout 60
		"power button on" { exp_continue }
		"reboot: Power down" { say ok shutdown }
		timeout { say FAIL shutdown "no power-off 60 s after the power button"; incr failed }
		eof { say FAIL shutdown "QEMU ended without the kernel powering off"; incr failed }
	}
	expect -timeout 30 eof {} timeout { give_up "shutdown: QEMU did not exit after powering off" }
	wait
	if {$failed} { exit 1 }
	say pass "all checks"
	exit 0
}

# The console's getty starts a moment after runit; type until a shell answers.
set ready 0
for {set i 0} {$i < 60 && !$ready} {incr i} {
	send "echo RE''ADY\r"
	expect {
		-timeout 2
		"READY" { set ready 1 }
		timeout {}
		eof { give_up "console: QEMU exited" }
	}
}
if {!$ready} { give_up "console: no root shell; is werewolf.debug=1 set?" 1 }

set f [open $checks]
while {[gets $f line] >= 0} {
	if {![regexp {^(ok|gap)\s+(\S+)\s+(.+)$} $line -> kind check cmd]} { continue }
	send "( $cmd ) 2>&1; printf '\\n@@%s=%d\\n' $check \$?\r"
	expect {
		-timeout 180
		-re "@@$check=(\[0-9]+)" { set rc $expect_out(1,string); set out $expect_out(buffer) }
		timeout { set rc timeout; set out "no answer in 180 s" }
		eof { give_up "$check: QEMU exited" }
	}
	if {$kind eq "ok" && $rc eq "0"} {
		say ok $check
	} elseif {$kind eq "gap" && $rc ne "0" && $rc ne "timeout"} {
		say gap $check
	} elseif {$kind eq "gap" && $rc eq "0"} {
		say FAIL $check "this gap has closed: make it ok in test/checks, and update docs/security.md"
		incr failed
	} else {
		say FAIL $check "exit $rc; console:\n$out"
		incr failed
	}
}
close $f

if {[info exists env(POWER_CUT)] && $env(POWER_CUT) ne ""} {
	# POWER_CUT: the power goes, as a reset or a host's hard stop takes it,
	# for what the next boot must find (QEMU's monitor, Ctrl-A c).
	send "\001c"
	expect -timeout 10 "(qemu)" {} timeout { give_up "power cut: no QEMU monitor" }
	send "quit\r"
	expect -timeout 30 eof {} timeout { give_up "power cut: QEMU did not quit" }
	wait
	say ok power-cut
} else {
	send "poweroff\r"
	expect {
		-timeout 120
		eof {}
		timeout { give_up "shutdown: still running after 120 s" }
	}
	lassign [wait] pid spawn_id os_error status
	if {$status != 0} { give_up "shutdown: QEMU exited $status" }
}

if {$failed} { exit 1 }
say pass "all checks"
