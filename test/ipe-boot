#!/usr/bin/env python3
"""Run the isolated kernel probe with a bounded lifetime and a saved console."""
import pathlib
import subprocess
import sys

log = pathlib.Path(sys.argv[1])
with log.open("wb") as output:
    try:
        result = subprocess.run(sys.argv[2:], stdout=output, stderr=subprocess.STDOUT, timeout=300, check=False)
    except subprocess.TimeoutExpired:
        sys.exit(f"ipe-check: timeout; see {log}")
text = log.read_bytes()
if result.returncode or b"ipe-check: PASS" not in text or b"ipe-check: FAIL" in text:
    print(text[-6000:].decode(errors="replace"), file=sys.stderr)
    sys.exit(f"ipe-check: kernel probe failed; see {log}")
print("pass   ipe-kernel: independent execution and mmap checks")
