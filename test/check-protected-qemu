#!/usr/bin/env python3
"""Exercise Linux publication on a disposable GHA runner with temporary test authority."""
import datetime
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'release'))
import image_profiles


def run(args, env):
    subprocess.run([str(arg) for arg in args], check=True, env=env)


def check():
    if os.environ.get('GITHUB_ACTIONS') != 'true' or os.environ.get('RUNNER_ENVIRONMENT') != 'github-hosted':
        raise ValueError('temporary trust validation requires a disposable GitHub-hosted runner')
    if platform.system() != 'Linux' or platform.machine() != 'x86_64':
        raise ValueError('QEMU publication validation requires a native x86_64 Linux runner')
    os.umask(0o077)
    trust = Path('release/protected')
    saved = {name: (trust / name).read_bytes() for name in ('boot.crt', 'image.crt')}
    with tempfile.TemporaryDirectory(prefix='ww-qemu-validation-') as temporary:
        work = Path(temporary)
        env = dict(os.environ)
        # Fixture keys never come from production secrets and never leave this
        # disposable signing host. Real publication keeps the committed pins.
        run([sys.executable, 'release/create-protected-trust', work / 'private', work / 'public'], env)
        try:
            for kind in ('boot', 'image'):
                shutil.copyfile(work / 'public' / (kind + '.crt'), trust / (kind + '.crt'))
                env['WEREWOLF_PROTECTED_' + kind.upper() + '_KEY'] = str(work / 'private' / (kind + '.key'))
            run(['make', 'howl'], env)
            # The published kernel's IPE trusts only the committed image certificate.
            kernel = work / 'test-kernel.tar'
            run(['sh', 'tools/test-kernel', 'x86_64', trust / 'image.crt', kernel], env)
            env['WEREWOLF_PROTECTED_TEST_KERNEL'] = str(kernel)
            for form in image_profiles.BASE_FORMS:
                start = datetime.datetime.now(datetime.timezone.utc)
                bundles = []
                for offset in range(3):
                    serial = (start + datetime.timedelta(seconds=offset)).strftime('%Y%m%dT%H%M%SZ')
                    bundle = Path('build/qemu-validation-candidates') / form / str(offset)
                    run([sys.executable, 'release/with-protected-keys', sys.executable, 'release/build-protected',
                         form, 'qemu', 'x86_64', serial, str(offset + 1), bundle], env)
                    bundles.append(bundle)
                run([sys.executable, 'release/with-protected-keys', sys.executable, 'release/authorize-protected',
                     'build/host/howl', 'qemu', *bundles], env)
                output = Path('build/protected-qemu-validation') / form
                run([sys.executable, 'test/check-published-lifecycle', 'build/host/howl', *bundles, output], env)
                # Exercise the actual signatures, export admission and qcow2 too.
                run([sys.executable, 'release/with-protected-keys', sys.executable, 'release/export-protected',
                     'build/host/howl', bundles[0], output / 'gates.json', 'qemu', work / ('assets-' + form)], env)
        finally:
            for name, data in saved.items():
                (trust / name).write_bytes(data)


if __name__ == '__main__':
    try:
        check()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit('check-protected-qemu: ' + str(error))
