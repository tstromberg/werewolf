#!/usr/bin/env python3
"""Verify the released signed disk, its enrollment, and firmware rejection."""
import hashlib
import json
import os
import pathlib
import pty
import re
import select
import shutil
import subprocess
import sys
import time

env = os.environ
arch = env['ARCH']
work = pathlib.Path(env['CHECK']) / 'secureboot'
work.mkdir(parents=True, exist_ok=True)
key = str(pathlib.Path(env['BOOT_KEY']).resolve())
cert = str(pathlib.Path(env['BOOT_CRT']).resolve())
howl = str(pathlib.Path(env['HOWL']).resolve())


def command(args, label):
    with (work / (label + '.log')).open('wb') as log:
        subprocess.run(args, check=True, stdout=log, stderr=subprocess.STDOUT)


release = work / 'release'
command([howl, 'build', '--build', '--with', 'prod', '--arch', arch, '-o', str(release),
         '--boot-key', key, '--boot-cert', cert, '--boot-native'], 'build')
manifest = json.loads((release / f'prod-{arch}.json').read_text())
uki = release / f'prod-{arch}-uki'
assert manifest['files']['uki']['sha256'] == hashlib.sha256(uki.read_bytes()).hexdigest()
assert manifest['files']['boot.crt']['sha256'] == hashlib.sha256(pathlib.Path(cert).read_bytes()).hexdigest()
disk = release / f'prod-{arch}-disk.qcow2'
command(['sh', 'tools/verify-boot-disk', arch, str(disk), cert, str(work)], 'verify-disk')
enrolled = work / 'enrolled'
command(['sh', 'tools/enroll-boot', arch, cert, str(enrolled)], 'enroll')
raw = work / 'disk.raw'
command(['qemu-img', 'convert', '-f', 'qcow2', '-O', 'raw', str(disk), str(raw)], 'raw')
installed = work / 'installed.efi'
installed.unlink(missing_ok=True)
command(['mcopy', '-i', str(raw) + '@@1048576', '::/werewolf/a/uki.efi', str(installed)], 'extract')
assert hashlib.sha256(installed.read_bytes()).hexdigest() == manifest['files']['uki']['sha256']

qemu = sys.argv[1:]
qemu[qemu.index('-M') + 1] = 'virt' if arch == 'aarch64' else 'q35,smm=on'
if arch == 'x86_64':
    qemu += ['-global', 'driver=cfi.pflash01,property=secure,value=on']


def boot(label, refused=False):
    variables = work / 'run.fd'
    shutil.copyfile(enrolled / 'vars.fd', variables)
    # AAVMF cannot log rejected boots after its flash writes are refused.
    # Use a disposable writable clone for that diagnostic; the successful
    # boot separately proves immutable enrollment and checks its digest.
    frozen = 'readonly=on,' if arch == 'aarch64' and not refused else ''
    digest = hashlib.sha256(variables.read_bytes()).digest()
    args = qemu + ['-drive', f'if=pflash,format=raw,readonly=on,file={enrolled}/code.fd',
                   '-drive', f'if=pflash,format=raw,{frozen}file={variables}',
                   '-drive', f'format=raw,if=virtio,file={raw}',
                   '-netdev', 'user,id=n0', '-device', 'virtio-net-pci,netdev=n0,romfile=']
    master, slave = pty.openpty()
    process = subprocess.Popen(args, stdin=slave, stdout=slave, stderr=slave)
    os.close(slave)
    seen = b''
    try:
        with (work / (label + '.log')).open('wb') as log:
            deadline = time.monotonic() + 300
            while time.monotonic() < deadline:
                if select.select([master], [], [], 0.5)[0]:
                    seen += os.read(master, 65536)
                    log.seek(0)
                    log.write(seen)
                    log.flush()
                if refused:
                    if b'up in ' in seen:
                        raise RuntimeError('tampered UKI handed over')
                    if b'access denied' in seen.lower():
                        return
                else:
                    line = re.search(rb'posture: fail=([^ ]*) pass=', seen)
                    if line:
                        failures = set(line[1].decode().split(',')) - {''}
                        expected = {x.lstrip('?') for x in env['POSTURE_KNOWN'].split()}
                        required = {x for x in env['POSTURE_KNOWN'].split() if not x.startswith('?')}
                        assert failures <= expected and required <= failures, failures
                        assert b'Secure Boot enforced outside setup mode' in seen
                        assert b'native UKI selected slot a' in seen
                        assert re.search(rb'slot a:[^\r\n]*verified', seen)
                        return
                if process.poll() is not None:
                    break
            raise RuntimeError('no expected firmware outcome: ' + label)
    finally:
        if process.poll() is None:
            process.terminate()
        process.wait(timeout=30)
        os.close(master)
        if frozen:
            assert hashlib.sha256(variables.read_bytes()).digest() == digest


boot('boot')
data = bytearray(installed.read_bytes())
data[len(data) // 2] ^= 1
changed = work / 'tampered.efi'
changed.write_bytes(data)
command(['mcopy', '-o', '-i', str(raw) + '@@1048576', str(changed), '::/werewolf/a/uki.efi'], 'tamper')
boot('refused', True)
print('pass   secureboot: released disk and manifest agree; enrolled native boot passes posture; tampered UKI refused')
