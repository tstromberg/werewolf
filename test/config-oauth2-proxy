#!/bin/sh
# config-oauth2-proxy DIR: the oauth2-proxy form's config for make check,
# in DIR: a provider the check's machine never reaches, given by hand so
# discovery is not needed, a client, and the two secrets. Nobody can log
# in; the check proves nobody gets past without.
set -eu
d=$1/oauth2-proxy
mkdir -p "$d"
umask 077
openssl rand -base64 24 | tr -d '\n' >"$d/cookie_secret"
printf '%s' werewolf-check-client-secret >"$d/client_secret"
cat >"$d/settings.json" <<JSON
{"provider-url": "https://idp.example.test", "client-id": "werewolf-check",
 "redirect-url": "https://app.example.test/oauth2/callback", "email-domains": ["example.test"],
 "skip-discovery": true, "login-url": "https://idp.example.test/authorize",
 "redeem-url": "https://idp.example.test/token", "jwks-url": "https://idp.example.test/jwks"}
JSON
