#!/usr/bin/env python3
"""Private mirrors must extend public TLS trust, including Fedora's bundle."""
import os
from pathlib import Path
import ssl
import subprocess
import tempfile
import unittest
from unittest.mock import patch
import consumer_trust


class Trust(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        for name in ('system', 'mirror'):
            subprocess.run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-x509',
                            '-days', '1', '-subj', '/CN=' + name, '-keyout', self.root / (name + '.key'),
                            '-out', self.root / (name + '.crt')], check=True, capture_output=True)

    def empty(self):
        return ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)

    def test_missing_python_cafile_retains_system_and_mirror_roots(self):
        with patch.object(consumer_trust.ssl, 'create_default_context', self.empty), \
                patch.object(consumer_trust, 'SYSTEM_BUNDLES', (str(self.root / 'system.crt'),)), \
                patch.dict(os.environ, {}, clear=True):
            roots = consumer_trust.mirror_roots(self.root / 'mirror.crt')
        context = self.empty()
        context.load_verify_locations(cadata=roots.decode())
        self.assertEqual(2, len(context.get_ca_certs(binary_form=True)))
        self.assertIn((self.root / 'system.crt').read_bytes(), roots)
        self.assertIn((self.root / 'mirror.crt').read_bytes(), roots)

    def test_explicit_curl_roots_are_preserved(self):
        with patch.object(consumer_trust.ssl, 'create_default_context', self.empty), \
                patch.object(consumer_trust, 'SYSTEM_BUNDLES', ()), \
                patch.dict(os.environ, {'CURL_CA_BUNDLE': str(self.root / 'system.crt')}, clear=True):
            roots = consumer_trust.mirror_roots(self.root / 'mirror.crt')
        self.assertIn((self.root / 'system.crt').read_bytes(), roots)

    def test_absent_public_trust_refuses_instead_of_trusting_only_the_mirror(self):
        with patch.object(consumer_trust.ssl, 'create_default_context', self.empty), \
                patch.object(consumer_trust, 'SYSTEM_BUNDLES', (str(self.root / 'missing'),)), \
                patch.dict(os.environ, {}, clear=True):
            with self.assertRaisesRegex(RuntimeError, 'public TLS roots'):
                consumer_trust.mirror_roots(self.root / 'mirror.crt')



class Evidence(unittest.TestCase):
    def test_first_boot_matches_the_actual_native_disk_console(self):
        # The native QEMU candidate uses the full slot path, not just its basename.
        lines = ["stage0: Secure Boot enforced outside setup mode",
                 "stage0: Secure Boot admits only this image's signer",
                 "stage0: TPM floor 1: release 1 admitted; reset authority sealed",
                 "stage0: slot a: /boot/slot/a/root.erofs, read-only, verified (root hash 1234…), is the root",
                 "stage0: IPE: only this root image may execute; policy administration removed"]
        consumer_trust.enrolled_boot('\n'.join(lines), 1)
        for omitted in range(len(lines)):
            with self.assertRaises(ValueError):
                consumer_trust.enrolled_boot('\n'.join(line for i, line in enumerate(lines) if i != omitted), 1)
        with self.assertRaises(ValueError):
            consumer_trust.enrolled_boot('\n'.join(lines), 2)

    def updates(self):
        return dict(format='werewolf-update-evidence/1', provider='qemu', arch='x86_64',
                    commit='a' * 40, passed=True,
                    checks={name: True for name in consumer_trust.UPDATE_GATES})

    def boot(self):
        return dict(ready=True, committed=True, paused=True, boot_id='first-boot',
                    cmdline='werewolf.channel=' + 'c' * 64 + ' werewolf.index=7',
                    checks=[dict(id=name, result='pass') for name in consumer_trust.PUBLISHED_CHECKS])

    def admit(self, value):
        return consumer_trust.candidate_boot(value, consumer_trust.PUBLISHED_CHECKS, 'c' * 64, 7)

    def test_only_matching_complete_update_evidence_is_admitted(self):
        consumer_trust.validate_updates(self.updates(), 'qemu', 'x86_64', 'a' * 40)
        for key, wrong in [('format', 'old'), ('passed', 1), ('passed', False),
                           ('provider', 'lima'), ('arch', 'aarch64'), ('commit', 'b' * 40)]:
            with self.subTest(key=key, value=wrong):
                value = self.updates()
                value[key] = wrong
                with self.assertRaises(ValueError):
                    consumer_trust.validate_updates(value, 'qemu', 'x86_64', 'a' * 40)
        for name in consumer_trust.UPDATE_GATES:
            for wrong in (False, 1, None):
                value = self.updates()
                value['checks'][name] = wrong
                with self.assertRaises(ValueError):
                    consumer_trust.validate_updates(value, 'qemu', 'x86_64', 'a' * 40)
            value = self.updates()
            del value['checks'][name]
            with self.assertRaises(ValueError):
                consumer_trust.validate_updates(value, 'qemu', 'x86_64', 'a' * 40)

    def test_candidate_must_commit_and_match_the_signed_release(self):
        self.assertEqual('first-boot', self.admit(self.boot())['boot_id'])
        for key in ('ready', 'committed'):
            for state in (False, 1, None):
                value = self.boot()
                value[key] = state
                self.assertIsNone(self.admit(value))
        for cmdline in ('', 'werewolf.release=' + 'c' * 64,
                        'werewolf.channel=' + 'd' * 64 + ' werewolf.index=7',
                        'werewolf.channel=' + 'c' * 64 + ' werewolf.index=6',
                        self.boot()['cmdline'] + ' werewolf.index=7'):
            value = self.boot()
            value['cmdline'] = cmdline
            with self.assertRaises(ValueError):
                self.admit(value)

    def test_no_protection_or_tamper_probe_can_be_missing_or_failed(self):
        for name in consumer_trust.PUBLISHED_CHECKS:
            value = self.boot()
            value['checks'] = [entry for entry in value['checks'] if entry['id'] != name]
            with self.assertRaises(ValueError):
                self.admit(value)
            value['checks'].append(dict(id=name, result='fail'))
            with self.assertRaises(ValueError):
                self.admit(value)
        value = self.boot()
        value['checks'].append(value['checks'][0])
        with self.assertRaises(ValueError):
            self.admit(value)

unittest.main()
