#!/usr/bin/env python3
"""Check Azure's structured security flags and specialized-image profile."""
import json
import sys


def valid(value):
    if not isinstance(value, dict) or value.get('os', False) is not None:
        return False
    security = value.get('security')
    if not isinstance(security, dict) or security.get('securityType') != 'TrustedLaunch':
        return False
    uefi = security.get('uefiSettings')
    return (isinstance(uefi, dict) and uefi.get('secureBootEnabled') is True
            and uefi.get('vTpmEnabled') is True)


if sys.argv[1:] == ['--test']:
    good = {'os': None, 'security': {'securityType': 'TrustedLaunch',
            'uefiSettings': {'secureBootEnabled': True, 'vTpmEnabled': True}}}
    assert valid(json.loads(json.dumps(good)))
    for field in ['secureBootEnabled', 'vTpmEnabled']:
        for bad in [False, None, 'true', 1]:
            altered = json.loads(json.dumps(good))
            altered['security']['uefiSettings'][field] = bad
            assert not valid(altered)
    altered = json.loads(json.dumps(good))
    altered['os'] = {'linuxConfiguration': {'ssh': {'publicKeys': []}}}
    assert not valid(altered)
    for bad in [None, {}, {'os': None}, {'security': good['security']}]:
        assert not valid(bad)
    print('pass   azure-security: enforcement flags and absent provisioning profile')
else:
    try:
        accepted = valid(json.load(sys.stdin))
    except ValueError:
        accepted = False
    sys.exit(0 if accepted else 1)
