#!/bin/sh
# lima-ci: make ci; run the CI job here, before pushing: test/ci-setup, then make
# test, lint and check, in an Ubuntu VM under Lima, as GitHub runs them.
# Nested virtualization (Apple M3 or later, macOS 15 or later) gives the VM
# KVM; without it QEMU emulates, and the checks take minutes.
#
# LIMA_TEMPLATE picks the Ubuntu, ubuntu-24.04 by default: under 26.04's
# kernel (7.0) and QEMU (10.2), nested guests here lose a CPU's timer early
# in boot and stall (rcu: "timer wakeup didn't happen"), which 24.04's do
# not. GitHub's runners are 26.04, without this nesting.
#
# The VM, werewolf-ci-VERSION, is kept between runs with its tools and build
# cache; `limactl delete -f werewolf-ci-24.04` starts over. The tree is copied in fresh
# each run, without config/ (keys stay on this machine) or .git, so what is
# checked is what is here, committed or not.
set -eu
template=${LIMA_TEMPLATE:-ubuntu-24.04}
vm=werewolf-ci-${template#ubuntu-}
repo=$(cd "$(dirname "$0")/.." && pwd)

if ! limactl list --format '{{.Name}}' | grep -qx "$vm"; then
	limactl create --name "$vm" --tty=false --cpus 8 --memory 8 --nested-virt "template://$template"
fi
[ "$(limactl list --format '{{.Status}}' "$vm")" = Running ] || limactl start "$vm"

# Lima mounts the home directory read-only at the same path, so the tree is
# copied from there. ci-setup runs again only when it has changed.
limactl shell --workdir / "$vm" sh -euc "
	command -v rsync >/dev/null || sudo apt-get install -y -q rsync
	rsync -a --delete --exclude /build --exclude /out --exclude /config --exclude /.git '$repo/' ~/werewolf/
	cd ~/werewolf
	if ! cmp -s test/ci-setup /var/lib/werewolf-ci/ci-setup; then
		sudo test/ci-setup
		sudo install -D -m 0644 test/ci-setup /var/lib/werewolf-ci/ci-setup
	fi
	# /dev/kvm's mode does not outlive a restart of the VM; ci-setup's does.
	[ ! -e /dev/kvm ] || sudo chmod 0666 /dev/kvm
	make test
	make lint
	# A boot takes two CPUs (CHECK_QEMU's -smp 2): one per two, so no guest
	# starves, which nested virtualization makes fatal (RCU stalls).
	make -k -j\$(( (\$(nproc) + 1) / 2 )) check
"
