#!/usr/bin/env python3
"""Keep one shell-free SSH VM running and replace one leashed native test."""
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import secrets
import shutil
import subprocess
import sys
import time

import importlib.machinery
import importlib.util


IDENT = re.compile(r'[a-z][a-z0-9-]*\Z')
CONTROL = '/usr/lib/werewolf/native-iterate'
ROOT = Path.cwd()
loader = importlib.machinery.SourceFileLoader('werewolf_native_tests', str(ROOT / 'test/native-tests'))
spec = importlib.util.spec_from_loader(loader.name, loader)
NATIVE = importlib.util.module_from_spec(spec)
loader.exec_module(NATIVE)


def call(argv, **kwargs):
    return subprocess.run([str(a) for a in argv], check=True, **kwargs)


def local_arch():
    machine = platform.machine().lower()
    if machine in ('arm64', 'aarch64'):
        return 'aarch64'
    if machine in ('x86_64', 'amd64'):
        return 'x86_64'
    raise ValueError('SSH iteration needs an aarch64 or x86_64 host')


def machine_name(form):
    suffix = hashlib.sha256(form.encode()).hexdigest()[:8]
    return 'test-' + form[:18].rstrip('-') + '-' + suffix


def paths(form, arch):
    work = ROOT / 'build/native-iterate' / arch / form
    return work, work / ('native-iterate-' + form), ROOT / 'build/machines' / machine_name(form)


def write(path, data, mode=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    if isinstance(data, (dict, list)):
        data = json.dumps(data, sort_keys=True, indent=2) + '\n'
    if not path.exists() or path.read_text() != data:
        temporary = path.with_name('.' + path.name + '.new')
        temporary.write_text(data)
        temporary.replace(path)
    if mode is not None:
        path.chmod(mode)


def service(driver):
    name = driver['name']
    binary = '/usr/lib/werewolf/' + name
    lines = [
        f'exec {binary} {name} {driver["mode"]} /run/svc/{name}/context',
        'user ' + driver['user'],
        'pledge ' + driver['pledge'],
        'config context /run/config/native-iterate-context',
        f'memory {driver.get("memory", 128)}',
        'nofile 128',
    ]
    for field in ('read', 'connect', 'run'):
        lines.extend(field + ' ' + item for item in driver[field])
    lines.extend('config ' + key + ' ' + value for key, value in driver.get('config', {}).items())
    lines.extend('group ' + group for group in driver.get('groups', []))
    return '\n'.join(lines) + '\n'


def prepare(form, arch, plan):
    work, generated, _ = paths(form, arch)
    # This overlay is generated in full. Recreate it so a removed driver can
    # never leave a runnable descriptor or symlink behind.
    if generated.exists():
        shutil.rmtree(generated)
    root = generated / 'rootfs'
    write(generated / 'form.yaml', NATIVE.form_config(form, plan))
    control = root / CONTROL.removeprefix('/')
    control.parent.mkdir(parents=True, exist_ok=True)
    call(['zig', 'build-exe', '-O', 'ReleaseSafe', '-fstrip',
          '-target', arch + '-linux-musl', str(ROOT / 'test/native/iterate.zig'),
          '-femit-bin=' + str(control)])
    write(root / 'usr/share/werewolf/test-image', 'werewolf-native-iteration/1\n')
    NATIVE.runtime_grants(root, plan['drivers'])
    for driver in plan['drivers']:
        name = driver['name']
        link = root / 'usr/lib/werewolf' / name
        link.parent.mkdir(parents=True, exist_ok=True)
        target = '/run/howl-dev/' + name
        if link.is_symlink() and os.readlink(link) == target:
            pass
        else:
            link.unlink(missing_ok=True)
            link.symlink_to(target)
        write(root / 'usr/share/werewolf/tests' / name / 'service', service(driver))
    return work, generated


def hash_tree(result, path, exclude_tests=False):
    if not path.exists():
        result.update(b'absent\0' + str(path).encode() + b'\0')
        return
    result.update(str(path).encode() + b'\0')
    result.update(str(path.lstat().st_mode & 0o7777).encode() + b'\0')
    if path.is_symlink():
        result.update(b'L' + os.readlink(path).encode() + b'\0')
        return
    if path.is_file():
        result.update(b'F' + path.read_bytes() + b'\0')
        return
    for item in sorted(path.rglob('*')):
        relative = item.relative_to(path)
        if exclude_tests and relative.parts and relative.parts[0] == 'test':
            continue
        result.update(str(path).encode() + b'\0' + str(relative).encode() + b'\0')
        result.update(str(item.lstat().st_mode & 0o7777).encode() + b'\0')
        if item.is_symlink():
            result.update(b'L' + os.readlink(item).encode() + b'\0')
        elif item.is_file():
            result.update(b'F' + item.read_bytes() + b'\0')
        elif item.is_dir():
            result.update(b'D\0')


def fingerprint(form, plan_path, generated):
    call(['make', '--no-print-directory', 'build/host/form'], stdout=subprocess.DEVNULL)
    dirs = call(['build/host/form', 'dirs', form], capture_output=True, text=True).stdout.splitlines()
    result = hashlib.sha256()
    for directory in dirs:
        hash_tree(result, ROOT / directory, exclude_tests=True)
    for path in (
        plan_path,
        ROOT / 'boot',
        ROOT / 'cmd',
        ROOT / 'lib',
        ROOT / 'files.zig',
        ROOT / 'Makefile',
        ROOT / 'build/lock/kernel.lock.json',
        ROOT / 'build/lock/boot.lock.json',
        ROOT / 'build/lock' / (generated.name + '-dev-ssh.lock.json'),
        ROOT / 'test/native/iterate.zig',
        generated,
    ):
        hash_tree(result, path)
    fixture = ROOT / 'forms' / form / 'test/config'
    hash_tree(result, fixture)
    kernel = os.environ.get('KERNEL_ROOTFS')
    if kernel is not None:
        archive = (ROOT / kernel).resolve()
        if not kernel or not archive.is_file():
            raise ValueError('KERNEL_ROOTFS must name a kernel archive')
        hash_tree(result, archive)
    return result.hexdigest()


def load_state(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def remove_machine(howl, name, machine):
    if not machine.exists():
        return
    call([howl, 'delete', name], stdout=subprocess.DEVNULL)


def config_for(form, work, fresh):
    config = work / 'config'
    if fresh and config.exists():
        shutil.rmtree(config)
    config.mkdir(parents=True, exist_ok=True, mode=0o700)
    key = config / 'data.key'
    if not key.exists():
        key.write_bytes(secrets.token_bytes(32))
        key.chmod(0o600)
    fixture = ROOT / 'forms' / form / 'test/config'
    if fixture.exists():
        call([fixture, config])
    return config


def ssh(howl, name, command, *, capture=False, check=True):
    return subprocess.run(
        [howl, 'ssh', name, '--', command],
        check=check,
        capture_output=capture,
        text=True,
    )


def running(howl, name, machine):
    if not machine.exists():
        return False
    return ssh(howl, name, CONTROL + ' ping', capture=True, check=False).returncode == 0


def ensure(howl, form, arch, work, generated, machine, wanted, reset):
    state_path = work / 'state.json'
    state = load_state(state_path)
    changed = state.get('fingerprint') != wanted
    if reset or changed:
        remove_machine(howl, machine_name(form), machine)
        state = {}
    if not running(howl, machine_name(form), machine):
        config = config_for(form, work, reset or changed or not state)
        call([
            howl, 'create', machine_name(form), '--with', generated, '--build', '--dev=ssh',
            '--disable=secureboot,tpm,ipe', '--on', 'qemu', '--config', config,
        ])
        # A first build may create or resolve its package locks. Record the
        # resolved inputs so the next driver edit can reuse this very boot.
        wanted = fingerprint(form, ROOT / 'forms' / form / 'test/native.json', generated)
    if not state.get('run'):
        state['run'] = secrets.token_hex(16)
    state.update(format='werewolf-native-iteration/1', form=form, arch=arch,
                 machine=machine_name(form), fingerprint=wanted)
    write(state_path, state, 0o600)
    return state


def ssh_details(machine, name):
    fields = {}
    for line in (machine / 'machine').read_text().splitlines():
        key, value = line.split(' ', 1)
        fields[key] = value
    if fields.get('dev') != '1':
        raise ValueError(name + ' is not a --dev machine')
    data = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) / 'howl'
    key = data / 'keys/dev/ssh-ed25519'
    if not key.is_file():
        raise ValueError('missing Howl developer key: ' + str(key))
    return fields['ssh'], key


def scp(machine, name, source, destination):
    port, key = ssh_details(machine, name)
    call([
        'scp', '-q', '-F', '/dev/null', '-P', port, '-i', key,
        '-o', 'IdentitiesOnly=yes',
        '-o', 'StrictHostKeyChecking=accept-new',
        '-o', 'UserKnownHostsFile=' + str(machine / 'known_hosts'),
        '-o', 'HostKeyAlias=' + name,
        source, 'root@127.0.0.1:' + destination,
    ])


def compile_driver(form, arch, driver, work):
    output = work / 'drivers' / (driver['name'] + '.new')
    output.parent.mkdir(parents=True, exist_ok=True)
    call([
        'zig', 'build-exe', '-O', 'ReleaseSafe', '-fstrip', '-target', arch + '-linux-musl',
        '--dep', 'test-driver',
        '-Mroot=' + str(ROOT / 'forms' / form / 'test' / driver['source']),
        '-Mtest-driver=' + str(ROOT / 'test/native/driver.zig'),
        '-femit-bin=' + str(output),
    ])
    return output


def wait_paths(howl, name, driver):
    paths = sorted({path for path in driver['read'] + driver['connect']
                    if path.startswith(('/run/svc/', '/data/share/'))})
    for path in paths:
        for _ in range(240):
            command = CONTROL + ' ready ' + path
            if ssh(howl, name, command, capture=True, check=False).returncode == 0:
                break
            time.sleep(0.25)
        else:
            raise ValueError('service path did not appear: ' + path)


def validate_output(text, driver, context):
    expected = set(driver['cases'][context['phase']])
    seen = set()
    for line in text.splitlines():
        if 'werewolf-test: ' not in line:
            continue
        record = json.loads(line.split('werewolf-test: ', 1)[1])
        if record.get('event') != 'case' or record.get('run') != context['run'] or \
                record.get('phase') != context['phase'] or record.get('suite') != driver['name'] or \
                record.get('status') != 'pass' or record.get('case') not in expected or \
                record.get('case') in seen:
            raise ValueError('unexpected test record: ' + line)
        seen.add(record['case'])
    if seen != expected:
        raise ValueError('missing test cases: ' + ', '.join(sorted(expected - seen)))
    return len(seen)


def run_driver(howl, form, arch, driver, phase, work, machine, state):
    name = state['machine']
    binary = compile_driver(form, arch, driver, work)
    context = {'run': state['run'], 'phase': phase}
    context_path = work / 'context.new'
    write(context_path, context, 0o600)
    remote_binary = '/run/howl-dev/.' + driver['name'] + '.new'
    scp(machine, name, binary, remote_binary)
    scp(machine, name, context_path, '/run/config/.native-iterate-context.new')
    ssh(howl, name, CONTROL + ' install ' + driver['name'])
    wait_paths(howl, name, driver)
    command = CONTROL + ' run ' + driver['name']
    result = ssh(howl, name, command, capture=True, check=False)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise ValueError(driver['name'] + ' exited ' + str(result.returncode))
    count = validate_output(result.stdout, driver, context)
    print('native-iterate: ' + driver['name'] + ': ' + str(count) + ' assertions passed')


def main():
    if len(sys.argv) not in (6, 7):
        raise ValueError('usage: native-iterate HOWL FORM ARCH ensure|reset|stop|run PHASE [DRIVER]')
    howl, form, arch, action, phase = sys.argv[1:6]
    driver_name = sys.argv[6] if len(sys.argv) == 7 else None
    if not IDENT.fullmatch(form) or arch not in ('aarch64', 'x86_64') or arch != local_arch():
        raise ValueError('SSH iteration runs the host architecture, aarch64 or x86_64')
    plan_path = ROOT / 'forms' / form / 'test/native.json'
    plan = NATIVE.read_plan(form)
    if phase not in ('seed', 'verify'):
        raise ValueError('phase is seed or verify')
    call(['make', '--no-print-directory', 'build/host/form'], stdout=subprocess.DEVNULL)
    work, generated = prepare(form, arch, plan)
    _, _, machine = paths(form, arch)
    name = machine_name(form)
    if action == 'stop':
        if machine.exists():
            call([howl, 'stop', name])
        return
    wanted = fingerprint(form, plan_path, generated)
    state = ensure(howl, form, arch, work, generated, machine, wanted, action == 'reset')
    if action in ('ensure', 'reset'):
        print('native-iterate: ' + name + ' is ready; use --driver NAME to upload and run a test')
        return
    if action != 'run' or driver_name is None:
        raise ValueError('run needs a driver')
    driver = next((item for item in plan['drivers'] if item['name'] == driver_name), None)
    if driver is None:
        raise ValueError('unknown test driver: ' + driver_name)
    run_driver(howl, form, arch, driver, phase, work, machine, state)


if __name__ == '__main__':
    os.umask(0o077)
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit('native-iterate: ' + str(error))
