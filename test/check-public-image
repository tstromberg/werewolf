#!/usr/bin/env python3
"""Discover, download and operate published QEMU images with no guest test additions."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'release'))
import image_catalog as catalog


def check(howl, target, work):
    form, arch = target['form'], target['arch']
    catalog.namespace(form, 'qemu', arch)
    if os.uname().sysname != 'Linux' or os.uname().machine != arch:
        raise ValueError('public image checks require a native Linux QEMU runner')
    work.mkdir(parents=True, exist_ok=False)
    consumer = Path(tempfile.mkdtemp(prefix='ww-public-', dir='/tmp'))
    machine = consumer / 'build/machines/public-image'
    wrappers = consumer / 'bin'
    wrappers.mkdir()
    for tool in ('apko', 'melange', 'zig', 'make', 'gmake', 'mkfs.erofs', 'mformat', 'mke2fs'):
        path = wrappers / tool
        path.write_text('#!/bin/sh\necho "public consumer attempted a build" >&2\nexit 99\n')
        path.chmod(0o755)
    env = dict(os.environ, XDG_DATA_HOME=str(consumer / 'data'),
               PATH=str(wrappers) + os.pathsep + os.environ['PATH'], PYTHONDONTWRITEBYTECODE='1')
    for name in list(env):
        if name.startswith(('WEREWOLF_BOOT_', 'WEREWOLF_IPE_', 'WEREWOLF_PROTECTED_', 'WEREWOLF_TPM_')) or \
                name in ('UKI_STUB', 'WEREWOLF_BUILD_VM'):
            env.pop(name)
    journal = []
    successful = False

    def run(args, label, required=True, timeout=600):
        result = subprocess.run([str(arg) for arg in args], cwd=consumer, env=env,
                                capture_output=True, timeout=timeout)
        log = work / ('%03d-%s.log' % (len(journal), label))
        log.write_bytes(result.stdout + result.stderr)
        journal.append(dict(label=label, exit=result.returncode, log=log.name))
        if required and result.returncode:
            raise RuntimeError(label + ': ' + result.stderr.decode(errors='replace')[-2000:])
        return result

    def status(previous=None):
        until = time.monotonic() + 240
        while time.monotonic() < until:
            reply = run([howl, 'owner', 'public-image', 'status'], 'status', required=False, timeout=20)
            try:
                value = json.loads(reply.stdout) if reply.returncode == 0 else {}
            except ValueError:
                value = {}
            if value.get('ready') and value.get('committed') and value.get('boot_id') != previous:
                checks = {c['id']: c['result'] for c in value['checks']}
                required = ('boot-secure-boot', 'boot-ipe-enforced', 'boot-rollback-protected',
                            'files-root-verity', 'files-root-readonly', 'files-exec-refused', 'files-system-writes')
                if any(checks.get(name) != 'pass' for name in required):
                    raise RuntimeError('public image reports missing protection: ' + repr(checks))
                run([howl, 'owner', 'public-image', 'pause'], 'pause')
                return value
            time.sleep(2)
        raise RuntimeError('public image did not report a committed protected boot')

    def authority():
        # The host keeps no TPM authority: only the enrolled boot certificate and the
        # machine's profile, which neither a repeat nor a resume may replace.
        return {name: hashlib.sha256((machine / name).read_bytes()).hexdigest()
                for name in ('boot.crt', 'authority/profile.json')}

    try:
        listing = json.loads(run([howl, 'forms', '--published', '--arch', arch, '--json'], 'discovery').stdout)
        row, = [r for r in listing['forms'] if (r['form'], r['provider'], r['arch']) == (form, 'qemu', arch)]
        if (row.get('latest') or {}).get('object') != target['object']:
            raise RuntimeError('signed public catalog does not advertise the published descriptor')
        create = [howl, 'create', 'public-image', '--with', form, '--on', 'qemu', '--yes']
        run(create, 'download-and-boot')
        first = status()
        profile = json.loads((machine / 'authority/profile.json').read_text())
        downloaded = Path(profile['bundle']['directory']) / 'boot.json'
        if catalog.sha(downloaded) != target['descriptor'] or \
                profile['spec']['boot_key'] is not None or profile['spec']['ipe_key'] is not None:
            raise RuntimeError('consumer did not use the expected vendor-signed public image')
        keys = authority()
        run(create, 'repeat')
        if status()['boot_id'] != first['boot_id'] or authority() != keys:
            raise RuntimeError('unchanged public run replaced the boot or owner authority')
        run([howl, 'owner', 'public-image', 'check'], 'authenticated-update-check')
        run([howl, 'stop', 'public-image', '--on', 'qemu'], 'stop')
        run(create, 'resume')
        resumed = status(first['boot_id'])
        if authority() != keys:
            raise RuntimeError('public resume replaced the enrollment')
        run([howl, 'delete', 'public-image', '--on', 'qemu'], 'cleanup')
        if machine.exists():
            raise RuntimeError('public consumer cleanup left the machine behind')
        (work / 'result.json').write_text(json.dumps(dict(target=target, public_download=True,
            source_free_consumer=True, guest_test_additions=False, first_boot=first['boot_id'],
            resumed_boot=resumed['boot_id'], retained_authority=True, authenticated_update_check=True,
            scope='Public R2 discovery, native admission, protected boots and the machine\'s own check of the public channel'), indent=2) + '\n')
        successful = True
        print('pass: public %s/qemu/%s discovery, protected boot, reuse, update check and resume' % (form, arch), flush=True)
    finally:
        if machine.exists():
            run([howl, 'stop', 'public-image', '--on', 'qemu'], 'retain-failure', required=False)
        (work / 'commands.json').write_text(json.dumps(journal, indent=2) + '\n')
        if successful:
            shutil.rmtree(consumer)
        else:
            (work / 'retained-consumer.txt').write_text(str(consumer) + '\n')


if __name__ == '__main__':
    if len(sys.argv) != 4:
        sys.exit('usage: check-public-image HOWL TARGETS_JSON OUTPUT')
    howl = Path(sys.argv[1]).resolve()
    targets, output = json.loads(sys.argv[2]), Path(sys.argv[3]).resolve()
    failed = False
    for target in targets:
        try:
            check(howl, target, output / (target['form'] + '-' + target['arch']))
        except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
            print('FAIL public image: ' + str(error), file=sys.stderr, flush=True)
            failed = True
    sys.exit(1 if failed else 0)
