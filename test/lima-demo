#!/bin/sh
# lima-demo runs the demo form in a Lima VM, made as a user makes one, with
# `howl create` (docs/design/cli.md). The VM has its own boot disk, boots
# under UEFI, and uses vzNAT, which this Mac reaches directly; the demo runs
# no ssh for Lima to forward through. The demo updates itself, keeps /data
# on its disk and scans with grype. `make demo` and `make demo-delete` use
# it; see forms/demo/README.md.
#
#   lima-demo          create the VM, or restart one made before, and print
#                      the page's URL once it answers
#   lima-demo delete   delete the VM, and the /data it kept
set -eu
vm=werewolf-demo
howl=build/host/howl

say() { echo "lima-demo: $*"; }
die() {
	say "$*" >&2
	exit 1
}
[ -x "$howl" ] || die "no $howl; make howl"
if [ "${1:-}" = delete ]; then
	exec "$howl" delete "$vm" --on lima
fi
[ $# -eq 0 ] || die "usage: lima-demo | delete"

made=$("$howl" create "$vm" --with demo --on lima) || die "howl create failed; its output is above"
addr=$(echo "$made" | cut -f2)

say "waiting for the page at http://$addr/"
i=0
until curl -fsS -m 3 -o /dev/null "http://$addr/" 2>/dev/null; do
	i=$((i + 1))
	[ $i -le 120 ] || die "no page after 10 minutes; the console: $howl console $vm"
	sleep 5
done
say "up. The first scan follows grype's database download, about a minute"
say "the demo: http://$addr/"
