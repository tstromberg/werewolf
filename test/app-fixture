#!/bin/sh
# app-fixture FORM DIR stages an application for the supplied-code boot.
# DIR is a disposable root overlay, separate from the form's shipped image.
set -eu
form=$1
dest=$2
source=$(awk -v form="$form" '$1 == form { print $2 }' test/app-fixtures)
[ -n "$source" ] || { echo "app-fixture: no fixture for $form" >&2; exit 1; }
mkdir -p "$dest"
if [ "$source" = java ]; then
    mkdir -p "$dest/usr/lib/app" "$dest/classes"
    javac -source 8 -target 8 -d "$dest/classes" test/app-fixture-java/Main.java
    jar cfe "$dest/usr/lib/app/app.jar" Main -C "$dest/classes" .
    # Only the application jar belongs in the verified root.
    rm -rf "$dest/classes"
else
    cp -R "$source/." "$dest/"
fi
