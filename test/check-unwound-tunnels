#!/usr/bin/env python3
"""Run real DNS tunnel clients against local servers, direct and through unwound.

Usage: sudo python3 test/check-unwound-tunnels FENCE UNWOUND SHELLACK_SERVER SHELLACK_CLIENT

Linux only. iodine, iodined, dns2tcpc, dns2tcpd, nslookup and timeout must be
installed. SHELLACK_SERVER is a locally built Linux binary from
~/src/shellack/cmd/server. No external network or DNS service is used.
"""
import atexit
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import time

here = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader('check_unwound_base', str(here / 'check-unwound'))
spec = importlib.util.spec_from_loader(loader.name, loader)
base = importlib.util.module_from_spec(spec)
loader.exec_module(base)

# Separate services make a refused tunnel's budget independent of the others.
base.POLICY = '''listen tcp 53 loopback
dns 54
lookup 0 * A AAAA
lookup 2002 * TXT
lookup 2003 * SRV CAA
'''


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def client(args, *, uid=None, seconds=8, input=None, env=None):
    """A successful tunnel stays up, so timeout is an expected result."""
    argv = ['timeout', '-s', 'TERM', str(seconds), *args]
    return subprocess.run(argv, input=input, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, text=True, env=env,
                          preexec_fn=(lambda: os.setuid(uid)) if uid is not None else None)


def config(address, port):
    # Inverse of shellack.sh's `tr 012. .201` configuration decoding.
    return f'-port={port} {address}'.translate(str.maketrans({'.': '0', '2': '1', '0': '2', '1': '.'}))


def checks(client_process, work):
    # BIND's nslookup in the lab VM rejects the base fixture's /etc tmpfs symlink.
    Path('/etc/resolv.conf').unlink()
    Path('/etc/resolv.conf').write_text('nameserver 127.0.0.53\n')
    servers = []
    magic = f'unwound-test-{os.getpid()}'
    shellack_file = Path('/tmp') / f'{magic}.aiff'
    def stop():
        for p in servers:
            if p.poll() is None:
                p.terminate()
        for p in servers:
            if p.poll() is None:
                p.wait(timeout=5)
    atexit.register(stop)
    def start(args, log):
        output = open(work / log, 'w')
        p = subprocess.Popen(['ip', 'netns', 'exec', 'unwound-peer', *args],
                             stdout=output, stderr=subprocess.STDOUT)
        output.close()
        servers.append(p)
        time.sleep(0.3)
        assert p.poll() is None, (args, (work / log).read_text())
        return p

    for last in (3, 4, 5):
        run(['ip', '-n', 'unwound-peer', 'addr', 'add', f'10.53.0.{last}/24', 'dev', 'peer'])
    def redirect(address, port=53):
        # Fence admits the sole DHCP resolver .2. In the private peer
        # namespace, NAT gives each real tunnel server that same endpoint.
        run(['ip', 'netns', 'exec', 'unwound-peer', '/usr/sbin/iptables-nft', '-t', 'nat',
             '-I', 'PREROUTING', '-d', '10.53.0.2', '-p', 'udp', '--dport', '53',
             '-j', 'DNAT', '--to-destination', f'{address}:{port}'])
    (work / 'dns2tcpd.conf').write_text('''listen = 10.53.0.4
port = 53
user = nobody
chroot = /tmp
domain = tunnel.test
resources = echo:10.53.0.4:16000
''')
    # dns2tcpd drops to nobody after binding its socket.
    Path('/etc/passwd').write_text('root:x:0:0:root:/root:/bin/sh\n'
                                   'nobody:x:65534:65534::/tmp:/bin/sh\n')
    Path('/etc/group').write_text('root:x:0:\nnogroup:x:65534:\n')
    # The base test mounts an empty /etc. Ubuntu's awk is an alternatives
    # symlink, so restore that link for shellack's shell pipeline.
    Path('/etc/alternatives').mkdir()
    Path('/etc/alternatives/awk').symlink_to('/usr/bin/mawk')

    start(['iodined', '-f', '-l', '10.53.0.3', '-P', 'local-test',
           '10.88.0.1', 'tunnel.test'], 'iodined.log')
    echo_server = '''import socket
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('10.53.0.4', 16000))
s.listen()
while True:
    c, _ = s.accept()
    with c:
        while data := c.recv(4096):
            c.sendall(data)
'''
    start([sys.executable, '-u', '-c', echo_server], 'echo.log')
    start(['dns2tcpd', '-F', '-f', str(work / 'dns2tcpd.conf')], 'dns2tcpd.log')
    # shellack's server binds all interfaces, so it uses another port. The
    # private namespace redirects only requests to its dedicated .5 address.
    start([sys.argv[4], '10553', 'printf shellack-ok'], 'shellack.log')
    try:
        iodine = ['iodine', '-r', '-f', '-P', 'local-test', '-T', 'A']
        direct = client(['ip', 'netns', 'exec', 'unwound-peer', *iodine,
                         '10.53.0.3', 'tunnel.test'], seconds=12)
        assert 'Connection setup complete' in direct.stdout, ('iodine direct', direct.stdout,
                                                                 (work / 'iodined.log').read_text())
        print('iodine direct: connected', flush=True)
        redirect('10.53.0.3')
        screened = client([*iodine, '127.0.0.53', 'tunnel.test'], seconds=8)
        assert 'Connection setup complete' not in screened.stdout, ('iodine through unwound', screened.stdout)
        print('iodine screened:', screened.stdout.strip()[-180:], flush=True)

        # Listing resources uses a real dns2tcp exchange before any resource
        # opens. Its default TXT transport is explicitly granted to the
        # screened service, so refusal tests screening rather than type policy.
        dns2tcp = ['dns2tcpc', '-z', 'tunnel.test']
        direct = client(['ip', 'netns', 'exec', 'unwound-peer', *dns2tcp, '10.53.0.4'])
        assert 'echo' in direct.stdout, ('dns2tcp direct', direct.stdout,
                                         (work / 'dns2tcpd.log').read_text())
        tunnel = subprocess.Popen(['ip', 'netns', 'exec', 'unwound-peer', *dns2tcp,
                                   '-r', 'echo', '-l', '16001', '10.53.0.4'],
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        try:
            echo_probe = '''import socket, time
for attempt in range(50):
    try:
        s = socket.create_connection(('127.0.0.1', 16001), timeout=1)
        s.settimeout(4)
        s.sendall(b'dns2tcp-ok\\n')
        print(s.recv(100).decode(), end='')
        break
    except OSError:
        time.sleep(.1)
else:
    raise SystemExit('dns2tcp local port never became ready')
'''
            direct_data = subprocess.run(['ip', 'netns', 'exec', 'unwound-peer', sys.executable,
                                          '-c', echo_probe], capture_output=True, text=True, timeout=12)
            assert 'dns2tcp-ok' in direct_data.stdout, ('dns2tcp direct data', direct_data,
                                                         (work / 'dns2tcpd.log').read_text())
        finally:
            tunnel.terminate()
            tunnel.communicate(timeout=5)
        print('dns2tcp direct: data echoed', flush=True)
        redirect('10.53.0.4')
        screened = client([*dns2tcp, '127.0.0.53'], uid=2002)
        assert 'echo' not in screened.stdout, ('dns2tcp through unwound', screened.stdout)
        print('dns2tcp screened:', screened.stdout.strip()[-180:], flush=True)

        shellack_env = dict(os.environ, TMPDIR='/tmp', MAGIC_WORD=magic)
        shellack_file.write_text(config('10.53.0.5', 10553))
        direct = client(['ip', 'netns', 'exec', 'unwound-peer', '/bin/sh', sys.argv[5]],
                        seconds=9, env=shellack_env)
        assert 'shellack-ok' in direct.stdout, ('shellack direct', direct.stdout,
                                                (work / 'shellack.log').read_text())
        assert 'decode <nil>: shellack-ok' in (work / 'shellack.log').read_text(), \
            ('shellack return message', (work / 'shellack.log').read_text())
        print('shellack direct: command ran', flush=True)
        shellack_file.write_text(config('127.0.0.53', 53))
        redirect('10.53.0.5', 10553)
        screened = client(['/bin/sh', sys.argv[5]], uid=2003, seconds=7, env=shellack_env)
        assert 'shellack-ok' not in screened.stdout, ('shellack through unwound', screened.stdout)
        print('shellack screened:', screened.stdout.strip()[-180:], flush=True)

        audit = [json.loads(line.split(': ', 1)[1]) for line in (work / 'audit').read_text().splitlines()
                 if ': ' in line]
        iodine_empty = [a for a in audit if a.get('uid') == 0 and a.get('why') == 'screened'
                        and a.get('type') == 'A' and a.get('answers') == 0]
        assert iodine_empty, ('iodine', audit)
        dns2tcp_denied = [a for a in audit if a.get('uid') == 2002 and a.get('decision') == 'deny'
                          and a.get('why') in ('tunnel', 'budget', 'malformed')]
        assert dns2tcp_denied, ('dns2tcp', audit)
        shellack_trimmed = [a for a in audit if a.get('uid') == 2003 and a.get('dropped_shape', 0) > 0]
        assert shellack_trimmed, ('shellack', audit)
        print('check-unwound-tunnels: direct sessions worked; all three screened sessions stopped')
    finally:
        stop()
        shellack_file.unlink(missing_ok=True)


base.checks = checks
if __name__ == '__main__':
    if len(sys.argv) == 7 and sys.argv[1] == '--inside':
        base.inside(sys.argv[2], sys.argv[3], sys.argv[6])
    elif len(sys.argv) == 5:
        if sys.platform != 'linux' or os.geteuid() != 0:
            sys.exit('check-unwound-tunnels needs Linux and root')
        run(['unshare', '--net', '--mount', '--fork', sys.executable, str(Path(__file__).resolve()),
             '--inside', *[str(Path(arg).resolve()) for arg in sys.argv[1:]],
             os.readlink('/proc/self/ns/net')])
    else:
        sys.exit(__doc__)
