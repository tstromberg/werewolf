#!/usr/bin/env python3
"""Boot identical vendor artifacts in independent Lima enrollments, without vendor keys."""
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlsplit
from publisher_transport import connection as publisher_connection

howl, kernel, policy_key, policy_cert, stub, output = sys.argv[1:]
howl, kernel, policy_key, policy_cert, stub = [str(Path(p).resolve())
    for p in (howl, kernel, policy_key, policy_cert, stub)]
for path in (howl, kernel, policy_key, policy_cert, stub):
    if not Path(path).is_file():
        sys.exit('shared boot: required input is missing: ' + path)
work = Path(output).resolve()
work.mkdir(mode=0o700, parents=True, exist_ok=False)
os.umask(0o077)
lima_home = Path(tempfile.mkdtemp(prefix='ww-shared-boot-', dir='/tmp'))
names = ['ww-published-' + secrets.token_hex(5) for _ in range(2)]
env = dict(os.environ, LIMA_HOME=str(lima_home), UKI_STUB=stub, PYTHONDONTWRITEBYTECODE='1',
           XDG_DATA_HOME=str(work / 'host-data'))
consumers = {name: work / 'consumers' / name for name in names}
for directory in consumers.values():
    directory.mkdir(parents=True)
for variable in ('WEREWOLF_BOOT_KEY', 'WEREWOLF_BOOT_CRT', 'WEREWOLF_BOOT_STATE',
                 'WEREWOLF_IPE_KEY', 'WEREWOLF_IPE_CRT', 'WEREWOLF_IPE_KERNEL'):
    env.pop(variable, None)
with socket.socket() as probe:
    probe.bind(('127.0.0.1', 0))
    port = probe.getsockname()[1]
channel = 'https://192.168.5.2:%d/playground' % port
service = work / 'host-data/howl/permit-service/private' / str(port)
commands = work / 'commands.jsonl'
commands.touch()
wrappers = work / 'bin'
wrappers.mkdir()
for tool in ('apko', 'melange', 'zig', 'make', 'gmake', 'mkfs.erofs', 'mformat',
             'mke2fs', 'zstd', 'openssl', 'osslsigncode'):
    actual = shutil.which(tool)
    if not actual:
        continue
    path = wrappers / tool
    path.write_text('#!/usr/bin/env python3\nimport os,sys,json\nwith open(' + repr(str(commands)) +
        ',"a") as f: f.write(json.dumps([os.path.basename(sys.argv[0]),*sys.argv[1:]])+"\\n")\n' +
        'os.execv(' + repr(actual) + ',[' + repr(actual) + ',*sys.argv[1:]])\n')
    path.chmod(0o755)
ssh_key = work / 'ssh.key'
actual_ssh = shutil.which('ssh')
ssh = wrappers / 'ssh'
ssh.write_text('#!/usr/bin/env python3\nimport os,sys\nos.execv(' + repr(actual_ssh) + ',' +
    repr([actual_ssh, '-F', '/dev/null', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes',
          '-i', str(ssh_key)]) + '+sys.argv[1:])\n')
ssh.chmod(0o755)
env['PATH'] = str(wrappers) + os.pathsep + env['PATH']
code_key, image_key = work / 'vendor-boot.key', work / 'vendor-image.key'
code_cert = work / 'vendor-boot.crt'
image_cert = work / 'vendor-image.crt'
producer = work / 'producer'
form = work / 'form'
overlay = form / 'rootfs/usr/bin'
overlay.mkdir(parents=True)
label_file = form / 'rootfs/usr/share/werewolf/ab-release'
label_file.parent.mkdir(parents=True)
label_file.write_text('A\n')
(form / 'form.yaml').write_text('base: playground\nweaknesses:' +
    Path('forms/playground/form.yaml').read_text().split('weaknesses:', 1)[1])


def run(args, label, check=True, timeout=600, machine=None):
    result = subprocess.run(list(map(str, args)), env=env, cwd=consumers.get(machine),
                            capture_output=True, timeout=timeout)
    with (work / (label + '.log')).open('ab') as log:
        log.write(result.stdout + result.stderr)
    if check and result.returncode:
        raise RuntimeError(label + ': ' + result.stderr.decode(errors='replace')[-2400:])
    return result


def ssh_run(name, command, label, **kwargs):
    check = kwargs.pop('check', True)
    result = run([howl, 'ssh', name, '--', command], label, check=False, machine=name, **kwargs)
    if check and result.returncode:
        run([howl, 'ssh', name, '--', '/usr/lib/werewolf/slot-update outcome'],
            name + '-failure-outcome', check=False, timeout=15, machine=name)
        run([howl, 'ssh', name, '--', 'cat /data/svc/autoupdate/log'],
            name + '-updater-log', check=False, timeout=15, machine=name)
        raise RuntimeError(label + ': ' + result.stderr.decode(errors='replace')[-2400:])
    return result


def wait(name, release, previous=None, anchor=None):
    until = time.monotonic() + 240
    while time.monotonic() < until:
        try:
            reply = ssh_run(name, '/usr/bin/ab-status', name + '-status', check=False, timeout=10)
            value = json.loads(reply.stdout) if reply.returncode == 0 else None
        except (ValueError, subprocess.TimeoutExpired):
            value = None
        if value and value['committed'] and value['release'] == release and value['boot_id'] != previous:
            if not all(value[flag] for flag in ('secure_boot', 'ipe', 'verified_root', 'rollback_protected')):
                raise RuntimeError('guest protection missing: ' + repr(value))
            paused = ssh_run(name, 'test -e /run/werewolf/updater-ready && sv pause /etc/sv/autoupdate',
                             name + '-pause', check=False, timeout=10)
            if paused.returncode:
                time.sleep(2)
                continue
            if anchor is not None and value['tpm_anchor'] != anchor:
                raise RuntimeError('rollback changed protected authorization')
            with (work / 'evidence.jsonl').open('a') as stream:
                stream.write(json.dumps(dict(machine=name, **value)) + '\n')
            print('pass: %s %s, four protections, exact measured identity' % (name, release), flush=True)
            return value
        time.sleep(2)
    raise RuntimeError(name + ' did not commit ' + release)


def unavailable(yes):
    for key in (code_key, image_key):
        source, target = (key, key.with_suffix('.unavailable')) if yes else (key.with_suffix('.unavailable'), key)
        source.rename(target)


def operations():
    return [json.loads(line) for line in commands.read_text().splitlines()]


def no_build(before):
    builders = ('apko', 'melange', 'zig', 'make', 'gmake', 'mkfs.erofs', 'mformat', 'mke2fs')
    for entry in operations()[before:]:
        if entry[0] in builders or (entry[0] == 'zstd' and '-d' not in entry):
            raise RuntimeError('consumer invoked a builder: ' + repr(entry))
        if entry[0] == 'osslsigncode' and entry[1] != 'verify':
            raise RuntimeError('consumer signed code')
        if entry[0] == 'openssl' and '-sign' in entry and entry[entry.index('-sign') + 1] in map(str, (code_key, image_key)):
            raise RuntimeError('consumer used a vendor signing key')


def produce(label):
    label_file.write_text(label + '\n')
    serial = '20261013T12000' + str(ord(label) - ord('A')) + 'Z'
    disk = producer / ('disk-' + label + '.raw')
    args = [howl, '_build', '--with', form, '--arch', 'aarch64', '--build', producer,
            '--ipe-kernel', kernel, '--ipe-key', image_key, '--ipe-cert', image_cert,
            '--ipe-updates', channel, '--image-serial', serial,
            '--boot-key', code_key, '--boot-cert', code_cert, '--boot-native', '--tpm-firmware',
            '--permit-host', '192.168.5.2', '--permit-port', str(port), '--disk', disk,
            '--disk-args', 'console=ttyAMA0 werewolf.ip=192.168.5.15/24 werewolf.gw=192.168.5.2 werewolf.dns=192.168.5.3', 'disk']
    run(args, 'produce-' + label, timeout=1200)
    bundle = work / ('image-' + label)
    cfg = dict(form='playground', arch='aarch64', disk=str(disk), slot=str(producer / 'form-ipe/slot'),
               configuration_form=str(form),
               head=str(producer / 'form-ipe/prebuilt/aarch64'), output=str(bundle),
               image_key=str(image_key), image_certificate=str(image_cert), boot_certificate=str(code_cert),
               channel=channel, permit_host='192.168.5.2', permit_port=port)
    config_file = work / ('produce-' + label + '.json')
    config_file.write_text(json.dumps(cfg))
    run([howl, '_boot-image', 'seal', config_file], 'seal-' + label)
    config_file.unlink()
    disk.unlink()
    print('pass: sealed vendor image ' + label, flush=True)
    return bundle


def update(name, label, previous):
    ssh_run(name, '/usr/lib/werewolf/slot-update check', name + '-check-' + label)
    ssh_run(name, '/usr/lib/werewolf/slot-update try', name + '-try-' + label, check=False, timeout=30)
    current = wait(name, label, previous['boot_id'])
    if current['tpm_anchor'] == previous['tpm_anchor']:
        raise RuntimeError('update did not extend protected authorization')
    return current


def shared_head(config):
    connection = publisher_connection(config)
    try:
        connection.request('GET', urlsplit(channel).path + '/aarch64/latest.json')
        response = connection.getresponse()
        body = response.read()
        if response.status != 200:
            raise RuntimeError('shared channel head refused: %d' % response.status)
        return body
    finally:
        connection.close()


try:
    shutil.copyfile(policy_key, image_key)
    shutil.copyfile(policy_cert, image_cert)
    run(['openssl', 'req', '-newkey', 'rsa:4096', '-nodes', '-x509', '-sha256', '-days', '2',
         '-subj', '/CN=werewolf-shared-vendor', '-keyout', code_key, '-out', code_cert], 'vendor-key')
    run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', ssh_key], 'ssh-key')
    run(['zig', 'build-exe', '-O', 'ReleaseSafe', '-fPIE', '-target', 'aarch64-linux-musl',
         '--dep', 'cmdline', '--dep', 'ipe', '--dep', 'tpm', '-Mroot=test/ab-status.zig',
         '--dep', 'network', '-Mcmdline=lib/cmdline.zig', '-Mnetwork=lib/network.zig', '-Mipe=lib/ipe.zig',
         '--dep', 'apk', '-Mtpm=lib/tpm.zig', '--dep', 'package', '-Mapk=lib/apk.zig',
         '-Mpackage=lib/package.zig', '-femit-bin=' + str(overlay / 'ab-status')], 'probe')
    for path in form.rglob('*'):
        path.chmod(0o755 if path.is_dir() or path.name == 'ab-status' else 0o644)
    image_a = produce('A')
    unavailable(True)
    states = []
    before = len(operations())
    for name in names:
        config = work / (name + '.tar')
        run([howl, 'pack', '--build', '--with', 'playground', '--hostname', name,
             '--root-keys', str(ssh_key) + '.pub', '-o', config], name + '-pack')
        run([howl, '_enroll-image', name, image_a, code_cert, image_cert, channel, config, 'lima'],
            name + '-enroll', machine=name)
        states.append(wait(name, 'A'))
    no_build(before)
    if states[0]['release_id'] != states[1]['release_id'] or states[0]['pcr11'] != states[1]['pcr11']:
        raise RuntimeError('machines did not boot identical signed code')
    authorities = [consumers[name] / 'build/machines' / name / 'authority' for name in names]
    factories = [(path / 'factory.permit').read_bytes() for path in authorities]
    if factories[0][16:48] == factories[1][16:48] or states[0]['tpm_anchor'] == states[1]['tpm_anchor']:
        raise RuntimeError('machines share enrollment')
    if (authorities[0] / 'permit.pub').read_bytes() == (authorities[1] / 'permit.pub').read_bytes():
        raise RuntimeError('machines share owner keys')
    for name in names:
        if (consumers[name] / 'build/machines' / name / 'boot.key').exists():
            raise RuntimeError('consumer has a vendor private boot key')
    print('pass: same artifact, distinct owner keys, nonces and TPM anchors', flush=True)
    unavailable(False)
    image_b = produce('B')
    unavailable(True)
    before = len(operations())
    for name in names:
        run([howl, '_accept-image', name, image_b], name + '-accept-B', machine=name)
    cfg = json.loads((authorities[0] / 'publisher.json').read_text())
    head = shared_head(cfg)
    (work / 'shared-head.log').write_bytes(head)
    updated = [update(name, 'B', state) for name, state in zip(names, states)]
    for name, state in zip(names, updated):
        ssh_run(name, '/usr/lib/werewolf/slot-update try', name + '-rollback', check=False, timeout=30)
        wait(name, 'A', state['boot_id'], state['tpm_anchor'])
        rejected = run([howl, '_accept-image', name, image_a], name + '-replay', check=False, machine=name)
        if rejected.returncode == 0:
            raise RuntimeError('accepted an older vendor head')
    no_build(before)
    # Removing one registration must not stop the other machine's shared issuer.
    run([howl, 'delete', names[0], '--on', 'lima'], names[0] + '-delete', machine=names[0])
    reply = ssh_run(names[1], '/usr/bin/ab-status', names[1] + '-still-running')
    if not json.loads(reply.stdout)['rollback_protected']:
        raise RuntimeError('deleting one machine affected another enrollment')
    if shared_head(cfg) != head:
        raise RuntimeError('deleting one machine stopped the shared issuer')
    (work / 'result.json').write_text(json.dumps({'same_vendor_artifact': True,
        'independent_machine_authorities': True, 'independent_consumer_directories': True,
        'vendor_keys_unavailable_to_consumer': True,
        'no_consumer_builds': True, 'ab_update_and_operator_rollback': True,
        'shared_service_survives_one_machine_removal': True}, indent=2) + '\n')
finally:
    for name in names:
        machine = consumers[name] / 'build/machines' / name
        if machine.exists():
            console = lima_home / name / 'serial.log'
            if console.exists():
                shutil.copyfile(console, work / (name + '-console.log'))
            result = subprocess.run([howl, 'delete', name, '--on', 'lima'], env=env, cwd=consumers[name],
                                    capture_output=True, timeout=120)
            (work / (name + '-cleanup.log')).write_bytes(result.stdout + result.stderr)
    if not any((lima_home / name).exists() for name in names):
        shutil.rmtree(lima_home)
    if service.exists() and not any((service / 'registry').glob('*.json')):
        for path in service.glob('*.log'):
            shutil.copyfile(path, work / ('service-' + path.name))
        shutil.rmtree(service)
    for private in (ssh_key, code_key, image_key, code_key.with_suffix('.unavailable'), image_key.with_suffix('.unavailable')):
        private.unlink(missing_ok=True)
