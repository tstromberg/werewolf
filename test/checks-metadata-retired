# A cloud account is present at boot, then absent from the next metadata
# generation. Polling locks it but retains its numeric identity and home.
ok  services-up      i=0; while sv status /etc/sv/* | grep -qE 'want up|^fail'; do i=$((i + 1)); [ $i -le 30 ] || break; sleep 1; done; ! sv status /etc/sv/* | grep -qE 'want up|^fail'
ok  initial-active   grep -q '^tom:\*:' /etc/shadow && grep -q tom@yubikey /run/werewolf/keys/tom && grep -qx 'p tom 654612137 654612137' /data/.werewolf/identities
ok  failed-removal   cp /run/werewolf/cloud/config.tar /tmp/retire-before.tar && mv /run/werewolf/keys/tom /tmp/retired-tom-key && mkdir /run/werewolf/keys/tom && i=0; until grep -q '^tom:!:' /etc/shadow; do i=$((i + 1)); [ $i -le 150 ] || exit 1; sleep 1; done; sleep 2; [ -d /run/werewolf/keys/tom ] && cmp -s /tmp/retire-before.tar /run/werewolf/cloud/config.tar
ok  person-retired   rmdir /run/werewolf/keys/tom && mv /tmp/retired-tom-key /run/werewolf/keys/tom && i=0; while cmp -s /tmp/retire-before.tar /run/werewolf/cloud/config.tar; do i=$((i + 1)); [ $i -le 150 ] || exit 1; sleep 1; done; grep -q '^tom:x:654612137:654612137::/data/home/tom:/sbin/nologin$' /etc/passwd && grep -q '^tom:x:654612137:$' /etc/group && ! grep -q '^tom$' /run/werewolf/people
ok  access-revoked   [ ! -e /run/werewolf/keys/tom ] && ! grep -q tom@yubikey /run/werewolf/keys/root && grep -q werewolf-check-key /run/werewolf/keys/root
ok  identity-kept    grep -qx 'p tom 654612137 654612137' /data/.werewolf/identities && [ "$(stat -c '%u:%g:%a' /data/home/tom)" = 654612137:654612137:700 ]
