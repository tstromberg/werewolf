def inside(fence, unwound, parent_net, age_binary=None):
    assert os.readlink('/proc/self/ns/net') != parent_net
    age_live = os.environ.get('AGE_LIVE_TEST') == '1'
    openssl_config = Path('/etc/ssl/openssl.cnf').read_bytes() if age_live else None
    run(['mount', '--make-rprivate', '/'])
    with tempfile.TemporaryDirectory(prefix='werewolf-unwound-') as name:
        work = Path(name)
        work.chmod(0o755)
        binaries = work / 'bin'
        binaries.mkdir(mode=0o755)
        shutil.copyfile(unwound, binaries / 'unwound')
        (binaries / 'unwound').chmod(0o755)
        driver = work / 'driver.py'
        driver.write_text(DRIVER)
        driver.chmod(0o644)
        for f in ['audit', 'stderr', 'upstream.log']:
            (work / f).touch(mode=0o666)
        run(['mount', '--bind', str(binaries), '/usr/local/bin'])
        for directory in ['/run', '/etc', '/usr/share', '/var']:
            run(['mount', '-t', 'tmpfs', 'tmpfs', directory])
        if age_live:
            Path('/etc/ssl').mkdir()
            Path('/etc/ssl/openssl.cnf').write_bytes(openssl_config)
        Path('/var/empty').mkdir(mode=0o755)
        policy = Path('/usr/share/werewolf/net')
        policy.parent.mkdir()
        age_test = os.environ.get('AGE_TEST') == '1' or age_live
        policy.write_text(POLICY + ('''lookup 55 * A AAAA unfiltered
connect 55 tcp 443 public
''' if age_live else ''))
        if age_test:
            (policy.parent / 'age-enforce').write_text('enforce\n')
            Path('/data').mkdir(exist_ok=True)
            run(['mount', '-t', 'tmpfs', 'tmpfs', '/data'])
            age_dir = Path('/data/svc/unwound-age')
            age_dir.mkdir(parents=True)
            age_db = sqlite3.connect(age_dir / 'age.db')
            age_db.executescript((Path(__file__).resolve().parents[1] /
                                   'cmd/unwound/age.sql').read_text())
            age_db.execute('PRAGMA journal_mode=WAL')
            now = int(time.time())
            for domain, status, effective in (() if age_live else (
                ('example.com', 'valid', 946684800),
                ('young.com', 'valid', now - 86400),
                ('example.net', 'unknown', None),
            )):
                age_db.execute('''INSERT INTO domain_age
                    (domain,source,status,registered_at,effective_at,fetched_at,
                     retry_after,last_used_at,psl_generation,bootstrap_generation)
                    VALUES (?,?,?,?,?,?,?,?,?,?)''',
                    (domain, 'rdap', status, effective, effective, now,
                     now + 86400, now, 'fixture', 'fixture'))
            if age_live:
                # Evidence expires while the screened DNS answers remain cached.
                expires = now + 30
                for domain, source, status, lifetime in (
                    ('expires.com', 'rdap', 'valid', 7 * 86400),
                    ('ctexpires.com', 'crtsh', 'history', 86400),
                ):
                    date = 946684800
                    age_db.execute('''INSERT INTO domain_age
                        (domain,source,status,registered_at,effective_at,ct_first_seen_at,
                         fetched_at,retry_after,last_used_at,psl_generation,bootstrap_generation)
                        VALUES (?,?,?,?,?,?,?,?,?,?,?)''',
                        (domain, source, status, date if source == 'rdap' else None,
                         date if source == 'rdap' else None, date if source == 'crtsh' else None,
                         expires - lifetime, expires + 1, now, 'fixture', 'fixture'))
            age_db.commit()
            age_db.close()
            os.chown(age_dir, 55, 55)
            os.chmod(age_dir, 0o700)
            for entry in age_dir.iterdir():
                os.chown(entry, 55, 55)
            Path('/run/werewolf-age').mkdir()
        network = Path('/run/werewolf/network')
        network.mkdir(parents=True)
        (network / 'resolv.conf').write_text('nameserver 127.0.0.53\n')
        (network / 'upstream').write_text('nameserver ' + UPSTREAM + '\n')
        Path('/etc/resolv.conf').symlink_to('/run/werewolf/network/resolv.conf')
        if age_live:
            ca_key, ca_cert = work / 'ca.key', work / 'ca.crt'
            server_key, server_csr, server_cert = work / 'server.key', work / 'server.csr', work / 'server.crt'
            run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '1',
                 '-keyout', str(ca_key), '-out', str(ca_cert), '-subj', '/CN=unwound-age-test-ca',
                 '-addext', 'basicConstraints=critical,CA:TRUE'], stderr=subprocess.DEVNULL)
            run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-keyout', str(server_key),
                 '-out', str(server_csr), '-subj', '/CN=rdap.verisign.com'], stderr=subprocess.DEVNULL)
            ext = work / 'server.ext'
            ext.write_text('subjectAltName=DNS:rdap.verisign.com,DNS:crt.sh\n'
                           'basicConstraints=CA:FALSE\n'
                           'extendedKeyUsage=serverAuth\n')
            run(['openssl', 'x509', '-req', '-in', str(server_csr), '-CA', str(ca_cert),
                 '-CAkey', str(ca_key), '-CAcreateserial', '-out', str(server_cert),
                 '-days', '1', '-extfile', str(ext)], stderr=subprocess.DEVNULL)
            cert_dir = Path('/etc/ssl/certs')
            cert_dir.mkdir(parents=True)
            shutil.copyfile(ca_cert, cert_dir / 'ca-certificates.crt')
        age_worker = None
        age_control = None
        age_mounts = []
        if age_test:
            parent, child = socket.socketpair()
            def control_fd():
                os.dup2(child.fileno(), 3)
            age_worker = subprocess.Popen([age_binary], pass_fds=(3, child.fileno()),
                                          preexec_fn=control_fd, stderr=subprocess.PIPE)
            child.close()
            age_control = parent
            parent.settimeout(10)
            assert parent.recv(1) == b'R', age_worker.stderr.read().decode()
            for path in (str(age_dir), '/run/werewolf-age'):
                run(['mount', '--bind', path, path])
                run(['mount', '-o', 'remount,bind,ro,nosuid,nodev,noexec,nosymfollow', path])
                age_mounts.append(path)
            parent.sendall(b'G')
        run(['ip', 'link', 'set', 'lo', 'up'])
        run(['ip', 'netns', 'add', 'unwound-peer'])
        run(['ip', 'link', 'add', 'client', 'type', 'veth', 'peer', 'name', 'peer'])
        run(['ip', 'link', 'set', 'peer', 'netns', 'unwound-peer'])
        run(['ip', 'addr', 'add', '10.53.0.1/24', 'dev', 'client'])
        run(['ip', 'link', 'set', 'client', 'up'])
        # werewolf leaves reverse-path filtering off (cmd/posture): its check
        # would look up a reply's reverse as unlabeled DNS, which fence refuses.
        # RP_FILTER=1 or 2 tries reverse-path filtering anyway.
        for scope in ['all', 'default', 'client']:
            Path('/proc/sys/net/ipv4/conf/' + scope + '/rp_filter').write_text(os.environ.get('RP_FILTER', '0') + '\n')
        run(['ip', '-n', 'unwound-peer', 'addr', 'add', UPSTREAM + '/24', 'dev', 'peer'])
        if age_live:
            run(['ip', '-n', 'unwound-peer', 'addr', 'add', AGE_HTTPS + '/32', 'dev', 'peer'])
            run(['ip', 'route', 'add', AGE_HTTPS + '/32', 'via', UPSTREAM, 'dev', 'client'])
        run(['ip', '-n', 'unwound-peer', 'link', 'set', 'peer', 'up'])
        run(['ip', '-n', 'unwound-peer', 'link', 'set', 'lo', 'up'])
        peer = subprocess.Popen(['ip', 'netns', 'exec', 'unwound-peer', sys.executable,
                                 str(Path(__file__).resolve()), '--server', str(work / 'upstream.log')],
                                stdout=subprocess.PIPE, text=True)
        client = None
        https = None
        try:
            assert select.select([peer.stdout], [], [], 10)[0] and peer.stdout.readline().strip() == 'ready'
            if age_live:
                https = subprocess.Popen(['ip', 'netns', 'exec', 'unwound-peer', sys.executable,
                                          str(Path(__file__).resolve()), '--age-https',
                                          str(server_cert), str(server_key), str(work / 'age-https.log')],
                                         stdout=subprocess.PIPE, text=True)
                assert select.select([https.stdout], [], [], 10)[0] and https.stdout.readline().strip() == 'ready'
            client = subprocess.Popen([fence, '/usr/bin/python3', '-u', str(driver), '/usr/local/bin/unwound',
                                       str(work / 'audit'), str(work / 'stderr')],
                                      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
            assert select.select([client.stdout], [], [], 10)[0], 'fence timeout'
            announcement = client.stdout.readline()
            assert '"event":"fence"' in announcement, announcement
            assert select.select([client.stdout], [], [], 10)[0], 'unwound timeout'
            assert client.stdout.readline().strip() == 'ready', (work / 'stderr').read_text()
            if age_live:
                age_live_checks(client, work, age_dir)
                print('check-unwound-age-live: passed')
            elif age_test:
                age_checks(client, work)
                print('check-unwound-age: passed')
            else:
                checks(client, work)
                print('check-unwound: passed')
        except BaseException:
            for f in ['stderr', 'audit', 'upstream.log']:
                print('--- ' + f + '\n' + (work / f).read_text(), file=sys.stderr)
            for args in (['ip', 'rule'], ['ip', 'route', 'show', 'table', 'all'], ['ss', '-uanp']):
                print('--- ' + ' '.join(args), file=sys.stderr)
                subprocess.run(args, stdout=sys.stderr)
            raise
        finally:
            if client and client.poll() is None:
                client.kill()
                client.wait()
            peer.terminate()
            peer.wait(timeout=5)
            if https is not None:
                https.terminate()
                https.wait(timeout=5)
            run(['ip', 'netns', 'delete', 'unwound-peer'])
            if age_worker is not None:
                age_worker.kill()
                age_worker.wait(timeout=5)
                age_control.close()
                for path in reversed(age_mounts):
                    run(['umount', path])


