                          ('young.com',)).fetchone() == ('rdap', 'valid')
        assert db.execute('SELECT source,status FROM domain_age WHERE domain=?',
                          ('outage.com',)).fetchone() == ('crtsh', 'history')
        assert db.execute('SELECT rdap_result,crtsh_result FROM age_check WHERE domain=?',
                          ('outage.com',)).fetchone() == ('error', 'history')
        assert db.execute('SELECT source,status FROM domain_age WHERE domain=?',
                          ('invalid.com',)).fetchone() == ('rdap', 'unknown')
        assert db.execute('SELECT source,status FROM domain_age WHERE domain=?',
                          ('invalidtls.org',)).fetchone() == ('rdap', 'unknown')
        refresh_at = db.execute('SELECT retry_after FROM domain_age WHERE domain=?',
                                ('expires.com',)).fetchone()[0]
    https = [json.loads(line) for line in (work / 'age-https.log').read_text().splitlines()]
    assert sum(x['host'] == 'rdap.verisign.com' and x['path'].endswith('/mature.com')
               for x in https) == 1, https
    assert sum(x['host'] == 'crt.sh' for x in https) == 1, https
    assert not any('expires.com' in x['path'] for x in https), https
    assert 'young.com' not in [json.loads(x)['name'] for x in
                               (work / 'upstream.log').read_text().splitlines()], 'young reached upstream'
    time.sleep(max(0, refresh_at - time.time()))
    for domain in ('expires.com', 'ctexpires.com'):
        assert ask(domain, tcp=True)['rcode'] == 5, domain
    with contextlib.closing(sqlite3.connect(f'file:{age_dir}/age.db?mode=ro', uri=True)) as db:
        for domain in ('expires.com', 'ctexpires.com'):
