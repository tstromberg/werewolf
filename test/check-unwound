        audit.write(sink.recv(4096).decode().rstrip('\n') + '\n')
threading.Thread(target=drain, daemon=True).start()
daemon = subprocess.Popen([sys.argv[1]], stderr=open(sys.argv[3], 'w'))

def encode(name):
    return b''.join(bytes([len(l)]) + l.encode() for l in name.split('.') if l) + b'\0'

def read_name(msg, at):
    labels = []
    while msg[at]:
        labels.append(msg[at + 1:at + 1 + msg[at]].decode())
        at += 1 + msg[at]
    return '.'.join(labels), at + 1

def ask(r, passed=None):
    query = r.get('raw')
    query = bytes.fromhex(query) if query else (struct.pack('!HHHHHH', 0x4242, 0x0100, 1, 0, 0, 0) +
                                                encode(r['name']) + struct.pack('!HH', r['type'], 1))
    kind = socket.SOCK_STREAM if r.get('tcp') else socket.SOCK_DGRAM
    s = passed if passed is not None else socket.socket(socket.AF_INET, kind)
    s.settimeout(r.get('timeout', 8))
    server = r.get('server', '127.0.0.53')
    try:
        if r.get('bind'):
            s.bind((r['bind'], 0))
        if r.get('tcp'):
            s.connect((server, 53))
            s.sendall(struct.pack('!H', len(query)) + query)
            size = struct.unpack('!H', s.recv(2))[0]
            msg = b''
            while len(msg) < size:
                msg += s.recv(size - len(msg))
        else:
            s.sendto(query, (server, 53))
            msg = s.recv(4096)
    except OSError as e:
        return {'error': e.errno and os.strerror(e.errno) or str(e)}
    return parse(msg)

def pipeline(r):
    """Put two complete DNS frames in one write, then read both replies."""
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(8)
    def query(ident, name):
        msg = struct.pack('!HHHHHH', ident, 0x0100, 1, 0, 0, 0) + encode(name) + b'\0\1\0\1'
        return struct.pack('!H', len(msg)) + msg
    def exact(n):
        out = b''
        while len(out) < n:
            part = s.recv(n - len(out))
            if not part:
                raise EOFError('TCP connection closed between pipelined replies')
            out += part
        return out
    s.connect(('127.0.0.53', 53))
    s.sendall(query(0x4242, r['name']) + query(0x4243, r['second']))
    answers = []
    for _ in range(2):
        size = struct.unpack('!H', exact(2))[0]
        answers.append(parse(exact(size)))
    s.close()
    return {'results': answers}

def many(r):
    """many asks the same question from r['parallel'] sockets at once."""
    socks = []
    for i in range(r['parallel']):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(8)
        s.sendto(struct.pack('!HHHHHH', 0x4300 + i, 0x0100, 1, 0, 0, 0) + encode(r['name']) +
                 struct.pack('!HH', r['type'], 1), ('127.0.0.53', 53))
        socks.append(s)
    return {'results': [parse(s.recv(4096)) for s in socks]}

def parse(msg):
    flags, qd, an = struct.unpack('!HHH', msg[2:8])
    at = 12
    for _ in range(qd):
        at = read_name(msg, at)[1] + 4
    answers, ttls, rdata = [], [], []
    for _ in range(an):
        name, at = read_name(msg, at)
        kind, _, ttl, size = struct.unpack('!HHIH', msg[at:at + 10])
        data = msg[at + 10:at + 10 + size]
        at += 10 + size
        answers.append(socket.inet_ntoa(data) if kind == 1 else kind)
        ttls.append(ttl)
        rdata.append(data.hex())
    return {'id': msg[0] << 8 | msg[1], 'rcode': flags & 0xf, 'tc': bool(flags & 0x200), 'answers': answers,
            'ttls': ttls, 'rdata': rdata, 'ad': bool(flags & 0x20)}

def passed_socket(r):
    """The creator exits before another UID uses its socket."""
    parent, child = socket.socketpair()
    pid = os.fork()
    if pid == 0:
        parent.close()
        os.setgroups([])
        os.setgid(r['socket_uid'])
        os.setuid(r['socket_uid'])
        kind = socket.SOCK_STREAM if r.get('tcp') else socket.SOCK_DGRAM
        sock = socket.socket(socket.AF_INET, kind)
        child.sendmsg([b'F'], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                               struct.pack('i', sock.fileno()))])
        os._exit(0)
    child.close()
    data, rights, flags, _ = parent.recvmsg(1, socket.CMSG_SPACE(struct.calcsize('i')))
    parent.close()
    assert os.waitpid(pid, 0)[1] == 0
    assert data == b'F' and flags == 0 and len(rights) == 1
    level, kind, descriptor = rights[0]
    assert (level, kind) == (socket.SOL_SOCKET, socket.SCM_RIGHTS)
    return socket.socket(fileno=struct.unpack('i', descriptor)[0])

def probe(r):
    passed = passed_socket(r) if 'socket_uid' in r else None
    reader, writer = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(reader)
        try:
            if r['uid']:
                os.setgroups([])
                os.setgid(r['uid'])
                os.setuid(r['uid'])
            start = time.monotonic()
            result = (pipeline(r) if r.get('pipeline') else
                      many(r) if r.get('parallel') else ask(r, passed))
            result['ms'] = int((time.monotonic() - start) * 1000)
            if passed is not None:
                result['sender_uid'] = os.getuid()
        except Exception as e:
            result = {'error': repr(e)}
        os.write(writer, json.dumps(result).encode())
        os._exit(0)
    os.close(writer)
    if passed is not None:
        passed.close()
    out = b''
    while chunk := os.read(reader, 65536):
        out += chunk
    os.close(reader)
    os.waitpid(pid, 0)
    return json.loads(out)

