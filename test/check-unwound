def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def encode(name):
    return b''.join(bytes([len(l)]) + l.encode() for l in name.split('.') if l) + b'\0'


def read_name(msg, at):
    labels = []
    while msg[at]:
        if msg[at] >= 0xc0:
            labels.append(read_name(msg, ((msg[at] & 0x3f) << 8) | msg[at + 1])[0])
            return '.'.join(labels), at + 2
        labels.append(msg[at + 1:at + 1 + msg[at]].decode())
        at += 1 + msg[at]
    return '.'.join(labels), at + 1


# --- the fixture resolver ----------------------------------------------------

# polls counts the questions for poll.example.test, which each get a new address.
polls = [0]

def record(name, kind, data, ttl=300):
    return encode(name) + struct.pack('!HHIH', kind, 1, ttl, len(data)) + data


# SOA for example.test: a negative answer may be kept min(300, 60) seconds.
SOA = record('example.test', 6, encode('ns.example.test') + encode('admin.example.test') +
             struct.pack('!IIIII', 1, 7200, 900, 86400, 60))


def answer(query, tcp):
    """answer returns the datagrams to send for query: usually one."""
    qname, end = read_name(query, 12)
    qtype = struct.unpack('!H', query[end:end + 2])[0]
    question = query[12:end + 4]
    name = qname.lower()

    def reply(records, rcode=0, flags=0x81a0, ident=query[:2], q=question, authority=()):
        return (ident + struct.pack('!HHHHH', flags | rcode, 1, len(records), len(authority), 0) + q +
                b''.join(records) + b''.join(authority))

    a = lambda ip: socket.inet_aton(ip)
    if name in ('rdap.verisign.com', 'rdap.publicinterestregistry.org', 'crt.sh') and qtype == 1:
        return [reply([record(qname, 1, a(AGE_HTTPS))])]
    if name in ('expires.com', 'ctexpires.com') and qtype == 1:
        return [reply([record(qname, 1, a('192.0.2.60'))])]
    if name == 'slow.example.test':
        return []
    if name == 'spoof.example.test':
        wrong_id = bytes([query[0] ^ 0xff, query[1]])
        lowered = encode(name) + query[end:end + 4]
        return [reply([record(qname, 1, a('192.0.2.66'))], ident=wrong_id),
                reply([record(name, 1, a('192.0.2.66'))], q=lowered),
                reply([record(qname, 1, a('192.0.2.14'))])]
    if name == 'poll.example.test':
        polls[0] += 1
        return [reply([record(qname, 1, a('198.51.100.%d' % polls[0]))])]
    if name == 'short.example.test':
        return [reply([record(qname, 1, a('192.0.2.30'), ttl=1)])]
    if name == 'zero.example.test':
        return [reply([record(qname, 1, a('192.0.2.31'), ttl=0)])]
    if name == 'gone.example.test':
        return [reply([], rcode=3, authority=[SOA])]
    if name.endswith('.fill.example.test'):
        return [reply([record(qname, 1, a('192.0.2.40'))])]
    if name == 'big.example.test' and qtype == 16:
        if not tcp:
            return [reply([], flags=0x8380)]
        txt = bytes([255]) + b'x' * 255
        return [reply([record(qname, 16, txt)] * 3)]
    aliases = {
        'assigned-alias.assigned.test': 'young.com',
        'explicit-alias.example.test': 'young.com',
        'revoked-alias.example.test': 'edge.assigned.test',
        'local-alias.example.com': 'edge.example.com',
        'cross-alias.example.com': 'young.com',
    }
    if name in aliases and qtype == 1:
        target = aliases[name]
        return [reply([record(qname, 5, encode(target)),
                       record(target, 1, a('192.0.2.50'))])]
    table = {
        ('api.example.test', 1): [record(qname, 1, a('192.0.2.10'))],
        ('api.example.test', 28): [record(qname, 28, socket.inet_pton(socket.AF_INET6, '2001:db8::10'))],
        ('x.cdn.example.test', 1): [record(qname, 1, a('192.0.2.11'))],
        ('alias-ok.example.test', 1): [record(qname, 5, encode('edge.cdn.example.test')),
                                       record('edge.cdn.example.test', 1, a('192.0.2.12'))],
        ('alias-bad.example.test', 1): [record(qname, 5, encode('evil.example.net')),
                                        record('evil.example.net', 1, a('192.0.2.13'))],
        ('open.example.test', 1): [record(qname, 1, a('192.0.2.15'))],
        ('cached.example.test', 1): [record(qname, 1, a('192.0.2.16'))],
        ('delayed.example.test', 1): [record(qname, 1, a('192.0.2.17'))],
        # Seven addresses behind an alias, two of them private.
        ('screened.example.test', 1): [record(qname, 5, encode('edge.cdn.example.test'))] + [
            record('edge.cdn.example.test', 1, a(ip)) for ip in
            ['10.0.0.1', '127.0.0.1', '192.0.2.20', '192.0.2.21', '192.0.2.22', '192.0.2.23', '192.0.2.24']],
        ('rebind.example.test', 1): [record(qname, 1, a('127.0.0.1')), record(qname, 1, a('192.168.1.1'))],
    }
    if (name, qtype) in table:
        return [reply(table[(name, qtype)])]
    return [reply([], rcode=3)]


def server(log_path):
    log = open(log_path, 'a', buffering=1)
    udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    udp.bind((UPSTREAM, 53))
    tcp = socket.socket()
    tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    tcp.bind((UPSTREAM, 53))
    tcp.listen()

    def note(query, proto):
        qname, end = read_name(query, 12)
        log.write(json.dumps({'name': qname, 'proto': proto, 'flags': query[2] << 8 | query[3],
                              'arcount': struct.unpack('!H', query[10:12])[0]}) + '\n')

    def streams():
        while True:
            client, _ = tcp.accept()
            with client:
                size = struct.unpack('!H', client.recv(2))[0]
                query = b''
                while len(query) < size:
                    query += client.recv(size - len(query))
                note(query, 'tcp')
                for out in answer(query, True):
                    client.sendall(struct.pack('!H', len(out)) + out)

    threading.Thread(target=streams, daemon=True).start()
    print('ready', flush=True)
    def later(query, addr):
        for out in answer(query, False):
            udp.sendto(out, addr)

    while True:
        query, addr = udp.recvfrom(2048)
        note(query, 'udp')
        # delayed.example.test is answered half a second later, so the same
        # question asked meanwhile finds it out.
        if read_name(query, 12)[0].lower() == 'delayed.example.test':
            threading.Timer(0.5, later, (query, addr)).start()
        else:
            later(query, addr)


def age_https(cert, key, log_path):
    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    tls.load_cert_chain(cert, key)
    sock = socket.socket()
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((AGE_HTTPS, 443))
    sock.listen(16)
    log = open(log_path, 'a', buffering=1)
    print('ready', flush=True)
    while True:
        raw, _ = sock.accept()
        try:
            with tls.wrap_socket(raw, server_side=True) as client:
                client.settimeout(20)
                header = client.recv(4096).decode('ascii', 'replace')
                line = header.split('\r\n', 1)[0]
                host = next((x[6:].strip() for x in header.split('\r\n')
                             if x.lower().startswith('host: ')), '')
                path = line.split(' ')[1]
                log.write(json.dumps({'host': host, 'path': path}) + '\n')
                recent = (datetime.datetime.now(datetime.timezone.utc) -
                          datetime.timedelta(days=5)).strftime('%Y-%m-%dT%H:%M:%SZ')
                if host == 'crt.sh':
                    domain = parse_qs(urlsplit(path).query)['q'][0]
                    assert domain in ('outage.com', 'ctexpires.com'), path
                    when = recent if domain == 'ctexpires.com' else '2020-01-01T00:00:00'
                    body = json.dumps([{'name_value': domain,
                                        'min_entry_timestamp': when}]).encode()
                    status = '200 OK'
                else:
                    domain = path.rsplit('/', 1)[-1]
                    if domain == 'timeout.com':
                        time.sleep(16)
                        continue
                    status = ('503 Service Unavailable' if domain in ('outage.com', 'ctexpires.com') else
                              '302 Found' if domain == 'redirect.com' else '200 OK')
                    when = recent if domain in ('young.com', 'expires.com') else '2020-01-01T00:00:00Z'
                    name = 'wrong.com' if domain == 'invalid.com' else domain
                    body = json.dumps({'objectClassName': 'domain', 'ldhName': name,
                                       'events': [{'eventAction': 'registration',
                                                   'eventDate': when}]}).encode()
                redirect = 'Location: https://crt.sh/?q=redirect.com&output=json\r\n' if status == '302 Found' else ''
                client.sendall((f'HTTP/1.1 {status}\r\n{redirect}Content-Type: application/json\r\n'
                                f'Content-Length: {len(body)}\r\nConnection: close\r\n\r\n').encode() + body)
        except (OSError, ssl.SSLError):
            pass
        finally:
            raw.close()


