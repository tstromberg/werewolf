DRIVER = r'''
import json, os, socket, struct, subprocess, sys, threading, time

audit = open(sys.argv[2], 'a', buffering=1)
os.makedirs('/run/syslog', exist_ok=True)
sink = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
sink.bind('/run/syslog/dev-log')
def drain():
