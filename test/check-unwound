def checks(client, work):
    def send(request):
        client.stdin.write(json.dumps(request) + '\n')
        client.stdin.flush()
        assert select.select([client.stdout], [], [], 15)[0], ('timeout', request)
        line = client.stdout.readline()
        assert line, ('driver exited', request, (work / 'stderr').read_text())
        return json.loads(line)

    def ask(uid, name, kind=1, **extra):
        return send(dict(uid=uid, name=name, type=kind, **extra))

    def expect(result, rcode, answers=None, why=''):
        assert result.get('rcode') == rcode, (why, result)
        if answers is not None:
            assert result['answers'] == answers, (why, result)

    # unwound's upstream user reaches the resolver; fence lets it.
    expect(ask(54, 'api.example.test', server=UPSTREAM), 0, ['192.0.2.10'], 'the upstream user')
    # Exact grants, by type, over UDP and TCP.
    expect(ask(2001, 'api.example.test'), 0, ['192.0.2.10'], 'granted A')
    assert not ask(2001, 'api.example.test')['ad'], 'AD from an untrusted upstream escaped'
    expect(ask(2001, 'API.Example.Test', tcp=True), 0, ['192.0.2.10'], 'granted A over TCP, any case')
    piped = ask(2001, 'api.example.test', pipeline=True, second='x.cdn.example.test')['results']
    assert [r['id'] for r in piped] == [0x4242, 0x4243], piped
    assert [r['answers'] for r in piped] == [['192.0.2.10'], ['192.0.2.11']], piped
    expect(ask(2001, 'api.example.test', 28), 0, [28], 'granted AAAA')
    expect(ask(2001, 'api.example.test', 16), 5, [], 'TXT not granted')
    expect(ask(2001, 'denied.example.test'), 5, [], 'name not granted')
    expect(ask(2001, 'host.corp.lan.test'), 5, [], 'system domain absent')
    assert send(dict(system_domain='corp.lan.test')) == {}
    expect(ask(2001, 'host.corp.lan.test'), 3, [], 'DHCP domain shared with DNS-enabled service')
    expect(ask(2001, 'corp.lan.test'), 3, [], 'system domain apex')
    expect(ask(2001, 'host.corp.lan.test', 16), 3, [], 'system domain supports DNS types')
    expect(ask(2001, 'host.corp.lan.test.evil'), 5, [], 'system domain label boundary')
    expect(ask(2001, 'a' * 41 + '.corp.lan.test'), 5, [], 'system domain still screened')
    assert send(dict(system_domain='config.lan.test', domain_source='config')) == {}
    expect(ask(2001, 'host.corp.lan.test'), 5, [], 'config domain overrides DHCP')
    expect(ask(2001, 'host.config.lan.test'), 3, [], 'config FQDN domain')
    assert send(dict(system_domain='', domain_source='config')) == {}
    expect(ask(2001, 'host.corp.lan.test'), 3, [], 'DHCP domain restored')
    assert send(dict(system_domain='')) == {}
    expect(ask(2001, 'host.corp.lan.test'), 5, [], 'domain revoked')
    # *.NAME: below it, never NAME.
    expect(ask(2001, 'x.cdn.example.test'), 0, ['192.0.2.11'], 'subtree grant')
    expect(ask(2001, 'cdn.example.test'), 5, [], 'subtree grant excludes its apex')
    # An alias's target must be granted too.
    expect(ask(2001, 'alias-ok.example.test'), 0, [5, '192.0.2.12'], 'granted alias target')
    expect(ask(2001, 'alias-bad.example.test'), 5, [], 'alias to an ungranted name')
    # Too large for UDP: truncated, then whole over TCP; upstream asked over TCP too.
    big = ask(2001, 'big.example.test', 16)
    assert big['rcode'] == 0 and big['tc'] and big['answers'] == [], big
    expect(ask(2001, 'big.example.test', 16, tcp=True), 0, [16, 16, 16], 'large answer over TCP')
    # Forged answers are ignored; the real one still arrives.
    expect(ask(2001, 'spoof.example.test'), 0, ['192.0.2.14'], 'forgeries ignored')
    # Silence is SERVFAIL, in two tries of a second.
    slow = ask(2001, 'slow.example.test')
    assert slow['rcode'] == 2 and slow['ms'] < 4000, slow
    # A screened * resolves names shaped like names, and keeps little of their
    # answers: up to four public addresses, the question's own, no aliases.
    expect(ask(2002, 'api.example.test'), 0, ['192.0.2.10'], 'screened *')
    expect(ask(2002, 'api.example.test', 28), 0, [], 'a documentation address dropped')
    expect(ask(2002, 'api.example.test', 16), 5, [], 'TXT not granted, screened or not')
    expect(ask(2002, 'screened.example.test'), 0, ['192.0.2.20', '192.0.2.21', '192.0.2.22', '192.0.2.23'],
           'four public addresses, no alias')
    expect(ask(2002, 'rebind.example.test'), 0, [], 'private and loopback addresses dropped')
    # A poller learns nothing new while an answer stands; unfiltered, it does.
    first = ask(2002, 'poll.example.test')
    assert first['rcode'] == 0 and len(first['answers']) == 1, first
    expect(ask(2002, 'poll.example.test'), 0, first['answers'], 'a standing answer')
    expect(ask(2002, 'poll.example.test', tcp=True), 0, first['answers'], 'a standing answer, over TCP')
    assert ask(2003, 'poll.example.test')['answers'] != first['answers'], 'unfiltered, a new answer'
    # Names shaped like data never leave.
    expect(ask(2002, '9b7e01c7da2a5d06c3a1f4e2b8d90c13ab.tunnel.test'), 5, [], 'a name shaped like data')
    expect(ask(2002, 'a.b.c.d.e.tunnel.test'), 5, [], 'seven labels')
    # A low-and-slow tunnel gets 32 new names of a site within the hour, then
    # none; names it already asked about still resolve.
    for i in range(32):
        expect(ask(2002, 'n%d.tunnel.test' % i), 3, [], 'within the budget')
    expect(ask(2002, 'n32.tunnel.test'), 5, [], 'past the budget')
    expect(ask(2002, 'n0.tunnel.test'), 3, [], 'a name already asked about')
    # Silence is not kept: whether a name fails is not the resolver's to say.
    asked = lambda name: sum(json.loads(l)['name'].lower() == name
                             for l in (work / 'upstream.log').read_text().splitlines())
    before = asked('slow.example.test')
    expect(ask(2002, 'slow.example.test'), 2, [], 'silence, screened')
    expect(ask(2002, 'slow.example.test'), 2, [], 'silence, screened, asked again')
    assert asked('slow.example.test') >= before + 4, 'silence was kept'
    # Unfiltered grants all unwound forwards, never ANY or AXFR.
    expect(ask(2003, 'open.example.test'), 0, ['192.0.2.15'], 'unfiltered *')
    expect(ask(2003, 'nowhere.example.test'), 3, [], 'NXDOMAIN passes')
    expect(ask(2003, 'open.example.test', 255), 5, [], 'ANY refused')
    expect(ask(2003, 'open.example.test', 252, tcp=True), 5, [], 'AXFR refused')
    # A DNS server's own host lookup still uses unwound; its explicitly
    # granted DNS transport may reach another server directly.
    expect(ask(2005, 'api.example.test'), 0, ['192.0.2.10'], 'DNS service local lookup')
    expect(ask(2005, 'api.example.test', server=UPSTREAM), 0, ['192.0.2.10'],
           'DNS service direct upstream')
    # Answers are kept, per service, as long as they say; failures are not.
    first = ask(2001, 'cached.example.test')
    expect(first, 0, ['192.0.2.16'], 'a granted answer')
    time.sleep(1.1)
    again = ask(2001, 'cached.example.test')
    expect(again, 0, ['192.0.2.16'], 'a kept answer')
    assert again['ttls'][0] < first['ttls'][0], ('the time left', first, again)
    expect(ask(2003, 'cached.example.test'), 0, ['192.0.2.16'], "another service's own answer")
    assert asked('cached.example.test') == 2, 'one question per service'
    expect(ask(2001, 'short.example.test'), 0, ['192.0.2.30'], 'a TTL of a second')
    expect(ask(2001, 'short.example.test'), 0, ['192.0.2.30'], 'kept within its second')
    time.sleep(1.1)
    expect(ask(2001, 'short.example.test'), 0, ['192.0.2.30'], 'asked again once it expired')
    assert asked('short.example.test') == 2, asked('short.example.test')
    for _ in range(2):
        expect(ask(2001, 'zero.example.test'), 0, ['192.0.2.31'], 'a TTL of 0')
    assert asked('zero.example.test') == 2, 'a TTL of 0 was kept'
    for _ in range(2):
        expect(ask(2001, 'gone.example.test'), 3, [], 'NXDOMAIN with an SOA')
    assert asked('gone.example.test') == 1, 'a negative answer with an SOA was not kept'
    expect(ask(2003, 'nowhere.example.test'), 3, [], 'NXDOMAIN without an SOA, again')
    assert asked('nowhere.example.test') == 2, 'a negative answer without an SOA was kept'
    # The same question, asked while it is out, waits for its answer.
    together = ask(2001, 'delayed.example.test', parallel=3)['results']
    assert [r['answers'] for r in together] == [['192.0.2.17']] * 3, together
    assert asked('delayed.example.test') == 1, 'the same question asked twice'
    # A full cache lets the answer least recently given go; it never fails.
    for i in range(257):
        expect(ask(2003, 'n%d.fill.example.test' % i), 0, ['192.0.2.40'], 'filling the cache')
    expect(ask(2003, 'n0.fill.example.test'), 0, ['192.0.2.40'], 'asked again, once let go')
    assert asked('n0.fill.example.test') == 2 and asked('n256.fill.example.test') == 1
    # Malformed queries: FORMERR with the ID; a response is not answered.
    bad = struct.pack('!HHHHHH', 0x5151, 0x0100, 2, 0, 0, 0) + encode('a.test') + b'\0\1\0\1'
    expect(send(dict(uid=2001, raw=bad.hex())), 1, [], 'two questions')
    response = struct.pack('!HHHHHH', 0x5151, 0x8180, 1, 0, 0, 0) + encode('a.test') + b'\0\1\0\1'
    assert 'timed out' in send(dict(uid=2001, raw=response.hex(), timeout=1))['error'], 'a response answered'
    expect(ask(2001, 'api.example.test'), 0, ['192.0.2.10'], 'still answering after bad input')
    # Only granted users reach unwound, each from its own label.
    for uid in (2004, 0):
        assert send(dict(uid=uid, name='api.example.test', type=1))['error'] == 'Permission denied', uid
    assert ask(2002, 'api.example.test', bind='127.53.0.1')['error'] == 'Permission denied', 'forged label'
    assert ask(2001, 'api.example.test', bind='127.0.0.1')['error'] == 'Permission denied', 'unlabeled source'
    expect(ask(2001, 'api.example.test', bind='127.53.0.1'), 0, ['192.0.2.10'], 'own label, bound')
    # Only unwound's upstream user and the explicit DNS service reach the
    # resolver directly, or any port 53.
    for uid in (2003, 0):
        for server in (UPSTREAM, '192.0.2.1'):
            got = ask(uid, 'api.example.test', server=server, timeout=1)
            assert got.get('error') == 'Permission denied', (uid, server, got)
    # No upstream: a kept answer is still given; anything else is SERVFAIL,
    # at once. Restored, it answers again.
    assert send(dict(upstream='')) == {}
    expect(ask(2001, 'api.example.test'), 0, ['192.0.2.10'], 'a kept answer, with no upstream')
    expect(ask(2001, 'y.cdn.example.test'), 2, [], 'no upstream fails closed')
    assert send(dict(upstream='nameserver ' + UPSTREAM + '\n')) == {}
    expect(ask(2001, 'y.cdn.example.test'), 3, [], 'upstream restored')

    # Upstream saw only what was allowed: canonical questions, no EDNS, in
    # mixed case, and never a denied name.
    seen = [json.loads(l) for l in (work / 'upstream.log').read_text().splitlines()]
    names = {s['name'].lower() for s in seen}
    for denied in ['denied.example.test', 'cdn.example.test', 'n32.tunnel.test', 'a.b.c.d.e.tunnel.test',
                   '9b7e01c7da2a5d06c3a1f4e2b8d90c13ab.tunnel.test']:
        assert denied not in names, denied
    # A standing answer was asked for once; unfiltered, once more.
    assert asked('poll.example.test') == 2, asked('poll.example.test')
    assert 'evil.example.net' not in names
    assert all(s['arcount'] == 0 and s['flags'] == 0x0100 for s in seen), seen
    assert any(s['name'] != s['name'].lower() for s in seen), 'no 0x20 case'
    assert {'udp', 'tcp'} <= {s['proto'] for s in seen}

    # Every decision is audited: who, what, why and the rule.
    for _ in range(50):
        audit = [json.loads(l.split(': ', 1)[1]) for l in (work / 'audit').read_text().splitlines()]
        if any(a.get('event') == 'age_observe' and a.get('qname') == 'poll.example.test'
               for a in audit):
            break
        time.sleep(.02)
    observations = [a for a in audit if a.get('event') == 'age_observe']
    assert any(a.get('uid') == 2002 and a.get('qname') == 'poll.example.test'
               and a.get('boundary') == 'unknown' and a.get('domain') is None
               and a.get('dns_id') == 0x4242 and a.get('qtype') == 1
               and a.get('transport') == 'udp' and a.get('source') == '127.53.0.2'
               and a.get('rule') == 10 for a in observations), observations
    assert not any(a.get('qname') == 'host.corp.lan.test' for a in observations), observations
    assert not any(a.get('qname') == 'open.example.test' for a in observations), observations
    queries = [a for a in audit if a.get('event') == 'query']
    def find(**want):
        return [a for a in queries if all(a.get(k) == v for k, v in want.items())]
    assert find(uid=2001, name='denied.example.test', decision='deny', why='no_grant'), queries
    assert find(uid=2001, name='api.example.test', type='A', decision='allow', rcode='noerror', rule=3)
    assert find(uid=2001, name='host.corp.lan.test', decision='allow', why='system_domain')
    assert find(uid=2001, name='alias-bad.example.test', decision='deny', why='alias', alias='evil.example.net')
    assert find(uid=2002, name='poll.example.test', decision='allow', why='screened', rule=10)
    assert find(uid=2002, name='poll.example.test', decision='allow', why='screened', cached=True, rule=10)
    assert find(uid=2001, name='cached.example.test', why='granted', cached=True)
    assert len(find(uid=2001, name='delayed.example.test', why='granted', merged=True)) == 2
    # Every question that gets no answer, or less of one, says why.
    assert find(uid=2002, name='n32.tunnel.test', decision='deny', why='budget', detail='new_names', rule=10)
    assert find(uid=2002, name='a.b.c.d.e.tunnel.test', decision='deny', why='tunnel', detail='many_labels')
    data = find(uid=2002, name='9b7e01c7da2a5d06c3a1f4e2b8d90c13ab.tunnel.test', why='tunnel',
                detail='random_label')
    assert data and data[0]['bits'] >= 3.5, data
    assert find(uid=2002, name='screened.example.test', why='screened', dropped_nonpublic=2, dropped_room=1)
    assert find(uid=2002, name='rebind.example.test', why='screened', answers=0, dropped_nonpublic=2)
    assert find(uid=2002, name='slow.example.test', decision='allow', why='unanswered', detail='timeout',
                rcode='servfail')
    assert find(uid=2001, name='y.cdn.example.test', why='unanswered', detail='no_resolvers')
    assert find(uid=2003, type='255', decision='deny', why='unsupported')
    assert find(uid=2001, why='malformed', detail='format')
    assert find(uid=2001, why='malformed', detail='response')
    assert any(a.get('event') == 'start' for a in audit), audit

    # If the upstream side dies, the frontend goes too, for runit to restart.
    assert send(dict(kill_upstream=True))['exit'] == 1


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == '--server':
        server(sys.argv[2])
    elif len(sys.argv) == 5 and sys.argv[1] == '--age-https':
        age_https(sys.argv[2], sys.argv[3], sys.argv[4])
    elif len(sys.argv) == 5 and sys.argv[1] == '--inside':
        inside(sys.argv[2], sys.argv[3], sys.argv[4])
    elif len(sys.argv) == 6 and sys.argv[1] == '--inside':
        inside(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
    elif len(sys.argv) in (3, 4):
        if sys.platform != 'linux':
            sys.exit('check-unwound requires Linux to create private namespaces')
        if os.geteuid() != 0:
            sys.exit('check-unwound needs root: fence sets routing rules and unwound drops to its users')
        command = ['unshare', '--net', '--mount', '--fork', sys.executable,
                   str(Path(__file__).resolve()), '--inside', str(Path(sys.argv[1]).resolve()),
                   str(Path(sys.argv[2]).resolve()), os.readlink('/proc/self/ns/net')]
        if len(sys.argv) == 4:
            command.append(str(Path(sys.argv[3]).resolve()))
        run(command)
    else:
        sys.exit(__doc__)
