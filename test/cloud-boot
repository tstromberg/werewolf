#!/bin/sh
# cloud-boot NAME PROVIDER PAYLOAD HOSTNAME FIRMWARE QEMU...
#
# cloud-boot boots prod as a machine on PROVIDER (gcp, aws, hetzner, azure;
# hyperv, which uses Azure's names on a desktop; or none, for a machine on no
# cloud), with no address and no config disk. test/metadata.zig serves PAYLOAD
# (good or hostile) at 169.254.169.254, its config naming the machine
# HOSTNAME. A machine that must take it boots its native test image, the
# config carrying the run's context (test/scenarios/metadata, native-tests
# boot). One that must take nothing, HOSTNAME -, boots the production image,
# judged by its console (test/console.zig): it must keep its own hostname.
# Then cloud-boot judges what the console and the metadata server saw:
#
#   good, on a cloud   the machine takes the config: a "config" event for
#                      PROVIDER; on AWS, it fetched a token first and used it
#   hostile            the machine refuses the whole config: a "refused" event
#   none, hyperv       no request reached the server at all
#
# FIRMWARE is UEFI for arm64, where only firmware gives the guest SMBIOS
# tables. It is empty on x86_64, whose default firmware does. QEMU... is the
# machine, without a network or a kernel. make passes CHECK_ENV (Makefile),
# ARCH and PRODUCTION_OUT, prod's image; OUT is the native test image.
set -eu
name=$1 provider=$2 payload=$3 hostname=$4 firmware=$5
shift 5

metadata_relay=$(command -v nc || command -v ncat || true)
[ -n "$metadata_relay" ] || { echo "cloud-boot: install nc or ncat" >&2; exit 2; }

port_file=$CHECK/$name.port
server_log=$CHECK/$name.server.log
context=$CHECK/$name.context
rm -f "$port_file" "$server_log" "$context"
: >"$server_log"
if [ "$hostname" = - ]; then
	build/host/metadata "$payload" "$port_file" "$server_log" &
else
	build/host/metadata "$payload" "$port_file" "$server_log" "$hostname" "$context" &
fi
server=$!
trap 'kill $server 2>/dev/null || true' EXIT
i=0
until [ -s "$port_file" ]; do
	i=$((i + 1))
	[ $i -le 100 ] || { echo "FAIL   $name            the metadata server did not start"; exit 1; }
	sleep 0.1
done
port=$(cat "$port_file")

chassis=
case $provider in
gcp) smbios='type=1,manufacturer=Google,product=Google Compute Engine' ;;
aws) smbios='type=1,manufacturer=Amazon EC2,product=m7g.large' ;;
hetzner) smbios='type=1,manufacturer=Hetzner,product=vServer' ;;
# Azure uses Hyper-V's names; only Azure sets the chassis asset tag.
azure) smbios='type=1,manufacturer=Microsoft Corporation,product=Virtual Machine'
	chassis='type=3,asset=7783-7084-3265-9085-8269-3286-77' ;;
hyperv) smbios='type=1,manufacturer=Microsoft Corporation,product=Virtual Machine' ;;
none) smbios= ;;
*) echo "cloud-boot: no provider $provider" >&2; exit 2 ;;
esac

# Make QEMU's user network look like a cloud's: the guest gets 169.254.0.15
# by DHCP, and 169.254.169.254:80 reaches the server through one TCP relay per
# connection.
net="user,id=n0,net=169.254.0.0/16,host=169.254.0.2,dhcpstart=169.254.0.15,dns=169.254.0.3,guestfwd=tcp:169.254.169.254:80-cmd:$metadata_relay 127.0.0.1 $port"
set -- "$@" ${firmware:+-bios "$firmware" -boot menu=on,splash-time=0} \
	${smbios:+-smbios "$smbios"} ${chassis:+-smbios "$chassis"} \
	-netdev "$net" -device virtio-net-pci,netdev=n0,romfile= -kernel "$KERNEL" -append "$BOOT"
if [ "$hostname" = - ]; then
	log=$CHECK/$name.log
	cat >"$CHECK/$name.checks" <<'EOF'
seen    hostname-kept   posture: .*"host":"werewolf"
unseen  config-taken    cloud-metadata: \{.*"event":"config"
EOF
	build/host/console "$name" "$CHECK/$name.checks" "$log" "$@" -initrd "$PRODUCTION_OUT/initramfs.zst"
else
	log=$CHECK/$name-native/seed.log
	NATIVE_CONTEXT=$context build/host/native-tests boot test/scenarios/metadata "$ARCH" seed "$name" \
		"$@" -initrd "$OUT/initramfs.zst"
fi

judge() {
	echo "FAIL   $name            $1"
	sed 's/^/         | /' "$server_log"
	exit 1
}
event() { grep -a -q "cloud-metadata: {.*\"event\":\"$1\"" "$log"; }
case $provider/$payload in
none/* | hyperv/*)
	[ ! -s "$server_log" ] || judge "a machine on no cloud asked the metadata server"
	;;
*/hostile)
	event refused || judge "no \"refused\" event for a hostile config"
	;;
aws/good)
	{ event config && grep -a -q "\"provider\":\"aws\"" "$log"; } || judge "no \"config\" event from aws"
	head -n 1 "$server_log" | grep -q '^PUT /latest/api/token ' || judge "AWS's user data was asked for without a session token first"
	grep -q "^GET /latest/user-data .*werewolf-check-token" "$server_log" || judge "AWS's user data was asked for without the token"
	;;
*/good)
	{ event config && grep -a -q "\"provider\":\"$provider\"" "$log"; } || judge "no \"config\" event from $provider"
	;;
*/good\>*)
	{ event config && grep -a -q "\"provider\":\"$provider\"" "$log"; } || judge "no \"config\" event from $provider"
	event people || judge "no \"people\" event: the service did not take the changed config"
	;;
*/people\>people2@1)
	event people || judge "the key update did not publish with its existing reservation"
	;;
esac
echo "pass   $name            the metadata server saw what it should"
