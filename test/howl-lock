#!/usr/bin/env python3
"""Exercise the build's lock path with an apko fixture and no network."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

howl = str(Path(sys.argv[1]).resolve())
with tempfile.TemporaryDirectory(prefix="howl-lock-") as work:
    root = Path(work)
    (root / "bin").mkdir()
    apko = root / "bin/apko"
    apko.write_text('''#!/usr/bin/env python3
import base64, hashlib, json, os, pathlib, sys
assert sys.argv[1] == "lock", sys.argv
out = sys.argv[sys.argv.index("--output") + 1]
config = pathlib.Path(sys.argv[-1]).read_bytes()
count = pathlib.Path(os.environ["LOCK_COUNT"])
count.write_text(str(int(count.read_text()) + 1) if count.exists() else "1")
pathlib.Path(out).write_text(json.dumps({
    "version": "v1",
    "config": {"checksum": "sha256-" + base64.b64encode(hashlib.sha256(config).digest()).decode()},
    "contents": {"packages": [
        {"url": "https://example.invalid/" + arch + "/busybox-1.0-r0.apk"}
        for arch in ("aarch64", "x86_64")
    ]}
}, indent=2))
''')
    apko.chmod(0o755)
    form = root / "forms/minimal"
    form.mkdir(parents=True)
    (form / "form.yaml").write_text("packages: [busybox]\n")
    (form / "rootfs").mkdir()
    payload = form / "rootfs/message"
    payload.write_text("first")
    env = dict(os.environ, PATH=str(root / "bin") + os.pathsep + os.environ["PATH"],
               LOCK_COUNT=str(root / "count"))

    def build(expected, *args):
        result = subprocess.run([howl, "_build", "--with", "minimal", *args, "lock"],
                                cwd=root, env=env, capture_output=True, text=True)
        assert result.returncode == 0, result.stderr
        assert int((root / "count").read_text()) == expected, result.stderr
        return json.loads((root / "build/lock/minimal.lock.json").read_text())

    first = build(1, "--arch", "aarch64")
    assert build(1, "--arch", "x86_64") == first
    before = payload.stat()
    payload.write_text("other")
    os.utime(payload, ns=(before.st_atime_ns, before.st_mtime_ns))
    changed = build(2)
    assert changed["werewolf"]["inputs"] != first["werewolf"]["inputs"]
    build(2)
    payload.unlink()
    build(3)
    payload.symlink_to("missing")
    build(4)
    payload.unlink()
    payload.symlink_to("elsewhere")
    build(5)
    app = root / "app"
    app.mkdir()
    (app / "server").write_text("app")
    applied = build(6, "--app-root", str(app))
    assert applied["werewolf"]["app"]
    build(6, "--app-root", str(app))
    (app / "server").chmod(0o755)
    build(7, "--app-root", str(app))
    (root / "build/lock/minimal.lock.json").write_text('{"version":"v1"}')
    build(8)
    (form / "form.yaml").write_text("# Generated by howl\n# create\npackages: [busybox]\n")
    build(8)
    (form / "form.yaml").write_text("# Generated by howl\n# apply --arch aarch64\npackages: [busybox]\n")
    build(8)
print("howl-lock: reuse across arches; bytes, removal, links, app modes and old locks invalidate")
