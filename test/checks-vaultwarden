# Vaultwarden works as a password manager's server: the admin, with the
# config's token, invites a user; the user registers (no mail: the
# verification token comes back from the API), logs in, stores an item
# and finds it in a sync. A stranger cannot sign up, a wrong admin token
# and a wrong master password are refused, the web vault is served, and
# the vault and token are vaultwarden's alone.
ok  vw-user          p=$(head -n 1 /run/cgroup/svc/vaultwarden/cgroup.procs); grep -q '^Uid:[[:space:]]*220[[:space:]]' /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  vw-alive         i=0; until wget -q -T 5 -O /dev/null http://127.0.0.1:8080/alive 2>/dev/null; do i=$((i + 1)); [ $i -le 60 ] || { echo "not alive"; exit 1; }; sleep 1; done; wget -q -T 5 -O - http://127.0.0.1:8080/ | grep -qi 'vaultwarden\|bitwarden'
ok  vw-signup-closed ! wget -q -T 5 -O /dev/null --header 'Content-Type: application/json' --post-data '{"email":"stranger@example.test","name":"x"}' http://127.0.0.1:8080/identity/accounts/register/send-verification-email 2>/dev/null
ok  vw-admin-locked  ! wget -q -T 5 -S -O /dev/null --post-data 'token=wrong-admin-token' http://127.0.0.1:8080/admin 2>&1 | grep -qi 'set-cookie: VW_ADMIN='
ok  vw-invite        c=$(wget -q -T 5 -S -O /dev/null --post-data 'token=werewolf-check-admin' http://127.0.0.1:8080/admin 2>&1 | sed -n 's/.*[Ss]et-[Cc]ookie: \(VW_ADMIN=[^;]*\).*/\1/p' | head -n 1); [ -n "$c" ] || { echo "no admin session"; exit 1; }; wget -q -T 5 -O - --header "Cookie: $c" --header 'Content-Type: application/json' --post-data '{"email":"check@example.test"}' http://127.0.0.1:8080/admin/invite | grep -qi 'check@example.test'
ok  vw-register      t=$(wget -q -T 5 -O - --header 'Content-Type: application/json' --post-data '{"email":"check@example.test","name":"check"}' http://127.0.0.1:8080/identity/accounts/register/send-verification-email) && [ -n "$t" ] && wget -q -T 10 -O /tmp/vw.reg --header 'Content-Type: application/json' --post-data "{\"email\":\"check@example.test\",\"emailVerificationToken\":\"$t\",\"kdf\":0,\"kdfIterations\":600000,\"masterPasswordHash\":\"d2VyZXdvbGYtY2hlY2staGFzaA==\",\"key\":\"2.YWJjZA==|ZWZnaA==|aWprbA==\",\"keys\":{\"publicKey\":\"cHVibGlj\",\"encryptedPrivateKey\":\"2.YWJjZA==|ZWZnaA==|aWprbA==\"}}" http://127.0.0.1:8080/identity/accounts/register/finish
ok  vw-login         wget -q -T 10 -O /tmp/vw.login --post-data 'grant_type=password&username=check%40example.test&password=d2VyZXdvbGYtY2hlY2staGFzaA%3D%3D&scope=api%20offline_access&client_id=web&deviceType=10&deviceIdentifier=4b2c3d4e-0000-4000-8000-000000000001&deviceName=check' http://127.0.0.1:8080/identity/connect/token && grep -q '"access_token":"' /tmp/vw.login
ok  vw-wrong-password ! wget -q -T 10 -O /dev/null --post-data 'grant_type=password&username=check%40example.test&password=d3Jvbmc%3D&scope=api%20offline_access&client_id=web&deviceType=10&deviceIdentifier=4b2c3d4e-0000-4000-8000-000000000001&deviceName=check' http://127.0.0.1:8080/identity/connect/token 2>/dev/null
ok  vw-vault         a=$(sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p' /tmp/vw.login); u=$(wget -q -T 10 -O - --header "Authorization: Bearer $a" http://127.0.0.1:8080/api/accounts/profile | sed -n 's/.*"id":"\([0-9a-f-]*\)".*/\1/p' | head -n 1); [ -n "$u" ] && wget -q -T 10 -O /dev/null --header "Authorization: Bearer $a" --header 'Content-Type: application/json' --post-data "{\"type\":2,\"name\":\"2.d2VyZXdvbGY=|Y2hlY2s=|aXRlbQ==\",\"notes\":null,\"secureNote\":{\"type\":0},\"favorite\":false,\"folderId\":null,\"organizationId\":null,\"encryptedFor\":\"$u\"}" http://127.0.0.1:8080/api/ciphers && wget -q -T 10 -O - --header "Authorization: Bearer $a" http://127.0.0.1:8080/api/sync | grep -q '2.d2VyZXdvbGY=|Y2hlY2s=|aXRlbQ=='
ok  vw-private       [ "$(stat -c '%u:%a' /run/svc/vaultwarden/admin-token)" = 220:600 ] && [ "$(stat -c %u /data/svc/vaultwarden/db.sqlite3)" = 220 ] && [ ! -e /data/svc/vaultwarden/config.json ]
