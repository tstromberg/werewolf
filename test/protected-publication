#!/usr/bin/env python3
"""Fault-test ordered object uploads and authenticated publication floors; no network or keys."""
import datetime
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader('protected_transport', 'release/publish-protected')
spec = importlib.util.spec_from_loader(loader.name, loader)
publisher = importlib.util.module_from_spec(spec)
loader.exec_module(publisher)
downloads = publisher.preparation.downloads


class RecordingStore(publisher.Store):
    def __init__(self, directory):
        super().__init__(str(directory))
        self.writes = []
        self.fail = None

    def upload(self, key, source, immutable):
        if self.fail and key.endswith(self.fail):
            raise OSError('injected upload failure')
        super().upload(key, source, immutable)
        self.writes.append((key, immutable))


class Publication(unittest.TestCase):
    def setUp(self):
        temporary = tempfile.TemporaryDirectory(prefix='ww-publication-test-')
        self.addCleanup(temporary.cleanup)
        self.root = Path(temporary.name)
        self.trust = self.root / 'trust'
        self.trust.mkdir()
        (self.trust / 'trust.json').write_text(json.dumps(dict(format='werewolf-boot-trust/2',
            source='https://vendor.test/boot/v1')))
        self.store = RecordingStore(self.root / 'store')
        self.namespace = self.root / 'store/playground/lima/aarch64'
        self.a = self.bundle('a', 0)
        self.b = self.bundle('b', 1)
        # These tests isolate upload transport and interruption handling. Native
        # cryptographic admission is exercised separately by boot-images/download.
        native = patch.object(downloads, 'native', side_effect=self.admit)
        native.start()
        self.addCleanup(native.stop)

    def bundle(self, name, minute, index=None):
        bundle = self.root / name
        bundle.mkdir()
        serial = (datetime.datetime.now(datetime.timezone.utc).replace(second=0, microsecond=0) +
                  datetime.timedelta(minutes=minute)).strftime('%Y%m%dT%H%M%SZ')
        manifest = dict(form='playground', image=dict(arch='aarch64', build=name * 64, serial=serial,
                                                      index=minute + 1 if index is None else index))
        (bundle / 'boot.json').write_text(json.dumps(manifest))
        (bundle / 'boot.json.sig').write_bytes(downloads.sha(bundle / 'boot.json').encode())
        (bundle / 'disk.img.zst').write_bytes(b'disk:' + name.encode())
        (bundle / 'slot').mkdir()
        for filename in downloads.FILES:
            (bundle / 'slot' / filename).write_bytes(filename.encode() + name.encode())
        head = bundle / 'prebuilt/aarch64'
        head.mkdir(parents=True)
        for filename in ('latest.json', 'latest.json.sig'):
            (head / filename).write_bytes(filename.encode() + name.encode())
        return bundle

    def admit(self, howl, operation, directory, request):
        self.assertEqual('https://vendor.test/boot/v1/playground/lima', request['channel'])
        head = Path(directory) / 'boot.json'
        if operation == 'head':
            self.assertEqual('lima', request['provider'])
            if (Path(directory) / 'boot.json.sig').read_bytes() != downloads.sha(head).encode():
                raise ValueError('test head signature differs')
            return json.loads(head.read_text())
        self.assertEqual('verify', operation)
        return dict(manifest=json.loads(head.read_text()))

    def report(self, bundle):
        return dict(format='werewolf-boot-gates/1', descriptor=downloads.sha(bundle / 'boot.json'),
                    arch='aarch64', provider='lima', checks={name: True for name in publisher.preparation.GATES})

    def publish(self, bundle, report=None):
        return publisher.publish('howl', bundle, report or self.report(bundle), 'lima', self.store, self.trust)

    def test_objects_precede_atomic_floor_and_both_heads(self):
        plan = self.publish(self.a)
        self.assertEqual(15, sum(immutable for _, immutable in self.store.writes))
        self.assertTrue(all(immutable for _, immutable in self.store.writes[:-5]))
        # The update head goes last: every machine on the channel takes it.
        self.assertEqual(['latest/accepted-head.json', 'latest/boot.json.sig', 'latest/boot.json',
                          'latest.json.sig', 'latest.json'],
                         [key.removeprefix('playground/lima/aarch64/') for key, _ in self.store.writes[-5:]])
        for entry in plan['files']:
            self.assertEqual(entry['sha256'], downloads.sha(self.root / 'store' / entry['key']))
        self.assertEqual((self.a / 'boot.json').read_bytes(), (self.namespace / 'latest/boot.json').read_bytes())
        self.assertEqual((self.a / 'prebuilt/aarch64/latest.json').read_bytes(),
                         (self.namespace / 'latest.json').read_bytes())

    def test_missing_lifecycle_gate_writes_nothing(self):
        report = self.report(self.a)
        del report['checks']['retirement_cuts']
        with self.assertRaises(ValueError):
            self.publish(self.a, report)
        self.assertEqual([], self.store.writes)
        self.assertFalse(self.namespace.exists())

    def heads(self):
        heads = {path.name: path.read_bytes() for path in (self.namespace / 'latest').iterdir()}
        heads.update({name: (self.namespace / name).read_bytes() for name in ('latest.json', 'latest.json.sig')})
        return heads

    def test_object_failure_keeps_previous_heads_and_floor(self):
        self.publish(self.a)
        previous = self.heads()
        self.store.fail = '/root.erofs'
        with self.assertRaises(OSError):
            self.publish(self.b)
        self.assertEqual(previous, self.heads())
        self.store.fail = None
        self.publish(self.b)

    def test_immutable_collision_never_advances_head(self):
        self.publish(self.a)
        previous = (self.namespace / 'latest/boot.json').read_bytes()
        descriptor = downloads.sha(self.b / 'boot.json')
        objects = self.namespace / 'objects' / descriptor
        objects.mkdir(parents=True)
        (objects / 'root.erofs').write_bytes(b'collision')
        with self.assertRaisesRegex(ValueError, 'collision'):
            self.publish(self.b)
        self.assertEqual(previous, (self.namespace / 'latest/boot.json').read_bytes())

    def test_torn_head_recovers_and_retains_newer_authenticated_floor(self):
        self.publish(self.a)
        self.store.fail = '/latest/boot.json'
        with self.assertRaises(OSError):
            self.publish(self.b)
        with self.assertRaisesRegex(ValueError, 'older'):
            self.publish(self.a)
        self.store.fail = None
        self.publish(self.b)
        self.assertEqual((self.b / 'boot.json').read_bytes(), (self.namespace / 'latest/boot.json').read_bytes())

    def test_cut_before_the_update_head_keeps_machines_on_the_previous_release_until_retried(self):
        self.publish(self.a)
        self.store.fail = 'aarch64/latest.json'
        with self.assertRaises(OSError):
            self.publish(self.b)
        self.assertEqual((self.b / 'boot.json').read_bytes(), (self.namespace / 'latest/boot.json').read_bytes())
        self.assertEqual((self.a / 'prebuilt/aarch64/latest.json').read_bytes(),
                         (self.namespace / 'latest.json').read_bytes())
        with self.assertRaisesRegex(ValueError, 'older'):
            self.publish(self.a)
        self.store.fail = None
        self.publish(self.b)
        self.assertEqual((self.b / 'prebuilt/aarch64/latest.json').read_bytes(),
                         (self.namespace / 'latest.json').read_bytes())

    def test_published_release_must_take_a_later_channel_index(self):
        self.publish(self.b)
        self.store.writes.clear()
        for name, index in (('d', 2), ('e', 1)):
            with self.subTest(index=index):
                with self.assertRaisesRegex(ValueError, 'later channel index'):
                    self.publish(self.bundle(name, 2, index))
                self.assertEqual([], self.store.writes)
        self.publish(self.bundle('f', 3, 3))
        self.assertEqual(3, json.loads((self.namespace / 'latest/boot.json').read_text())['image']['index'])

    def test_head_without_an_index_precedes_every_indexed_release(self):
        # A head published before channel indices counts as index 0.
        head = self.namespace / 'latest/boot.json'
        head.parent.mkdir(parents=True)
        head.write_text(json.dumps(dict(form='playground', image=dict(arch='aarch64', build='9' * 64,
                                                                     serial='20260101T000000Z'))))
        (head.parent / 'boot.json.sig').write_bytes(downloads.sha(head).encode())
        self.publish(self.a)
        self.assertEqual((self.a / 'boot.json').read_bytes(), (self.namespace / 'latest/boot.json').read_bytes())

    def test_first_publication_cut_can_be_retried(self):
        for failure in ('/latest/boot.json.sig', '/latest/boot.json',
                        'aarch64/latest.json.sig', 'aarch64/latest.json'):
            with self.subTest(failure=failure):
                store = RecordingStore(self.root / ('first-' + failure.rsplit('/', 1)[1]))
                store.fail = failure
                with self.assertRaises(OSError):
                    publisher.publish('howl', self.a, self.report(self.a), 'lima', store, self.trust)
                store.fail = None
                publisher.publish('howl', self.a, self.report(self.a), 'lima', store, self.trust)

    def test_tampered_publication_receipt_refuses_all_writes(self):
        self.publish(self.a)
        receipt = self.namespace / 'latest/accepted-head.json'
        saved = json.loads(receipt.read_text())
        saved['head'] += ' '
        receipt.write_text(json.dumps(saved))
        self.store.writes.clear()
        with self.assertRaises(ValueError):
            self.publish(self.b)
        self.assertEqual([], self.store.writes)

    def test_replay_and_equivocation_refuse_but_identical_retry_skips_immutable_uploads(self):
        self.publish(self.a)
        self.store.writes.clear()
        self.publish(self.a)
        self.assertEqual(5, len(self.store.writes))
        self.assertFalse(any(immutable for _, immutable in self.store.writes))
        self.publish(self.b)
        with self.assertRaisesRegex(ValueError, 'older'):
            self.publish(self.a)
        changed = self.bundle('c', 1)
        with self.assertRaisesRegex(ValueError, 'serial reused'):
            self.publish(changed)


if __name__ == '__main__':
    unittest.main()
