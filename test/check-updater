#!/bin/sh
# check-updater QEMU... makes the disk test/update updates, then runs it on
# QEMU..., the machine, with a network (make check-updater). The disk is an
# ext4 with FORM's slot a and a separate native EFI partition. The
# slot's root is the build's, its record claiming the kernel release before
# its own, laid over as a later tar entry, so the updater finds Alpine's
# kernel newer. Its stage0 is the build's, with this root's dm-verity table.
#
# With PUBLISHED=1, the slot's forms are werewolf's published ones but its
# own, and the claim adds a marker to prod's staged copy and to the root, as
# an older prod-form would have: the slot the updater builds must have
# neither, as it composes prod from the package it installs (test/update).
#
# make passes CHECK, FORM, OUT, TAR, SLOTS, PRUNE (what the form leaves
# out of its packages), EROFS_OPTS, VERITY (build/host/verity), CONSOLE,
# SEAL_ARGS, STAGED and PUBLISHED, which test/update reads.
set -eu
dir=$CHECK/update-$FORM
rm -rf "$dir/claim" "$dir/slots" "$dir/slots.img" "$dir/b"
mkdir -p "$dir/claim/usr/share/werewolf" "$dir/slots/slot/a"
# Keep the installed package name and claim an older version. Kernel versions
# need not have three dotted components (linux-werewolf-7.3-r7, for example).
awk '{ if (!sub(/-[0-9][^-]*-r[0-9]+$/, "-0.0.0-r0")) exit 1; print }' \
	"$OUT/meta/usr/share/werewolf/kernel" >"$dir/claim/usr/share/werewolf/kernel"
printf '#mtree\n./ type=dir uid=0 gid=0 uname=root gname=root mode=0755 time=0.0\n' >"$dir/root.mtree"
claimed=usr/share/werewolf/kernel
if [ -n "${PUBLISHED:-}" ]; then
	old=usr/share/werewolf/forms/prod/rootfs/etc/werewolf-old-form
	mkdir -p "$dir/claim/${old%/*}" "$dir/claim/etc"
	echo "an older prod-form's" | tee "$dir/claim/$old" >"$dir/claim/etc/werewolf-old-form"
	claimed="$claimed $old etc/werewolf-old-form"
fi
# shellcheck disable=SC2086 # claimed is paths
"$TAR" -C "$dir/claim" -cf "$dir/claim.tar" --uid 0 --gid 0 --numeric-owner $claimed
# roottar writes the slot's root: the build's, less what the form prunes,
# then the claim.
roottar() {
	set -f --
	for p in $PRUNE; do set -- "$@" --exclude "^$p"; done
	set +f
	"$TAR" -cf "$dir/root.tar" --uid 0 --gid 0 --numeric-owner "$@" \
		"@$dir/root.mtree" "@$OUT/rootfs.tar" "@$OUT/overlay.tar" "@$dir/claim.tar"
}
roottar
# shellcheck disable=SC2086 # EROFS_OPTS are words
mkfs.erofs $EROFS_OPTS -T0 -U 00000000-0000-0000-0000-000000000000 --tar=f \
	"$dir/slots/slot/a/root.erofs" "$dir/root.tar" >/dev/null
rm -rf "$dir/root.tar" "$dir/verity" && mkdir -p "$dir/verity"
"$VERITY" "$dir/slots/slot/a/root.erofs" "$dir/verity/verity"
mke2fs -q -F -t ext4 -U "$SLOTS" -d "$dir/slots" "$dir/slots.img" 3G
# Match production disk creation: mke2fs preserves the host builder's owners,
# while the mount broker deliberately has no DAC override capability.
for path in /slot /slot/a /slot/a/root.erofs; do
	for field in uid gid; do
		printf 'sif %s %s 0\n' "$path" "$field"
	done
done >"$dir/ownership.debugfs"
"$DEBUGFS" -w -f "$dir/ownership.debugfs" "$dir/slots.img" >"$dir/ownership.log" 2>&1
cp "$OUT/slot/vmlinuz" "$dir/"
(cd "$dir/verity" && "$TAR" -cf - --format newc --uid 0 --gid 0 --numeric-owner verity) |
	zstd -q -c | cat "$OUT/slot/stage0.zst" - >"$dir/stage0.zst"
cmdline="console=$CONSOLE panic=1 $(cat "$OUT/slot/cmdline") $SEAL_ARGS werewolf.ip=10.0.2.15/24 werewolf.gw=10.0.2.2 werewolf.dns=10.0.2.3"
sh test/slot-esp "$dir/esp.img" a "$cmdline init=/init werewolf.slots=$SLOTS werewolf.esp=57E1-F000"
exec test/update "$dir" "$cmdline init=/init werewolf.slots=$SLOTS werewolf.esp=57E1-F000" "$@"
