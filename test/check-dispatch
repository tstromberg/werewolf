#!/usr/bin/env python3
"""Selected release forms keep their real make targets during native migration."""
import os
from pathlib import Path
import subprocess
import tempfile

with tempfile.TemporaryDirectory() as temporary:
    overrides = Path(temporary) / 'checks.mk'
    howl = Path(temporary) / 'howl'
    howl.write_text('#!/bin/sh\nexit 99\n')
    howl.chmod(0o700)
    overrides.write_text('''
_check-legacy-prod-ssh:
	@echo dispatched-legacy-prod-ssh
_check-legacy-playground:
	@echo dispatched-legacy-playground
check-native-tests-minimal:
	@echo dispatched-native-minimal
_check-legacy-minimal:
	@echo unexpected-legacy-minimal; exit 99
''')
    env = dict(os.environ)
    for key in ('MAKEFLAGS', 'MFLAGS', 'MAKELEVEL'):
        env.pop(key, None)
    result = subprocess.run(['make', '-s', '-f', 'Makefile', '-f', str(overrides), '-o', str(howl),
                             'FORMS_FOR_ARCH=minimal prod-ssh playground', 'HOWL=' + str(howl),
                             'check-prod-ssh', 'check-playground', 'check-minimal'],
                            env=env, capture_output=True, text=True, timeout=60)
    assert result.returncode == 0, result.stdout + result.stderr
    assert result.stdout.splitlines() == ['dispatched-legacy-prod-ssh',
                                          'dispatched-legacy-playground',
                                          'dispatched-native-minimal'], result.stdout
    print('check-dispatch: legacy forms and native minimal execute their intended checks')
