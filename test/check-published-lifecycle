#!/usr/bin/env python3
"""Boot the exact vendor candidate; prove updates on disposable authority from the same tree.

A candidate follows its signed public channel, so its future updates cannot run before
publication. The update proof is produced separately by check-independent-updates on
the same provider and architecture. No production signing key enters that proof.
"""
import hashlib
import http.server
import json
import os
from pathlib import Path
import shutil
import ssl
import subprocess
import sys
import tempfile
import threading
import time
from consumer_trust import (mirror_roots, validate_updates, candidate_boot, enrolled_boot,
                            UPDATE_GATES, CANDIDATE_GATES, PUBLISHED_CHECKS, SSH_CHECKS)
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'release'))
import image_profiles

if len(sys.argv) != 6:
    sys.exit('usage: check-published-lifecycle HOWL PROVIDER BUNDLE UPDATES OUTPUT')
howl, initial, updates, work = [Path(arg).resolve() for arg in (sys.argv[1], *sys.argv[3:])]
provider = sys.argv[2]
manifest = json.loads((initial / 'boot.json').read_text())
arch, form = manifest['image']['arch'], manifest['form']
if provider not in ('lima', 'qemu') or arch not in ('aarch64', 'x86_64') or (provider == 'lima' and arch != 'aarch64'):
    sys.exit('unsupported published lifecycle target')
shellfree = provider == 'qemu'
if form not in image_profiles.FORMS or (not shellfree and form != 'playground'):
    sys.exit('this form requires the QEMU owner-control lifecycle')
if manifest['format'] != 'werewolf-boot/2' or manifest['image']['format'] != 'werewolf-image/2':
    sys.exit('published lifecycle requires indexed boot images')
channel_id, index = manifest['image']['channel_id'], manifest['image']['index']
commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
validate_updates(json.loads((updates / 'result.json').read_text()), provider, arch, commit)
work.mkdir(mode=0o700, parents=True, exist_ok=False)
os.umask(0o077)
bundles = [initial]
# QEMU's console and monitor are Unix sockets (108-byte Linux path limit).
# Keep a fresh consumer independent of the checkout's possibly deep CI path.
consumer_work = tempfile.TemporaryDirectory(prefix='ww-consumer-', dir='/tmp')
consumer = Path(consumer_work.name)
mirror = work / 'mirror'
base = mirror / form / provider / arch
latest = base / 'latest'
latest.mkdir(parents=True)
for bundle in bundles:
    descriptor = hashlib.sha256((bundle / 'boot.json').read_bytes()).hexdigest()
    objects = base / 'objects' / descriptor
    objects.mkdir(parents=True)
    for name in ('vmlinuz', 'root.erofs', 'stage0.zst', 'cmdline', 'uki.efi'):
        os.link(bundle / 'slot' / name, objects / name)
    os.link(bundle / 'disk.img.zst', objects / 'disk.img.zst')
    for name in ('latest.json', 'latest.json.sig'):
        os.link(bundle / 'prebuilt' / arch / name, objects / name)


def promote(bundle):
    for name in ('boot.json.sig', 'boot.json'):
        incoming = latest / (name + '.new')
        shutil.copyfile(bundle / name, incoming)
        os.replace(incoming, latest / name)


promote(initial)
identity, ca, key = [work / name for name in ('ssh.key', 'mirror.crt', 'mirror.key')]
subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', identity], check=True)
root_keys = [] if shellfree else ['--root-keys', str(identity) + '.pub']
subprocess.run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-x509', '-sha256', '-days', '2',
    '-subj', '/CN=werewolf-lifecycle-mirror', '-addext', 'subjectAltName=IP:127.0.0.1',
    '-keyout', key, '-out', ca], check=True, capture_output=True)
requests = []


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(mirror), **kwargs)

    def log_message(self, *args):
        pass

    def do_GET(self):
        requests.append(self.path)
        super().do_GET()


server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain(ca, key)
server.socket = context.wrap_socket(server.socket, server_side=True)
server_thread = threading.Thread(target=server.serve_forever, daemon=True)
server_thread.start()
wrappers = work / 'bin'
wrappers.mkdir()
for tool in ('apko', 'melange', 'zig', 'make', 'gmake', 'mkfs.erofs', 'mformat', 'mke2fs'):
    path = wrappers / tool
    path.write_text('#!/bin/sh\necho "consumer attempted a build: ' + tool + '" >&2\nexit 99\n')
    path.chmod(0o755)
ssh_binary = shutil.which('ssh')
ssh_wrapper = wrappers / 'ssh'
ssh_wrapper.write_text('#!/usr/bin/env python3\nimport os,sys\nos.execv(' + repr(ssh_binary) + ', ' +
    repr([ssh_binary, '-F', '/dev/null', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes', '-i', str(identity)]) + '+sys.argv[1:])\n')
ssh_wrapper.chmod(0o755)
lima_home = Path(tempfile.mkdtemp(prefix='ww-published-lifecycle-', dir='/tmp'))
roots = work / 'mirror-roots.pem'
roots.write_bytes(mirror_roots(ca))
# The consumer's howl data stays here too: a self-hosted runner's own is
# never read or written.
env = dict(os.environ, LIMA_HOME=str(lima_home), SSL_CERT_FILE=str(roots), XDG_DATA_HOME=str(consumer / 'data'),
           WEREWOLF_BOOT_MIRROR='https://127.0.0.1:%d' % server.server_port,
           PATH=str(wrappers) + os.pathsep + os.environ['PATH'], PYTHONDONTWRITEBYTECODE='1')
for name in ('WEREWOLF_BOOT_KEY', 'WEREWOLF_BOOT_CRT', 'WEREWOLF_IPE_KEY', 'WEREWOLF_IPE_CRT',
             'WEREWOLF_IPE_KERNEL', 'UKI_STUB', 'WEREWOLF_BUILD_VM',
             'WEREWOLF_PROTECTED_BOOT_KEY', 'WEREWOLF_PROTECTED_IMAGE_KEY'):
    env.pop(name, None)
names = ['werewolf-run']
machine = consumer / 'build/machines' / names[0]
required = PUBLISHED_CHECKS if shellfree else SSH_CHECKS
arguments = [howl, 'run', '--with', form, '--on', provider, '--add-current-user', 'no', *root_keys]


def run(args, label, check=True, timeout=300):
    result = subprocess.run([str(arg) for arg in args], cwd=consumer, env=env,
                            capture_output=True, timeout=timeout)
    with (work / (label + '.log')).open('ab') as stream:
        stream.write(result.stdout + result.stderr)
    if check and result.returncode:
        raise RuntimeError(label + ': ' + result.stderr.decode(errors='replace')[-3000:])
    return result


def ssh(command, label, **kwargs):
    return run([howl, 'ssh', 'root@werewolf-run', '--no-agent', '--', command], label, **kwargs)


def status():
    if shellfree:
        reply = run([howl, 'owner', names[0], 'status'], 'status', check=False, timeout=20)
        if reply.returncode:
            return None
        try:
            value = json.loads(reply.stdout)
        except ValueError:
            return None
        boot = candidate_boot(value, required, channel_id, index)
        if boot is not None and not value['paused']:
            run([howl, 'owner', names[0], 'pause'], 'pause')
        return boot
    command = ('/usr/lib/werewolf/posture --json; printf "\\nBOOT-ID "; '
               'cat /proc/sys/kernel/random/boot_id; printf "CMDLINE "; cat /proc/cmdline; '
               'printf "COMMITTED "; if test -e /run/werewolf/committed; then echo yes; else echo no; fi')
    reply = ssh(command, 'status', check=False, timeout=15)
    if reply.returncode:
        return None
    text = reply.stdout.decode()
    marker = '\nBOOT-ID '
    if marker not in text:
        return None
    report, extra = text.split(marker, 1)
    value = json.loads(report)
    lines = dict(line.split(' ', 1) for line in ('BOOT-ID ' + extra).splitlines())
    value.update(ready=True, committed=lines.get('COMMITTED') == 'yes',
                 boot_id=lines.get('BOOT-ID'), cmdline=lines.get('CMDLINE', ''))
    boot = candidate_boot(value, required, channel_id, index)
    if boot is not None and ssh('test -e /run/werewolf/updater-ready && sv pause /etc/sv/autoupdate',
                                'pause-updater', check=False, timeout=15).returncode:
        return None
    return boot


def committed(previous=None):
    until = time.monotonic() + 240
    while time.monotonic() < until:
        value = status()
        if value and value['boot_id'] != previous:
            return value
        time.sleep(2)
    raise RuntimeError('the candidate did not report a committed protected boot')


def authority():
    return {name: hashlib.sha256((machine / name).read_bytes()).hexdigest()
            for name in ('boot.crt', 'authority/profile.json')}


def freshness():
    return {str(path): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in (consumer / 'build/boot-cache').rglob('current.json')}


def console():
    return (machine / 'console.log') if shellfree else (lima_home / names[0] / 'serial.log')


try:
    run(arguments, 'first-run', timeout=600)
    first = committed()
    enrolled_boot(console().read_text(errors='replace'), index)
    if not requests:
        raise RuntimeError('the first run downloaded nothing from the mirror')
    if not shellfree:
        for command, label in (('cp /usr/bin/true /data/unsigned-probe && /data/unsigned-probe', 'unsigned'),
                               ('echo tamper >> /usr/bin/true', 'root-write')):
            if ssh(command, label, check=False).returncode == 0:
                raise RuntimeError(label + ' was accepted')
    before, checked, downloaded = authority(), freshness(), len(requests)
    began = time.monotonic()
    run(arguments, 'repeat-run')
    elapsed = time.monotonic() - began
    repeated = status()
    if not repeated or repeated['boot_id'] != first['boot_id'] or len(requests) != downloaded:
        raise RuntimeError('unchanged run rebooted or downloaded again')
    if freshness() != checked or authority() != before:
        raise RuntimeError('unchanged run rechecked freshness or replaced machine authority')
    profile = json.loads((machine / 'authority/profile.json').read_text())
    spec = profile['spec']
    if spec['boot_key'] is not None or spec['ipe_key'] is not None:
        raise RuntimeError('consumer owns a vendor signing key')
    descriptor = hashlib.sha256((initial / 'boot.json').read_bytes()).hexdigest()
    actual = Path(profile['bundle']['directory']) / 'boot.json'
    if hashlib.sha256(actual.read_bytes()).hexdigest() != descriptor:
        raise RuntimeError('the download differs from the candidate')
    run([howl, 'stop'], 'stop')
    run(arguments, 'resume', timeout=600)
    committed(first['boot_id'])
    if authority() != before:
        raise RuntimeError('resume replaced the enrollment')
    report = dict(format='werewolf-boot-gates/1', descriptor=descriptor, arch=arch, provider=provider,
                  checks={name: True for name in CANDIDATE_GATES | UPDATE_GATES})
    (work / 'gates.json').write_text(json.dumps(report, indent=2) + '\n')
    (work / 'result.json').write_text(json.dumps(dict(index=index, unchanged_run_seconds=elapsed,
        unchanged_run_no_network=True, retained_enrollment=True,
        updates='check-independent-updates on disposable keys', commit=commit), indent=2) + '\n')
    print('pass: exact candidate downloads, boots protected at its TPM index and retains enrollment; '
          'updates proved from the same tree on disposable keys', flush=True)
finally:
    if console().exists():
        shutil.copyfile(console(), work / 'console.log')
    if provider == 'lima':
        for log in (lima_home / names[0]).glob('*.log'):
            shutil.copyfile(log, work / ('werewolf-run-' + log.name))
    if (machine / 'create.log').exists():
        shutil.copyfile(machine / 'create.log', work / 'create.log')
    run([howl, 'delete', names[0], '--on', provider], 'cleanup', check=False, timeout=180)
    server.shutdown()
    server_thread.join(timeout=10)
    server.server_close()
    shutil.rmtree(lima_home, ignore_errors=True)
    consumer_work.cleanup()
    identity.unlink(missing_ok=True)
    key.unlink(missing_ok=True)
