# What every werewolf machine must hold, checked as root on its console by
# test/boot. One check a line:
#
#   KIND NAME COMMAND
#
# COMMAND is one line of sh, run in a subshell; exit 0 means it holds.
#
#   ok    must hold.
#   gap   a known weakness (docs/security.md, "Not yet"), so must not hold
#         yet. When one starts holding, make it ok and update the docs.
#
# A form declares the ports it listens on, one a line, in
# /etc/werewolf/listen; ssh's 22 is declared by sshd being installed. The
# listeners check fails on anything else listening.
#
# The machine's settings, and the attacks on them, are posture's to judge
# (cmd/posture/posture.zig): test/boot judges every machine's posture line
# against test/posture-known before these run. Checks here are the boot's
# own behaviour, which posture cannot see.
#
# Checks run in order on one machine. The first waits for the services to
# settle (a service still starting, or one that keeps crashing, reads "want
# up") before judging them. boot-quiet allows the two kernel lines that
# posture's own attacks leave. No tabs: the console's shell would complete
# them.

ok  network          grep -q '10\.0\.2\.15' /proc/net/fib_trie && awk '$2 == "00000000" && $3 == "0202000A" { f = 1 } END { exit !f }' /proc/net/route
ok  services-up      i=0; while sv status /etc/sv/* | grep -qE 'want up|^fail'; do i=$((i + 1)); [ $i -le 30 ] || break; sleep 1; done; sleep 2; ! sv status /etc/sv/* | grep -E 'want up|^fail'
ok  boot-quiet       ! dmesg | grep -E 'Lockdown:|ptrace attach' | grep -v -e 'Lockdown: run: /dev/mem' -e 'ptrace attach of "runit"\[1\] was attempted by "\./run"'
ok  listeners        bad=$(netstat -ltun | awk 'NR > 2 { n = split($4, a, ":"); print a[n] }' | sort -u | grep -vx -e none $(command -v sshd >/dev/null && echo -e 22) $(sed 's/^/-e /' /etc/werewolf/listen 2>/dev/null)); [ -z "$bad" ] || { echo "listening, undeclared: $bad"; exit 1; }
ok  data-usable      [ ! -e /run/werewolf/nodata ]
ok  data-encrypted   ! command -v cryptsetup || grep -q '^/dev/mapper/data /data ' /proc/mounts
ok  slot-commits     ! grep -q werewolf.slot= /proc/cmdline || { i=0; while [ ! -e /run/werewolf/committed ] && [ $i -lt 120 ]; do sleep 1; i=$((i + 1)); done; [ -e /run/werewolf/committed ]; }
ok  cleanup          ! command -v bite-cleanup || ! grep -q werewolf.slot= /proc/cmdline || { bite-cleanup -n | grep -q 'would delete 7 entries' && [ -e /victim/etc/os-release ] && bite-cleanup && [ "$(ls -A /victim | tr '\n' ' ')" = "boot var " ] && [ "$(ls -A /victim/var /victim/var/lib | tr '\n' ' ')" = "/victim/var: lib  /victim/var/lib: werewolf " ] && [ -s /victim/var/lib/werewolf/a/root.erofs ] && [ -s /victim/boot/grub/grubenv ] && [ -d /run/werewolf ]; }
ok  root-unlinked    ! rm -f /init && [ -e /init ] && awk '$2 == "/" { o = $4 } END { exit o !~ /^ro(,|$)/ }' /proc/mounts
# Last, for the second boot (test/checks-again): a mark on a /data that is
# kept on a disk.
ok  data-mark        grep -q ' /data tmpfs ' /proc/mounts || echo kept >/data/.werewolf-check
