#!/bin/sh
# check-slot QEMU... boots minimal's native test image from its slot, as a
# machine howl installs boots: slot a's root.erofs on an ext4, beside a FAT EFI
# partition with one counted entry, and the shared checks (native-tests boot).
# Once healthy, the machine must commit that entry: no try count left. make
# passes CHECK_ENV and ARCH (Makefile).
set -eu
v=$CHECK/slots
img=$CHECK/slots.img
rm -rf "$v" "$img"
mkdir -p "$v/slot/a"
cp "$OUT/slot/root.erofs" "$v/slot/a/"
mke2fs -q -F -t ext4 -U "$SLOTS" -d "$v" "$img" 128M
# Match production's numeric owners instead of the host builder's UID/GID.
for path in /slot /slot/a /slot/a/root.erofs; do
	for field in uid gid; do
		printf 'sif %s %s 0\n' "$path" "$field"
	done
done >"$CHECK/slot-ownership.debugfs"
"$DEBUGFS" -w -f "$CHECK/slot-ownership.debugfs" "$img" >"$CHECK/slot-ownership.log" 2>&1
cmdline="$CMDLINE init=/init werewolf.slots=$SLOTS werewolf.esp=57E1-F000"
sh test/slot-esp "$CHECK/slot-esp.img" a "$cmdline"
build/host/native-tests boot minimal "$ARCH" seed slot "$@" \
    -kernel "$OUT/slot/vmlinuz" -initrd "$OUT/slot/stage0.zst" \
    -append "$cmdline werewolf.slot=a" \
    -drive "file=$img,format=raw,if=virtio" \
    -drive "file=$CHECK/slot-esp.img,format=raw,if=virtio"
mtype -i "$CHECK/slot-esp.img" ::/loader/entries/werewolf-a.conf >/dev/null ||
    { echo "FAIL   slot               EFI entry did not commit"; exit 1; }
! mdir -b -i "$CHECK/slot-esp.img" ::/loader/entries/ | grep -q 'werewolf-a+' ||
    { echo "FAIL   slot               EFI entry still has a try count"; exit 1; }
echo "pass   slot               native EFI entry committed"
