#!/usr/bin/env python3
"""Keep the IPE source version aligned with both locked Alpine kernels."""
import json
import pathlib
import re
import sys

pin = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "boot/kernel-source")
lock = pathlib.Path(sys.argv[2] if len(sys.argv) > 2 else "build/lock/kernel.lock.json")
source = pin.read_text()
version = re.search(r"^version=([0-9]+\.[0-9]+\.[0-9]+)$", source, re.M)
alpine = re.search(r"^alpine_version=([0-9]+\.[0-9]+\.[0-9]+-r[0-9]+)$", source, re.M)
if not version or not re.search(r"^sha256=[0-9a-f]{64}$", source, re.M):
    sys.exit("kernel-version: invalid source version or SHA-256 pin")
packages = json.loads(lock.read_text())["contents"]["packages"]
kernels = [p for p in packages if p["name"] == "linux-virt"]
if len(kernels) != 2 or {p["architecture"] for p in kernels} != {"aarch64", "x86_64"}:
    sys.exit("kernel-version: one Alpine linux-virt lock per supported architecture is required")
versions = {p["version"] for p in kernels}
if len(versions) != 1 or not re.fullmatch(re.escape(version[1]) + r"-r[0-9]+", next(iter(versions))):
    sys.exit(f"kernel-version: source {version[1]} differs from locked Alpine kernels {sorted(versions)}")
if not alpine or versions != {alpine[1]}:
    sys.exit(f"kernel-version: Alpine packages changed: pinned {alpine[1] if alpine else 'missing'}, available {sorted(versions)}")
print(f"pass   kernel-version: source {version[1]} matches both Alpine architecture locks")
