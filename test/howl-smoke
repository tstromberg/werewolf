#!/bin/sh
# howl-smoke HOWL BUILD runs the lines the README and the docs advertise, as
# a user runs them, as far as a line goes with nothing built or booted: -h
# and -n (make test). BUILD holds what howl form -n must not write. Each line
# takes --build, this checkout's forms, so none needs werewolf's repository.
howl=$1 smoke=$2/adhoc/smoke
fail() { echo "howl-smoke: $1"; exit 1; }
# A long validator refusal must not disappear when it exceeds the output buffer.
long=$(awk 'BEGIN { for (i=0; i<3000; i++) printf "x"; printf "end-of-long-diagnostic" }')
out=$("$howl" "$long" 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'end-of-long-diagnostic' || fail "long diagnostic disappeared"
"$howl" versions -h >/dev/null 2>&1 || fail "howl versions -h"
out=$("$howl" run --with playground --version 20261014T232908Z --build 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q -- '--version requires' || fail "version silently selected a source build"
out=$("$howl" create version-check --with playground --version ../image 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q -- '--version takes' || fail "create accepted a version path"
"$howl" run --build -h >/dev/null 2>&1 || fail "howl run -h"
"$howl" run --build -n 2>&1 | grep -q 'as it is' || fail "howl run -n should name its environment's form"
"$howl" run --build --on qemu -n 2>&1 | grep -q 'playground as it is' || fail "howl run --on qemu -n should be playground"
"$howl" run --build --on qemu -h >/dev/null 2>&1 || fail "howl run --on qemu -h"
"$howl" run --build --disable=secureboot,tpm,ipe --dev -h >/dev/null 2>&1 || fail "explicit unprotected development help"
out=$("$howl" create --build smoke --with playground --on firecracker 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'protected deployment is not ready' || fail "default allowed unprotected Firecracker"
out=$("$howl" create --build smoke --with playground --dev 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q -- '--dev --disable=secureboot,tpm,ipe' || fail "--dev silently disabled protection"
out=$("$howl" create --build smoke --with playground --dev=ssh 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q -- '--dev=ssh --disable=secureboot,tpm,ipe' || fail "SSH iteration silently disabled protection"
out=$("$howl" run --build --disable=tpm 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'without all three' || fail "a partial --disable was accepted"
out=$("$howl" run --build --on gcp 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'protected deployment is not ready' || fail "default allowed incomplete cloud protection"
out=$(WEREWOLF_BOOT_MIRROR=http://127.0.0.1 "$howl" run 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'protected image download failed' || fail "published mode silently rebuilt or downgraded"
out=$("$howl" upload missing.qcow2 --on aws 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'cannot bring Secure Boot, the TPM or IPE' || fail "raw-disk upload bypassed the protected default"
"$howl" create --build smoke --with prod -h >/dev/null 2>&1 || fail "howl create smoke --with prod -h"
"$howl" create --build web --with python-app --app ./myapp -h >/dev/null 2>&1 ||
	fail "README: howl create web --with python-app --app ./myapp"
"$howl" run --build --with webshell-example -n 2>&1 | grep -q 'as it is' || fail "README: howl run --with webshell-example"
out=$("$howl" run --build --with vuln-demo -n 2>&1) || fail "README: howl run --with vuln-demo --build: $out"
echo "$out" | grep -q 'as it is' || fail "vuln-demo should run without config: $out"
help=$("$howl" pack --build --with vuln-demo -h 2>&1) || fail "vuln-demo config help: $help"
! echo "$help" | grep -q -- '--n8n-runners-auth-token' || fail "vuln-demo exposed its internal runner token as required config"
"$howl" run --build --with go-example -n 2>&1 | grep -q 'as it is' || fail "examples: howl run --with go-example"
"$howl" create --build web --with python-example --on gcp -h >/dev/null 2>&1 ||
	fail "examples: howl create web --with python-example --on gcp"
"$howl" pack --build --with prod -h >/dev/null 2>&1 || fail "howl pack --with prod -h"
out=$("$howl" run --build --with caddy,valkey -n 2>&1) || fail "howl run --with caddy,valkey -n: $out"
echo "$out" | grep -q 'with:' || fail "run --with caddy,valkey -n did not show the form: $out"
out=$("$howl" run --build --with caddy -n 2>&1) || fail "howl run --with caddy -n: $out"
echo "$out" | grep -q 'as it is' || fail "one form alone should run as it is: $out"
rm -rf "$smoke"
"$howl" form --build --with caddy --packages curl -o "$smoke" -n >/dev/null 2>&1 || fail "howl form -n"
[ ! -e "$smoke" ] || fail "form -n left $smoke"
out=$("$howl" form --build --with prod-ssh -o "$smoke" -n 2>&1) ||
	fail "prod-ssh's replacement of the sshd service collided with its base: $out"
[ ! -e "$smoke" ] || fail "prod-ssh form -n left $smoke"
out=$("$howl" form --build --with prod-ssh --services.other.exec /bin/true \
	--services.other.listen tcp/22 -o "$smoke" -n 2>&1)
[ $? -ne 0 ] && echo "$out" | grep -q 'both listen on tcp/22' ||
	fail "prod-ssh accepted a different service on its SSH port: $out"
! "$howl" run --build caddy >/dev/null 2>&1 || fail "howl run caddy (a positional form) was taken"
! "$howl" _build --with minimal --disk-args x slot >/dev/null 2>&1 || fail "_build took --disk-args without disk"
# forms/mastodon/README.md's line, packed as create packs it: one --domain
# for Caddy and Mastodon, each settings file holding it.
mkdir -p "$smoke.m" && printf x >"$smoke.m/pw"
"$howl" pack --build --with mastodon -o "$smoke.m/c.tar" --domain social.example.com \
	--owner alice --owner-email alice@example.com --owner-password "$smoke.m/pw" >/dev/null 2>&1 ||
	fail "forms/mastodon/README.md: howl pack --with mastodon --domain ... --owner-password FILE"
for f in caddy/settings.json mastodon/settings.json; do
	tar -xOf "$smoke.m/c.tar" "$f" 2>/dev/null | grep -q '"domain":"social.example.com"' ||
		fail "mastodon: --domain did not reach $f"
done
rm -rf "$smoke.m"
# forms/mastodon/README.md's lines, packed as create packs them: one
# --domain for Caddy and Mastodon, and the relay's password a file.
mkdir -p "$smoke.m" && printf x >"$smoke.m/pw"
"$howl" pack --build --with mastodon -o "$smoke.m/c.tar" --domain social.example.com \
	--owner alice --owner-email alice@example.com --owner-password "$smoke.m/pw" \
	--smtp-server smtp.postmarkapp.com --smtp-port 587 --smtp-login u \
	--smtp-from notifications@social.example.com --smtp-password "$smoke.m/pw" >/dev/null 2>&1 ||
	fail "forms/mastodon/README.md: howl pack --with mastodon, its flags"
for f in caddy/settings.json mastodon/settings.json; do
	tar -xOf "$smoke.m/c.tar" "$f" 2>/dev/null | grep -q '"domain":"social.example.com"' ||
		fail "mastodon: --domain did not reach $f"
done
tar -tf "$smoke.m/c.tar" | grep -qx mastodon-jobs/smtp-password ||
	fail "mastodon: --smtp-password is not mastodon-jobs/smtp-password"
rm -rf "$smoke.m"
echo "howl-smoke: the advertised lines take their forms"
