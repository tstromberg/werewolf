#!/usr/bin/env python3
"""Build disposable TPM-gated releases and run the protected QEMU lifecycle."""
import json
import os
from pathlib import Path
import subprocess
import sys
import ab_build

howl, arch, kernel, key, cert, destination = sys.argv[1:]
howl, kernel, key, cert = [str(Path(p).resolve()) for p in [howl, kernel, key, cert]]
root = Path(destination).resolve()
root.mkdir(parents=True, exist_ok=False, mode=0o700)
os.umask(0o077)


def run(args, label, env=None):
    with (root / (label + '.log')).open('wb') as output:
        subprocess.run([str(arg) for arg in args], env=env, stdout=output,
                       stderr=subprocess.STDOUT, check=True)


run(['openssl', 'genrsa', '-out', root / 'permit.key', '2048'], 'permit-key')
run(['openssl', 'pkey', '-in', root / 'permit.key', '-pubout', '-out', root / 'permit.pub'], 'permit-public')
run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '2',
     '-subj', '/CN=werewolf-tpm-required', '-keyout', root / 'boot.key', '-out', root / 'boot.crt'], 'boot-key')
env = dict(os.environ, WEREWOLF_TPM_PUB=str(root / 'permit.pub'),
           AB_BOOT_KEY=str(root / 'boot.key'), AB_BOOT_CRT=str(root / 'boot.crt'))
env.pop('WEREWOLF_BOOT_STATE', None)
if 'UKI_STUB' not in env:
    stub = Path('/usr/lib/systemd/boot/efi') / ('linuxaa64.efi.stub' if arch == 'aarch64' else 'linuxx64.efi.stub')
    if not stub.is_file():
        raise RuntimeError('install systemd-boot-efi or set UKI_STUB to a TPM-enabled systemd stub')
    env['UKI_STUB'] = str(stub)
fixture_dir = root / 'fixture'
run(['python3', 'test/ab-fixture', howl, arch, kernel, key, cert, fixture_dir, 'secure'], 'fixture', env)
run(['python3', 'test/tpm-fixture', fixture_dir / 'fixture.json', root / 'permit.key',
     root / 'permit.pub', 'build/host/tpm-policy', 'build/host/uki'], 'permits')
f = json.loads((fixture_dir / 'fixture.json').read_text())
env['WEREWOLF_BOOT_STATE'] = str(fixture_dir / 'tpm/aa.permit')
args, output = ab_build.arguments(
    howl, f['form'], arch, kernel, key, cert, fixture_dir / 'build', f['channel'],
    f['initial_serial'], root / 'boot.key', root / 'boot.crt', root / 'permit.pub')
run(args, 'factory', env)
ab_build.export(output, f['form'], arch, fixture_dir / 'release-A')
subprocess.run(['python3', 'test/check-tpm-guest', str(fixture_dir / 'fixture.json'),
                str(root / 'guest'), str(Path('build/host/tpm-policy').resolve())], check=True)
print('pass   protected QEMU lifecycle: disposable factory, A/B rollback and retirement cuts')
