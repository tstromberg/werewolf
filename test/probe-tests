    def test_custom_native_clients_do_not_count_as_standard_yaml_probes(self):
        loader = importlib.machinery.SourceFileLoader('coverage', str(Path(__file__).with_name('form-coverage')))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        coverage = importlib.util.module_from_spec(spec)
        loader.exec_module(coverage)
        helper = '/usr/lib/werewolf/test-helper'
        raw = dict(version=1, suites=[
            dict(name='helper', source='driver.zig', mode='wire', user='root',
                 policy={'pledge': 'stdio'}, cases={'seed': ['control'], 'verify': ['control']}),
            dict(name='cases', policy={'run': [helper, '/usr/bin/psql']}, cases=[
                dict(name='custom', steps=[dict(exec={'argv': [helper]}, expect={'exit': 0})]),
                dict(name='client', steps=[dict(exec={'argv': ['/usr/bin/psql']}, expect={'exit': 0})]),
                dict(name='file', steps=[dict(file='/etc/passwd', expect={'type': 'file'})])])])
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            directory = root / 'forms/example/test'
            directory.mkdir(parents=True)
            (root / 'test').mkdir()
            (directory / 'driver.zig').write_text('// Native client fixture.\n')
            (directory / 'tests.yaml').write_text(json.dumps(raw))
            (root / 'test/form-probe-baseline.json').write_text(json.dumps({
                'base': 'fixture', 'forms': {'example': ['custom', 'client', 'file']}}))
            with contextlib.redirect_stdout(io.StringIO()):
                counts = coverage.probe_coverage(root)
            self.assertEqual(counts, {'probes': 2, 'native': 1, 'legacy': 0})

