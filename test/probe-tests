class Plans(unittest.TestCase):
    def plan(self):
        return dict(version=1, suites=[dict(name='web', cases=[dict(name='health', steps=[
            dict(fetch=dict(url='http://localhost/'), expect=dict(status=200))])])])

    def test_normalizes_case_names_and_pinned_transport(self):
        plan = normalize(self.plan(), Path('tests.yaml'))
        self.assertEqual(plan['drivers'][0]['cases'], {'seed': ['health'], 'verify': ['health']})
        self.assertEqual(plan['drivers'][0]['user'], 'root')
        self.assertEqual(plan['packages'], ['libcurl-openssl4'])

    def test_native_drivers_receive_declared_fixtures_without_probe_data(self):
        suite = dict(name='client', source='driver.zig', mode='protocol', user='nobody',
                     policy={'pledge': 'stdio rpath'},
                     fixtures={'password': '/run/config/app/password'},
                     cases={'seed': ['login'], 'verify': ['login']})
        plan = dict(version=1, suites=[suite])
        driver = normalize(plan, Path('tests.yaml'))['drivers'][0]
        self.assertEqual(driver['config'], {'password': '/run/config/app/password'})
        self.assertNotIn('probes', driver)
        for invalid in ('relative', '/etc/shadow', '/run/config/../shadow'):
            suite['fixtures']['password'] = invalid
            with self.subTest(path=invalid), self.assertRaises(ValueError):
                normalize(plan, Path('tests.yaml'))

    def test_rejects_mutating_poll_and_forward_capture(self):
        for changes in [dict(fetch=dict(url='http://localhost/', method='POST'), **{'await': '1s'}),
                        dict(fetch=dict(url='http://localhost/', bearer=dict(step='future', json='/token'))),
                        dict(fetch=dict(url='file:///etc/passwd')),
                        dict(unknown='typo'), dict(expect={})]:
            plan = self.plan()
            plan['suites'][0]['cases'][0]['steps'][0].update(changes)
            with self.subTest(changes=changes), self.assertRaises(ValueError):
                normalize(plan, Path('tests.yaml'))

    def test_rejects_nested_type_errors_and_injection(self):
        for update in (
            {'fetch':{'url':'http://localhost/', 'headers':{'x':3}}},
            {'fetch':{'url':'http://localhost/', 'headers':{'x':'good\r\nbad:value'}}},
            {'fetch':{'url':'http://user:secret@localhost/'}},
            {'fetch':{'url':'http://localhost/', 'resolve':'127.0.0.1'}},
            {'fetch':{'url':'http://localhost/', 'multipart':{'doc':{'file':'relative'}}}},
            {'expect':{'status':{'one_of':200}}},
            {'expect':{'json':{'/bad~2key':True}}},
            {'expect':{'status':{'min':1, 'typo':2}}},
            {'expect':{'status':1 << 60}},
            {'expect':{'status':float('inf')}},
            {'expect':{'body':{'occurrences':{'':0}}}},
            {'expect':{'body':{'occurrences':{'x':-1}}}},
            {'expect':{'body':{'occurrences':{'x':True}}}},
            {'expect':{'body':{'occurrences':{}}}},
        ):
            plan = self.plan()
            plan['suites'][0]['cases'][0]['steps'][0].update(update)
            with self.subTest(update=update), self.assertRaises(ValueError): normalize(plan, Path('tests.yaml'))

    def test_captures_require_a_probe_that_produces_the_selected_field(self):
        for selector in ({'header': 'x-token'}, {'cookie': 'session'}, {'body': True}):
            plan = self.plan()
            suite = plan['suites'][0]
            suite['policy'] = {'run': ['/usr/bin/client']}
            suite['cases'][0]['steps'] = [
                dict(name='client', exec={'argv': ['/usr/bin/client']}, expect={'exit': 0}),
                dict(fetch={'url': 'http://localhost/', 'bearer': dict(step='client', **selector)},
                     expect={'status': 200})]
            with self.subTest(selector=selector), self.assertRaises(ValueError):
                normalize(plan, Path('tests.yaml'))

    def test_listener_absence_can_cover_every_address_but_equality_is_exact(self):
        for expect, valid in [({'absent':[{'port':5432}]},True),
                              ({'contains':[{'address':'127.0.0.1','port':8080}]},True),
                              ({'equals':[]},True), ({'absent':[]},False),
                              ({'contains':[{}]},False), ({'equals':[{'port':5432}]},False)]:
            plan=self.plan()
            plan['suites'][0]['cases'][0]['steps']=[{'listeners':'tcp','expect':expect}]
            if valid: normalize(plan,Path('tests.yaml'))
            else:
                with self.assertRaises(ValueError): normalize(plan,Path('tests.yaml'))

    def test_yaml_duplicate_alias_and_ambiguous_scalar(self):
        for text in ['version: 1\nversion: 1\nsuites: []\n',
                     'version: 1\nsuites: &x [*x]\n',
                     'version: 01\nsuites: []\n',
                     'version: !!int 1\nsuites: []\n', '', 'version: [', 'version: '+ '['*40 +']'*40]:
            with tempfile.TemporaryDirectory() as directory:
                path = Path(directory) / 'tests.yaml'
                path.write_text(text)
                with self.subTest(text=text), self.assertRaises(ValueError): load(path)

    def test_yaml_locations(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'tests.yaml'
            path.write_text('version: 1\nsuites:\n  - name: web\n    cases:\n      - name: health\n        steps:\n          - fetch: {url: "http://localhost/"}\n            expect: {status: 200}\n')
            self.assertEqual(load(path)['drivers'][0]['probes']['cases'][0]['steps'][0]['line'], 7)

    def test_raw_fixture_selector_is_explicit(self):
        plan = self.plan()
        plan['suites'][0]['fixtures'] = {'body': '/run/config/tests/body'}
        request = plan['suites'][0]['cases'][0]['steps'][0]['fetch']
        request.update(method='POST', body={'fixture': 'body', 'raw': True})
        normalize(plan, Path('tests.yaml'))
        for value in (False, 'true', 1, None):
            request['body']['raw'] = value
            with self.subTest(value=value), self.assertRaises(ValueError):
                normalize(plan, Path('tests.yaml'))


class Server(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    calls = {}

    def log_message(self, *_): pass

    def handle(self):
        try: super().handle()
        except (BrokenPipeError, ConnectionResetError): pass  # Bounded clients deliberately disconnect.


    def reply(self, code, value, headers=None):
        body = json.dumps(value).encode()
        self.send_response(code)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Content-Type', 'application/json')
        for key, value in (headers or {}).items(): self.send_header(key, value)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        self.calls[self.path] = self.calls.get(self.path, 0) + 1
        if self.path == '/cookie':
            self.reply(200, {}, {'Set-Cookie': 'session=secret-cookie; Path=/; HttpOnly'})
        elif self.path == '/protected':
            good = self.headers.get('Authorization') == 'Bearer secret-token'
            self.reply(200 if good else 401, {'results': []})
        elif self.path == '/cookie-protected':
            self.reply(200 if self.headers.get('Cookie') == 'session=secret-cookie' else 401, {})
        elif self.path == '/ready':
            self.reply(200, {'ready': self.calls[self.path] >= 3})
        elif self.path in ('/starting', '/invalid-json'):
            if self.path == '/starting' and self.calls[self.path] >= 3:
                self.reply(200, {'ready': True})
            else:
                self.send_response(502 if self.path == '/starting' else 200)
                self.send_header('Content-Length', '0')
                self.end_headers()
        elif self.path == '/duplicate':
            self.send_response(200)
            self.send_header('Content-Length', '2')
            self.send_header('X-Token', 'one')
            self.send_header('X-Token', 'two')
            self.end_headers()
            self.wfile.write(b'{}')
        elif self.path == '/two-cookies':
            self.send_response(200)
            self.send_header('Content-Length', '2')
            self.send_header('Set-Cookie', 'session=one; Path=/')
            self.send_header('Set-Cookie', 'session=two; Path=/protected')
            self.end_headers()
            self.wfile.write(b'{}')
        elif self.path == '/too-large':
            self.reply(200, 'x' * (2 << 20))
        elif self.path == '/truncated':
            self.send_response(200)
            self.send_header('Content-Length', '20')
            self.end_headers()
            self.wfile.write(b'{}')
            self.close_connection = True
        elif self.path == '/../../literal':
            self.reply(200, {'path':self.path})
        elif self.path == '/redirect':
            self.reply(302, {}, {'Location': '/must-not-fetch'})
        else:
            self.reply(404, {})

    def do_POST(self):
        body = self.rfile.read(int(self.headers['Content-Length']))
        self.calls[self.path] = self.calls.get(self.path, 0) + 1
        if self.path == '/binary':
            self.reply(200, {'hex': body.hex()})
        elif self.path == '/echo':
            self.reply(200, {'body':body.decode(), 'type':self.headers.get('Content-Type')})
        elif self.path == '/login' and json.loads(body) == {'username': 'admin', 'password': 'secret-password'}:
            self.reply(200, {'token': 'secret-token'})
        else:
            self.reply(400, {})


@unittest.skipUnless(os.environ.get('HOWL_PROBE_TEST_BINARY'), 'set HOWL_PROBE_TEST_BINARY for transport tests')
class Workflows(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.server = ThreadingHTTPServer(('127.0.0.1', 0), Server)
        cls.thread = threading.Thread(target=cls.server.serve_forever)
        cls.thread.start()
        cls.base = 'http://127.0.0.1:' + str(cls.server.server_port)

    @classmethod
    def tearDownClass(cls):
        cls.server.shutdown()
        cls.server.server_close()
        cls.thread.join()

    def setUp(self): Server.calls = {}

    def run_plan(self, cases, fixture=b'secret-password\n'):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            password = root / 'password'
            password.write_bytes(fixture)
            plan = normalize(dict(version=1, suites=[dict(name='web',
                policy={'run':[sys.executable]}, fixtures={'password': '/run/config/test/password'}, cases=cases)]), Path('tests.yaml'))
            data = plan['drivers'][0]['probes']
            data['fixtures']['password'] = str(password)
            (root / 'plan.json').write_text(json.dumps(data))
            (root / 'context').write_text(json.dumps(dict(run='a' * 32, phase='seed')))
            return subprocess.run([os.environ['HOWL_PROBE_TEST_BINARY'], 'test-web', 'probes', str(root/'context'), str(root/'plan.json')], capture_output=True, text=True, timeout=20)

    def fetch(self, path, **options): return dict(url=self.base+path, **options)

    def test_binary_body_preserves_nuls_but_headers_refuse_them(self):
        fixture = {'fixture': 'password', 'raw': True}
        result = self.run_plan([dict(name='binary', steps=[dict(
            fetch=self.fetch('/binary', method='POST', body=fixture),
            expect={'status': 200, 'json': {'/hex': '00ff0d0a'}})])], fixture=b'\0\xff\r\n')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        result = self.run_plan([dict(name='invalid-header', steps=[dict(
            fetch=self.fetch('/must-not-fetch', bearer=fixture),
            expect={'status': 200})])], fixture=b'\0' * 5)
        self.assertEqual(result.returncode, 1)
        self.assertIn('InvalidTextInput', result.stdout)
        self.assertNotIn('/must-not-fetch', Server.calls)

    def test_token_cookie_polling_and_literal_redirect(self):
        result = self.run_plan([
            dict(name='login', steps=[
                dict(name='login', fetch=self.fetch('/login', method='POST', json={'username': 'admin', 'password': {'fixture': 'password'}}), expect={'status': 200}),
                dict(fetch=self.fetch('/protected', bearer={'step': 'login', 'json': '/token'}), expect={'status': 200, 'json': {'/results': []}})]),
            dict(name='cookies', steps=[
                dict(fetch=self.fetch('/cookie', session='browser'), expect={'status': 200}),
                dict(fetch=self.fetch('/cookie-protected', session='browser'), expect={'status': 200})]),
            dict(name='readiness', steps=[dict(fetch=self.fetch('/ready'), expect={'json': {'/ready': True}}, **{'await': '2s'})]),
            dict(name='redirect', steps=[dict(fetch=self.fetch('/redirect'), expect={'status': 302})]),
        ])
        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)
        self.assertEqual(result.stdout.count('"status":"pass"'), 4)
        self.assertEqual(Server.calls.get('/login'), 1)
        self.assertNotIn('/must-not-fetch', Server.calls)
        self.assertNotIn('secret-', result.stdout+result.stderr)

    def test_failure_stops_dependent_steps_but_not_independent_cases(self):
        result = self.run_plan([
            dict(name='failure', steps=[
                dict(fetch=self.fetch('/missing'), expect={'status': 200, 'json': {'/missing': True}}),
                dict(fetch=self.fetch('/must-not-fetch'), expect={'status': 200})]),
            dict(name='independent', steps=[dict(fetch=self.fetch('/redirect'), expect={'status': 302})]),
        ])
        self.assertEqual(result.returncode, 1, result.stdout+result.stderr)

        self.assertIn('"status":"fail"', result.stdout)
        self.assertIn('"status":"pass"', result.stdout)
        self.assertIn('"got":404', result.stdout)
        self.assertNotIn('/must-not-fetch', Server.calls)

    def test_header_absence_is_explicit_and_rejects_present_headers(self):
        for headers, expected in [({'x-missing': None}, 0), ({'content-type': None}, 1),
                                  ({'x-missing': {'absent': 'secret'}}, 1),
                                  ({'x-missing': ''}, 1)]:
            with self.subTest(headers=headers):
                result = self.run_plan([dict(name='headers', steps=[dict(
                    fetch=self.fetch('/ready'), expect={'status': 200, 'headers': headers})])])
                self.assertEqual(result.returncode, expected, result.stdout+result.stderr)

    def test_readiness_checks_status_before_json_but_rejects_malformed_success(self):
        for path, expected, calls in [('/starting', 0, 3), ('/invalid-json', 1, 1)]:
            with self.subTest(path=path):
                result = self.run_plan([dict(name='ready', steps=[dict(
                    fetch=self.fetch(path), expect={'status': 200, 'json': {'/ready': True}},
                    **{'await': '2s'})])])
                self.assertEqual(result.returncode, expected, result.stdout+result.stderr)
                self.assertEqual(Server.calls[path], calls)

    def test_form_encoding_multipart_and_literal_paths(self):
        result = self.run_plan([
            dict(name='form',steps=[dict(fetch=self.fetch('/echo',method='POST',form={'q':'a & b'}),
                expect={'status':200,'json':{'/body':'q=a%20%26%20b','/type':'application/x-www-form-urlencoded'}})]),
            dict(name='multipart',steps=[dict(fetch=self.fetch('/echo',method='POST',multipart={'title':'example'}),
                expect={'status':200,'json':{'/body':{'contains':'example'},'/type':{'contains':'multipart/form-data; boundary='}}})]),
            dict(name='literal',steps=[dict(fetch=self.fetch('/../../literal'),expect={'status':200,'json':{'/path':'/../../literal'}})]),
        ])
        self.assertEqual(result.returncode,0,result.stdout+result.stderr)

    def test_ambiguous_header_capture_fails_without_running_dependent_request(self):
        result = self.run_plan([dict(name='ambiguous',steps=[
            dict(name='tokens',fetch=self.fetch('/duplicate'),expect={'status':200}),
            dict(fetch=self.fetch('/must-not-fetch',bearer={'step':'tokens','header':'X-Token'}),expect={'status':200}),
        ])])
        self.assertEqual(result.returncode,1,result.stdout+result.stderr)
        self.assertIn('AmbiguousCapture',result.stdout)
        self.assertNotIn('/must-not-fetch',Server.calls)

    def test_cookie_assertions_distinguish_missing_from_ambiguous_names(self):
        result = self.run_plan([dict(name='cookies', steps=[
            dict(fetch=self.fetch('/cookie'), expect={'status': 200, 'cookies': {'session': 'secret-cookie'}}),
            dict(fetch=self.fetch('/cookie-protected'), expect={'status': 401, 'cookies': {'session': None}})])])
        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)
        result = self.run_plan([dict(name='ambiguous', steps=[dict(
            fetch=self.fetch('/two-cookies'), expect={'status': 200, 'cookies': {'session': None}})])])
        self.assertEqual(result.returncode, 1, result.stdout+result.stderr)
        self.assertIn('"field":"session"', result.stdout)

    def test_truncated_and_oversized_http_responses_fail(self):
        result = self.run_plan([
            dict(name='large',steps=[dict(fetch=self.fetch('/too-large'),expect={'status':200})]),
            dict(name='truncated',steps=[dict(fetch=self.fetch('/truncated'),expect={'status':200})]),
        ])
        self.assertEqual(result.returncode,1,result.stdout+result.stderr)
        self.assertEqual(result.stdout.count('"status":"fail"'),2,result.stdout)
        self.assertIn('ResponseTooLarge',result.stdout)
        self.assertIn('HttpTransport',result.stdout)

    def test_timeout_kills_client_helpers_retaining_pipes(self):
        with tempfile.TemporaryDirectory() as directory:
            pidfile=Path(directory)/'pid'
            code = "import os,time; p=os.fork(); open("+repr(str(pidfile))+",'w').write(str(p)) if p else None; time.sleep(60) if not p else None"
            result=self.run_plan([dict(name='helper',steps=[dict(
                exec={'argv':[sys.executable,'-c',code],'readonly':True},expect={'exit':0},**{'await':'1s'})])])
            self.assertEqual(result.returncode,1,result.stdout+result.stderr)
            self.assertIn('Timeout',result.stdout)
            pid=int(pidfile.read_text())
            deadline=time.monotonic()+2
            while time.monotonic()<deadline:
                state=subprocess.run(['ps','-o','stat=','-p',str(pid)],capture_output=True,text=True).stdout.strip()
                if not state or state.startswith('Z'): break
                time.sleep(.05)
            else: self.fail('client helper survived timeout')

    def test_tls_requires_trusted_ca_and_correct_hostname(self):
        with tempfile.TemporaryDirectory() as directory:
            key, cert = Path(directory)/'key', Path(directory)/'cert'
            subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-days','1',
                '-subj','/CN=localhost','-addext','subjectAltName=DNS:localhost',
                '-keyout',str(key),'-out',str(cert)],check=True,capture_output=True)
            context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            context.load_cert_chain(cert,key)
            server = ThreadingHTTPServer(('127.0.0.1',0),Server)
            server.socket = context.wrap_socket(server.socket,server_side=True)
            thread = threading.Thread(target=server.serve_forever)
            thread.start()
            try:
                url = 'https://localhost:'+str(server.server_port)+'/redirect'
                result = self.run_plan([
                    dict(name='untrusted',steps=[dict(fetch={'url':url},expect={'status':302})]),
                    dict(name='wrong-host',steps=[dict(fetch={'url':url.replace('localhost','127.0.0.1'),'ca':str(cert)},expect={'status':302})]),
                    dict(name='trusted',steps=[dict(fetch={'url':url,'ca':str(cert)},expect={'status':302})]),
                ])
                self.assertEqual(result.returncode,1,result.stdout+result.stderr)
                self.assertEqual(result.stdout.count('CertificateVerification'),2,result.stdout)
                self.assertIn('"case":"trusted","status":"pass"',result.stdout)
            finally:
                server.shutdown(); server.server_close(); thread.join()

    def test_exec_stdin_drains_both_pipes_and_reports_exit(self):
        code = "import sys; sys.stdout.write('o'*100000); sys.stdout.flush(); sys.stderr.write('e'*10000); sys.stderr.flush(); data=sys.stdin.read(); sys.stdout.write(data); sys.exit(7)"
        result = self.run_plan([dict(name='client', steps=[dict(
            exec={'argv':[sys.executable, '-c', code], 'stdin':'i'*100000},
            expect={'exit':7, 'stdout':{'count':200000}, 'stderr':{'count':10000}})])])
        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)

    def test_exec_json_workflow_passes_captured_values_as_literal_arguments(self):
        value = 'literal; $(exit 9)'
        result = self.run_plan([dict(name='client-json', steps=[
            dict(name='list', exec={'argv': [sys.executable, '-c',
                'import json; print(json.dumps([{"id": "literal; $(exit 9)"}]))']},
                expect={'exit': 0, 'json': {'': {'count': 1}, '/0/id': value}}),
            dict(exec={'argv': [sys.executable, '-c', 'import sys; print(sys.argv[1])',
                {'step': 'list', 'json': '/0/id'}]}, expect={'exit': 0, 'stdout': value+'\n'})])])
        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)
        result = self.run_plan([dict(name='client-failed', steps=[dict(
            exec={'argv': [sys.executable, '-c', 'print("not JSON"); raise SystemExit(7)']},
            expect={'exit': 0, 'json': {'/id': 'unused'}})])])
        self.assertEqual(result.returncode, 1)
        self.assertIn('"field":"exit"', result.stdout)
        self.assertNotIn('SyntaxError', result.stdout)

    def test_exec_timeout_after_output_closes_is_not_success(self):
        code = "import os,time; os.close(1); os.close(2); time.sleep(60)"
        start = time.monotonic()
        result = self.run_plan([dict(name='timeout', steps=[dict(
            exec={'argv':[sys.executable, '-c', code], 'readonly':True},
            expect={'exit':0}, **{'await':'1s'})])])
        self.assertEqual(result.returncode, 1, result.stdout+result.stderr)
        self.assertIn('Timeout', result.stdout)
        self.assertLess(time.monotonic()-start, 5)

    def test_exec_output_limit_fails(self):
        code = "import sys; sys.stdout.write('x'*2000000)"
        result = self.run_plan([dict(name='large', steps=[dict(
            exec={'argv':[sys.executable, '-c', code]}, expect={'exit':0})])])
        self.assertEqual(result.returncode, 1, result.stdout+result.stderr)
        self.assertIn('StreamTooLong', result.stdout)

    def test_capture_type_error_fails_case_without_crashing_runner(self):
        result = self.run_plan([
            dict(name='bad-capture', steps=[
                dict(name='login', fetch=self.fetch('/login', method='POST', json={'username':'admin','password':{'fixture':'password'}}), expect={'status':200}),
                dict(fetch=self.fetch('/protected', bearer={'step':'login','json':''}), expect={'status':200})]),
            dict(name='independent', steps=[dict(fetch=self.fetch('/redirect'),expect={'status':302})])])
        self.assertEqual(result.returncode, 1, result.stdout+result.stderr)
        self.assertIn('"case":"independent","status":"pass"', result.stdout)

    def test_builtin_run_id_is_literal_typed_data(self):
        result = self.run_plan([dict(name='run-id', steps=[dict(
            exec={'argv':[sys.executable,'-c','import sys; print(sys.argv[1])',{'run':True}]},
            expect={'exit':0,'stdout':'a'*32+'\n'})])])
        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)


