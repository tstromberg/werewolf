        self.assertEqual(compiled['timeout_seconds'], 45)
        self.assertEqual(compiled['await_seconds'], 0)
        for invalid in ('0s', '301s', '-1s', '1m', 45, True):
            step['timeout'] = invalid
            with self.subTest(timeout=invalid), self.assertRaises(ValueError):
                normalize(plan, Path('tests.yaml'))
        step.update(timeout='45s', **{'await': '60s'})
        with self.assertRaises(ValueError): normalize(plan, Path('tests.yaml'))
        step.clear()
        step.update(file='/etc/passwd', timeout='1s', expect={'exists': True})
        with self.assertRaises(ValueError): normalize(plan, Path('tests.yaml'))

