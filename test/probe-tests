    def test_tls_startup_handshake_retries_only_with_explicit_await(self):
        with tempfile.TemporaryDirectory() as directory:
            key, cert = Path(directory)/'key', Path(directory)/'cert'
            subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-days','1',
                '-subj','/CN=localhost','-addext','subjectAltName=DNS:localhost',
                '-keyout',str(key),'-out',str(cert)],check=True,capture_output=True)
            context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            context.load_cert_chain(cert,key)

            class StartingTLS(ThreadingHTTPServer):
                attempts = 0

                def get_request(self):
                    sock, address = super().get_request()
                    self.attempts += 1
                    if self.attempts == 1:
                        # Caddy can accept TLS before it has a serving certificate.
                        sock.sendall(b'\x15\x03\x03\x00\x02\x02\x50')
                        sock.close()
                        raise OSError('certificate not ready')
                    return context.wrap_socket(sock, server_side=True), address

            for wait in (False, True):
                with self.subTest(wait=wait):
                    server = StartingTLS(('127.0.0.1',0),Server)
                    thread = threading.Thread(target=server.serve_forever)
                    thread.start()
                    try:
                        step = dict(fetch={'url':'https://localhost:'+str(server.server_port)+'/redirect',
                                           'ca':str(cert)}, expect={'status':302})
                        if wait: step['await'] = '3s'
                        result = self.run_plan([dict(name='startup',steps=[step])])
                        self.assertEqual(result.returncode, 0 if wait else 1,
                                         result.stdout+result.stderr)
                        self.assertEqual(server.attempts, 2 if wait else 1)
                        if not wait: self.assertIn('TlsHandshake', result.stdout)
                    finally:
                        server.shutdown(); server.server_close(); thread.join()

