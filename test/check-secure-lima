#!/usr/bin/env python3
"""Exercise secured local CLI deployment and contextual A/B updates under Lima or QEMU.

--build makes a protected bundle signed with the caller's keys, which the machine
enrolls as it would werewolf's download; a rerun with changed inputs offers it
the next bundle. Keys go to a private XDG_DATA_HOME, never the caller's own."""
import concurrent.futures
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import tempfile
import subprocess
import sys
import time
from tpm_proxy import Proxy
from publisher_transport import connection as publisher_connection

howl, kernel, key, cert, stub, output = sys.argv[1:7]
provider = sys.argv[7] if len(sys.argv) == 8 else "lima"
if provider not in ["lima", "qemu"]:
    raise ValueError("provider must be lima or qemu")
arch = "aarch64" if os.uname().machine in ["arm64", "aarch64"] else "x86_64"
howl, kernel, key, cert, stub = [str(Path(p).resolve()) for p in [howl, kernel, key, cert, stub]]
work = Path(output).resolve()
work.mkdir(parents=True, mode=0o700, exist_ok=False)
os.umask(0o077)
name = 'ww-secure-' + secrets.token_hex(6)
proxy = None
proxy_work = tempfile.TemporaryDirectory(prefix='ww-secure-proxy-')
proxy_dir = Path(proxy_work.name)
wrapper_dir = work / 'wrapper'
wrapper_dir.mkdir()
qemu_binary = shutil.which('qemu-system-' + arch)
if not qemu_binary:
    raise RuntimeError('missing QEMU')
wrapper = wrapper_dir / ('qemu-system-' + arch)
wrapper.write_text('''#!/usr/bin/env python3
import json, os, sys, time
from pathlib import Path
args = sys.argv[1:]
root = Path(''' + repr(str(proxy_dir)) + ''')
for i, arg in enumerate(args):
    if i and args[i - 1] == '-chardev' and 'socket,' in arg and 'tpm' in arg:
        parts = arg.split(',')
        backend = next(part[5:] for part in parts if part.startswith('path='))
        (root / 'backend.json').write_text(json.dumps(backend))
        while not (root / 'ready').exists(): time.sleep(.05)
        args[i] = ','.join('path=' + str(root / 'proxy.sock') if part.startswith('path=') else part for part in parts)
os.execv(''' + repr(qemu_binary) + ''', [''' + repr(qemu_binary) + ''', *args])
''')
wrapper.chmod(0o755)
ssh_binary = shutil.which('ssh')
private_ssh = work / 'ssh.key'
ssh_wrapper = wrapper_dir / 'ssh'
ssh_options = [ssh_binary, '-F', '/dev/null', '-o', 'BatchMode=yes',
               '-o', 'IdentitiesOnly=yes', '-i', str(private_ssh)]
ssh_wrapper.write_text('#!/usr/bin/env python3\nimport os,sys\nos.execv(' + repr(ssh_binary) +
                       ', ' + repr(ssh_options) + ' + sys.argv[1:])\n')
ssh_wrapper.chmod(0o755)
machine = Path('build/machines') / name
authority = machine / 'authority'
form = work / 'form'
overlay = form / 'rootfs'
overlay.mkdir(parents=True)
(form / 'form.yaml').write_text('base: playground\nweaknesses:' +
    Path('forms/playground/form.yaml').read_text().split('weaknesses:', 1)[1])
label_file = overlay / 'usr/share/werewolf/ab-release'
label_file.parent.mkdir(parents=True)
label_file.write_text('A\n')
env = dict(os.environ, WEREWOLF_IPE_KERNEL=kernel, WEREWOLF_IPE_KEY=key,
           WEREWOLF_IPE_CRT=cert, UKI_STUB=stub,
           WEREWOLF_BOOT_KEY=str(work / 'boot.key'),
           WEREWOLF_BOOT_CRT=str(work / 'boot.crt'),
           XDG_DATA_HOME=str(work / 'data'),
           PATH=str(wrapper_dir) + os.pathsep + os.environ['PATH'])


def run(args, label, check=True, timeout=600):
    result = subprocess.run([str(arg) for arg in args], env=env, text=True,
                            capture_output=True, timeout=timeout, umask=0o022)
    with (work / (label + '.log')).open('a') as log:
        log.write(result.stdout + result.stderr)
    if check and result.returncode:
        raise RuntimeError(label + ': ' + result.stderr[-2000:])
    return result


def ssh(command, label, **kwargs):
    return run([howl, 'ssh', name, '--', command], label, **kwargs)


def wait_boot(label, previous=None, anchor=None, committed=True):
    until = time.monotonic() + 240
    paused = None
    while time.monotonic() < until:
        try:
            reply = ssh('/usr/bin/ab-status', 'status', check=False, timeout=10)
            status = json.loads(reply.stdout) if reply.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError):
            status = None
        if status and status['release'] == label and status['boot_id'] != previous:
            if not all(status[flag] for flag in ['secure_boot', 'ipe', 'verified_root', 'rollback_protected']):
                raise RuntimeError('missing guest enforcement: ' + str(status))
            if paused != status['boot_id'] and status['committed'] is committed:
                result = ssh('test -e /run/werewolf/updater-ready && sv pause /etc/sv/autoupdate',
                             'pause', check=False, timeout=10)
                if result.returncode:
                    time.sleep(2)
                    continue
                paused = status['boot_id']
            if status['committed'] is committed:
                if anchor is not None and status['tpm_anchor'] != anchor:
                    raise RuntimeError('rollback or restart changed protected authorization')
                mappings = json.loads((authority / 'releases.json').read_text())
                if mappings.get(status['release_id']) != status['pcr11']:
                    raise RuntimeError('actual PCR does not match this signed release identity')
                with (work / 'evidence.jsonl').open('a') as log:
                    log.write(json.dumps(status) + '\n')
                print('pass   secure-' + provider + ': ' + label + ', enrolled firmware, IPE, exact measured TPM pair', flush=True)
                return status
        time.sleep(2)
    raise RuntimeError('secured ' + provider + ' did not commit ' + label)


def candidate_bundle():
    return json.loads((authority / 'profile.json').read_text())['candidate']['directory']


def refresh(label):
    # A rerun with changed inputs builds the next bundle and offers it.
    label_file.write_text(label + '\n')
    run(create, 'refresh-' + label)
    bundle = candidate_bundle()
    run(create, 'unchanged-' + label)
    if candidate_bundle() != bundle:
        raise RuntimeError('unchanged pinned inputs generated another release')
    image = json.loads((Path(bundle) / 'latest.json').read_bytes())
    core = b'werewolf.release/2\0' + arch.encode() + b'\0'
    for filename in ['root.erofs', 'vmlinuz', 'stage0.zst']:
        core += bytes.fromhex(image['files'][filename]['sha256'])
    core += bytes.fromhex(image['boot_context'])
    return hashlib.sha256(core).hexdigest()


def update(label, previous, committed=True):
    candidate = refresh(label)
    ssh('/usr/lib/werewolf/slot-update check', 'check-' + label)
    ssh('/usr/lib/werewolf/slot-update try', 'try-' + label, check=False, timeout=30)
    current = wait_boot(label, previous['boot_id'], committed=committed)
    if current['tpm_anchor'] == previous['tpm_anchor']:
        raise RuntimeError('replacement did not retire the inactive release')
    raw = (authority / 'records' / (current['tpm_anchor'] + '.permit')).read_bytes()
    if raw[112:144].hex() != candidate:
        raise RuntimeError('permit named a different candidate')
    if raw[144:176].hex() != previous['pcr11']:
        raise RuntimeError('permit did not bind the actual retained boot')
    return current


try:
    run(['openssl', 'req', '-newkey', 'rsa:4096', '-nodes', '-x509', '-sha256',
         '-days', '2', '-subj', '/CN=werewolf-caller-build',
         '-keyout', env['WEREWOLF_BOOT_KEY'], '-out', env['WEREWOLF_BOOT_CRT']], 'boot-key')
    run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', private_ssh], 'ssh-key')
    probe = overlay / 'usr/bin/ab-status'
    probe.parent.mkdir(parents=True)
    run(['zig', 'build-exe', '-O', 'ReleaseSafe', '-target', arch + '-linux-musl',
         '--dep', 'cmdline', '--dep', 'ipe', '--dep', 'tpm', '-Mroot=test/ab-status.zig',
         '--dep', 'network', '-Mcmdline=lib/cmdline.zig', '-Mnetwork=lib/network.zig',
         '-Mipe=lib/ipe.zig', '--dep', 'apk', '-Mtpm=lib/tpm.zig', '--dep', 'package',
         '-Mapk=lib/apk.zig', '-Mpackage=lib/package.zig', '-femit-bin=' + str(probe)], 'probe')
    for path in overlay.rglob('*'):
        path.chmod(0o755 if path.is_dir() or path == probe else 0o644)
    # Exercise the protected default, without a Lima selector.
    create = [howl, 'create', name, '--with', form, '--build', '--yes', '--root-keys', str(private_ssh) + '.pub']
    if provider == 'qemu':
        create += ['--on', provider]
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        creation = pool.submit(run, create, 'create')
        deadline = time.monotonic() + 600
        while not (proxy_dir / 'backend.json').exists():
            if creation.done():
                creation.result()
                raise RuntimeError('QEMU did not attach its TPM through the test proxy')
            if time.monotonic() > deadline:
                raise RuntimeError('QEMU launch did not reach the TPM proxy')
            time.sleep(.1)
        if (machine / 'boot.crt').read_bytes() != (work / 'boot.crt').read_bytes():
            raise RuntimeError('--build did not enroll the caller\'s boot certificate')
        backend = json.loads((proxy_dir / 'backend.json').read_text())
        proxy = Proxy(proxy_dir / 'proxy.sock', backend)
        (proxy_dir / 'ready').touch()
        creation.result()
    a = wait_boot('A')
    profile = json.loads((authority / 'profile.json').read_text())
    if profile['spec'].get('tpm_firmware'):
        ssh('test "$(cat /usr/share/werewolf/tpm/protocol)" = 2-firmware && '
            'test ! -e /usr/share/werewolf/tpm/signer.pub && '
            'test "$(wc -c < /usr/share/werewolf/tpm/vendor.sha256)" -eq 32',
            'authority-source')
    refused = run([*create, '--disable=secureboot,tpm,ipe'], 'downgrade-refused', check=False)
    if refused.returncode == 0 or 'keeps its protections' not in refused.stderr:
        raise RuntimeError('existing enrollment accepted --disable')
    if (machine / 'boot.key').exists():
        raise RuntimeError('the machine holds a private boot key; the caller\'s keys stay in its data directory')
    configuration = json.loads((authority / 'publisher.json').read_text())
    for secret in [work / 'data/howl/keys/boot' / arch / 'boot.key', Path(configuration['key']),
                   authority / 'permit.key', authority / 'credentials/owner.auth',
                   authority / 'credentials/lockout.auth']:
        if secret.stat().st_mode & 0o777 != 0o600:
            raise RuntimeError('private host key permissions weakened: ' + str(secret))
    attempt = ssh('cp /usr/bin/true /data/unsigned-probe && /data/unsigned-probe', 'unsigned', check=False)
    if attempt.returncode == 0:
        raise RuntimeError('unsigned writable code executed')
    attempt = ssh('echo tamper >> /usr/bin/true', 'root-write', check=False)
    if attempt.returncode == 0:
        raise RuntimeError('verified root accepted a write')
    b = update('B', a)
    c = update('C', b)
    # Registered history is not authority to install a retired release.
    configuration = json.loads((authority / 'publisher.json').read_text())
    factory_record = (authority / 'factory.permit').read_bytes()
    current_head = json.loads((authority / 'approved.json').read_text())
    route = '/' + arch + '/permits/' + factory_record[16:48].hex() + '/' + factory_record[112:144].hex() + \
            '.permit?from=' + c['tpm_anchor'] + '&retain=' + current_head['candidate']
    connection = publisher_connection(configuration)
    try:
        connection.request('GET', route)
        response = connection.getresponse()
        response.read()
        if response.status != 404:
            raise RuntimeError('host issuer did not refuse a retired image: %d' % response.status)
    finally:
        connection.close()
    ssh('/usr/lib/werewolf/slot-update try', 'rollback-B', check=False, timeout=30)
    b2 = wait_boot('B', c['boot_id'], c['tpm_anchor'])
    # An unchanged create keeps a running machine. Request the restart explicitly.
    if provider == 'lima':
        run(['limactl', 'stop', '--force', name], 'stop')
    else:
        ssh('/usr/bin/reboot', 'restart-request', check=False, timeout=30)
    run(create, 'restart')
    b3 = wait_boot('B', b2['boot_id'], b2['tpm_anchor'])
    d = update('D', b3)
    # Gate the actual TPM command on the host; no hooks enter the signed guest.
    candidate = refresh('F')
    recovered = d
    for cut in ['before', 'after']:
        proxy.arm(cut)
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
            checking = pool.submit(ssh, '/usr/lib/werewolf/slot-update check', 'cut-' + cut,
                                   check=False, timeout=240)
            try:
                if not proxy.hit.wait(180) or proxy.failures:
                    raise RuntimeError('TPM retirement boundary not reached: ' + str(proxy.failures))
                if provider == 'lima':
                    instance = json.loads(run(['limactl', 'list', name, '--json'], 'instance').stdout)
                    home = Path(instance['dir'])
                    vm_pid = int((home / 'qemu.pid').read_text())
                    processes = subprocess.check_output(['ps', '-axo', 'pid=,command='], env=env, text=True).splitlines()
                    matches = [int(line.split(None, 1)[0]) for line in processes
                               if backend in line and '--tpmstate' in line and 'swtpm' in line]
                    if len(matches) != 1:
                        raise RuntimeError('cannot identify the owned Lima TPM process')
                    tpm_pid = matches[0]
                else:
                    vm_pid = int((machine / 'qemu.pid').read_text())
                    home = None
                    # The private host service owns its swtpm; discover only its child.
                    tpm_pid = int((authority / 'tpm.pid').read_text())
                os.kill(vm_pid, signal.SIGKILL)
                try:
                    os.kill(tpm_pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                proxy.cancel()
            finally:
                proxy.cancel()
                checking.result()
        # Recreate the proxy connections while preserving disk, keys and backing NV.
        proxy.close()
        proxy = Proxy(proxy_dir / 'proxy.sock', backend)
        if provider == 'lima':
            run(['limactl', 'stop', '--force', name], 'stop-after-' + cut)
        run(create, 'recover-' + cut)
        following = wait_boot('D', recovered['boot_id'], recovered['tpm_anchor'] if cut == 'before' else None)
        if cut == 'after':
            raw = (authority / 'records' / (following['tpm_anchor'] + '.permit')).read_bytes()
            if following['tpm_anchor'] == recovered['tpm_anchor'] or raw[112:144].hex() != candidate:
                raise RuntimeError('completed retirement was lost after power cut')
        recovered = following
        print('pass   secure-' + provider + ': ' + cut + ' retirement power cut recovered D', flush=True)
    ssh('/usr/lib/werewolf/slot-update check', 'resume-F')
    ssh('/usr/lib/werewolf/slot-update try', 'try-F', check=False, timeout=30)
    d = wait_boot('F', recovered['boot_id'], recovered['tpm_anchor'])
    unhealthy = overlay / 'etc/sv/ab-unhealthy'
    unhealthy.mkdir(parents=True, mode=0o755)
    for path in [overlay / 'etc', overlay / 'etc/sv']:
        path.chmod(0o755)
    (unhealthy / 'run').symlink_to('/usr/bin/false')
    trial = update('E', d, committed=False)
    ssh('/usr/bin/reboot', 'failed-trial-reboot', check=False, timeout=30)
    wait_boot('F', trial['boot_id'], trial['tpm_anchor'])
    print('pass   secure-' + provider + ': A/B updates, rollback, power cuts, restart and tamper refusals', flush=True)
finally:
    if authority.exists():
        for filename in ['releases.json', 'approved.json', 'permit.pub', 'factory.permit']:
            source = authority / filename
            if source.exists():
                (work / filename).write_bytes(source.read_bytes())
    if provider == 'qemu':
        console = machine / 'console.log'
        if console.exists():
            (work / 'console.log').write_bytes(console.read_bytes())
    else:
        instance = Path(env.get('LIMA_HOME', str(Path.home() / '.lima'))) / name
        console = instance / 'serial.log'
        if console.exists():
            (work / 'console.log').write_bytes(console.read_bytes())
    for source, target in [(machine / 'create.log', 'native-create.log'),
                           (machine / 'build.log', 'native-build.log')]:
        if source.exists():
            (work / target).write_bytes(source.read_bytes())
    if machine.exists():
        run([howl, 'delete', name, '--on', provider], 'cleanup', check=False)
    if proxy:
        proxy.close()
    private_ssh.unlink(missing_ok=True)
    (work / 'boot.key').unlink(missing_ok=True)
    shutil.rmtree(work / 'data', ignore_errors=True)
    proxy_work.cleanup()
