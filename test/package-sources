#!/usr/bin/env python3
"""Check source ownership, pin tampering and external release inputs without network."""
import importlib.machinery
import os
from pathlib import Path
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path('release').resolve()))
sources = importlib.machinery.SourceFileLoader('package_sources_tested', 'tools/checkout-packages').load_module()
images = importlib.machinery.SourceFileLoader('package_images_tested', 'release/form-images').load_module()


class Sources(unittest.TestCase):
    def setUp(self):
        self.work = tempfile.TemporaryDirectory(prefix='ww-package-source-')
        self.addCleanup(self.work.cleanup)
        self.root = Path(self.work.name)
        self.context = self.root / 'solr'
        self.context.mkdir()
        self.recipe = self.context / 'solr.yaml'
        self.recipe.write_text('package: original\n')
        self.patch = self.context / 'port.patch'
        self.patch.write_text('original patch\n')

    def test_patch_bytes_modes_and_removal_change_both_identities(self):
        def identities():
            return sources.digest(self.root, ['solr']), images.recipe_identity([str(self.recipe)])
        original = identities()
        old = self.patch.stat()
        self.patch.write_text('modified patch\n')
        os.utime(self.patch, ns=(old.st_atime_ns, old.st_mtime_ns))
        changed = identities()
        self.assertTrue(all(a != b for a, b in zip(original, changed)))
        self.patch.chmod(0o755)
        executable = identities()
        self.assertTrue(all(a != b for a, b in zip(changed, executable)))
        self.patch.unlink()
        self.assertTrue(all(a != b for a, b in zip(executable, identities())))

    def test_missing_context_fails_and_unrelated_context_does_not_change_identity(self):
        original = sources.digest(self.root, ['solr'])
        (self.root / 'other').mkdir()
        (self.root / 'other/recipe.yaml').write_text('unrelated')
        self.assertEqual(original, sources.digest(self.root, ['solr']))
        with self.assertRaisesRegex(ValueError, 'missing package context'):
            sources.digest(self.root, ['missing'])
        with self.assertRaisesRegex(ValueError, 'missing recipe context'):
            images.recipe_identity([str(self.root / 'missing/recipe.yaml')])

    def test_existing_user_checkout_is_never_updated(self):
        (self.root / '.git').mkdir()
        source = dict(name='packages', repository='https://example.invalid/packages', ref='main')
        with patch.object(sources.subprocess, 'run') as run:
            sources.checkout(source, self.root)
        run.assert_not_called()
        self.assertEqual('package: original\n', self.recipe.read_text())


if __name__ == '__main__':
    unittest.main()
