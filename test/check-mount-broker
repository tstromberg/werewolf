#!/usr/bin/env python3
"""Exercise the real confined broker with three private role channels.

Linux root, in a private mount namespace: mount tmpfs on /run first.
No request in this test performs a mount, writes boot media, or reboots.
"""
import fcntl
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import time

if os.geteuid() != 0 or not Path("/run/runit").is_dir():
    sys.exit("run as root with a private /run/runit fixture")

binary = str(Path(sys.argv[1]).resolve())


def start(log):
    pairs = [socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET) for _ in range(3)]
    for server, _ in pairs:
        server.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4096)

    def child():
        copies = [fcntl.fcntl(server.fileno(), fcntl.F_DUPFD_CLOEXEC, 128) for server, _ in pairs]
        for dst, src in zip((3, 4, 5), copies):
            os.dup2(src, dst)

    inherited = set((3, 4, 5)) | {server.fileno() for server, _ in pairs}
    proc = subprocess.Popen([binary], pass_fds=tuple(inherited), preexec_fn=child,
                            stdout=log, stderr=log)
    clients = []
    for server, client in pairs:
        server.close()
        client.settimeout(3)
        clients.append(client)
    return proc, clients


def exchange(client, request, expected):
    client.send(request)
    answer = client.recv(2048)
    if answer != expected:
        raise RuntimeError(f"request {request!r}: expected {expected!r}, got {answer!r}")


def stall(client, request):
    client.setblocking(False)
    sent = 0
    until = time.monotonic() + 1
    while sent < 4096 and time.monotonic() < until:
        try:
            client.send(request)
            sent += 1
        except BlockingIOError:
            time.sleep(.001)
        except (BrokenPipeError, ConnectionResetError):
            break
    if sent < 2:
        raise RuntimeError(f"fixture could not queue requests ({sent})")


def closed(client):
    client.settimeout(3)
    for _ in range(4096):
        try:
            if not client.recv(2048):
                return
        except ConnectionResetError:
            return
    raise RuntimeError("stalled channel retained after losing replies")


with tempfile.TemporaryFile() as log:
    proc, clients = start(log)
    updater, keeper, stage = clients
    try:
        exchange(updater, b"owner-channel", b"ok none\n")
        exchange(keeper, b"shutdown", b"no NotStageThree\n")
        exchange(stage, b"reboot", b"no NotSlotService\n")
        exchange(updater, b"reboot extra", b"no BadRequest\n")
        exchange(updater, b"x" * 1025, b"no BadRequest\n")
        exchange(updater, b"owner-channel", b"ok none\n")
        print("PASS role restrictions, exact requests, oversized packets, recovery", flush=True)
        # Stop reading replies; force a full broker send queue without filling
        # its log or invoking any device/file operation.
        stall(updater, b"owner-channel")
        exchange(stage, b"reboot", b"no NotSlotService\n")
        exchange(keeper, b"shutdown", b"no NotStageThree\n")
        closed(updater)
        print("PASS stalled updater cannot block keeper or shutdown channel", flush=True)
        stall(stage, b"reboot")
        exchange(keeper, b"shutdown", b"no NotStageThree\n")
        closed(stage)
        print("PASS ordinary replies also disconnect stalled readers", flush=True)
        keeper.send(b"")
        closed(keeper)
        print("PASS empty request closes its channel", flush=True)
        if proc.poll() is not None:
            raise RuntimeError("broker exited")
    except Exception:
        log.seek(0)
        sys.stderr.write(log.read().decode(errors="replace")[-4096:])
        raise
    finally:
        for client in clients:
            client.close()
        proc.kill()
        proc.wait(timeout=5)

if len(sys.argv) > 2:
    unit = str(Path(sys.argv[2]).resolve())
    with tempfile.TemporaryDirectory(prefix="broker-files-", dir="/tmp") as directory:
        subprocess.run([unit], cwd=directory, check=True, timeout=60)
