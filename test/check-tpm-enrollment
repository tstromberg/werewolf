#!/usr/bin/env python3
"""Verify native host enrollment, private credentials, restart and reset refusal."""
import hashlib
import signal
import socket
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

probe = Path(os.environ.get('TPM_POLICY_PROBE', 'build/host/tpm-policy')).resolve()


def command(*args, success=True):
    result = subprocess.run([str(probe), *map(str, args)], capture_output=True, timeout=20)
    if (result.returncode == 0) != success:
        raise RuntimeError('unexpected enrollment result: ' + result.stderr.decode(errors='replace')[-1000:])
    return result


def start(work):
    endpoint = work / 'tpm.sock'
    control = work / 'ctrl.sock'
    for path in [endpoint, control]:
        path.unlink(missing_ok=True)
    process = subprocess.Popen(['swtpm', 'socket', '--tpm2', '--tpmstate', 'dir=' + str(work / 'nv'),
                                '--server', 'type=unixio,path=' + str(endpoint),
                                '--ctrl', 'type=unixio,path=' + str(control),
                                '--flags', 'not-need-init,startup-clear'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    for _ in range(100):
        if process.poll() is not None:
            raise RuntimeError(process.stderr.read().decode())
        if endpoint.exists():
            return process, 'unix:' + str(endpoint)
        time.sleep(0.05)
    process.terminate()
    process.communicate(timeout=10)
    raise RuntimeError('simulator did not start')


def main():
    os.umask(0o077)
    with tempfile.TemporaryDirectory(prefix='ww-enroll-', dir='/tmp') as temporary:
        work = Path(temporary)
        (work / 'nv').mkdir(mode=0o700)
        public = work / 'signer.pub'
        private = work / 'signer.key'
        subprocess.run(['openssl', 'genrsa', '-out', str(private), '2048'], check=True, capture_output=True)
        subprocess.run(['openssl', 'pkey', '-in', str(private), '-pubout', '-out', str(public)],
                       check=True, capture_output=True)
        initial = work / 'aa.permit'
        raw = b'werewolf.boot/2\0' + bytes.fromhex('42' * 32 + '00' * 32 + 'aa' * 64 + '11' * 32)
        (work / 'aa.state').write_bytes(raw)
        command('permit-pair', public, work / 'aa.state', work / 'message')
        subprocess.run(['openssl', 'dgst', '-sha256', '-sign', str(private), '-out', str(work / 'signature'),
                        str(work / 'message')], check=True, capture_output=True)
        initial.write_bytes(raw + (work / 'signature').read_bytes())
        expected = hashlib.sha256(raw[48:80] + hashlib.sha256(raw).digest()).digest()
        process, endpoint = start(work)
        try:
            command('bootstrap-pair', public, initial, endpoint, work / 'credentials')
            for filename in ['owner.auth', 'lockout.auth']:
                secret = work / 'credentials' / filename
                if len(secret.read_bytes()) != 32 or secret.stat().st_mode & 0o777 != 0o600:
                    raise RuntimeError('private credential contract failed')
            if (work / 'credentials').stat().st_mode & 0o777 != 0o700:
                raise RuntimeError('private directory contract failed')
            command('read-pair', public, endpoint, work / 'anchor')
            if (work / 'anchor').read_bytes() != expected:
                raise RuntimeError('wrong protected anchor')
            command('bootstrap-pair', public, initial, endpoint, work / 'credentials', success=False)
            command('bootstrap-pair', public, initial, endpoint, work / 'repeat', success=False)
            command('read-pair', public, endpoint, work / 'after-refusal')
            if (work / 'after-refusal').read_bytes() != expected:
                raise RuntimeError('enrollment refusal changed protected state')
            invalid = bytearray(initial.read_bytes())
            invalid[-1] ^= 1
            (work / 'invalid').write_bytes(invalid)
            command('bootstrap-pair', public, work / 'invalid', endpoint, work / 'bad', success=False)
            if (work / 'bad').exists():
                raise RuntimeError('unverified factory changed host state')
        finally:
            process.terminate()
            process.communicate(timeout=10)
        process, endpoint = start(work)
        try:
            command('read-pair', public, endpoint, work / 'restarted')
            if (work / 'restarted').read_bytes() != expected:
                raise RuntimeError('restart lost enrollment')
        finally:
            process.terminate()
            process.communicate(timeout=10)
        # The production supervisor must preserve enrolled storage, reuse its
        # daemon, recover a killed simulator, and refuse missing backing state.
        (work / 'nv').rename(work / 'swtpm')
        (work / 'enrolled').write_bytes(expected)
        service = Path('tools/local-tpm').resolve()
        sockets = work / 'service'
        def supervise(operation, success=True, backend='qemu'):
            result = subprocess.run([sys.executable, str(service), operation, str(work), str(sockets), backend],
                                    capture_output=True, timeout=20)
            if (result.returncode == 0) != success:
                raise RuntimeError('unexpected supervisor result: ' + result.stderr.decode()[-1000:])
        try:
            supervise('start')
            first = int((work / 'tpm.pid').read_text())
            supervise('start')
            if int((work / 'tpm.pid').read_text()) != first:
                raise RuntimeError('restart created a second simulator')
            os.kill(first, signal.SIGKILL)
            supervise('stop')
            if sockets.exists() or (work / 'tpm.pid').exists():
                raise RuntimeError('TPM service did not remove its private runtime sockets')
            for _ in range(3):
                supervise('start')
                supervise('stop')
                if sockets.exists() or (work / 'tpm.pid').exists():
                    raise RuntimeError('TPM shutdown returned before removing its sockets')
            # bhyve sends raw TPM commands, without QEMU's control/FD handshake.
            # Every boot must reset volatile TPM state but preserve enrolled NV.
            for _ in range(2):
                supervise('start', backend='bhyve')
                with socket.socket(socket.AF_UNIX) as client:
                    client.settimeout(5)
                    client.connect(str(sockets / 'data.sock'))
                    client.sendall(bytes.fromhex('80010000000c000001440000'))  # Startup(CLEAR)
                    if client.recv(10) != bytes.fromhex('80010000000a00000000'):
                        raise RuntimeError('bhyve TPM did not start with fresh volatile state')
                command('read-pair', public, 'unix:' + str(sockets / 'data.sock'), work / 'bhyve-anchor')
                if (work / 'bhyve-anchor').read_bytes() != expected:
                    raise RuntimeError('bhyve reboot lost enrollment')
                supervise('stop', backend='bhyve')
            saved = work / 'saved-nv'
            (work / 'swtpm').rename(saved)
            supervise('start', success=False)
            if (work / 'swtpm').exists():
                raise RuntimeError('missing state was silently replaced')
            saved.rename(work / 'swtpm')
        finally:
            supervise('stop')
        (work / 'swtpm').rename(work / 'nv')
        process, endpoint = start(work)
        try:
            command('read-pair', public, endpoint, work / 'after-supervisor')
            if (work / 'after-supervisor').read_bytes() != expected:
                raise RuntimeError('supervisor restart lost enrollment')
        finally:
            process.terminate()
            process.communicate(timeout=10)
    print('pass   native TPM enrollment and supervisor: private custody, reset refusal, restart, crash recovery')


if __name__ == '__main__':
    main()
