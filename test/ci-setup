#!/bin/sh
# ci-setup [apko]: install what `make test lint check` needs on Ubuntu
# 24.04, as GitHub's runners have it, and open /dev/kvm to the user who runs
# the checks. With `apko`, install apko alone, for jobs that only resolve
# packages: no apt, no QEMU, no Zig. Run as root. Used by
# .github/workflows/check.yml, release.yml and test/lima-ci.
#
# apko and Zig are not in Ubuntu at the versions the build wants, so they
# come from their releases, pinned by version and sha256.
set -eu
case ${1:-all} in
all | apko) only=${1:-all} ;;
*)
	echo "usage: ci-setup [apko]" >&2
	exit 2
	;;
esac

apko_version=1.3.1
zig_version=0.16.0

arch=$(uname -m)
case $arch in
x86_64)
	go=amd64 qemu=qemu-system-x86
	apko_sha256=b8c39ff7e63864efa1296d36a95d3c56f750ef2ab41cdc6d7fad0ae6a483b604
	zig_sha256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
	;;
aarch64)
	go=arm64 qemu=qemu-system-arm
	apko_sha256=47ec5e9e66372629919598f5176b37e9e47a3be456b2c8c9541a891065123fbb
	zig_sha256=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
	;;
*)
	echo "ci-setup: $arch is not supported" >&2
	exit 1
	;;
esac

if [ "$only" = all ]; then
	export DEBIAN_FRONTEND=noninteractive
	apt-get update -q
	apt-get install -y -q --no-install-recommends ca-certificates curl make xz-utils \
		zstd libarchive-tools erofs-utils e2fsprogs expect "$qemu" python3-pip
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fetch() { # fetch URL SHA256 FILE
	curl -fsSL --retry 3 -o "$tmp/$3" "$1"
	echo "$2  $tmp/$3" | sha256sum -c --quiet -
}

fetch "https://github.com/chainguard-dev/apko/releases/download/v$apko_version/apko_${apko_version}_linux_$go.tar.gz" \
	"$apko_sha256" apko.tar.gz
tar -xzf "$tmp/apko.tar.gz" -C "$tmp"
install -m 0755 "$(find "$tmp" -type f -name apko)" /usr/local/bin/apko
if [ "$only" = apko ]; then
	echo "ci-setup: apko $(apko version 2>/dev/null | sed -n 's/^GitVersion: *//p')"
	exit 0
fi

fetch "https://ziglang.org/download/$zig_version/zig-$arch-linux-$zig_version.tar.xz" "$zig_sha256" zig.tar.xz
rm -rf /usr/local/zig
mkdir /usr/local/zig
tar -xJf "$tmp/zig.tar.xz" -C /usr/local/zig --strip-components=1
ln -sf /usr/local/zig/zig /usr/local/bin/zig

if [ -e /dev/kvm ]; then
	chmod 0666 /dev/kvm
	echo "ci-setup: KVM available"
else
	echo "ci-setup: no /dev/kvm; QEMU will emulate, slowly"
fi
echo "ci-setup: apko $(apko version 2>/dev/null | sed -n 's/^GitVersion: *//p'), zig $(zig version), $(qemu-system-"$arch" --version | head -n 1)"
