#!/bin/sh
# ci-setup [apko] [zig] installs what `make test lint check` needs on GitHub's
# Ubuntu 26.04 runners and make ci's VM: tools/install-deps's tools, without
# asking, and /dev/kvm opened to the user who runs the checks. With `apko`,
# `zig` or both, it installs only those, for jobs that resolve packages or
# build a tool. Run it as root. .github/workflows/check.yml, release.yml,
# update.yml and test/lima-ci use it. Like install-deps, it does only what is
# not done yet, so a second run takes a second.
set -eu
for a; do
	case $a in
	apko | zig) ;;
	*)
		echo "usage: ci-setup [apko] [zig]" >&2
		exit 2
		;;
	esac
done
"$(dirname "$0")/../tools/install-deps" -y "$@"
[ -z "${1:-}" ] || exit 0

# Ubuntu's AppArmor stops unprivileged programs from making user namespaces,
# which bubblewrap (melange's sandbox) needs. The machines this runs on are
# thrown away afterwards, so lift the restriction here. install-deps never
# lifts it, because it runs on machines people keep.
r=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [ "$(cat $r 2>/dev/null)" = 1 ]; then
	echo 0 >$r
	echo "ci-setup: unprivileged user namespaces allowed, for bubblewrap"
fi

if [ -e /dev/kvm ]; then
	chmod 0666 /dev/kvm
	echo "ci-setup: KVM available"
else
	echo "ci-setup: no /dev/kvm; QEMU will emulate, slowly"
fi
