#!/bin/sh
# ci-setup [apko | zig]: install what `make test lint check` needs, on
# GitHub's Ubuntu 26.04 runners and make ci's VM: tools/install-deps's
# tools, without asking, and /dev/kvm opened to the user who runs the
# checks. With `apko` or `zig`, install that alone, for jobs that only
# resolve packages or build a tool. Run as root. Used by
# .github/workflows/check.yml, release.yml, update.yml and test/lima-ci.
# Like install-deps, it does only what is not done yet, so it runs again
# in a second.
set -eu
case ${1:-} in
'' | apko | zig) ;;
*)
	echo "usage: ci-setup [apko | zig]" >&2
	exit 2
	;;
esac
"$(dirname "$0")/../tools/install-deps" -y "$@"
[ -z "${1:-}" ] || exit 0

# Ubuntu's AppArmor keeps unprivileged programs from making user
# namespaces, which bubblewrap, melange's sandbox, needs. The machines this
# runs on are thrown away after, so the restriction is lifted here, never
# by install-deps on a machine someone keeps.
r=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [ "$(cat $r 2>/dev/null)" = 1 ]; then
	echo 0 >$r
	echo "ci-setup: unprivileged user namespaces allowed, for bubblewrap"
fi

if [ -e /dev/kvm ]; then
	chmod 0666 /dev/kvm
	echo "ci-setup: KVM available"
else
	echo "ci-setup: no /dev/kvm; QEMU will emulate, slowly"
fi
