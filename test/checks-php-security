# Test the public application contract, not merely an open socket.
ok  app-greeting [ "$(wget -q -T 5 -O - http://127.0.0.1:80/)" = 'Hello from PHP on werewolf!' ]
ok  app-health [ "$(wget -q -T 5 -O - http://127.0.0.1:80/health)" = ok ]
ok  app-not-found wget -q -T 5 -S -O /dev/null http://127.0.0.1:80/werewolf-missing 2>&1 | grep -q 'HTTP/1.[01] 404'
ok  app-method-refused wget -q -T 5 -S -O /dev/null --post-data 'changed' http://127.0.0.1:80/ 2>&1 | grep -q 'HTTP/1.[01] 405'
ok  app-query [ "$(wget -q -T 5 -O - 'http://127.0.0.1:80/health?probe=integration')" = ok ]
ok  app-content-type wget -q -T 5 -S -O /dev/null http://127.0.0.1:80/ 2>&1 | grep -qi 'Content-Type: text/plain; charset=utf-8'

# Each probe executes under the real php-fpm service's identity and leash.
ok  php-state [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=state')" = ok ]
ok  php-immutable [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=immutable')" = ok ]
ok  php-privileges [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=privileges')" = ok ]
ok  php-network [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=network')" = ok ]
ok  php-config [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=config')" = ok ]
ok  php-ini [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=ini')" = ok ]
ok  php-exec [ "$(wget -q -T 5 -O - 'http://127.0.0.1/_werewolf-security.php?case=exec')" = ok ]
ok  php-encoded-stager wget -q -T 5 -S -O /dev/null 'http://127.0.0.1/app_84304470%2Ephp' 2>&1 | grep -q 'HTTP/1.[01] 404'
