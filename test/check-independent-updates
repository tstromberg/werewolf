#!/usr/bin/env python3
"""A protected machine takes its own TPM and updates from a static channel alone.

check-independent-updates HOWL OUTPUT [lima|qemu]

howl create --build makes release A (index 1) of a channel this test serves as static
HTTPS files, signed with the caller's keys, and boots it under Secure Boot, IPE and a
fresh TPM, which its first boot makes its own. Releases B and C are published to the
channel; the machine's own updater installs each, and the mount broker raises the TPM
floor before overwriting a slot. Operator rollback, a power cut at the floor's increment,
a restored older disk (refused by stage0), a failed trial and a service reaching for the
TPM are each checked (docs/design/independent-updates.md). No host service but the
static file server takes part."""
import concurrent.futures
import datetime
import functools
import http.server
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import socket
import ssl
import subprocess
import sys
import tempfile
import threading
import time
from tpm_proxy import Proxy

howl, output = sys.argv[1:3]
provider = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] else 'lima'
if provider not in ('lima', 'qemu'):
    sys.exit('check-independent-updates: provider must be lima or qemu')
arch = 'aarch64' if os.uname().machine in ('arm64', 'aarch64') else 'x86_64'
howl = str(Path(howl).resolve())
source_commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
work = Path(output).resolve()
work.mkdir(parents=True, mode=0o700, exist_ok=False)
os.umask(0o077)
name = 'ww-floor-' + secrets.token_hex(4)
machine = Path('build/machines') / name
gateway = '192.168.5.2' if provider == 'lima' else '10.0.2.2'
proxy_work = tempfile.TemporaryDirectory(prefix='ww-floor-proxy-')
proxy_dir = Path(proxy_work.name)
proxy = None
server = None

# QEMU, wherever howl or Lima starts it, reaches its TPM through the test's proxy.
wrapper_dir = work / 'wrapper'
wrapper_dir.mkdir()
qemu_binary = shutil.which('qemu-system-' + arch)
wrapper = wrapper_dir / ('qemu-system-' + arch)
wrapper.write_text('''#!/usr/bin/env python3
import json, os, sys, time
from pathlib import Path
args = sys.argv[1:]
root = Path(''' + repr(str(proxy_dir)) + ''')
for i, arg in enumerate(args):
    if i and args[i - 1] == '-chardev' and 'socket,' in arg and 'tpm' in arg:
        parts = arg.split(',')
        backend = next(part[5:] for part in parts if part.startswith('path='))
        (root / 'backend.json').write_text(json.dumps(backend))
        while not (root / 'ready').exists(): time.sleep(.05)
        args[i] = ','.join('path=' + str(root / 'proxy.sock') if part.startswith('path=') else part for part in parts)
os.execv(''' + repr(qemu_binary) + ''', [''' + repr(qemu_binary) + ''', *args])
''')
wrapper.chmod(0o755)
private_ssh = work / 'ssh.key'
ssh_binary = shutil.which('ssh')
ssh_wrapper = wrapper_dir / 'ssh'
ssh_wrapper.write_text('#!/usr/bin/env python3\nimport os,sys\nos.execv(' + repr(ssh_binary) + ', ' +
                       repr([ssh_binary, '-F', '/dev/null', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes',
                             '-i', str(private_ssh)]) + ' + sys.argv[1:])\n')
ssh_wrapper.chmod(0o755)

form = work / 'form'
overlay = form / 'rootfs'
label_file = overlay / 'usr/share/werewolf/ab-release'
label_file.parent.mkdir(parents=True)
(form / 'form.yaml').write_text('base: playground\nweaknesses:' +
                                Path('forms/playground/form.yaml').read_text().split('weaknesses:', 1)[1])
www = work / 'www'
(www / 'image' / arch).mkdir(parents=True)
listener = socket.socket()
listener.bind(('127.0.0.1', 0))
port = listener.getsockname()[1]
listener.close()
channel = 'https://%s:%d/image' % (gateway, port)
env = dict(os.environ, IPE_UPDATES=channel, IPE_UPDATES_CA=str(work / 'ca.crt'), IMAGE_INDEX='1',
           PATH=str(wrapper_dir) + os.pathsep + os.environ['PATH'])
passed = []


def run(args, label, check=True, timeout=1800):
    result = subprocess.run([str(a) for a in args], env=env, text=True, capture_output=True,
                            timeout=timeout, umask=0o022)
    with (work / (label + '.log')).open('a') as log:
        log.write(result.stdout + result.stderr)
    if check and result.returncode:
        raise RuntimeError(label + ': ' + result.stderr[-3000:])
    return result


def ok(what):
    passed.append(what)
    print('pass   independent-updates: ' + what, flush=True)


def ssh(command, label, **kwargs):
    # Use the fixture identity through our SSH wrapper, never the runner's agent.
    return run([howl, 'ssh', 'root@' + name, '--no-agent', '--', command], label, **kwargs)


def status():
    try:
        reply = ssh('/usr/bin/ab-status', 'status', check=False, timeout=15)
        return json.loads(reply.stdout) if reply.returncode == 0 else None
    except (subprocess.TimeoutExpired, ValueError):
        return None


def wait_boot(label, index, floor, previous=None, committed=True):
    until = time.monotonic() + 420
    paused = None
    while time.monotonic() < until:
        s = status()
        if s and s['release'] == label and s['boot_id'] != previous:
            for flag in ('secure_boot', 'ipe', 'verified_root', 'rollback_protected'):
                if not s[flag]:
                    raise RuntimeError('missing guest enforcement %s: %s' % (flag, s))
            if s['index'] != index or s['floor'] != floor:
                raise RuntimeError('%s: want index %d floor %d, have %s' % (label, index, floor, s))
            if paused != s['boot_id'] and s['committed'] is committed:
                # Keep the updater from acting on its own between steps.
                if ssh('test -e /run/werewolf/updater-ready && sv pause /etc/sv/autoupdate', 'pause',
                       check=False, timeout=15).returncode:
                    time.sleep(2)
                    continue
                paused = s['boot_id']
            if s['committed'] is committed:
                with (work / 'evidence.jsonl').open('a') as log:
                    log.write(json.dumps(s) + '\n')
                return s
        time.sleep(3)
    raise RuntimeError('%s did not boot %s (index %d, floor %d)' % (name, label, index, floor))


def profile():
    return json.loads((machine / 'authority/profile.json').read_text())


def publish(label, index, extra=None):
    """Build release label at index with the machine's own keys and inputs, and make it
    the channel's head, as a publisher uploads objects before the head. Each release
    builds from its own copy of the form, so the machine's own stays A's."""
    source = work / 'releases' / label / 'form'
    shutil.copytree(form, source, symlinks=True)
    (source / 'rootfs/usr/share/werewolf/ab-release').write_text(label + '\n')
    if extra:
        extra(source / 'rootfs')
    spec = profile()['local']
    build = work / ('build-' + label)
    serial = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    environment = dict(env, UKI_STUB=str(machine / 'authority/linux.efi.stub'))
    result = subprocess.run([howl, '_build', '--with', str(source), '--arch', arch, '--build', str(build),
                             '--ipe-kernel', spec['ipe_kernel'], '--ipe-key', spec['ipe_key'],
                             '--ipe-cert', spec['ipe_cert'], '--boot-key', spec['boot_key'],
                             '--boot-cert', spec['boot_cert'], '--boot-native', '--tpm',
                             '--ipe-updates', channel, '--image-serial', serial,
                             '--image-index', str(index), '--update-ca', str(work / 'ca.crt'),
                             '--disk', str(build / 'disk.img'),
                             '--disk-args', ' '.join(spec['disk']['args']), 'disk', 'prebuilt'],
                            env=environment, text=True, capture_output=True, timeout=3600, umask=0o022)
    (work / ('build-' + label + '.log')).write_text(result.stdout + result.stderr)
    if result.returncode:
        raise RuntimeError('build ' + label + ': ' + result.stderr[-3000:])
    head = next(build.glob('*/prebuilt/' + arch))
    manifest = json.loads((head / 'latest.json').read_text())
    if manifest['index'] != index:
        raise RuntimeError('built %s at index %s' % (label, manifest['index']))
    objects = head / manifest['build']
    shutil.copytree(objects, www / 'image' / arch / manifest['build'], dirs_exist_ok=True)
    for file in ('latest.json.sig', 'latest.json'):
        shutil.copyfile(head / file, www / 'image' / arch / (file + '.new'))
    for file in ('latest.json.sig', 'latest.json'):
        os.replace(www / 'image' / arch / (file + '.new'), www / 'image' / arch / file)
    return manifest


def install(label, index, floor, previous, committed=True):
    ssh('/usr/lib/werewolf/slot-update check', 'check-' + label, timeout=900)
    ssh('/usr/lib/werewolf/slot-update try', 'try-' + label, check=False, timeout=60)
    return wait_boot(label, index, floor, previous['boot_id'], committed)


def processes(pattern):
    lines = subprocess.check_output(['ps', '-axo', 'pid=,command='], text=True).splitlines()
    return [int(line.split(None, 1)[0]) for line in lines if pattern in line]


def power_off(stopped=False):
    """Cut the machine's power, as a host crash would: the VM and its TPM die at once,
    and the TPM's NV keeps what it last committed."""
    if provider == 'lima':
        home = Path(os.environ.get('LIMA_HOME', Path.home() / '.lima')) / name
        pidfile = home / 'qemu.pid'
        tpm = processes('--tpmstate dir=' + str(home / 'swtpm'))
        if not stopped and len(tpm) != 1:
            raise RuntimeError('power cut requires exactly one owned TPM process')
    else:
        pidfile = machine / 'qemu.pid'
        tpmfile = machine / 'authority/tpm.pid'
        tpm = [int(tpmfile.read_text())] if tpmfile.exists() or not stopped else []
    # Refusing a retired disk may already have stopped QEMU and removed its
    # pidfile. Real floor-increment cuts still require live ownership records.
    vm = [int(pidfile.read_text())] if pidfile.exists() or not stopped else []
    for pid in [*vm, *tpm]:
        if pid <= 1:
            raise RuntimeError('invalid owned process ID')
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


def restart(label):
    if provider == 'lima':
        run(['limactl', 'stop', '--force', name], 'stop-' + label, check=False)
    run(create, 'restart-' + label)


def console():
    if provider == 'lima':
        path = Path(os.environ.get('LIMA_HOME', Path.home() / '.lima')) / name / 'serial.log'
    else:
        path = machine / 'console.log'
    return path.read_text(errors='replace') if path.exists() else ''


class Handler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt, *args):
        with (work / 'channel.log').open('a') as log:
            log.write((fmt % args) + '\n')


try:
    # A channel on a private CA, which the images trust (IPE_UPDATES_CA).
    run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '2', '-subj', '/CN=floor-test-ca',
         '-keyout', work / 'ca.key', '-out', work / 'ca.crt'], 'ca')
    run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-subj', '/CN=' + gateway,
         '-keyout', work / 'tls.key', '-out', work / 'tls.csr'], 'tls')
    (work / 'tls.ext').write_text('subjectAltName=IP:%s\n' % gateway)
    run(['openssl', 'x509', '-req', '-in', work / 'tls.csr', '-CA', work / 'ca.crt', '-CAkey', work / 'ca.key',
         '-CAcreateserial', '-days', '2', '-extfile', work / 'tls.ext', '-out', work / 'tls.crt'], 'tls-sign')
    server = http.server.ThreadingHTTPServer(('127.0.0.1', port), functools.partial(Handler, directory=str(www)))
    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    tls.load_cert_chain(work / 'tls.crt', work / 'tls.key')
    server.socket = tls.wrap_socket(server.socket, server_side=True)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', private_ssh], 'ssh-key')
    probe = overlay / 'usr/bin/ab-status'
    probe.parent.mkdir(parents=True)
    run(['zig', 'build-exe', '-O', 'ReleaseSafe', '-fPIE', '-target', arch + '-linux-musl',
         '--dep', 'cmdline', '--dep', 'ipe', '--dep', 'tpm', '-Mroot=test/ab-status.zig',
         '--dep', 'network', '-Mcmdline=lib/cmdline.zig', '-Mnetwork=lib/network.zig',
         '-Mipe=lib/ipe.zig', '--dep', 'apk', '-Mtpm=lib/tpm.zig', '--dep', 'package',
         '-Mapk=lib/apk.zig', '-Mpackage=lib/package.zig', '-femit-bin=' + str(probe)], 'probe')
    label_file.write_text('A\n')
    for path in overlay.rglob('*'):
        path.chmod(0o755 if path.is_dir() or path == probe else 0o644)

    create = [howl, 'create', name, '--with', form, '--build', '--yes', '--root-keys', str(private_ssh) + '.pub']
    if provider == 'qemu':
        create += ['--on', 'qemu']
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        creation = pool.submit(run, create, 'create', True, 3600)
        deadline = time.monotonic() + 3600
        while not (proxy_dir / 'backend.json').exists():
            if creation.done():
                creation.result()
                raise RuntimeError('QEMU did not attach its TPM through the test proxy')
            if time.monotonic() > deadline:
                raise RuntimeError('QEMU did not start')
            time.sleep(.2)
        proxy = Proxy(proxy_dir / 'proxy.sock', json.loads((proxy_dir / 'backend.json').read_text()))
        (proxy_dir / 'ready').touch()
        creation.result()
    shutil.copyfile(machine / 'disk.img', work / 'release-a.img')
    a = wait_boot('A', 1, 1)
    text = console()
    if 'TPM floor 1: release 1 admitted; reset authority sealed' not in text:
        raise RuntimeError('stage0 did not enroll the fresh TPM at release 1')
    ok('A enrolled its own TPM at floor 1 under Secure Boot and IPE')
    if ssh('exec 3<>/dev/tpmrm0', 'tpm-denied', check=False).returncode == 0:
        raise RuntimeError('a root session opened the TPM')
    ok('a root session cannot open the TPM')
    if ssh('cp /usr/bin/true /data/unsigned && /data/unsigned', 'unsigned', check=False).returncode == 0:
        raise RuntimeError('unsigned writable code ran')
    ok('IPE refuses code outside the verified root')

    publish('B', 2)
    b = install('B', 2, 1, a)
    ok('B installed from the static channel; floor stays at the retained release, 1')
    ssh('/usr/lib/werewolf/slot-update try', 'rollback-A', check=False, timeout=60)
    a2 = wait_boot('A', 1, 1, b['boot_id'])
    ok('operator rollback to A, the retained release, boots')
    ssh('/usr/lib/werewolf/slot-update try', 'forward-B', check=False, timeout=60)
    b = wait_boot('B', 2, 1, a2['boot_id'])

    # Installing C overwrites A: the broker raises the floor to B first. Cut the power
    # at that increment, before and after the TPM executes it.
    publish('C', 3)
    current = b
    for cut, floor in (('before', 1), ('after', 2)):
        proxy.arm(cut)
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
            checking = pool.submit(ssh, '/usr/lib/werewolf/slot-update check', 'cut-' + cut,
                                   check=False, timeout=900)
            if not proxy.hit.wait(900) or proxy.failures:
                raise RuntimeError('the floor increment was not reached: %s' % proxy.failures)
            power_off()
            proxy.cancel()
            checking.result()
        proxy.close()
        proxy = Proxy(proxy_dir / 'proxy.sock', json.loads((proxy_dir / 'backend.json').read_text()))
        restart('cut-' + cut)
        current = wait_boot('B', 2, floor, current['boot_id'])
        ok('power cut %s the floor increment: B boots at floor %d' % (cut, floor))
    c = install('C', 3, 2, current)
    ok('C installed; A is retired, floor 2')

    # A restored disk with A on it, the TPM kept: stage0 refuses it before handover.
    saved = work / 'current.img'
    run(['limactl', 'stop', '--force', name] if provider == 'lima' else [howl, 'stop', name], 'stop-restore',
        check=False)
    disk = (Path(os.environ.get('LIMA_HOME', Path.home() / '.lima')) / name / 'disk') if provider == 'lima' \
        else machine / 'disk.img'
    info = json.loads(run(['qemu-img', 'info', '--output=json', disk], 'disk-info').stdout)
    os.replace(disk, saved)
    run(['qemu-img', 'convert', '-O', info['format'], work / 'release-a.img', disk], 'restore-a')
    refused = 'TPM floor: release 1 is below its channel\'s floor, 2; not handing over'
    # Lima starts a new serial log on each start: count refusals, not offsets.
    before = console().count(refused)
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        restoring = pool.submit(run, create, 'restore-boot', False, 600)
        until = time.monotonic() + 420
        while console().count(refused) <= before:
            if time.monotonic() > until:
                raise RuntimeError('stage0 did not refuse the restored release A')
            time.sleep(2)
        restoring.result()
    ok('a restored disk holding retired A is refused by stage0')
    power_off(stopped=True)
    os.replace(saved, disk)
    restart('restored')
    c = wait_boot('C', 3, 2)

    # A trial that never becomes healthy falls back to C, and the floor stays.
    def unhealthy(root):
        service = root / 'etc/sv/ab-unhealthy'
        service.mkdir(parents=True, mode=0o755)
        for path in (root / 'etc', root / 'etc/sv'):
            path.chmod(0o755)
        (service / 'run').symlink_to('/usr/bin/false')
    publish('E', 4, unhealthy)
    # Installing E overwrote B: the floor rose to C, the running release, first.
    trial = install('E', 4, 3, c, committed=False)
    ssh('/usr/bin/reboot', 'failed-trial-reboot', check=False, timeout=60)
    wait_boot('C', 3, 3, trial['boot_id'])
    ok('a failed trial of E falls back to C at floor 3')
    evidence = dict(format='werewolf-update-evidence/1', provider=provider, arch=arch,
                    commit=source_commit, passed=True, checks=dict(ab_upgrade=True, operator_rollback=True,
                    unhealthy_fallback=True, retirement_cuts=True))
    (work / 'result.json').write_text(json.dumps(evidence, indent=2) + '\n')
    print('pass   independent-updates: %d checks on %s' % (len(passed), provider), flush=True)
finally:
    if server:
        server.shutdown()
    try:
        (work / 'console.log').write_text(console())
    except Exception:
        pass
    for source in ('create.log', 'build.log'):
        if (machine / source).exists():
            shutil.copyfile(machine / source, work / ('native-' + source))
    if os.environ.get('FLOOR_KEEP') != '1' and machine.exists():
        run([howl, 'delete', name, '--on', provider], 'cleanup', check=False)
    if proxy:
        proxy.close()
    private_ssh.unlink(missing_ok=True)
    proxy_work.cleanup()
