#!/usr/bin/env python3
"""Inspect account defaults in real config tars without creating any machines."""
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile


howl = str(Path(sys.argv[1]).resolve())
forms = Path('forms').resolve()
security_key = 'sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5 fixture'
software_key = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5 fixture'
root_key = 'sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE6 root-only\n'

with tempfile.TemporaryDirectory(prefix='howl-current-user-') as temporary:
    root = Path(temporary)
    (root / 'forms').mkdir()
    for form in forms.iterdir():
        if form.is_dir():
            (root / 'forms' / form.name).symlink_to(form, target_is_directory=True)
    for name, text in {
        'named-users': 'users:\n  bob:\n    keys: [' + security_key + ']\n',
        'empty-users': 'users: {}\n',
        'existing-current-user': 'users:\n  alice: {}\n',
    }.items():
        directory = root / 'forms' / name
        directory.mkdir()
        (directory / 'form.yaml').write_text('base: playground\n' + text)
    home = root / 'home'
    ssh = home / '.ssh'
    ssh.mkdir(parents=True)
    (ssh / 'fido.pub').write_text(security_key + '\n')
    (ssh / 'software.pub').write_text(software_key + '\n')
    (root / 'root.pub').write_text(root_key)
    binaries = root / 'bin'
    binaries.mkdir()
    identity = binaries / 'id'
    identity.write_text('#!' + sys.executable + '\nimport os, sys\n'
                        'assert sys.argv[1:] == ["-un"]\n'
                        'print(os.environ.get("HOWL_TEST_CURRENT_USER", "alice"))\n')
    identity.chmod(0o755)
    env = dict(os.environ, HOME=str(home), USER='untrusted-environment-user',
               PATH=str(binaries) + os.pathsep + os.environ['PATH'])
    output = root / 'config.tar'

    def pack(*flags, provider='qemu', form='playground', status=0, **changes):
        output.unlink(missing_ok=True)
        args = [howl, 'pack', '--build', '--with', form, '--root-keys',
                str(root / 'root.pub'), '-o', str(output)]
        if provider is not None:
            args += ['--on', provider]
        result = subprocess.run(args + list(flags), cwd=root, env=dict(env, **changes),
                                capture_output=True, text=True, timeout=30)
        assert result.returncode == status, (args, flags, result.stderr)
        if status:
            assert not output.exists(), result
            return result.stderr
        with tarfile.open(output) as tar:
            files = {entry.name: tar.extractfile(entry).read().decode()
                     for entry in tar.getmembers() if entry.isfile()}
        assert files['authorized_keys'] == root_key, files
        return files

    expected = 'alice ' + security_key + '\nalice ' + software_key + '\n'
    for provider in ('qemu', 'firecracker', 'bhyve', 'proxmox', 'gcp', 'aws', 'azure'):
        files = pack(provider=provider)
        assert files['users'] == expected, (provider, files)
        assert 'admin' not in files['users']
    for mode in ('auto', 'yes', 'no'):
        assert 'users' not in pack('--add-current-user=' + mode, provider='lima')
    assert 'users' not in pack('--add-current-user=no')
    assert 'users' not in pack(provider=None)
    assert pack('--add-current-user', 'yes', provider=None)['users'] == expected

    assert pack(form='empty-users')['users'] == ''
    assert pack('--add-current-user=yes', form='empty-users')['users'] == expected
    declared = 'bob ' + security_key + '\n'
    assert pack(form='named-users')['users'] == declared
    assert pack('--add-current-user=yes', form='named-users')['users'] == declared + expected
    assert pack('--add-current-user=yes', form='existing-current-user')['users'] == 'alice\n'

    config = root / 'config'
    config.mkdir()
    (config / 'users').write_text('')
    assert pack('--config', str(config))['users'] == ''
    assert pack('--config', str(config), '--add-current-user=yes')['users'] == expected
    (config / 'users').write_text('alice\n')
    assert pack('--config', str(config), '--add-current-user=yes')['users'] == 'alice\n'

    assert pack(form='prod-ssh')['users'] == 'alice ' + security_key + '\n'
    assert 'users' not in pack(form='minimal')
    assert 'does not run SSH' in pack('--add-current-user=yes', form='minimal', status=1)
    assert 'auto, yes or no' in pack('--add-current-user=maybe', status=1)
    assert 'given twice' in pack('--add-current-user=auto', '--add-current-user=no', status=1)
    assert 'users' not in pack(HOWL_TEST_CURRENT_USER='root')
    assert 'not a standard user' in pack('--add-current-user=yes', status=1,
                                      HOWL_TEST_CURRENT_USER='root')

    (ssh / 'fido.pub').unlink()
    assert 'users' not in pack(form='prod-ssh')
    assert 'no local public SSH keys' in pack('--add-current-user=yes', form='prod-ssh', status=1)
    assert pack()['users'] == 'alice ' + software_key + '\n'
    (ssh / 'software.pub').unlink()
    assert 'users' not in pack()
    assert 'no local public SSH keys' in pack('--add-current-user=yes', status=1)

print('howl-current-user: provider defaults, explicit accounts, overrides and SSH key policy passed')
