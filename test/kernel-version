#!/usr/bin/env python3
"""Exercise version and package-revision drift without repository access."""
import copy
import json
import pathlib
import re
import subprocess
import tempfile

pin = pathlib.Path('boot/kernel-source')
version = re.search(r'^alpine_version=(.+)$', pin.read_text(), re.M)[1]
document = {'contents': {'packages': [
    {'name': 'linux-virt', 'architecture': arch, 'version': version}
    for arch in ['aarch64', 'x86_64']]}}

with tempfile.TemporaryDirectory(prefix='werewolf-kernel-version-') as tmp:
    lock = pathlib.Path(tmp) / 'kernel.json'

    def run(data, expected=''):
        lock.write_text(json.dumps(data))
        result = subprocess.run(['python3', 'test/check-kernel-version', str(pin),
                                 str(lock)], capture_output=True, text=True)
        if expected:
            assert result.returncode != 0 and expected in result.stderr, result.stderr
        else:
            assert result.returncode == 0, result.stderr

    run(document)
    revision = copy.deepcopy(document)
    for package in revision['contents']['packages']:
        if package['name'] == 'linux-virt':
            package['version'] = package['version'].split('-r')[0] + '-r9999'
    run(revision, 'Alpine packages changed')
    version = copy.deepcopy(revision)
    for package in version['contents']['packages']:
        if package['name'] == 'linux-virt':
            package['version'] = '99.0.0-r0'
    run(version, 'differs from locked Alpine kernels')
    missing = copy.deepcopy(document)
    missing['contents']['packages'] = [p for p in missing['contents']['packages']
                                      if p['name'] != 'linux-virt' or p['architecture'] != 'aarch64']
    run(missing, 'one Alpine linux-virt lock per supported architecture')
print('pass   kernel-version: agreement, upstream drift, revision drift and missing architecture')
