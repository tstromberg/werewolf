    def test_signed_ab_preserves_both_releases(self):
        bundle = self.issue()
        state = publisher.record(bundle)
        self.assertEqual((state['retained'], state['candidate'], state['pcr']), (A, B, PA))
        path = self.records / (state['anchor'] + '.permit')
        publisher.run([HOWL, '_boot-record', self.root / 'permit.pub', path])

    def test_operator_rollback_changes_retained_pcr(self):
        previous = publisher.record(self.issue())['anchor']
        self.approve(C)
        from_b = publisher.record(self.issue(C, previous, B))
        from_a = publisher.record(self.issue(C, previous, A))
        self.assertEqual((from_b['retained'], from_b['pcr']), (B, PB))
        self.assertEqual((from_a['retained'], from_a['pcr']), (A, PA))
        self.assertNotEqual(from_a['anchor'], from_b['anchor'])

    def test_completed_transition_resumes_without_new_extension(self):
        original = self.issue()
        self.approve(C)
        self.assertEqual(original, self.issue(B, publisher.record(original)['anchor'], A))
        self.assertEqual(2, len(list(self.records.glob('*.permit'))))

    def test_guest_cannot_reauthorize_a_retired_registered_release(self):
        ab = publisher.record(self.issue())['anchor']
        self.approve(C)
        bc = publisher.record(self.issue(C, ab, B))['anchor']
        with self.assertRaises(ValueError):
            self.issue(A, bc, C)
        self.assertEqual(3, len(list(self.records.glob('*.permit'))))

    def test_restart_and_concurrent_requests_are_idempotent(self):
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            bundles = list(pool.map(lambda _: self.issue(), range(8)))
        self.assertTrue(all(bundle == bundles[0] for bundle in bundles))
        self.issuer = publisher.Publisher(self.config)
        self.assertEqual(bundles[0], self.issue())
        self.assertEqual(2, len(list(self.records.glob('*.permit'))))

    def test_unregistered_foreign_and_unsafe_requests_are_refused(self):
        for candidate, previous, retained in [('dd' * 32, None, A), (B, 'ee' * 32, A),
                                              (B, None, C), (A, None, A)]:
            with self.assertRaises((ValueError, FileNotFoundError, subprocess.SubprocessError)):
                self.issue(candidate, previous, retained)
        for value in ['../permit.key', 'ab', 'AA' * 32]:
            with self.assertRaises(ValueError):
                self.issuer.permit(value, B, self.factory['anchor'], A)
        with self.assertRaises(ValueError):
            self.issuer.permit('01' * 32, B, self.factory['anchor'], A)
        self.assertEqual(1, len(list(self.records.glob('*.permit'))))

    def test_corrupt_registered_record_is_refused_before_signing(self):
        path = self.records / (self.factory['anchor'] + '.permit')
        raw = bytearray(path.read_bytes())
        raw[-1] ^= 1
        path.write_bytes(raw)
        with self.assertRaises(subprocess.SubprocessError):
            self.issue()

    def test_issuance_is_bounded(self):
        saved = publisher.MAX_RECORDS
        try:
            publisher.MAX_RECORDS = 1
            with self.assertRaises(ValueError):
                self.issue()
        finally:
            publisher.MAX_RECORDS = saved

    def signed_image(self, name, serial):
        private = self.root / 'image.key'
        certificate = self.root / 'image.crt'
        if not private.exists():
            publisher.run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '2',
                '-subj', '/CN=publisher-image-test', '-keyout', private, '-out', certificate])
        build = hashlib.sha256(name.encode()).hexdigest()
        source = self.root / name
        public = source / 'prebuilt/aarch64'
        payload = public / build
        payload.mkdir(parents=True)
        slot = source / 'slot'
        slot.mkdir()
        files = {}
        for filename in publisher.FILES:
            raw = (name + ':' + filename).encode()
            (payload / filename).write_bytes(raw)
            files[filename] = dict(size=len(raw), sha256=hashlib.sha256(raw).hexdigest())
        image = dict(arch='aarch64', channel='https://192.168.5.2:9443/playground', ipe=True,
                     serial=serial, build=build, files=files, boot_context='44' * 32)
        manifest = public / 'latest.json'
        manifest.write_text(json.dumps(image))
        publisher.run(['openssl', 'dgst', '-sha256', '-sign', private,
                       '-out', public / 'latest.json.sig', manifest])
        identity = b'werewolf.release/2\0aarch64\0'
        for filename in ('root.erofs', 'vmlinuz', 'stage0.zst'):
            identity += bytes.fromhex(files[filename]['sha256'])
        identity += bytes.fromhex(image['boot_context'])
        (slot / 'release.id').write_bytes(hashlib.sha256(identity).digest())
        (slot / 'pcr11').write_bytes(bytes.fromhex(PB))
        self.config.update(image_certificate=str(certificate), channel=image['channel'])
        return source

    def test_shared_head_floor_applies_to_new_owners(self):
        a = self.signed_image('public-a', '20261013T000000Z')
        b = self.signed_image('public-b', '20261013T000001Z')
        publisher.publish(self.config, a)
        publisher.publish(self.config, b)
        other = self.root / 'another-owner'
        other.mkdir()
        fresh = dict(self.config, authority=str(other))
        with self.assertRaisesRegex(ValueError, 'shared update head'):
            publisher.publish(fresh, a)
        publisher.publish(fresh, b)
        self.assertEqual((self.root / 'approved.json').read_bytes(), (other / 'approved.json').read_bytes())

    def test_atomic_shared_floor_survives_a_torn_latest_pair(self):
        a = self.signed_image('old-public', '20261013T000000Z')
        b = self.signed_image('new-public', '20261013T000001Z')
        publisher.publish(self.config, a)
        real = publisher.atomic
        def cut(path, data):
            if path == self.public / 'aarch64/latest.json':
                raise OSError('cut before latest JSON')
            return real(path, data)
        with patch.object(publisher, 'atomic', side_effect=cut):
            with self.assertRaises(OSError):
                publisher.publish(self.config, b)
        with self.assertRaises(ValueError):
            publisher.publish(self.config, a)
        publisher.publish(self.config, b)
        self.assertEqual((b / 'prebuilt/aarch64/latest.json').read_bytes(),
                         (self.public / 'aarch64/latest.json').read_bytes())

    def test_shared_refresh_selects_registered_download_owners(self):
