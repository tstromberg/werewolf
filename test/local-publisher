#!/usr/bin/env python3
"""Exercise host permit issuance, rollback context, restart, limits and HTTPS exposure."""
import concurrent.futures
import hashlib
import http.client
import importlib.machinery
import json
import os
from pathlib import Path
import socket
import ssl
import subprocess
import sys
import tempfile
import threading
import unittest
from unittest.mock import patch
from urllib.request import urlopen
from urllib.error import HTTPError

publisher = importlib.machinery.SourceFileLoader('publisher', 'tools/local-publisher').load_module()
HOWL = str(Path(sys.argv.pop(1) if len(sys.argv) > 1 else 'build/host/howl').resolve())
PROBE = str(Path('build/host/tpm-policy').resolve())
A, B, C = [value * 32 for value in ['aa', 'bb', 'cc']]
PA, PB, PC = [value * 32 for value in ['11', '22', '33']]


class Issuance(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='ww-publisher-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.records = self.root / 'records'
        self.records.mkdir()
        self.public = self.root / 'public'
        self.public.mkdir()
        publisher.run(['openssl', 'genrsa', '-out', self.root / 'permit.key', '2048'])
        publisher.run(['openssl', 'pkey', '-in', self.root / 'permit.key', '-pubout', '-out', self.root / 'permit.pub'])
        raw = publisher.TAG + bytes.fromhex(getattr(self, 'nonce', '42' * 32) + '00' * 32 + A + A + PA)
        state = self.root / 'factory.state'
        state.write_bytes(raw)
        publisher.run([PROBE, 'permit-pair', self.root / 'permit.pub', state, self.root / 'factory.message'])
        publisher.run(['openssl', 'dgst', '-sha256', '-sign', self.root / 'permit.key',
                       '-out', self.root / 'factory.sig', self.root / 'factory.message'])
        bundle = raw + (self.root / 'factory.sig').read_bytes()
        (self.root / 'factory.permit').write_bytes(bundle)
        self.factory = publisher.record(bundle)
        (self.records / (self.factory['anchor'] + '.permit')).write_bytes(bundle)
        (self.root / 'releases.json').write_text(json.dumps({A: PA, B: PB, C: PC}))
        self.approve(B)
        self.config = {'authority': str(self.root), 'public': str(self.public), 'howl': HOWL, 'arch': 'aarch64'}
        self.issuer = publisher.Publisher(self.config)

    def issue(self, candidate=B, previous=None, retained=A):
        return self.issuer.permit(self.factory['machine'], candidate,
                                 previous or self.factory['anchor'], retained)

    def approve(self, candidate):
        (self.root / 'approved.json').write_text(json.dumps({'candidate': candidate, 'serial': '20261012T000000Z'}))

    def service(self, directory, port):
        directory = directory.resolve()
        directory.mkdir(parents=True)
        (directory / 'registry').mkdir()
        publisher.run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '1',
                       '-subj', '/CN=shared-checkouts', '-addext', 'subjectAltName=IP:127.0.0.1',
                       '-keyout', directory / 'tls.key', '-out', directory / 'tls.crt'])
        config = dict(authority=str(directory), registry=str(directory / 'registry'), port=port,
                      certificate=str(directory / 'tls.crt'), key=str(directory / 'tls.key'), token='shared-checkouts')
        (directory / 'publisher.json').write_text(json.dumps(config))
        return directory, config

    def free_port(self):
        with socket.socket() as reservation:
            reservation.bind(('127.0.0.1', 0))
            return reservation.getsockname()[1]

    def test_live_legacy_publisher_is_shared_across_checkouts_preserving_trust(self):
        other = Issuance('test_signed_ab_preserves_both_releases')
        other.nonce = '43' * 32
        other.setUp()
        self.addCleanup(other.doCleanups)
        first = (self.root / 'first').resolve()
        second = (self.root / 'second').resolve()
        second.mkdir()
        port = self.free_port()
        legacy, service = self.service(first / ('build/permit-service/lima-%d' % port), port)
        shared = self.root.resolve() / 'state' / str(port)
        certificate = (legacy / 'tls.crt').read_bytes()
        self.config.update(service=str(legacy), channel='https://192.168.5.2:%d/_local/first' % port)
        other.config.update(service=str(shared), channel='https://10.0.2.2:%d/_local/second' % port)
        clients = []
        for fixture in (self, other):
            client = fixture.root / 'publisher.json'
            client.write_text(json.dumps(fixture.config))
            clients.append(client)
        tool = [sys.executable, str(Path('tools/local-publisher').resolve())]
        try:
            publisher.run(tool + ['start', clients[0]])
            with patch.object(publisher, 'worktrees', return_value=[second, first]):
                publisher.prepare_service(shared, second)
            self.assertTrue(legacy.is_symlink())
            self.assertEqual(shared, legacy.resolve())
            self.assertEqual(certificate, (shared / 'tls.crt').read_bytes())
            config = json.loads((shared / 'publisher.json').read_text())
            self.assertEqual(service['token'], config['token'])
            self.assertTrue(publisher.control(config))
            self.assertEqual(config, publisher.service_config(shared, port))
            # A listener owns the migrated lifetime lock after the handover.
            with (shared / 'publisher.lock').open('a+b') as guard:
                with self.assertRaises(BlockingIOError):
                    publisher.fcntl.flock(guard, publisher.fcntl.LOCK_EX | publisher.fcntl.LOCK_NB)
            with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
                list(pool.map(lambda _: publisher.prepare_service(shared, second), range(8)))
            config['program'] = str(self.root / 'previous-helper.py')
            publisher.atomic(shared / 'publisher.json', json.dumps(config).encode())
            publisher.prepare_service(shared, second)
            config = json.loads((shared / 'publisher.json').read_text())
            self.assertEqual(str(Path('tools/local-publisher').resolve()), config['program'])
            self.assertEqual(certificate, (shared / 'tls.crt').read_bytes())
            # The reloaded listener no longer depends on the old checkout.
            legacy.unlink()
            self.assertTrue(publisher.control(config))
            publisher.run(tool + ['start', clients[1]])
            registry = shared / 'registry'
            self.assertEqual({self.factory['machine'], other.factory['machine']},
                             {p.stem for p in registry.glob('*.json')})
            context = ssl.create_default_context(cafile=config['certificate'])
            for fixture in (self, other):
                route = '/aarch64/permits/' + fixture.factory['machine'] + '/' + B + '.permit?from=' + \
                    fixture.factory['anchor'] + '&retain=' + A
                with urlopen('https://127.0.0.1:%d' % port + route, context=context, timeout=10) as reply:
                    self.assertEqual(fixture.factory['machine'], publisher.record(reply.read())['machine'])
            legacy.symlink_to(shared, target_is_directory=True)
            publisher.run(tool + ['stop', clients[0]])
            self.assertTrue(publisher.control(config))
            self.assertEqual({other.factory['machine']}, {p.stem for p in registry.glob('*.json')})
            publisher.run(tool + ['stop', clients[1]])
            self.assertFalse(publisher.healthy(config))
        finally:
            path = (shared if shared.exists() else legacy) / 'publisher.json'
            publisher.run(tool + ['stop', path])

