    def test_shared_state_refuses_an_unrelated_listener_without_mutating_it(self):
        with socket.socket() as listener:
            listener.bind(('127.0.0.1', 0))
            listener.listen()
            port = listener.getsockname()[1]
            shared = self.root.resolve() / 'state' / str(port)
            with patch.object(publisher, 'worktrees', return_value=[self.root.resolve()]):
                with self.assertRaisesRegex(RuntimeError, 'already occupied'):
                    publisher.prepare_service(shared, self.root)
            self.assertFalse(shared.exists())
            self.assertEqual(port, listener.getsockname()[1])

    def test_shared_listener_routes_provider_images_by_the_signed_channel_host(self):
        other = Issuance('test_signed_ab_preserves_both_releases')
        other.nonce = '43' * 32
        other.setUp()
        self.addCleanup(other.doCleanups)
        directory, config = self.service(self.root / 'service', 0)
        server = publisher.Server(config)
        port = server.server_port
        fixtures = [(self, '192.168.5.2', b'lima'), (other, '10.0.2.2', b'qemu')]
        for fixture, host, content in fixtures:
            fixture.config['channel'] = 'https://%s:%d/playground' % (host, port)
            (directory / 'registry' / (fixture.factory['machine'] + '.json')).write_text(json.dumps(fixture.config))
            head = fixture.public / 'aarch64/latest.json'
            head.parent.mkdir()
            head.write_bytes(content)
        thread = threading.Thread(target=server.serve_forever)
        thread.start()
        try:
            context = ssl.create_default_context(cafile=config['certificate'])
            for host, expected in [('192.168.5.2', b'lima'), ('10.0.2.2', b'qemu'), ('127.0.0.1', None)]:
                connection = http.client.HTTPSConnection('127.0.0.1', port, context=context, timeout=10)
                try:
                    connection.request('GET', '/playground/aarch64/latest.json', headers={'Host': '%s:%d' % (host, port)})
                    reply = connection.getresponse()
                    if expected is None:
                        self.assertEqual(404, reply.status)
                        reply.read()
                    else:
                        self.assertEqual(200, reply.status)
                        self.assertEqual(expected, reply.read())
                finally:
                    connection.close()
        finally:
            server.shutdown()
            thread.join()
            server.server_close()

    def test_multiple_stopped_legacy_identities_are_not_silently_combined(self):
        port = self.free_port()
        checkout = self.root.resolve() / 'checkout'
        legacy = []
        for provider in ('lima', 'qemu'):
            directory, config = self.service(checkout / ('build/permit-service/%s-%d' % (provider, port)), port)
            legacy.append((directory, config))
        shared = self.root.resolve() / 'state' / str(port)
        with patch.object(publisher, 'worktrees', return_value=[checkout]):
            with self.assertRaisesRegex(ValueError, 'multiple legacy'):
                publisher.prepare_service(shared, checkout)
        self.assertFalse(shared.exists())
        for directory, config in legacy:
            self.assertEqual(config, json.loads((directory / 'publisher.json').read_text()))

