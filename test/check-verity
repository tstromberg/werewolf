#!/bin/sh
# check-verity QEMU... boots minimal's root.erofs with one byte of its
# superblock changed (make check-verity). A root image changed after its
# build must not boot: stage0 must refuse it before erofs reads it, and the
# machine end there (test/console.zig, CONSOLE_ENDS). dm-verity's own line
# varies by kernel, so it is matched loosely. make passes CHECK_ENV
# (Makefile).
set -eu
dir=$CHECK/verity
rm -rf "$dir" && mkdir -p "$dir" && cp "$OUT/slot/root.erofs" "$dir/"
printf x | dd of="$dir/root.erofs" bs=1 seek=1024 conv=notrunc 2>/dev/null
(cd "$dir" && "$TAR" -cf - --format newc --uid 0 --gid 0 --numeric-owner root.erofs) |
	zstd -1 -q -c | cat "$OUT/slot/stage0.zst" - >"$CHECK/verity.zst"
rm -r "$dir"
cat >"$CHECK/verity.checks" <<'EOF'
seen    refused    stage0: cannot mount /root.erofs
seen    corrupted  device-mapper: verity:.* corrupted|cannot read erofs superblock
unseen  booted     handing over to runit
EOF
CONSOLE_ENDS=1 CONSOLE_TIMEOUT=120 build/host/console verity "$CHECK/verity.checks" \
	"$CHECK/verity.log" "$@" -kernel "$KERNEL" -initrd "$CHECK/verity.zst" -append "$CMDLINE"
