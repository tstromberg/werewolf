# Extra failure cases for the minimal guest; ordinary boots check identities.
# A dead reader must restart its monitor, which must still shut down cleanly.
ok  power-worker-restarts  parent=$(cat /etc/sv/power-button/supervise/pid); worker=$(for d in /proc/[0-9]*; do awk -v p=$parent '/^PPid:/ {exit $2 != p}' "$d/status" 2>/dev/null && echo ${d#/proc/}; done); [ -n "$worker" ] && kill -KILL $worker || exit 1; i=0; while :; do next=$(cat /etc/sv/power-button/supervise/pid); [ "$next" -gt 1 ] && [ "$next" != "$parent" ] && break; i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done; i=0; while [ -d /proc/$worker ]; do i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done
# A service cannot reuse a reserved worker identity, even without capabilities.
ok  system-identities-reserved  mkdir -p /tmp/identity-probe; for u in _power _slotkeep _netcfg; do printf 'exec /usr/bin/true\nuser %s\npledge stdio\n' "$u" >/tmp/identity-probe/service; (cd /tmp/identity-probe && /usr/lib/werewolf/leash) >/tmp/identity-probe/result 2>&1 && exit 1; grep -q 'is a system' /tmp/identity-probe/result || { cat /tmp/identity-probe/result; exit 1; }; done
# Losing the monitor must also release its reader and input descriptors.
ok  power-monitor-restarts  parent=$(cat /etc/sv/power-button/supervise/pid); worker=$(for d in /proc/[0-9]*; do awk -v p=$parent '/^PPid:/ {exit $2 != p}' "$d/status" 2>/dev/null && echo ${d#/proc/}; done); [ -n "$worker" ] && kill -KILL $parent || exit 1; i=0; while :; do next=$(cat /etc/sv/power-button/supervise/pid); [ "$next" -gt 1 ] && [ "$next" != "$parent" ] && break; i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done; i=0; while [ -d /proc/$worker ]; do i=$((i+1)); [ $i -lt 30 ] || exit 1; sleep 1; done
