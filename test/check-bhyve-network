#!/usr/bin/env python3
"""Check TAP ownership, bridge selection and cleanup without changing host interfaces."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader('bhyve_network', str(ROOT / 'tools/bhyve-network'))
spec = importlib.util.spec_from_loader(loader.name, loader)
network = importlib.util.module_from_spec(spec)
loader.exec_module(network)


class Tap(unittest.TestCase):
    def setUp(self):
        temporary = tempfile.TemporaryDirectory(prefix='ww-tap-test-')
        self.addCleanup(temporary.cleanup)
        self.directory = Path(temporary.name)
        self.interfaces = {'re0bridge': None}
        self.members = {'re0bridge': {'re0'}}
        self.calls = []
        self.fail_attach = False
        mock = patch.object(network, 'ifconfig', side_effect=self.ifconfig)
        mock.start()
        self.addCleanup(mock.stop)

    def ifconfig(self, *args, change=False, missing=False):
        self.calls.append((args, change))
        if args == ('-g', 'bridge'):
            return '\n'.join(self.members)
        if args == ('tap', 'create'):
            name = 'tap0'
            self.assertNotIn(name, self.interfaces)
            self.interfaces[name] = None
            return name + '\n'
        name = args[0]
        if len(args) == 1:
            if name not in self.interfaces:
                if missing:
                    return None
                raise ValueError('missing interface')
            text = name + ': flags=UP\n'
            if self.interfaces[name]:
                text += '\tdescription: ' + self.interfaces[name] + '\n'
            for member in self.members.get(name, ()):
                text += '\tmember: ' + member + ' flags=UP\n'
            return text
        if args[1] == 'description':
            self.interfaces[name] = args[2]
        elif args[1] == 'addm':
            if self.fail_attach:
                raise ValueError('bridge attach failed')
            self.assertNotIn(args[2], self.members[name])
            self.members[name].add(args[2])
        elif args[1] == 'destroy':
            del self.interfaces[name]
            for members in self.members.values():
                members.discard(name)
        elif args[1] != 'up':
            self.fail('unexpected network mutation: ' + repr(args))
        self.assertTrue(change)
        return ''

    def test_single_existing_bridge_is_selected_and_owned_tap_removed(self):
        state = network.up(self.directory)
        self.assertEqual('re0bridge', state['bridge'])
        self.assertEqual({'re0', 'tap0'}, self.members['re0bridge'])
        self.assertEqual(state, network.load(self.directory))
        self.assertEqual(0o600, (self.directory / 'bhyve-network.json').stat().st_mode & 0o777)
        network.down(self.directory, state['owner'])
        self.assertEqual({'re0bridge': None}, self.interfaces)
        self.assertEqual({'re0'}, self.members['re0bridge'])
        self.assertIsNone(network.load(self.directory))

    def test_reuse_does_not_recreate_or_add_existing_member(self):
        state = network.up(self.directory)
        self.assertEqual(state, network.up(self.directory))
        self.assertEqual(1, sum(args == ('tap', 'create') for args, _ in self.calls))

    def test_reuse_restores_detached_membership(self):
        state = network.up(self.directory)
        self.members['re0bridge'].remove(state['tap'])
        self.assertEqual(state, network.up(self.directory))
        self.assertIn(state['tap'], self.members['re0bridge'])

    def test_ambiguous_or_absent_bridge_refuses_before_any_mutation(self):
        for bridges in ({}, {'bridge0': set(), 'bridge1': set()}):
            self.members = bridges
            self.calls.clear()
            with self.assertRaisesRegex(ValueError, '--bridge'):
                network.up(self.directory)
            self.assertFalse(any(change for _, change in self.calls))

    def test_explicit_bridge_resolves_ambiguity_and_invalid_names_refuse(self):
        self.interfaces['bridge1'] = None
        self.members['bridge1'] = set()
        state = network.up(self.directory, 'bridge1')
        self.assertEqual('bridge1', state['bridge'])
        network.down(self.directory)
        for invalid in ('missing', '-a', 're0bridge,slirp', 're0bridge;bad', 'a' * 16):
            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
                network.up(self.directory, invalid)

    def test_failed_attach_rolls_back_only_new_tap(self):
        self.fail_attach = True
        with self.assertRaisesRegex(ValueError, 'attach failed'):
            network.up(self.directory)
        self.assertEqual({'re0bridge': None}, self.interfaces)
        self.assertIsNone(network.load(self.directory))

    def test_foreign_interface_is_neither_adopted_nor_destroyed(self):
        state = network.up(self.directory)
        self.interfaces[state['tap']] = 'another owner'
        for action in (network.up, network.down):
            with self.assertRaisesRegex(ValueError, 'not this VM'):
                action(self.directory)
        self.assertEqual('another owner', self.interfaces[state['tap']])
        self.assertIsNotNone(network.load(self.directory))

    def test_old_supervisor_cannot_remove_successor(self):
        old = network.up(self.directory)
        network.down(self.directory, old['owner'])
        new = network.up(self.directory)
        self.assertNotEqual(old['owner'], new['owner'])
        network.down(self.directory, old['owner'])
        self.assertEqual(new, network.load(self.directory))
        self.assertIn(new['tap'], self.interfaces)

    def test_missing_interface_after_reboot_is_safe(self):
        state = network.up(self.directory)
        del self.interfaces[state['tap']]
        self.members['re0bridge'].discard(state['tap'])
        new = network.up(self.directory)
        self.assertNotEqual(state['owner'], new['owner'])
        del self.interfaces[new['tap']]
        network.down(self.directory)
        self.assertIsNone(network.load(self.directory))

    def test_malformed_or_other_directory_state_refuses(self):
        state = network.up(self.directory)
        path = self.directory / 'bhyve-network.json'
        for invalid in ([], dict(state, tap='re0'), dict(state, owner='howl:other:00'),
                        dict(state, bridge=None)):
            path.write_text(json.dumps(invalid))
            with self.assertRaises(ValueError):
                network.down(self.directory)
        self.assertIn('tap0', self.interfaces)


if __name__ == '__main__':
    unittest.main()
