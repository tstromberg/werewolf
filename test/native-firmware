#!/usr/bin/env python3
"""Firmware pins must reject corruption, mixed pairs and unauthenticated packages."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader('native_firmware', 'tools/native-firmware')
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


class NativeFirmware(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='ww-firmware-test-')
        self.root = Path(self.temporary.name)

    def tearDown(self):
        self.temporary.cleanup()

    def test_exact_bytes_and_size_required_and_symlinks_refused(self):
        records = {}
        for name in module.FILES:
            path = self.root / name
            with path.open('wb') as stream:
                stream.write(name.encode())
                stream.truncate(64 << 20)
            records[name] = (name, module.digest(path))
        with patch.object(module, 'FILES', records):
            self.assertTrue(module.valid(self.root))
            code = self.root / 'code.fd'
            with code.open('r+b') as stream:
                stream.write(b'tamper')
            self.assertFalse(module.valid(self.root))
            with code.open('r+b') as stream:
                stream.write(b'code.fd')
            self.assertTrue(module.valid(self.root))
            template = self.root / 'template.fd'
            template.rename(self.root / 'original')
            template.symlink_to(self.root / 'original')
            self.assertFalse(module.valid(self.root))
            template.unlink()
            template.write_bytes(code.read_bytes())
            self.assertFalse(module.valid(self.root))

    def test_untrusted_download_is_refused_before_any_archive_parser_or_installer(self):
        requirements = self.root / 'requirements'
        requirements.write_text('pinned tools')

        def download(argv, **kwargs):
            self.assertEqual(argv[0], 'curl')
            destination = Path(argv[argv.index('-o') + 1])
            with destination.open('wb') as stream:
                stream.truncate(4114848)

        with patch.object(module, 'run', download), patch.object(module.subprocess, 'run') as process:
            with self.assertRaises(ValueError):
                module.provision('aarch64', requirements, self.root / 'cache')
            process.assert_not_called()
        self.assertFalse(list((self.root / 'cache').rglob('public-firmware-*')))

    def test_unsupported_architecture_refuses_before_creating_state(self):
        cache = self.root / 'must-not-exist'
        with self.assertRaises(ValueError):
            module.provision('unknown', self.root / 'missing', cache)
        self.assertFalse(cache.exists())

    def test_enrollment_separates_platform_owner_from_executable_trust(self):
        firmware = self.root / 'firmware'
        firmware.mkdir()
        for name in ('code.fd', 'vars.fd'):
            (firmware / name).write_bytes(b'public firmware fixture')
        tools = self.root / 'bin'
        tools.mkdir()
        command = tools / 'virt-fw-vars'
        command.write_text('''#!/usr/bin/env python3
import json, os, sys
from pathlib import Path
args = sys.argv[1:]
Path(os.environ['WW_ENROLL_ARGS']).write_text(json.dumps(args))
for flag in ['--output', '--output-aws', '--output-json']:
    if flag in args: Path(args[args.index(flag) + 1]).write_text('public output')
''')
        command.chmod(0o755)
        certificates = {}
        for name in ('owner', 'vendor'):
            certificates[name] = self.root / (name + '.crt')
            subprocess.run(['openssl', 'x509', '-inform', 'DER', '-in',
                            'lib/testdata/boot-authority/' + name + '.der', '-out',
                            str(certificates[name])], check=True)
        capture = self.root / 'args.json'
        env = dict(os.environ, PATH=str(tools) + os.pathsep + os.environ['PATH'],
                   SECUREBOOT_DIR=str(firmware), WW_ENROLL_ARGS=str(capture))
        env.pop('WEREWOLF_BUILD_VM', None)
        output = self.root / 'enrolled'
        subprocess.run(['sh', 'tools/enroll-boot', 'x86_64', str(certificates['vendor']),
                        str(output), 'local', str(certificates['owner'])],
                       env=env, check=True, capture_output=True)
        args = json.loads(capture.read_text())
        for flag in ('--set-pk', '--add-kek'):
            self.assertEqual(args[args.index(flag) + 2], str(certificates['owner']))
        self.assertEqual(args[args.index('--add-db') + 2], str(certificates['vendor']))
        self.assertEqual([args[i + 1] for i, value in enumerate(args) if value == '--delete'],
                         ['PK', 'KEK', 'db', 'dbx'])
        self.assertEqual((output / 'boot.der').read_bytes(),
                         Path('lib/testdata/boot-authority/vendor.der').read_bytes())
        # Existing single-certificate source builds keep their original enrollment behavior.
        subprocess.run(['sh', 'tools/enroll-boot', 'x86_64', str(certificates['vendor']),
                        str(self.root / 'legacy')], env=env, check=True, capture_output=True)
        args = json.loads(capture.read_text())
        for flag in ('--set-pk', '--add-kek', '--add-db'):
            self.assertEqual(args[args.index(flag) + 2], str(certificates['vendor']))


unittest.main()
