#!/usr/bin/env python3
"""Boot the signed rootless enrollment image; keep only public evidence after testing."""
import argparse
import hashlib
import json
import os
from pathlib import Path
from enrollment_cuts import selected
from tpm_proxy import Proxy
import shutil
import signal
import socket
import struct
import subprocess
import tarfile
import tempfile
import time


def run(*args):
    return subprocess.run(list(map(str, args)), check=True, capture_output=True, timeout=60).stdout


def wait_path(path, process):
    until = time.monotonic() + 10
    while time.monotonic() < until:
        if path.exists():
            return
        if process.poll() is not None:
            raise RuntimeError('test process exited before creating its socket')
        time.sleep(.05)
    raise RuntimeError('test socket did not appear')


def stop(process):
    if process and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=10)


def recv(channel, size):
    result = bytearray()
    while len(result) < size:
        raw = channel.recv(size - len(result))
        if not raw:
            raise RuntimeError('truncated enrollment response')
        result.extend(raw)
    return bytes(result)


def pin_pem(raw):
    # Standard EK public area from the private host-side simulator connection.
    if len(raw) != 316 or raw[-258:-256] != b'\x01\x00':
        raise RuntimeError('unexpected standard RSA-2048 EK template')
    modulus = b'\x00' + raw[-256:]
    rsa = b'\x30\x82\x01\x0a\x02\x82\x01\x01' + modulus + b'\x02\x03\x01\x00\x01'
    return subprocess.run(['openssl', 'rsa', '-RSAPublicKey_in', '-inform', 'DER', '-pubout'],
                          input=rsa, check=True, capture_output=True, timeout=10).stdout


def exercise(args, private):
    root, work = Path(private), Path(args.work).resolve()
    work.mkdir(parents=True, mode=0o700, exist_ok=False)
    codec, policy, uki = [Path(p).resolve() for p in [args.codec, args.policy, args.uki]]
    run('openssl', 'genrsa', '-out', root / 'permit.key', '2048')
    run('openssl', 'pkey', '-in', root / 'permit.key', '-pubout', '-out', root / 'permit.pub')
    run('openssl', 'genrsa', '-out', root / 'attacker.key', '2048')
    run('openssl', 'pkey', '-in', root / 'attacker.key', '-pubout', '-out', root / 'attacker.pub')
    machine = os.urandom(32)
    state = b'werewolf.boot/2\0' + machine + bytes(32) + b'A' * 64 + b'F' * 32
    (root / 'factory.state').write_bytes(state)
    run(policy, 'permit-pair', root / 'permit.pub', root / 'factory.state', root / 'factory.message')
    run('openssl', 'dgst', '-sha256', '-sign', root / 'permit.key', '-out', root / 'factory.sig', root / 'factory.message')
    factory = state + (root / 'factory.sig').read_bytes()
    (root / 'factory.permit').write_bytes(factory)
    with (root / 'reset.credentials').open('xb') as credentials:
        credentials.write(os.urandom(64))
        credentials.flush()
        os.fsync(credentials.fileno())
    boot_key, boot_cert = args.boot_key, args.boot_cert
    if not boot_key:
        boot_key, boot_cert = root / 'boot.key', root / 'boot.crt'
        run('openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '2',
            '-subj', '/CN=werewolf-bootstrap-test', '-keyout', boot_key, '-out', boot_cert)
    firmware = Path(args.firmware).resolve() if args.firmware else root / 'enrolled'
    if not args.firmware:
        env = dict(os.environ, ENROLL_TEST_SETUP='1')
        subprocess.run(['sh', 'tools/enroll-boot', args.arch, str(boot_cert), str(firmware)],
                       env=env, check=True, capture_output=True, timeout=60)
    kernel = Path(args.kernel).resolve()
    if tarfile.is_tarfile(kernel):
        with tarfile.open(kernel) as archive:
            candidates = [member for member in archive if member.isfile() and
                          member.name.removeprefix('./').startswith('boot/vmlinuz')]
            if len(candidates) != 1 or candidates[0].size > 64 << 20:
                raise RuntimeError('ambiguous or oversized bootstrap kernel')
            data = archive.extractfile(candidates[0]).read()
        kernel = root / 'vmlinuz'
        kernel.write_bytes(data)
    image = root / 'image'
    run('python3', 'tools/build-tpm-bootstrap', '--arch', args.arch, '--agent', args.agent,
        '--kernel', kernel, '--stub', args.stub, '--publisher', root / 'permit.pub',
        '--factory', root / 'factory.permit', '--boot-key', boot_key, '--boot-cert', boot_cert,
        '--ipe-key', args.ipe_key, '--ipe-cert', args.ipe_cert,
        '--output', image, '--codec', codec, '--uki', uki)
    info = json.loads((image / 'manifest.json').read_text())
    shutil.copyfile(image / 'manifest.json', work / 'manifest.json')
    shutil.copyfile(root / 'permit.pub', work / 'publisher.pub')
    shutil.copyfile(root / 'factory.permit', work / 'factory.permit')
    pcr = bytes.fromhex(info['pcr11'])
    recovery_image = root / 'recovery'
    if args.recovery_cuts:
        run('python3', 'tools/build-tpm-bootstrap', '--arch', args.arch, '--agent', args.agent,
            '--kernel', kernel, '--stub', args.stub, '--publisher', root / 'permit.pub',
            '--factory', root / 'factory.permit', '--boot-key', boot_key, '--boot-cert', boot_cert,
            '--ipe-key', args.ipe_key, '--ipe-cert', args.ipe_cert,
            '--output', recovery_image, '--codec', codec, '--uki', uki, '--recovery')
        recovery_info = json.loads((recovery_image / 'manifest.json').read_text())
        if recovery_info['mode'] != 'recovery' or recovery_info['pcr11'] == info['pcr11']:
            raise RuntimeError('recovery image does not have a separate measured identity')
        shutil.copyfile(recovery_image / 'manifest.json', work / 'recovery-manifest.json')
    if args.unmeasured_stub:
        unsigned = root / 'unmeasured.unsigned'
        run(uki, args.unmeasured_stub, unsigned, '.linux=' + str(kernel),
            '.initrd=' + str(image / 'bootstrap.initrd'), '.cmdline=' + str(image / 'cmdline'))
        run('osslsigncode', 'sign', '-certs', boot_cert, '-key', boot_key,
            '-in', unsigned, '-out', root / 'unmeasured.efi')
    backend = None
    process = None
    channel = None
    proxy = None
    endpoint = root / 'tpm.sock'
    (root / 'nv').mkdir()

    def start_tpm(startup=False, server=False):
        nonlocal backend
        for path in [endpoint, Path(str(endpoint) + '.ctrl')]:
            path.unlink(missing_ok=True)
        command = ['swtpm', 'socket', '--tpm2', '--tpmstate', 'dir=' + str(root / 'nv'),
                   '--ctrl', 'type=unixio,path=' + str(endpoint) + '.ctrl',
                   '--flags', 'not-need-init' + (',startup-clear' if startup else '')]
        if server:
            command += ['--server', 'type=unixio,path=' + str(endpoint)]
        backend = subprocess.Popen(command,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        wait_path(Path(str(endpoint) + '.ctrl'), backend)

    def boot(label, tpm=True, setup=False, tamper=False, recovery=False):
        nonlocal process, channel
        disk = root / 'esp.img'
        with disk.open('wb') as target:
            target.truncate(128 << 20)
        run('mformat', '-i', disk, '-F', '::')
        run('mmd', '-i', disk, '::/EFI', '::/EFI/BOOT')
        binary = (recovery_image if recovery else image) / 'bootstrap.efi'
        if label == 'unmeasured':
            binary = root / 'unmeasured.efi'
        if tamper:
            changed = bytearray(binary.read_bytes())
            changed[len(changed) // 2] ^= 1
            binary = root / 'tampered.efi'
            binary.write_bytes(changed)
        run('mcopy', '-i', disk, binary, '::/EFI/BOOT/' + ('BOOTAA64.EFI' if args.arch == 'aarch64' else 'BOOTX64.EFI'))
        template = firmware / ('setup.fd' if setup else 'vars.fd')
        shutil.copyfile(template, root / 'vars.fd')
        endpoint_channel = root / 'channel.sock'
        endpoint_channel.unlink(missing_ok=True)
        command = ['qemu-system-' + args.arch, '-accel', args.accel,
                   '-M', 'virt' if args.arch == 'aarch64' else 'q35,smm=on',
                   '-cpu', 'host' if args.accel != 'tcg' else 'max', '-smp', '2', '-m', '1024',
                   '-display', 'none', '-monitor', 'none', '-serial', 'stdio', '-no-reboot',
                   '-nic', 'none',
                   '-drive', 'if=pflash,format=raw,readonly=on,file=' + str(firmware / 'code.fd'),
                   '-drive', 'if=pflash,format=raw,' + ('readonly=on,' if args.arch == 'aarch64' and not tamper else '') + 'file=' + str(root / 'vars.fd'),
                   '-drive', 'if=virtio,format=raw,file=' + str(disk),
                   '-device', 'virtio-serial-pci', '-chardev', 'socket,id=enroll,server=on,wait=off,path=' + str(endpoint_channel),
                   '-device', 'virtserialport,chardev=enroll,name=werewolf.enroll,nr=1']
        if args.arch == 'x86_64':
            command += ['-global', 'driver=cfi.pflash01,property=secure,value=on']
        if tpm:
            control = str(proxy.path) if proxy else str(endpoint) + '.ctrl'
            command += ['-chardev', 'socket,id=tpm,path=' + control,
                        '-tpmdev', 'emulator,id=tpm,chardev=tpm',
                        '-device', ('tpm-tis-device' if args.arch == 'aarch64' else 'tpm-tis') +
                        ',tpmdev=tpm' + (',ppi=off' if args.accel == 'hvf' else '')]
        with (work / (label + '.log')).open('wb') as log:
            process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
        wait_path(endpoint_channel, process)
        channel = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        channel.settimeout(60)
        # bind creates the socket path before QEMU starts listening.
        until = time.monotonic() + 10
        while True:
            try:
                channel.connect(str(endpoint_channel))
                break
            except (FileNotFoundError, ConnectionRefusedError):
                if process.poll() is not None or time.monotonic() >= until:
                    raise
                time.sleep(.05)

    def refused(label, reason):
        until = time.monotonic() + 90
        while time.monotonic() < until:
            exited = process.poll() is not None
            log = (work / (label + '.log')).read_bytes()
            if reason.lower() in log.lower():
                channel.settimeout(.2)
                try:
                    extra = channel.recv(1)
                except socket.timeout:
                    extra = b''
                if extra:
                    raise RuntimeError('refused bootstrap emitted unexpected enrollment output')
                print('pass   signed bootstrap: ' + label + ' refused (' + reason.decode() + ')', flush=True)
                return
            if b'protected factory enrollment complete' in log or exited:
                break
            # Serial output can arrive in pieces even for one guest write.
            # Do not kill QEMU after seeing only the refusal's prefix.
            if b'tpm-enroll: refused:' in log and b'\n' in log.split(b'tpm-enroll: refused:', 1)[1]:
                break
            time.sleep(.1)
        raise RuntimeError(label + ': no expected refusal\n' + log[-4000:].decode(errors='replace'))

    def close_boot():
        nonlocal channel, proxy
        if channel:
            channel.close()
            channel = None
        stop(process)
        stop(backend)
        if proxy:
            proxy.close()
            proxy = None

    def deliver(expected_pcr, filename='reset.credentials'):
        if recv(channel, 8) != b'WWREADY1':
            raise RuntimeError('recovery bootstrap did not become ready')
        raw = machine + hashlib.sha256(factory).digest() + expected_pcr + os.urandom(32)
        (root / 'context').write_bytes(raw)
        channel.sendall(b'WWCHAL01' + raw)
        if recv(channel, 8) != b'WWENROL1':
            raise RuntimeError('invalid recovery proof frame')
        for name in ['ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']:
            size = struct.unpack('>H', recv(channel, 2))[0]
            if size == 0 or size > 1024:
                raise RuntimeError('oversized recovery proof field')
            (root / name).write_bytes(recv(channel, size))
        verify = [root / name for name in ['context', 'ek.pem', 'ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']]
        run(codec, 'verify', *verify)
        capsule = root / 'recovery.capsule'
        capsule.unlink(missing_ok=True)
        run(codec, 'wrap', *verify, root / filename, root / 'permit.key', root / 'permit.pub', capsule)
        body = capsule.read_bytes()
        channel.sendall(b'WWCAPS01' + struct.pack('>H', len(body)) + body)

    def finish(label):
        if recv(channel, 8) != b'WWDONE01' or recv(channel, 32).hex() != info['anchor']:
            raise RuntimeError('recovery protected readback mismatch')
        process.wait(timeout=30)
        if b'protected factory enrollment complete; rebooting' not in (work / (label + '.log')).read_bytes():
            raise RuntimeError('recovery did not reboot without handing over a workload')

    try:
        # Host retrieves the simulator EK before any guest proof exists; never trust a guest-supplied pin.
        start_tpm(True, server=True)
        wait_path(endpoint, backend)
        run(codec, 'ek-probe', 'unix:' + str(endpoint), root / 'ek.pin')
        (root / 'ek.pem').write_bytes(pin_pem((root / 'ek.pin').read_bytes()))
        stop(backend)
        if args.recovery_cuts:
            shutil.copytree(root / 'nv', root / 'pristine')
        cases = ['wrong-machine', 'wrong-pcr', 'foreign-signer', 'bad-aead', 'unsigned', 'oversized']
        if args.unmeasured_stub:
            cases += ['unmeasured']
        cases += ['valid', 'replay', 'missing-tpm', 'tampered']
        for kind in cases:
            start_tpm()
            boot(kind, tpm=kind != 'missing-tpm', tamper=kind == 'tampered')
            raw = machine + hashlib.sha256(factory).digest() + pcr + os.urandom(32)
            if kind == 'wrong-machine':
                raw = bytes([raw[0] ^ 1]) + raw[1:]
            if kind == 'wrong-pcr':
                raw = raw[:64] + bytes([pcr[0] ^ 1]) + raw[65:]
            if kind in ['replay', 'missing-tpm', 'tampered', 'unmeasured']:
                reason = {'replay': b'TpmAlreadyProvisioned', 'missing-tpm': b'MissingBootstrapDevice',
                          'tampered': b'access denied', 'unmeasured': b'UnmeasuredBoot'}[kind]
                refused(kind, reason)
            else:
                (root / 'context').write_bytes(raw)
                if recv(channel, 8) != b'WWREADY1':
                    raise RuntimeError('bootstrap did not become ready for a fresh challenge')
                channel.sendall(b'WWCHAL01' + raw)
                if kind in ['wrong-machine', 'wrong-pcr']:
                    refused(kind, b'WrongFactoryBootState' if kind == 'wrong-machine' else b'WrongBootstrapMeasurement')
                else:
                    if recv(channel, 8) != b'WWENROL1':
                        raise RuntimeError('invalid bootstrap proof frame')
                    for name in ['ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']:
                        size = struct.unpack('>H', recv(channel, 2))[0]
                        if size == 0 or size > 1024:
                            raise RuntimeError('oversized proof field')
                        (root / name).write_bytes(recv(channel, size))
                    verify = [root / name for name in ['context', 'ek.pem', 'ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']]
                    run(codec, 'verify', *verify)
                    sender = 'attacker' if kind == 'foreign-signer' else 'permit'
                    capsule = root / 'capsule'
                    capsule.unlink(missing_ok=True)
                    run(codec, 'wrap', *verify, root / 'reset.credentials', root / (sender + '.key'), root / (sender + '.pub'), capsule)
                    body = capsule.read_bytes()
                    if kind == 'bad-aead':
                        corrupted = bytearray(body[:438])
                        corrupted[358] ^= 1
                        message = b'werewolf.enroll.capsule/1\0' + hashlib.sha256(b'werewolf.enroll/1\0' + raw).digest() + corrupted
                        (root / 'corrupted.message').write_bytes(message)
                        run('openssl', 'dgst', '-sha256', '-sign', root / 'permit.key', '-out', root / 'corrupted.sig', root / 'corrupted.message')
                        body = corrupted + b'\x01\x00' + (root / 'corrupted.sig').read_bytes()
                    if kind == 'unsigned':
                        body = body[:438]
                    if kind == 'oversized':
                        channel.sendall(b'WWCAPS01\xff\xff')
                        refused(kind, b'BadEnrollmentCapsule')
                    elif kind == 'foreign-signer':
                        channel.sendall(b'WWCAPS01' + struct.pack('>H', len(body)) + body)
                        refused(kind, b'BadEnrollmentSignature')
                    elif kind in ['unsigned', 'bad-aead']:
                        channel.sendall(b'WWCAPS01' + struct.pack('>H', len(body)) + body)
                        refused(kind, b'BadEnrollmentCapsule' if kind == 'unsigned' else b'AuthenticationFailed')
                    else:
                        channel.sendall(b'WWCAPS01' + struct.pack('>H', len(body)) + body)
                        if recv(channel, 8) != b'WWDONE01' or recv(channel, 32).hex() != info['anchor']:
                            raise RuntimeError('protected enrollment readback mismatch')
                        process.wait(timeout=30)
                        if b'protected factory enrollment complete; rebooting' not in (work / 'valid.log').read_bytes():
                            raise RuntimeError('bootstrap did not reboot without workload handover')
                        stop(backend)
                        start_tpm(True, server=True)
                        run(policy, 'read-pair', root / 'permit.pub', 'unix:' + str(endpoint), root / 'anchor')
                        if (root / 'anchor').read_bytes().hex() != info['anchor']:
                            raise RuntimeError('independent protected NV readback mismatch')
                        for name in ['context', 'ek.pem', 'ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']:
                            shutil.copyfile(root / name, work / name)
                        print('pass   signed bootstrap: expected actual PCR, pinned EK, encrypted enrollment, protected readback and reboot', flush=True)
            close_boot()
        if (firmware / 'setup.fd').exists():
            start_tpm()
            boot('setup-mode', setup=True)
            refused('setup-mode', b'UnenforcedSecureBoot')
            close_boot()
        start_tpm(True, server=True)
        run(policy, 'read-pair', root / 'permit.pub', 'unix:' + str(endpoint), root / 'final.anchor')
        if (root / 'final.anchor').read_bytes().hex() != info['anchor']:
            raise RuntimeError('bootstrap replay or refusals changed the protected pair')
        shutil.copyfile(root / 'final.anchor', work / 'anchor')
        print('pass   signed bootstrap: protected pair unchanged after replay and all post-enrollment refusals', flush=True)
        close_boot()
        if args.recovery_cuts:
            expected_recovery = bytes.fromhex(recovery_info['pcr11'])
            for step, when in [('owner', 'before'), ('owner', 'after'), ('define', 'after'), ('extend', 'after')]:
                suffix = step + '-' + when
                shutil.rmtree(root / 'nv')
                shutil.copytree(root / 'pristine', root / 'nv')
                start_tpm()
                proxy = Proxy(root / 'proxy.sock', str(endpoint) + '.ctrl', lambda raw: selected(raw, step))
                proxy.arm(when)
                boot('cut-' + suffix)
                deliver(pcr)
                if not proxy.hit.wait(timeout=30) or proxy.failures:
                    raise RuntimeError('signed VM provisioning cut missing: ' + suffix)
                process.kill()
                process.wait(timeout=10)
                backend.kill()
                backend.wait(timeout=10)
                close_boot()
                start_tpm()
                boot('normal-refusal-' + suffix, recovery=step == 'owner' and when == 'before')
                reason = b'NoIncompleteEnrollment' if step == 'owner' and when == 'before' else b'TpmAlreadyProvisioned'
                refused('normal-refusal-' + suffix, reason)
                close_boot()
                start_tpm()
                if step == 'owner' and when == 'before':
                    boot('fresh-retry-' + suffix)
                    deliver(pcr)
                    finish('fresh-retry-' + suffix)
                elif step == 'extend':
                    boot('recovery-terminal-' + suffix, recovery=True)
                    refused('recovery-terminal-' + suffix, b'TpmAlreadyProvisioned')
                else:
                    # Recovery quotes cannot be substituted with ordinary bootstrap measurement.
                    boot('recovery-wrong-pcr-' + suffix, recovery=True)
                    if recv(channel, 8) != b'WWREADY1':
                        raise RuntimeError('partial recovery did not become ready')
                    channel.sendall(b'WWCHAL01' + machine + hashlib.sha256(factory).digest() + pcr + os.urandom(32))
                    refused('recovery-wrong-pcr-' + suffix, b'WrongBootstrapMeasurement')
                    close_boot()
                    start_tpm()
                    boot('recovery-wrong-owner-' + suffix, recovery=True)
                    damaged = bytearray((root / 'reset.credentials').read_bytes())
                    damaged[0] ^= 1
                    (root / 'wrong.credentials').write_bytes(damaged)
                    deliver(expected_recovery, 'wrong.credentials')
                    refused('recovery-wrong-owner-' + suffix, b'TpmRefused')
                    close_boot()
                    start_tpm()
                    proxy = Proxy(root / 'proxy.sock', str(endpoint) + '.ctrl', lambda raw: selected(raw, 'lockout'))
                    proxy.arm('after')
                    boot('recovery-cut-' + suffix, recovery=True)
                    deliver(expected_recovery)
                    if not proxy.hit.wait(timeout=30) or proxy.failures:
                        raise RuntimeError('signed VM recovery interruption missing')
                    process.kill()
                    process.wait(timeout=10)
                    backend.kill()
                    backend.wait(timeout=10)
                    close_boot()
                    start_tpm()
                    boot('recovery-valid-' + suffix, recovery=True)
                    deliver(expected_recovery)
                    finish('recovery-valid-' + suffix)
                close_boot()
                start_tpm(True, server=True)
                run(policy, 'read-pair', root / 'permit.pub', 'unix:' + str(endpoint), root / 'recovery.anchor')
                if (root / 'recovery.anchor').read_bytes().hex() != info['anchor']:
                    raise RuntimeError('provisioning/recovery cut changed the factory authorization')
                close_boot()
                start_tpm()
                boot('recovery-replay-' + suffix, recovery=True)
                refused('recovery-replay-' + suffix, b'TpmAlreadyProvisioned')
                close_boot()
                print('pass   signed recovery: ' + suffix + ', original encrypted authority, exact anchor and replay refusal', flush=True)
    finally:
        close_boot()
    print('pass   signed bootstrap: no root image, workload service or guest reset secret persisted', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    # The IPE key signs the bootstrap's policy; the kernel must trust its certificate.
    for arg in ['arch', 'kernel', 'stub', 'agent', 'work', 'ipe-key', 'ipe-cert']:
        parser.add_argument('--' + arg, required=True)
    parser.add_argument('--codec', default='build/host/tpm-bootstrap')
    parser.add_argument('--policy', default='build/host/tpm-policy')
    parser.add_argument('--uki', default='build/host/uki')
    parser.add_argument('--accel', default='tcg')
    parser.add_argument('--firmware')
    parser.add_argument('--boot-key')
    parser.add_argument('--boot-cert')
    parser.add_argument('--unmeasured-stub')
    parser.add_argument('--recovery-cuts', action='store_true')
    args = parser.parse_args()
    if bool(args.boot_key) != bool(args.boot_cert) or bool(args.firmware) != bool(args.boot_key):
        parser.error('pre-enrolled firmware requires both matching test boot key and certificate')
    os.umask(0o077)
    signal.signal(signal.SIGTERM, interrupted)
    with tempfile.TemporaryDirectory(prefix='ww-bootstrap-guest-', dir='/tmp') as private:
        exercise(args, private)


def interrupted(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    main()
