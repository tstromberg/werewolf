#!/usr/bin/env python3
"""Validate proposed cloud activation policy with independent TPM tools."""
from contextlib import contextmanager
import hashlib
import os
from pathlib import Path
import subprocess
import tempfile
import time

probe = Path(os.environ.get('TPM_BOOTSTRAP_PROBE', 'build/host/tpm-bootstrap')).resolve()
policy_probe = Path(os.environ.get('TPM_POLICY_PROBE', 'build/host/tpm-policy')).resolve()


@contextmanager
def simulator(root):
    (root / 'nv').mkdir()
    endpoint = root / 'tpm.sock'
    process = subprocess.Popen([
        'swtpm', 'socket', '--tpm2', '--tpmstate', 'dir=' + str(root / 'nv'),
        '--server', 'type=unixio,path=' + str(endpoint),
        '--ctrl', 'type=unixio,path=' + str(endpoint) + '.ctrl',
        '--flags', 'not-need-init,startup-clear',
    ], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    try:
        for _ in range(100):
            if process.poll() is not None:
                raise RuntimeError(process.stderr.read().decode())
            if endpoint.exists():
                break
            time.sleep(.05)
        else:
            raise RuntimeError('simulator did not start')
        yield dict(os.environ, TPM2TOOLS_TCTI='swtpm:path=' + str(endpoint))
    finally:
        process.terminate()
        try:
            process.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate(timeout=10)


def exercise(root, env):
    def run(*args, success=True):
        result = subprocess.run(list(map(str, args)), cwd=root, env=env,
                                capture_output=True, timeout=20)
        if (result.returncode == 0) != success:
            raise RuntimeError(str(args) + ': ' + result.stderr.decode(errors='replace'))
        return result

    run('tpm2_pcrextend', '-Q', '11:sha256=' + '11' * 32)
    run('tpm2_pcrread', '-Q', 'sha256:11', '-o', 'expected.pcr')
    for code, output in [('TPM2_CC_Quote', 'quote.policy'),
                         ('TPM2_CC_ActivateCredential', 'activate.policy')]:
        run('tpm2_startauthsession', '-S', 'trial.ctx')
        run('tpm2_policypcr', '-Q', '-S', 'trial.ctx', '-l', 'sha256:11', '-f', 'expected.pcr')
        run('tpm2_policycommandcode', '-Q', '-S', 'trial.ctx', code, '-L', output)
        run('tpm2_flushcontext', 'trial.ctx')
    branches = 'sha256:quote.policy,activate.policy'
    run('tpm2_startauthsession', '-S', 'trial.ctx')
    run('tpm2_policyor', '-Q', '-S', 'trial.ctx', '-l', branches, '-L', 'policy.bin')
    run('tpm2_flushcontext', 'trial.ctx')
    if not probe.is_file():
        raise RuntimeError('build the native probe: make build/host/tpm-bootstrap')
    expected = b''.join((root / f).read_bytes() for f in ['quote.policy', 'activate.policy', 'policy.bin'])
    assert run(probe, 'policy', 'expected.pcr').stdout == expected
    run('tpm2_createek', '-Q', '-c', '0x81010001', '-G', 'rsa', '-u', 'ek.pub')

    def parent():
        run('tpm2_startauthsession', '--policy-session', '-S', 'parent.ctx')
        run('tpm2_policysecret', '-Q', '-S', 'parent.ctx', '-c', 'e')

    parent()
    attributes = 'fixedtpm|fixedparent|sensitivedataorigin|adminwithpolicy|restricted|sign'
    run('tpm2_create', '-Q', '-C', '0x81010001', '-P', 'session:parent.ctx',
        '-G', 'rsa2048:rsassa-sha256:null', '-g', 'sha256', '-a', attributes,
        '-L', 'policy.bin', '-u', 'ak.pub', '-r', 'ak.priv')
    run('tpm2_flushcontext', 'parent.ctx')
    parent()
    run('tpm2_load', '-Q', '-C', '0x81010001', '-P', 'session:parent.ctx',
        '-u', 'ak.pub', '-r', 'ak.priv', '-c', 'ak.ctx', '-n', 'ak.name')
    run('tpm2_evictcontrol', '-Q', '-C', 'o', '-c', 'ak.ctx', '0x81010002')
    run('tpm2_flushcontext', 'parent.ctx')
    run('tpm2_flushcontext', '-t')

    def policy(code='TPM2_CC_ActivateCredential'):
        run('tpm2_startauthsession', '--policy-session', '-S', 'akpol.ctx')
        run('tpm2_policypcr', '-Q', '-S', 'akpol.ctx', '-l', 'sha256:11', '-f', 'expected.pcr')
        run('tpm2_policycommandcode', '-Q', '-S', 'akpol.ctx', code)
        run('tpm2_policyor', '-Q', '-S', 'akpol.ctx', '-l', branches)

    policy('TPM2_CC_Quote')
    (root / 'context').write_bytes(bytes.fromhex('aa' * 32 + 'bb' * 32) +
                                 (root / 'expected.pcr').read_bytes() + os.urandom(32))
    nonce = run(probe, 'challenge', 'context').stdout.hex()
    run('tpm2_quote', '-Q', '-c', '0x81010002', '-p', 'session:akpol.ctx', '-l', 'sha256:11',
        '-q', nonce, '-m', 'quote.msg', '-s', 'quote.sig', '-o', 'quote.pcr', '-g', 'sha256')
    run('tpm2_flushcontext', 'akpol.ctx')

    def quote(challenge, pcr='expected.pcr', success=True):
        run('tpm2_checkquote', '-Q', '-u', 'ak.pub', '-m', 'quote.msg', '-s', 'quote.sig',
            '-f', pcr, '-l', 'sha256:11', '-g', 'sha256', '-q', challenge, success=success)

    quote(nonce)
    quote('00' * 32, success=False)
    (root / 'wrong.pcr').write_bytes(bytes.fromhex('33' * 32))
    quote(nonce, 'wrong.pcr', success=False)
    run('tpm2_readpublic', '-Q', '-c', '0x81010001', '-f', 'pem', '-o', 'ek.pem')
    verify = [probe, 'verify', 'context', 'ek.pem', 'ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']
    run(*verify)
    if os.environ.get('TPM_BOOTSTRAP_FIXTURES'):
        directory = Path(os.environ['TPM_BOOTSTRAP_FIXTURES'])
        directory.mkdir(parents=True, mode=0o700, exist_ok=True)
        for name in ['context', 'ek.pem', 'ek.pub', 'ak.pub', 'quote.msg', 'quote.sig']:
            (directory / name).write_bytes((root / name).read_bytes())
    original = (root / 'ak.pub').read_bytes()
    changed = bytearray(original)
    changed[9] ^= 0x40  # Adding userWithAuth must not permit empty-auth activation.
    (root / 'weak-ak.pub').write_bytes(changed)
    run(*verify[:5], 'weak-ak.pub', *verify[6:], success=False)
    for size in range(len(original)):
        (root / 'truncated-ak.pub').write_bytes(original[:size])
        run(*verify[:5], 'truncated-ak.pub', *verify[6:], success=False)
    print('pass   native cloud attestation: independent policy/quote match; weak and truncated templates refused')
    secret = os.urandom(32)
    (root / 'secret').write_bytes(secret)
    name = (root / 'ak.name').read_bytes().hex()
    run('tpm2_makecredential', '-Q', '-T', 'none', '-u', 'ek.pub', '-s', 'secret',
        '-n', name, '-o', 'capsule')

    def activate(capsule, output, success=True, auth='session:akpol.ctx'):
        args = ['tpm2_activatecredential', '-Q', '-c', '0x81010002', '-C', '0x81010001',
                '-P', 'session:parent.ctx', '-i', capsule, '-o', output]
        if auth is not None:
            args += ['-p', auth]
        run(*args, success=success)
        if not success:
            assert not (root / output).exists()

    def flush():
        run('tpm2_flushcontext', 'parent.ctx')
        run('tpm2_flushcontext', 'akpol.ctx')

    parent()
    policy('TPM2_CC_Quote')
    activate('capsule', 'wrong-command', success=False)
    flush()
    parent()
    activate('capsule', 'empty-auth', success=False, auth=None)
    run('tpm2_flushcontext', 'parent.ctx')
    parent()
    policy()
    activate('capsule', 'recovered')
    assert (root / 'recovered').read_bytes() == secret
    flush()
    print('pass   cloud TPM activation: fresh quote, expected PCR, encrypted key and command/empty-auth refusals')

    # Bind the capsule to this AK name and reject corruption before releasing its key.
    run('tpm2_makecredential', '-Q', '-T', 'none', '-u', 'ek.pub', '-s', 'secret',
        '-n', '000b' + '44' * 32, '-o', 'wrong-name')
    damaged = bytearray((root / 'capsule').read_bytes())
    damaged[-1] ^= 1
    (root / 'damaged').write_bytes(damaged)
    for capsule in ['wrong-name', 'damaged']:
        parent()
        policy()
        activate(capsule, capsule + '.recovered', success=False)
        flush()
    print('pass   cloud TPM activation: wrong AK identity and corrupted capsule refused')

    # Native host wrapping must interoperate with the independent TPM client.
    (root / 'reset.credentials').write_bytes(os.urandom(64))
    run('openssl', 'genrsa', '-out', 'capsule-sign.key', '2048')
    run('openssl', 'pkey', '-in', 'capsule-sign.key', '-pubout', '-out', 'capsule-sign.pub')
    run(probe, 'wrap', *verify[2:], 'reset.credentials', 'capsule-sign.key', 'capsule-sign.pub', 'native.bundle')
    bundle = (root / 'native.bundle').read_bytes()
    if os.environ.get('TPM_BOOTSTRAP_FIXTURES'):
        directory = Path(os.environ['TPM_BOOTSTRAP_FIXTURES'])
        for name in ['native.bundle', 'capsule-sign.pub']:
            (directory / name).write_bytes((root / name).read_bytes())
    header = len(b'werewolf.enroll/1\0')
    assert len(bundle) == header + 328 + 92 + 2 + 256
    (root / 'native.credential').write_bytes((root / 'capsule').read_bytes()[:8] +
                                           bundle[header:header + 328])
    parent()
    policy()
    activate('native.credential', 'native.key')
    flush()
    check = [probe, 'check-capsule', 'context', 'ek.pem', 'ak.pub', 'native.key',
             'native.bundle', 'reset.credentials', 'capsule-sign.pub']
    run(*check)
    changed = bytearray(bundle)
    changed[-1] ^= 1
    (root / 'corrupted.bundle').write_bytes(changed)
    run(*check[:6], 'corrupted.bundle', *check[7:], success=False)
    changed = bytearray((root / 'context').read_bytes())
    changed[0] ^= 1
    (root / 'foreign.context').write_bytes(changed)
    run(check[0], check[1], 'foreign.context', *check[3:], success=False)
    print('pass   native cloud capsule: independent TPM activation, authenticated reset credentials and tamper refusals')

    run('tpm2_pcrextend', '-Q', '11:sha256=' + '22' * 32)
    run('tpm2_startauthsession', '--policy-session', '-S', 'bad.ctx')
    run('tpm2_policypcr', '-Q', '-S', 'bad.ctx', '-l', 'sha256:11',
        '-f', 'expected.pcr', success=False)
    parent()
    activate('capsule', 'wrong-boot', success=False, auth='session:bad.ctx')
    print('pass   cloud TPM activation: stale challenge, wrong quote/PCR and post-boot activation refused')


def main():
    os.umask(0o077)
    with tempfile.TemporaryDirectory(prefix='ww-cloud-ak-', dir='/tmp') as temporary:
        root = Path(temporary)
        with simulator(root) as env:
            exercise(root, env)
        nested = root / 'native'
        nested.mkdir()
        with simulator(nested) as env:
            native_guest(nested, env)


def native_guest(root, env):
    def run(*args, success=True):
        result = subprocess.run(list(map(str, args)), cwd=root, env=env,
                                capture_output=True, timeout=20)
        if (result.returncode == 0) != success:
            raise RuntimeError(str(args) + ': ' + result.stderr.decode(errors='replace'))
        return result

    run('tpm2_pcrextend', '-Q', '11:sha256=' + '11' * 32)
    run('tpm2_pcrread', '-Q', 'sha256:11', '-o', 'expected.pcr')
    run('tpm2_createek', '-Q', '-c', '0x81010001', '-G', 'rsa', '-u', 'ek.pub')
    run('tpm2_readpublic', '-Q', '-c', '0x81010001', '-f', 'pem', '-o', 'ek.pem')
    run('openssl', 'genrsa', '-out', 'permit.key', '2048')
    run('openssl', 'pkey', '-in', 'permit.key', '-pubout', '-out', 'permit.pub')
    state = b'werewolf.boot/2\0' + bytes.fromhex('42' * 32 + '00' * 32 + 'aa' * 64 + '11' * 32)
    (root / 'factory.state').write_bytes(state)
    run(policy_probe, 'permit-pair', 'permit.pub', 'factory.state', 'factory.message')
    run('openssl', 'dgst', '-sha256', '-sign', 'permit.key', '-out', 'factory.sig', 'factory.message')
    factory = state + (root / 'factory.sig').read_bytes()
    (root / 'factory.permit').write_bytes(factory)
    (root / 'context').write_bytes(bytes.fromhex('42' * 32) + hashlib.sha256(factory).digest() +
                                 (root / 'expected.pcr').read_bytes() + os.urandom(32))
    (root / 'reset.credentials').write_bytes(os.urandom(64))
    endpoint = 'unix:' + str(root / 'tpm.sock')
    command = [str(probe), 'guest-probe', 'context', endpoint, 'permit.pub', 'factory.permit']
    run('openssl', 'genrsa', '-out', 'attacker.key', '2048')
    run('openssl', 'pkey', '-in', 'attacker.key', '-pubout', '-out', 'attacker.pub')
    original = (root / 'context').read_bytes()
    for offset, error in [(32, b'WrongFactoryBootState'), (64, b'WrongBootstrapMeasurement')]:
        damaged = bytearray(original)
        damaged[offset] ^= 1
        (root / 'context').write_bytes(damaged)
        refusal = run(*command, success=False)
        assert not refusal.stdout and error in refusal.stderr, refusal.stderr
    (root / 'context').write_bytes(original)

    def exchange(kind):
        guest = subprocess.Popen(command, cwd=root, env=env, stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            def read(count):
                raw = guest.stdout.read(count)
                if len(raw) != count:
                    raise RuntimeError('native guest failed: ' + guest.stderr.read().decode(errors='replace'))
                return raw
            assert read(8) == b'WWENROL1'
            fields = {}
            for name in ['native.ek', 'native.ak', 'native.quote', 'native.signature']:
                size = int.from_bytes(read(2), 'big')
                assert size <= 1024
                fields[name] = read(size)
                (root / name).write_bytes(fields[name])
            nonce = run(probe, 'challenge', 'context').stdout.hex()
            run('tpm2_checkquote', '-Q', '-u', 'native.ak', '-m', 'native.quote',
                '-s', 'native.signature', '-f', 'expected.pcr', '-l', 'sha256:11',
                '-g', 'sha256', '-q', nonce)
            output = 'bundle-' + kind
            sender = 'attacker' if kind == 'foreign-signer' else 'permit'
            run(probe, 'wrap', 'context', 'ek.pem', 'native.ek', 'native.ak',
                'native.quote', 'native.signature', 'reset.credentials', sender + '.key', sender + '.pub', output)
            capsule = bytearray((root / output).read_bytes())
            if kind == 'corrupted':
                capsule[-1] ^= 1
            elif kind == 'bad-aead':
                capsule[437] ^= 1
                message = b'werewolf.enroll.capsule/1\0' + bytes.fromhex(nonce) + capsule[:438]
                (root / 'corrupted.message').write_bytes(message)
                run('openssl', 'dgst', '-sha256', '-sign', 'permit.key', '-out',
                    'corrupted.signature', 'corrupted.message')
                capsule = capsule[:438] + b'\x01\x00' + (root / 'corrupted.signature').read_bytes()
            elif kind == 'unsigned':
                capsule = capsule[:438]
            elif kind == 'truncated':
                capsule = capsule[:-1]
            elif kind == 'oversized':
                capsule += b'x'
            guest.stdin.write(capsule)
            guest.stdin.close()
            guest.stdin = None
            receipt, error = guest.communicate(timeout=20)
            if kind != 'valid':
                assert guest.returncode != 0 and not receipt, error
                expected_error = (b'AuthenticationFailed' if kind == 'bad-aead' else
                                  b'BadEnrollmentSignature' if kind in ['corrupted', 'foreign-signer'] else
                                  b'BadEnrollmentCapsule')
                assert expected_error in error, error
                print('pass   native guest refusal: ' + kind + ' before provisioning')
            else:
                assert guest.returncode == 0, error.decode(errors='replace')
                expected = hashlib.sha256(state[48:80] + hashlib.sha256(state).digest()).digest()
                assert receipt == expected
                run('tpm2_nvread', '-Q', '-C', '0x01500021', '-s', '32', '-o',
                    'independent.anchor', '0x01500021')
                assert (root / 'independent.anchor').read_bytes() == expected
        finally:
            if guest.poll() is None:
                guest.kill()
            guest.communicate(timeout=10)

    for kind in ['corrupted', 'bad-aead', 'foreign-signer', 'unsigned', 'truncated', 'oversized', 'valid']:
        exchange(kind)
    replay = run(*command, success=False)
    assert not replay.stdout
    assert b'TpmAlreadyProvisioned' in replay.stderr
    partial = root / 'partial'
    partial.mkdir()
    for name in ['context', 'permit.pub', 'factory.permit']:
        (partial / name).write_bytes((root / name).read_bytes())
    (partial / 'owner.auth').write_bytes(os.urandom(32))
    with simulator(partial) as partial_env:
        subprocess.run(['tpm2_changeauth', '-c', 'o', 'file:' + str(partial / 'owner.auth')],
                       env=partial_env, capture_output=True, check=True)
        refusal = subprocess.run([str(probe), 'guest-probe', 'context',
                                  'unix:' + str(partial / 'tpm.sock'), 'permit.pub', 'factory.permit'],
                                 cwd=partial, env=partial_env, capture_output=True, timeout=20)
        assert refusal.returncode != 0 and not refusal.stdout
        assert b'TpmAlreadyProvisioned' in refusal.stderr, refusal.stderr
    print('pass   native guest bootstrap: encrypted exchange, malformed-capsule refusal, protected readback and replay refusal')
    print('pass   native guest bootstrap: wrong factory/PCR and incomplete prior provisioning refused before proof')


if __name__ == '__main__':
    main()
