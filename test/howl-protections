#!/usr/bin/env python3
"""Default refusal must precede provider tools, VM replacement and weaker builds."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile


howl = str(Path(sys.argv[1]).resolve())
with tempfile.TemporaryDirectory(prefix='howl-protections-') as temporary:
    root = Path(temporary)
    for name in ('minimal', 'prod-ssh', 'playground'):
        directory = root / 'forms' / name
        directory.mkdir(parents=True)
        (directory / 'form.yaml').write_text('' if name == 'minimal' else 'base: minimal\n')
    previous = root / 'build/machines/werewolf-run'
    previous.mkdir(parents=True)
    (previous / 'engine').write_text('qemu')
    (previous / 'disk.img').write_bytes(b'previous machine must survive refusal')
    tools = root / 'bin'
    tools.mkdir()
    invoked = root / 'tool-invoked'
    for name in ('aws', 'gcloud', 'az', 'limactl', 'qemu-system-aarch64',
                 'qemu-system-x86_64', 'ssh', 'curl', 'make', 'gmake'):
        tool = tools / name
        tool.write_text('#!' + sys.executable + '\nimport os, pathlib\n'
                        'pathlib.Path(os.environ["HOWL_PROTECTION_INVOKED"]).touch()\n'
                        'raise SystemExit(97)\n')
        tool.chmod(0o700)
    # Build-system environment is not user consent to a CLI downgrade.
    env = dict(os.environ, PATH=str(tools) + os.pathsep + os.environ['PATH'],
               HOWL_PROTECTION_INVOKED=str(invoked), DISABLE='secureboot,tpm,ipe',
               DEV='1', IPE='0')

    def refused(args, message):
        result = subprocess.run([howl, *args], cwd=root, env=env,
                                capture_output=True, text=True, timeout=15)
        assert result.returncode != 0 and message in result.stderr, (args, result)
        assert not invoked.exists(), (args, 'a backend or weaker build was invoked')
        assert (previous / 'disk.img').read_bytes() == b'previous machine must survive refusal'

    for provider in ('aws', 'gcp', 'azure', 'bhyve', 'firecracker', 'proxmox'):
        for build in ([], ['--build']):
            for verb in ('run', 'create'):
                args = [verb, *(['protection-check'] if verb == 'create' else []),
                        '--with', 'prod-ssh', '--on', provider, '--yes', *build]
                refused(args, 'protected deployment is not ready')
    for provider in ('lima', 'qemu'):
        for dev in ('--dev', '--dev=ssh'):
            for verb in ('run', 'create'):
                refused([verb, *(['protection-check'] if verb == 'create' else []),
                         '--with', 'prod-ssh', '--on', provider, '--build', dev, '--yes'],
                        'developer access requires an unprotected local machine')
    refused(['upload', 'missing.qcow2', '--on', 'aws'], 'cannot bring Secure Boot')
    refused(['_build', '--with', 'prod-ssh', '--dev', 'disk'],
            'which --disable does not name')
    refused(['_build', '--with', 'prod-ssh', '--disk-args',
             'werewolf.disable=secureboot,tpm,ipe', 'disk'], 'which --disable does not name')

print('howl-protections: protected defaults refuse before tools or replacement; dev, environment and raw arguments cannot downgrade')
