#!/usr/bin/env python3
"""First use and restart must prepare a real isolated Linux instance before shell."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader('build_helper', 'tools/build-helper')
spec = importlib.util.spec_from_loader(loader.name, loader)
helper = importlib.util.module_from_spec(spec)
loader.exec_module(helper)


def record(status='Stopped', **config):
    return dict(name='werewolf-build', arch='aarch64', status=status,
                config=dict(os='Linux', mounts=[], ssh=dict(forwardAgent=False), **config))


class BuildHelper(unittest.TestCase):
    def test_preparation_uses_private_shared_lock_and_releases_after_failure(self):
        with tempfile.TemporaryDirectory(prefix='ww-helper-lock-') as temporary, \
                patch.dict(os.environ, {'LIMA_HOME': temporary}), \
                patch.object(helper, 'ensure', side_effect=[ValueError('test'), None]) as ensure:
            with self.assertRaises(ValueError):
                helper.prepare('werewolf-build', 'template.yaml')
            helper.prepare('werewolf-build', 'template.yaml')
            self.assertEqual(ensure.call_count, 2)
            lock = Path(temporary) / '.werewolf-build-werewolf-build.lock'
            self.assertEqual(lock.stat().st_mode & 0o777, 0o600)

    def execute(self, states):
        with patch.object(helper, 'instance', side_effect=states), \
                patch.object(helper, 'run') as run:
            helper.ensure('werewolf-build', '/embedded/template.yaml')
            return [call.args[0] for call in run.call_args_list]

    def test_missing_helper_is_created_then_started_before_shell(self):
        calls = self.execute([None, record(), record('Running')])
        self.assertEqual([call[1] for call in calls], ['create', 'start', 'shell'])
        self.assertEqual(calls[0][-1], '/embedded/template.yaml')

    def test_stopped_helper_is_started_and_running_helper_is_reused(self):
        self.assertEqual([call[1] for call in self.execute([record(), record('Running')])],
                         ['start', 'shell'])
        self.assertEqual([call[1] for call in self.execute([record('Running')])], ['shell'])

    def test_failed_creation_or_start_never_invokes_shell(self):
        for states in [[None, None], [record(), None], [record(), record()]]:
            with patch.object(helper, 'instance', side_effect=states), \
                    patch.object(helper, 'run') as run:
                with self.assertRaises(ValueError):
                    helper.ensure('werewolf-build', 'template.yaml')
                self.assertFalse(any(call.args[0][1] == 'shell' for call in run.call_args_list))

    def test_unsafe_existing_helper_is_not_started_or_modified(self):
        values = [record(), record(), record(), record()]
        values[0]['arch'] = 'x86_64'
        values[1]['config']['os'] = 'Other'
        values[2]['config']['mounts'] = [dict(location='/Users/somebody', writable=False)]
        values[3]['config']['ssh']['forwardAgent'] = True
        for value in values:
            with patch.object(helper, 'instance', return_value=value), \
                    patch.object(helper, 'run') as run:
                with self.assertRaises(ValueError):
                    helper.ensure('werewolf-build', 'template.yaml')
                run.assert_not_called()

    def test_invalid_names_refuse_before_running_lima(self):
        for name in ['', '../somebody', '-flag', 'space name', 'a' * 65]:
            with patch.object(helper, 'run') as run:
                with self.assertRaises(ValueError):
                    helper.ensure(name, 'template.yaml')
                run.assert_not_called()

    def test_json_list_absence_and_ambiguity(self):
        for values, expected in [([], None), ([record()], record())]:
            with patch.object(helper, 'run', return_value=subprocess.CompletedProcess(
                    [], 0, stdout='\n'.join(json.dumps(value) for value in values))):
                self.assertEqual(helper.instance('werewolf-build'), expected)
        with patch.object(helper, 'run', return_value=subprocess.CompletedProcess(
                [], 0, stdout='\n'.join(json.dumps(record()) for _ in range(2)))):
            with self.assertRaises(ValueError):
                helper.instance('werewolf-build')


unittest.main()
