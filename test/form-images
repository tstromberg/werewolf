def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


def admit(howl, operation, directory, request):
    # Native admission is tested by boot-images/boot-download; here a bundle
    # is admitted when its signature verifies against the fixture image key.
    head = Path(directory) / 'boot.json'
    catalog.verify_signature(head.read_bytes(), (Path(directory) / 'boot.json.sig').read_bytes(),
                             Path(request['image_certificate']))
    return json.loads(head.read_text()) if operation == 'head' else {}


class Images(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.temporary = tempfile.TemporaryDirectory(prefix='ww-form-trust-')
        root = Path(cls.temporary.name)
        cls.trust, cls.key = root / 'trust', root / 'image.key'
        cls.trust.mkdir()
        subprocess.run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-x509', '-sha256', '-days', '2',
                        '-subj', '/CN=form-image-tests', '-keyout', cls.key, '-out', cls.trust / 'image.crt'],
                       check=True, capture_output=True)
        shutil.copyfile(cls.trust / 'image.crt', cls.trust / 'boot.crt')
        shutil.copyfile('release/protected/trust.json', cls.trust / 'trust.json')
        raw = root / 'disk.raw'
        with raw.open('wb') as output:
            output.write(b'protected disk header')
            output.truncate(512 << 20)
        cls.disk = root / 'disk.img.zst'
        subprocess.run(['zstd', '-q', raw, '-o', cls.disk], check=True)

    @classmethod
    def tearDownClass(cls):
        cls.temporary.cleanup()

    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='ww-form-images-')
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        self.store = images.publisher.Store(str(self.root / 'store'))
        self.serial = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        self.environment = dict(WEREWOLF_PROTECTED_IMAGE_KEY=str(self.key), GITHUB_REPOSITORY='werewolf-linux/werewolf',
                                GITHUB_SHA='b' * 40, GITHUB_RUN_ID='123', GITHUB_RUN_ATTEMPT='1')
        for patcher in [patch.object(images, 'TRUST', self.trust), patch.object(downloads, 'native', side_effect=admit),
                        patch.dict(os.environ, self.environment),
                        patch.object(images, 'forms', return_value=['caddy', 'nginx', 'playground']),
                        patch.object(images, 'query', return_value=['x86_64'])]:
            patcher.start()
            self.addCleanup(patcher.stop)
        self.inventory = dict(format=notes.FORMAT, form='playground', arch='x86_64', packages=[
            dict(scope='runtime', name='busybox', version='1.37-r0', checksum='a' * 64),
            dict(scope='runtime', name='removed', version='1-r0', checksum='b' * 64),
            dict(scope='build:kernel', name='gcc', version='15-r0', checksum='e' * 64),
        ], images=[])

    def bundle(self, path, serial, form='playground'):
        (path / 'slot').mkdir(parents=True)
        for name in downloads.FILES:
            (path / 'slot' / name).write_bytes((name + serial).encode())
        (path / 'prebuilt/x86_64').mkdir(parents=True)
        for name in ('latest.json', 'latest.json.sig'):
            (path / 'prebuilt/x86_64' / name).write_bytes((name + serial).encode())
        shutil.copyfile(self.disk, path / 'disk.img.zst')
        manifest = dict(form=form, image=dict(arch='x86_64', build=digest(serial), serial=serial),
                        raw_size=512 << 20, permit_host='10.0.2.2')
        (path / 'boot.json').write_text(json.dumps(manifest))
        (path / 'boot.json.sig').write_bytes(catalog.sign((path / 'boot.json').read_bytes(), self.key))
        return path

    def run_pipeline(self, serial, statuses=None, gated=True, focused=False, flat=False):
        """One workflow run: plan, verified evidence, a gated bundle, export and publish."""
        work = self.root / ('run-' + serial)
        statuses = statuses or {}
        selected = ('playground',) if focused else ('caddy', 'playground')
        targets = [dict(form=form, arch='x86_64', status=statuses.get(form, 'build'), inputs=digest(form),
                        commit='b' * 40, serial=serial) for form in selected]
        if not focused:
            targets.append(dict(form='nginx', arch='x86_64', status='resolution failed'))
        snapshots = work / ('snapshots' if flat else 'snapshots/inputs-x86_64-1')
        images.write(snapshots / 'plan.json', dict(arch='x86_64', shard=1, targets=targets))
        verified = work / ('verified' if flat else 'verified/verified-x86_64-1')
        gates = work / ('gated' if flat else 'gated/gated-qemu-x86_64')
        bundle = self.bundle(gates / 'bundle', serial)
        results = []
        for target in targets:
            results.append(dict(target, status='passed' if target['status'] == 'build' else target['status']))
            if target['status'] != 'build':
                continue
            directory = verified / target['form']
            directory.mkdir(parents=True)
            inventory = dict(self.inventory, form=target['form'])
            (directory / 'packages.json').write_bytes(catalog.encode(inventory))
            (directory / 'inputs.tar.gz').write_bytes(b'locks')
            images.write(directory / 'tests.json', dict(format='werewolf-form-tests/1', form=target['form'],
                         arch='x86_64', inputs=target['inputs'], checks={c: True for c in images.CHECKS},
                         bundles={'qemu': catalog.sha(bundle / 'boot.json')}))
        images.write(verified / 'results.json', results)
        report = dict(format='werewolf-boot-gates/1', descriptor=catalog.sha(bundle / 'boot.json'),
                      arch='x86_64', provider='qemu', checks={g: True for g in images.publisher.preparation.GATES})
        images.write(bundle.parent / 'gates.json', report)
        if not gated:
            shutil.rmtree(work / 'gated')
        listing = work / 'exported.json'
        images.export(work / 'snapshots', work / 'verified', work / 'gated', self.store, work / 'assets', listing)
        failed = images.publish(work / 'snapshots', work / 'verified', {('qemu', 'x86_64')}, listing, self.store,
                                focused=focused)
        return failed, json.loads(listing.read_text())

    def rows(self):
        return images.index(self.store)

    def test_single_artifact_downloads_publish_with_flat_directories(self):
        for offset, focused in enumerate((False, True)):
            with self.subTest(focused=focused):
                serial = (datetime.datetime.strptime(self.serial, '%Y%m%dT%H%M%SZ') +
                          datetime.timedelta(seconds=offset)).strftime('%Y%m%dT%H%M%SZ')
                outputs = self.root / ('flat-outputs-' + str(offset))
                with patch.dict(os.environ, GITHUB_OUTPUT=str(outputs)):
                    failed, listing = self.run_pipeline(serial, focused=focused, flat=True)
                self.assertEqual(not focused, failed)  # The full run includes an unresolved nginx.
                self.assertEqual('targets=1\nreleased=true\n', outputs.read_text())
                self.assertEqual(['playground'], [target['form'] for target in listing])
                row = self.rows()[images.FOCUSED_TARGET]
                self.assertEqual(catalog.PUBLISHED, row['status'])
                self.assertEqual(serial, row['latest']['serial'])
                self.assertTrue((self.root / 'store' / row['latest']['object'] / 'disk.qcow2').is_file())

