    def test_gate_failure_keeps_other_forms_and_unchanged_targets_need_no_authorization(self):
        lifecycle = self.root / 'lifecycle'
        for form in ('minimal', 'prod-ssh'):
            for name in ('qemu', 'qemu-update-1', 'qemu-update-2'):
                directory = lifecycle / form / name
                directory.mkdir(parents=True)
                (directory / 'production').write_text(form)
        def run(argv):
            if argv[1] == 'release/authorize-protected' and 'minimal' in str(argv[4]):
                raise subprocess.CalledProcessError(1, argv)
            if argv[1] == 'test/check-published-lifecycle':
                logs = Path(argv[-1])
                logs.mkdir(parents=True)
                images.write(logs / 'gates.json', {'passed': True})
        output = self.root / 'gated'
        updates = self.root / 'updates'
        images.write(updates / 'result.json', {})
        with patch.object(images, 'native'), self.assertRaisesRegex(ValueError, 'update evidence'):
            images.gate(lifecycle, self.root / 'no-evidence', 'qemu', 'x86_64', ['minimal'], self.root / 'missing')
        previous = Path.cwd()
        os.chdir(self.root)
        try:
            with patch.object(images, 'native'), patch.object(images, 'run', side_effect=run) as called:
                self.assertTrue(images.gate(lifecycle, output, 'qemu', 'x86_64', ['minimal', 'prod-ssh', 'playground'], updates))
        finally:
            os.chdir(previous)
        self.assertEqual(3, called.call_count)
        self.assertEqual({'prod-ssh'}, {p.name for p in output.iterdir()})
        self.assertEqual('prod-ssh', (output / 'prod-ssh/bundle/production').read_text())
        self.assertTrue((output / 'prod-ssh/gates.json').is_file())
        self.assertTrue((lifecycle / 'minimal/qemu/production').is_file())
        with patch.object(images, 'native'), patch.object(images, 'run') as called:
            self.assertFalse(images.gate(lifecycle, self.root / 'unchanged', 'qemu', 'x86_64', ['playground'], updates))
            called.assert_not_called()

