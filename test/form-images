    def test_focused_publication_preserves_allowed_rows_and_retires_unlisted_forms(self):
        self.run_pipeline(self.serial)
        previous = self.rows()
        # Preserve other targets of allowed forms without relabeling their
        # health, while removing forms retired from the publication allowlist.
        previous[('retired-form', 'qemu', 'aarch64')] = dict(
            form='retired-form', provider='qemu', arch='aarch64', status='tests failed', inputs='a' * 64)
        arm = previous[('playground', 'lima', 'aarch64')]
        arm.update(status=catalog.PUBLISHED, inputs='c' * 64, latest=dict(
            serial=self.serial, commit='b' * 40, descriptor='d' * 64, size=123,
            object='playground/lima/aarch64/objects/' + 'd' * 64))
        images.write(self.root / 'store/index.json', json.loads(catalog.envelope(
            dict(format=catalog.FORMAT, forms=list(previous.values())), self.key)))
        later = (datetime.datetime.strptime(self.serial, '%Y%m%dT%H%M%SZ') +
                 datetime.timedelta(seconds=5)).strftime('%Y%m%dT%H%M%SZ')
        failed, listing = self.run_pipeline(later, focused=True)
        self.assertFalse(failed)  # Existing prod-ssh/retired-form failures are unrelated.
        self.assertEqual(['playground'], [t['form'] for t in listing])
        rows = self.rows()
        self.assertEqual({target for target in previous if target[0] in images.profiles.FORMS}, set(rows))
        for target in previous:
            if target != images.FOCUSED_TARGET and target[0] in images.profiles.FORMS:
                self.assertEqual(previous[target], rows[target])
        self.assertEqual(later, rows[images.FOCUSED_TARGET]['latest']['serial'])

