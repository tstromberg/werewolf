    def test_focused_resolution_only_locks_playground(self):
        queries = []

        def query(verb, form):
            queries.append((verb, form))
            return ['x86_64'] if verb == 'archs' else [form]

        snapshot = self.root / 'focused-snapshot'
        with patch.object(images, 'shared_inputs'), patch.object(images, 'query', side_effect=query), \
                patch.object(images.catalog, 'read_index', return_value={}), \
                patch.object(images.subprocess, 'check_output', return_value='b' * 40), \
                patch.object(images.shutil, 'copyfile'), patch.object(images, 'run') as run, \
                patch.object(images, 'tool_versions', return_value={}), \
                patch.object(images, 'resolved_identity', return_value='a' * 64):
            images.resolve('x86_64', 1, 1, snapshot, focused=True)
        self.assertEqual([('archs', 'playground'), ('names', 'playground')], queries)
        plan = json.loads((snapshot / 'plan.json').read_text())
        self.assertEqual([('playground', 'build')], [(t['form'], t['status']) for t in plan['targets']])
        self.assertEqual(2, run.call_count)  # Release and integration locks.
        for arch, shard, shards in [('aarch64', 1, 1), ('x86_64', 1, 8)]:
            with self.assertRaisesRegex(ValueError, 'single x86_64 shard'):
                images.resolve(arch, shard, shards, self.root / 'invalid', focused=True)

    def test_nonmatching_builds_fail_before_testing_or_writing_evidence(self):
        target = dict(form='caddy', arch='x86_64', serial=self.serial, inputs=digest('caddy'))
        first, second = self.root / 'one/caddy', self.root / 'two/caddy'
        for copy in (first, second):
            self.bundle(copy / 'qemu', self.serial, form='caddy')
        (second / 'qemu/slot/root.erofs').write_bytes(b'different output')
        for copy in (first, second):
            images.keep(target, copy)
        arguments = (target, self.root / 'snapshot', first, second, self.root / 'verified', self.root / 'lifecycle')
        with patch.object(images, 'run') as run:
            with self.assertRaisesRegex(ValueError, 'builds differ'):
                images.check_one(*arguments)
            shutil.copyfile(first.parent / 'caddy.files.json', second.parent / 'caddy.files.json')
            (first / 'qemu/boot.json').write_bytes(b'{"changed": "after the build"}')
            with self.assertRaisesRegex(ValueError, 'build record'):
                images.check_one(*arguments)
            run.assert_not_called()
        self.assertFalse((self.root / 'verified').exists())

    def test_builds_keep_only_what_later_jobs_read(self):
        for form in ('caddy', 'playground'):
            output = self.root / 'candidates' / form
            target = dict(form=form, arch='x86_64', serial=self.serial)
            for name, _, serial in images.bundles(target):
                self.bundle(output / name, serial, form=form)
            for name in ('inputs.tar.gz', 'packages.json'):
                (output / name).write_bytes(name.encode())
            whole = images.digests(output)
            images.keep(target, output)
            self.assertEqual(whole, json.loads((output.parent / (form + '.files.json')).read_text()))
        self.assertEqual({'qemu/boot.json', 'inputs.tar.gz', 'packages.json'},
                         set(images.digests(self.root / 'candidates/caddy')))
        playground = self.root / 'candidates/playground'
        self.assertEqual(json.loads((playground.parent / 'playground.files.json').read_text()),
                         images.digests(playground))

    def test_release_notes_escape_package_and_image_text(self):
        inventory = copy.deepcopy(self.inventory)
        inventory['packages'][0].update(name='<script>', version='<img>')
