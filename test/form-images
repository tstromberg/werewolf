    def test_a_successful_form_can_publish_while_another_form_fails(self):
        snapshots, verified = self.root / 'snapshots', self.root / 'verified'
        plan = dict(arch='x86_64', shard=1, targets=[dict(self.candidate, status='build'),
                    dict(form='nginx', arch='x86_64', status='resolution failed')])
        images.write(snapshots / 'inputs-x86_64-1/plan.json', plan)
        destination = verified / 'verified-x86_64-1'
        shutil.copytree(self.assets, destination / 'caddy')
        images.write(destination / 'caddy-tests.json', self.report)
        images.write(destination / 'results.json', [dict(self.candidate, status='passed')])
        actual = catalog.publish

        def publish(directory, report, store, key, certificate, run):
            return actual(directory, report, store, key, self.cert, run)

        open_head = catalog.open_head
        with patch.dict(os.environ, WEREWOLF_BOOT_KEY=str(self.key), GITHUB_RUN_ID='123', GITHUB_SHA='b' * 40,
                        GITHUB_REPOSITORY='werewolf-linux/werewolf', GITHUB_STEP_SUMMARY=str(self.root / 'summary')), \
                patch.object(images, 'forms', return_value=['caddy', 'nginx']), \
                patch.object(images, 'query', return_value=['aarch64', 'x86_64']), \
                patch.object(catalog, 'publish', side_effect=publish), \
                patch.object(catalog, 'open_head', side_effect=lambda raw, _, form, arch: open_head(raw, self.cert, form, arch)):
            self.assertTrue(images.publish(snapshots, verified, self.store))
        raw = json.loads((self.root / 'store/index.json').read_text())
        catalog.verify_signature(raw['manifest'].encode(), bytes.fromhex(raw['signature']), self.cert)
        rows = json.loads(raw['manifest'])['forms']
        published = next(row for row in rows if row['form'] == 'caddy' and row['arch'] == 'x86_64')
        self.assertEqual('published', published['status'])
        self.assertIn('latest', published)
        self.assertEqual(4, len(rows))
        self.assertTrue((self.root / 'store/caddy/index.html').exists())
        self.assertTrue((self.root / 'store/nginx/index.html').exists())
        self.assertFalse((self.root / 'store/nginx/x86_64/current.json').exists())
        summary = (self.root / 'summary').read_text()
        self.assertIn('/release-notes.html)', summary)
        self.assertIn('| caddy | x86_64 | published |', summary)
        self.assertIn('| nginx | x86_64 | resolution failed | Not published |', summary)


