    def test_gated_target_publishes_and_every_target_is_cataloged(self):
        outputs = self.root / 'outputs'
        with patch.dict(os.environ, GITHUB_OUTPUT=str(outputs)):
            failed, listing = self.run_pipeline(self.serial)
        self.assertTrue(failed)  # nginx did not resolve
        self.assertEqual('targets=1\nreleased=true\n', outputs.read_text())
        self.assertEqual(['playground'], [t['form'] for t in listing])
        rows = self.rows()
        published = rows[('playground', 'qemu', 'x86_64')]
        self.assertEqual(catalog.PUBLISHED, published['status'])
        self.assertEqual(self.serial, published['latest']['serial'])
        self.assertEqual(catalog.UNGATED, rows[('caddy', 'qemu', 'x86_64')]['status'])
        self.assertNotIn('latest', rows[('caddy', 'qemu', 'x86_64')])
        self.assertEqual('resolution failed', rows[('nginx', 'qemu', 'x86_64')]['status'])
        self.assertEqual('unsupported architecture', rows[('caddy', 'lima', 'aarch64')]['status'])
        objects = self.root / 'store' / published['latest']['object']
        signed = json.loads((objects / 'downloads.json').read_text())
        catalog.verify_signature((objects / 'downloads.json').read_bytes(),
                                 (objects / 'downloads.json.sig').read_bytes(), self.trust / 'image.crt')
        for name in images.exporter.EXTRAS | {'disk.qcow2', 'gates.json', 'boot.json'}:
            self.assertEqual(signed['files'][name]['sha256'], catalog.sha(objects / name))
        self.assertIn('Initial published image', (objects / 'release-notes.html').read_text())
        self.assertTrue((self.root / 'store/playground/qemu/x86_64/latest/boot.json').exists())
        self.assertTrue((self.root / 'store/caddy/index.html').exists())
        self.assertIn('playground/qemu/x86_64/objects/', (self.root / 'store/index.html').read_text())

    def test_release_notes_compare_with_the_targets_last_publication(self):
        self.run_pipeline(self.serial)
        previous = self.rows()[('playground', 'qemu', 'x86_64')]['latest']
        self.inventory['packages'][0].update(version='1.38-r0', checksum='1' * 64)
        self.inventory['packages'].pop(1)
        later = (datetime.datetime.strptime(self.serial, '%Y%m%dT%H%M%SZ') +
                 datetime.timedelta(seconds=5)).strftime('%Y%m%dT%H%M%SZ')
        self.run_pipeline(later, statuses=dict(caddy='unchanged'))
        rows = self.rows()
        latest = rows[('playground', 'qemu', 'x86_64')]['latest']
        self.assertEqual(later, latest['serial'])
        release = json.loads((self.root / 'store' / latest['object'] / 'release-notes.json').read_text())
        self.assertEqual({k: previous[k] for k in ('serial', 'commit', 'object')}, release['previous'])
        changes = {p['name']: p['kind'] for p in release['packages']}
        self.assertEqual(dict(busybox='updated', removed='removed'), changes)
        page = (self.root / 'store' / latest['object'] / 'release-notes.html').read_text()
        self.assertIn('href="../' + previous['descriptor'] + '/release-notes.html"', page)
        # An unchanged target keeps its settled status and the inputs it settled on.
        self.assertEqual(catalog.UNGATED, rows[('caddy', 'qemu', 'x86_64')]['status'])
        self.assertEqual(digest('caddy'), rows[('caddy', 'qemu', 'x86_64')]['inputs'])

