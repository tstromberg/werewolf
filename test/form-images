    def test_head_signature_and_identity_are_checked_before_use(self):
        manifest = self.publish()
        raw = catalog.envelope(manifest, self.key)
        for form, arch in [('nginx', 'x86_64'), ('caddy', 'aarch64')]:
            with self.assertRaises(ValueError):
                catalog.open_head(raw, self.cert, form, arch)
        changed = json.loads(raw)
        changed['manifest'] = changed['manifest'].replace('caddy', 'nginx')
        with self.assertRaises(subprocess.CalledProcessError):
            catalog.open_head(catalog.encode(changed), self.cert, 'nginx', 'x86_64')

    def test_immutable_collision_leaves_existing_head_unchanged(self):
        manifest = self.publish()
        head = self.root / 'store/caddy/x86_64/current.json'
        before = head.read_bytes()
        # Exercise immutable collision independently; an equal serial is an
        # idempotent retry and never rewrites the immutable object tree.
        target = self.root / 'store' / manifest['object'] / 'disk.qcow2'
        target.write_bytes(b'foreign bytes')
        with self.assertRaisesRegex(ValueError, 'collision'):
            self.store.immutable(manifest['object'] + '/disk.qcow2', self.assets / 'disk.qcow2', self.root / 'existing')
        self.assertEqual(before, head.read_bytes())

    def test_interrupted_update_head_is_repaired_at_the_accepted_floor(self):
        original = self.store.upload

        def fail_signature(key, path, immutable=False):
            if key == 'caddy/x86_64/latest.json.sig':
                raise OSError('power cut')
            original(key, path, immutable)

        with patch.object(self.store, 'upload', side_effect=fail_signature):
            with self.assertRaises(OSError):
                self.publish()
        head = self.root / 'store/caddy/x86_64/current.json'
        accepted = head.read_bytes()
        manifest = self.publish()
        objects = self.root / 'store' / manifest['object']
        before_notes = (objects / 'release-notes.json').read_bytes()
        self.publish()
        self.assertEqual(before_notes, (objects / 'release-notes.json').read_bytes())
        self.assertEqual(accepted, head.read_bytes())
        for name in ('latest.json', 'latest.json.sig'):
            self.assertEqual((self.assets / name).read_bytes(),
                             (self.root / 'store/caddy/x86_64' / name).read_bytes())
        self.assertEqual(self.candidate['serial'], manifest['serial'])

    def test_missing_update_head_cannot_be_an_unchanged_snapshot(self):
        manifest = self.publish()
        head = catalog.envelope(manifest, self.key)
        with patch.object(catalog.urllib.request, 'urlopen', side_effect=[io.BytesIO(head), io.BytesIO(b'wrong head')]):
            self.assertIsNone(catalog.read_public('caddy', 'x86_64', self.cert))
        with patch.object(catalog.urllib.request, 'urlopen', side_effect=[io.BytesIO(head),
                io.BytesIO((self.assets / 'latest.json').read_bytes()),
                io.BytesIO((self.assets / 'latest.json.sig').read_bytes())]):
            self.assertEqual(manifest, catalog.read_public('caddy', 'x86_64', self.cert))

    def test_public_https_verification_rejects_wrong_or_oversized_streams(self):
        expected = catalog.record(self.assets / 'disk.qcow2')
        with patch.object(catalog.urllib.request, 'urlopen', return_value=io.BytesIO(b'wrong')):
            with self.assertRaises(ValueError):
                catalog.verify_public('image', expected)
        with patch.object(catalog.urllib.request, 'urlopen', return_value=io.BytesIO(b'x' * (expected['size'] + 1))):
            with self.assertRaises(ValueError):
                catalog.verify_public('image', expected)

