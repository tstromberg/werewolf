    def test_catalog_signature_rows_and_objects_are_checked(self):
        row = dict(form='caddy', provider='qemu', arch='x86_64', status=catalog.UNGATED, inputs='a' * 64)
        raw = catalog.envelope(dict(format=catalog.FORMAT, forms=[row]), self.key)
        self.assertEqual({('caddy', 'qemu', 'x86_64'): row}, catalog.open_index(raw, self.trust / 'image.crt'))
        changed = json.loads(raw)
        changed['manifest'] = changed['manifest'].replace('caddy', 'nginx')
        with self.assertRaises(subprocess.CalledProcessError):
            catalog.open_index(catalog.encode(changed), self.trust / 'image.crt')
        latest = dict(serial=self.serial, commit='b' * 40, descriptor='d' * 64, size=1,
                      object='nginx/qemu/x86_64/objects/' + 'd' * 64)
        published = dict(row, status=catalog.PUBLISHED, latest=dict(latest, index=2,
                         object='caddy/qemu/x86_64/objects/' + 'd' * 64))
        self.assertEqual(published, catalog.validate(published))
        for bad in [[row, row], [dict(row, provider='lima')], [dict(row, status='\x1b[2J')],
                    [dict(row, latest=latest)], [dict(row, extra=1)],
                    *([dict(published, latest=dict(published['latest'], index=index))]
                      for index in (0, -1, '2', True, None))]:
            with self.assertRaises(ValueError):
                catalog.open_index(catalog.envelope(dict(format=catalog.FORMAT, forms=bad), self.key),
                                   self.trust / 'image.crt')

