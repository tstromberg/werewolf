    def test_candidate_inventory_identity_is_checked_even_when_hashes_match(self):
        for inventory in [dict(self.inventory, form='nginx'), dict(self.inventory, arch='aarch64'),
                          dict(self.inventory, packages=self.inventory['packages'] * 2)]:
