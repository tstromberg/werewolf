class Images(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.temporary = tempfile.TemporaryDirectory(prefix='ww-form-trust-')
        cls.trust = Path(cls.temporary.name)
        cls.key, cls.cert = cls.trust / 'key', cls.trust / 'cert'
        subprocess.run(['openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-x509', '-sha256', '-days', '2',
                        '-subj', '/CN=form-image-tests', '-keyout', cls.key, '-out', cls.cert],
                       check=True, capture_output=True)

    @classmethod
    def tearDownClass(cls):
        cls.temporary.cleanup()

    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='ww-form-images-')
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        self.assets = self.root / 'candidate'
        self.assets.mkdir()
        self.store = catalog.Store(self.root / 'store')
        self.run = 'https://github.com/werewolf-linux/werewolf/actions/runs/123'
        self.candidate = self.make_candidate()
        self.report = dict(format='werewolf-form-tests/1', form='caddy', arch='x86_64', inputs='a' * 64,
                           candidate=catalog.sha(self.assets / 'candidate.json'),
                           checks={name: True for name in catalog.CHECKS})

    def make_candidate(self):
        for name in catalog.ASSETS - {'boot.crt', 'latest.json', 'latest.json.sig'}:
            (self.assets / name).write_bytes(('fixture ' + name).encode())
        shutil.copyfile(self.cert, self.assets / 'boot.crt')
        self.inventory = dict(format=notes.FORMAT, form='caddy', arch='x86_64', packages=[
            dict(scope='runtime', name='caddy', version='2.10.0-r0', checksum='a' * 64),
            dict(scope='runtime', name='removed', version='1-r0', checksum='b' * 64),
            dict(scope='runtime', name='rebuilt', version='1-r0', checksum='c' * 64),
            dict(scope='local', name='local-package', version='1-r0', checksum='d' * 64),
            dict(scope='build:kernel', name='gcc', version='15-r0', checksum='e' * 64),
        ], images=[dict(form='caddy', service='web', ref='example.test/web:latest',
                        digest='example.test/web@sha256:' + 'f' * 64)])
        (self.assets / 'packages.json').write_bytes(catalog.encode(self.inventory))
        serial = '20261015T120000Z'
        slot = dict(format='werewolf-image/1', ipe=True, channel=catalog.PUBLIC + '/caddy',
                    arch='x86_64', serial=serial, boot_context=None,
                    files={n: catalog.record(self.assets / n) for n in
                           ('vmlinuz', 'root.erofs', 'stage0.zst', 'cmdline', 'uki.efi')})
        build = hashlib.sha256()
        for name, entry in slot['files'].items():
            build.update(('%s %s %d\n' % (name, entry['sha256'], entry['size'])).encode())
        slot['build'] = build.hexdigest()
        raw = catalog.encode(slot)
        (self.assets / 'latest.json').write_bytes(raw)
        (self.assets / 'latest.json.sig').write_bytes(catalog.sign(raw, self.key))
        candidate = dict(format='werewolf-form-image/1', profile='uefi-ipe/1', form='caddy', arch='x86_64',
                         serial=serial, inputs='a' * 64, commit='b' * 40,
                         files={n: catalog.record(self.assets / n) for n in catalog.ASSETS})
        (self.assets / 'candidate.json').write_bytes(catalog.encode(candidate))
        return candidate

    def publish(self, report=None, store=None):
        return catalog.publish(self.assets, report or self.report, store or self.store,
                               self.key, self.cert, self.run)

    def advance(self, inventory):
        self.inventory = inventory
        (self.assets / 'packages.json').write_bytes(catalog.encode(inventory))
        slot = json.loads((self.assets / 'latest.json').read_text())
        slot['serial'] = (catalog.serial(slot['serial']) + datetime.timedelta(seconds=1)).strftime('%Y%m%dT%H%M%SZ')
        raw = catalog.encode(slot)
        (self.assets / 'latest.json').write_bytes(raw)
        (self.assets / 'latest.json.sig').write_bytes(catalog.sign(raw, self.key))
        self.candidate = dict(self.candidate, serial=slot['serial'],
                              files={n: catalog.record(self.assets / n) for n in catalog.ASSETS})
        (self.assets / 'candidate.json').write_bytes(catalog.encode(self.candidate))
        self.report['candidate'] = catalog.sha(self.assets / 'candidate.json')

    def test_publication_authenticates_heads_and_keeps_complete_immutable_assets(self):
        manifest = self.publish()
        current = self.root / 'store/caddy/x86_64/current.json'
        self.assertEqual(manifest, catalog.open_head(current.read_bytes(), self.cert, 'caddy', 'x86_64'))
        objects = self.root / 'store' / manifest['object']
        self.assertEqual(catalog.ASSETS | catalog.RELEASE_ASSETS | {'downloads.json', 'downloads.json.sig'},
                         {p.name for p in objects.iterdir()})
        for name, expected in manifest['files'].items():
            self.assertEqual(expected, catalog.record(objects / name))
        catalog.verify_signature((objects / 'downloads.json').read_bytes(),
                                 (objects / 'downloads.json.sig').read_bytes(), self.cert)
        release = json.loads((objects / 'release-notes.json').read_text())
        self.assertIsNone(release['previous'])
        self.assertTrue(all(p['kind'] == 'added' and p['before'] is None for p in release['packages']))
        self.assertIn('Initial published image', (objects / 'release-notes.html').read_text())

    def test_release_notes_compare_packages_with_the_last_passing_release(self):
        previous = self.publish()
        inventory = copy.deepcopy(self.inventory)
        inventory['packages'][0].update(version='2.11.0-r0', checksum='1' * 64)
        inventory['packages'].pop(1)
        inventory['packages'][1]['checksum'] = '2' * 64
        inventory['packages'][2].update(version='2-r0', checksum='3' * 64)
        inventory['packages'][3].update(version='16-r0', checksum='4' * 64)
        inventory['packages'].append(dict(scope='runtime', name='added', version='1-r0', checksum='5' * 64))
        inventory['images'][0]['digest'] = 'example.test/web@sha256:' + '6' * 64
        self.advance(inventory)
        failed = copy.deepcopy(self.report)
        failed['checks']['integration'] = False
        with self.assertRaises(ValueError):
            self.publish(failed)
        self.assertEqual(previous, catalog.open_head((self.root / 'store/caddy/x86_64/current.json').read_bytes(),
                                                   self.cert, 'caddy', 'x86_64'))
        manifest = self.publish()
        objects = self.root / 'store' / manifest['object']
        release = json.loads((objects / 'release-notes.json').read_text())
        changes = {p['name']: p for p in release['packages']}
        self.assertEqual({k: previous[k] for k in ('serial', 'commit', 'object')}, release['previous'])
        self.assertEqual('updated', changes['caddy']['kind'])
        self.assertEqual('2.10.0-r0', changes['caddy']['before']['version'])
        self.assertEqual('2.11.0-r0', changes['caddy']['after']['version'])
        self.assertEqual('rebuilt', changes['rebuilt']['kind'])
        self.assertEqual('removed', changes['removed']['kind'])
        self.assertEqual('added', changes['added']['kind'])
        self.assertEqual('local', changes['local-package']['scope'])
        self.assertEqual('build:kernel', changes['gcc']['scope'])
        self.assertEqual('updated', release['images'][0]['kind'])
        page = (objects / 'release-notes.html').read_text()
        self.assertIn('href="../' + previous['object'].split('/')[-1] + '/release-notes.html"', page)
        self.assertIn('release-notes.html', catalog.page([dict(form='caddy', arch='x86_64', status='published', latest=manifest)]))

    def test_previous_inventory_must_match_its_signed_digest(self):
        previous = self.publish()
        inventory = copy.deepcopy(self.inventory)
        self.advance(inventory)
        before = (self.root / 'store/caddy/x86_64/current.json').read_bytes()
        package_file = self.root / 'store' / previous['object'] / 'packages.json'
        package_file.write_bytes(b'changed')
        with self.assertRaisesRegex(ValueError, 'previous release package inventory'):
            self.publish()
        package_file.unlink()
        with self.assertRaisesRegex(ValueError, 'previous release package inventory'):
            self.publish()
        self.assertEqual(before, (self.root / 'store/caddy/x86_64/current.json').read_bytes())

    def test_source_only_rebuild_has_no_invented_package_changes(self):
        previous = self.publish()
        self.advance(copy.deepcopy(self.inventory))
        self.candidate['commit'] = 'c' * 40
        (self.assets / 'candidate.json').write_bytes(catalog.encode(self.candidate))
        self.report['candidate'] = catalog.sha(self.assets / 'candidate.json')
        manifest = self.publish()
        objects = self.root / 'store' / manifest['object']
        release = json.loads((objects / 'release-notes.json').read_text())
        self.assertEqual([], release['packages'])
        self.assertEqual([], release['images'])
        self.assertEqual(notes.page(release), notes.page(copy.deepcopy(release)))
        self.assertIn('No resolved package or OCI image changes', notes.page(release))
        self.assertIn('/compare/' + previous['commit'] + '...' + self.candidate['commit'], notes.page(release))

