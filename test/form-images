    def test_gated_target_publishes_and_every_target_is_cataloged(self):
        outputs = self.root / 'outputs'
        with patch.dict(os.environ, GITHUB_OUTPUT=str(outputs)):
            failed, listing = self.run_pipeline(self.serial)
        self.assertTrue(failed)  # prod-ssh did not resolve
        self.assertTrue(outputs.read_text().startswith('targets=1\nreleased=true\npublic_targets=0\n'))
        self.assertEqual([], json.loads(outputs.read_text().split('smoke=', 1)[1])['include'])
        self.assertEqual(['playground'], [t['form'] for t in listing])
        rows = self.rows()
        published = rows[('playground', 'qemu', 'x86_64')]
        self.assertEqual(catalog.PUBLISHED, published['status'])
        self.assertEqual(self.serial, published['latest']['serial'])
        self.assertEqual(1, published['latest']['index'])
        self.assertEqual(catalog.NO_RUNNER, rows[('minimal', 'qemu', 'x86_64')]['status'])
        self.assertNotIn('latest', rows[('minimal', 'qemu', 'x86_64')])
        self.assertEqual('resolution failed', rows[('prod-ssh', 'qemu', 'x86_64')]['status'])
        self.assertEqual('unsupported architecture', rows[('minimal', 'lima', 'aarch64')]['status'])
        objects = self.root / 'store' / published['latest']['object']
        signed = json.loads((objects / 'downloads.json').read_text())
        catalog.verify_signature((objects / 'downloads.json').read_bytes(),
                                 (objects / 'downloads.json.sig').read_bytes(), self.trust / 'image.crt')
        for name in images.exporter.EXTRAS | {'disk.qcow2', 'gates.json', 'boot.json'}:
            self.assertEqual(signed['files'][name]['sha256'], catalog.sha(objects / name))
        self.assertIn('Initial published image', (objects / 'release-notes.html').read_text())
        self.assertTrue((self.root / 'store/playground/qemu/x86_64/latest/boot.json').exists())
        self.assertTrue((self.root / 'store/minimal/index.html').exists())
        self.assertIn('playground/qemu/x86_64/objects/', (self.root / 'store/index.html').read_text())

    def test_retry_reuses_signed_exports_and_preserves_immutable_objects(self):
        failed, listing = self.run_pipeline(self.serial, focused=True)
        self.assertFalse(failed)
        work = self.root / ('run-' + self.serial)
        objects = self.root / 'store' / self.rows()[('playground', 'qemu', 'x86_64')]['latest']['object']
        before = {path.name: catalog.sha(path) for path in objects.iterdir()}
        exported = work / 'retry.json'
        with patch.dict(os.environ, GITHUB_RUN_ATTEMPT='2'), \
             patch.object(images.exporter, 'export', side_effect=AssertionError('must reuse the signed export')):
            images.export(work / 'snapshots', work / 'verified', work / 'gated', self.store, work / 'retry-assets', exported)
            failed = images.publish(work / 'snapshots', work / 'verified', {('playground', 'qemu', 'x86_64')},
                                    exported, self.store, focused=True)
        self.assertFalse(failed)
        retried, = json.loads(exported.read_text())
        self.assertEqual(before, {path.name: catalog.sha(path) for path in objects.iterdir()})
        signed = json.loads((Path(retried['assets']) / 'playground-qemu-x86_64-downloads.json').read_text())
        self.assertEqual('1', signed['provenance']['attempt'])

    def test_retry_refuses_damaged_signed_exports(self):
        self.run_pipeline(self.serial, focused=True)
        work = self.root / ('run-' + self.serial)
        objects = self.root / 'store' / self.rows()[('playground', 'qemu', 'x86_64')]['latest']['object']
        for filename in ('downloads.json.sig', 'packages.json'):
            with self.subTest(filename=filename):
                path = objects / filename
                original = path.read_bytes()
                path.write_bytes(b'corrupted')
                try:
                    with contextlib.redirect_stderr(io.StringIO()), patch.dict(os.environ, GITHUB_RUN_ATTEMPT='2'):
                        images.export(work / 'snapshots', work / 'verified', work / 'gated', self.store,
                                      work / ('retry-' + filename), work / 'retry.json')
                    self.assertEqual([], json.loads((work / 'retry.json').read_text()))
                finally:
                    path.write_bytes(original)

    def test_release_notes_compare_with_the_targets_last_publication(self):
        self.run_pipeline(self.serial)
        previous = self.rows()[('playground', 'qemu', 'x86_64')]['latest']
        self.inventory['packages'][0].update(version='1.38-r0', checksum='1' * 64)
        self.inventory['packages'].pop(1)
        later = (datetime.datetime.strptime(self.serial, '%Y%m%dT%H%M%SZ') +
                 datetime.timedelta(seconds=5)).strftime('%Y%m%dT%H%M%SZ')
        self.run_pipeline(later, statuses=dict(minimal='unchanged'))
        rows = self.rows()
        latest = rows[('playground', 'qemu', 'x86_64')]['latest']
        self.assertEqual(later, latest['serial'])
        self.assertEqual(previous['index'] + 1, latest['index'])
        release = json.loads((self.root / 'store' / latest['object'] / 'release-notes.json').read_text())
        self.assertEqual({k: previous[k] for k in ('serial', 'commit', 'object')}, release['previous'])
        changes = {p['name']: p['kind'] for p in release['packages']}
        self.assertEqual(dict(busybox='updated', removed='removed'), changes)
        page = (self.root / 'store' / latest['object'] / 'release-notes.html').read_text()
        self.assertIn('href="../' + previous['descriptor'] + '/release-notes.html"', page)
        # An unchanged target keeps its settled status and the inputs it settled on.
        self.assertEqual(catalog.NO_RUNNER, rows[('minimal', 'qemu', 'x86_64')]['status'])
        self.assertEqual(digest('minimal'), rows[('minimal', 'qemu', 'x86_64')]['inputs'])

