    def test_inventory_uses_only_target_packages_and_stable_content_identities(self):
        snapshot = self.root / 'snapshot/caddy'
        snapshot.mkdir(parents=True)

        def package(name, arch='x86_64', version='1-r0'):
            return dict(name=name, architecture=arch, version=version, checksum='Q1test',
                        data=dict(range='bytes=1-100', checksum='sha256-test'), url='https://example.test/' + name)

        runtime = [package('caddy'), package('other-architecture', arch='aarch64')]
        images.write(snapshot / 'caddy.lock.json', dict(contents=dict(packages=runtime), werewolf=dict(images=[])))
        images.write(snapshot / 'caddy-dev.lock.json', dict(contents=dict(packages=[*runtime, package('busybox')])))
        images.write(snapshot.parent / 'kernel.lock.json', dict(contents=dict(packages=[package('linux-werewolf')])))
        images.write(snapshot.parent / 'stub-builder.lock.json', dict(contents=dict(packages=[package('gcc')])))
        images.write(snapshot / 'melange-local.lock.json', dict(contents=dict(packages=[package('cargo')])))
        images.write(snapshot / 'melange.json', {'forms/caddy/melange/local.yaml': 'melange-local.lock.json'})
        local = [dict(name='local', version='2-r0', checksum='c' * 64)]
        first = notes.inventory(snapshot, 'caddy', 'x86_64', local)
        self.assertEqual({'runtime': ['caddy'], 'test': ['busybox'], 'kernel': ['linux-werewolf'],
                          'build:stub': ['gcc'], 'build:forms/caddy/melange/local.yaml': ['cargo'], 'local': ['local']},
                         {scope: [p['name'] for p in first['packages'] if p['scope'] == scope]
                          for scope in {p['scope'] for p in first['packages']}})
        for path in snapshot.parent.rglob('*.lock.json'):
            lock = json.loads(path.read_text())
            lock['contents']['packages'].reverse()
            for p in lock['contents']['packages']:
                p.update(url='https://mirror.test/' + p['name'])
                p['data']['range'] = 'bytes=10-200'
            images.write(path, lock)
        self.assertEqual(first, notes.inventory(snapshot, 'caddy', 'x86_64', local))

    def test_local_inventory_reads_main_and_subpackage_payload_identities(self):
        snapshot = self.root / 'snapshot'
        snapshot.mkdir()
        images.write(snapshot / 'melange.json', {'forms/example/melange/package.yaml': 'example.lock.json'})
        package_dir = self.root / 'packages'
        (package_dir / 'x86_64').mkdir(parents=True)

        def apk(name, digest, arch='x86_64'):
            metadata = ('pkgname = %s\npkgver = 2-r1\narch = %s\ndatahash = %s\n' %
                        (name, arch, digest)).encode()
            with tarfile.open(package_dir / 'x86_64' / (name + '-2-r1.apk'), 'w:gz') as archive:
                member = tarfile.TarInfo('.PKGINFO')
                member.size = len(metadata)
                archive.addfile(member, io.BytesIO(metadata))

        apk('example', 'a' * 64)
        apk('example-web', 'b' * 64)
        check_output = subprocess.check_output

        def query(args, **kwargs):
            if args[0] == 'melange':
                return 'example-2-r1 example-web-2-r1\n'
            return check_output(args, **kwargs)

        with patch.object(images.subprocess, 'check_output', side_effect=query):
            self.assertEqual([dict(name='example', version='2-r1', checksum='a' * 64),
                              dict(name='example-web', version='2-r1', checksum='b' * 64)],
                             images.local_packages(snapshot, 'x86_64', package_dir))
            apk('example-web', 'c' * 64, arch='aarch64')
            with self.assertRaisesRegex(ValueError, 'wrong architecture'):
                images.local_packages(snapshot, 'x86_64', package_dir)


