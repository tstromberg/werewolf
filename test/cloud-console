#!/usr/bin/env python3
"""Rejoin userspace records interrupted by kernel console messages."""
import re
import sys


def clean(data):
    return re.sub(rb"\[\s*[0-9]+\.[0-9]+\][^\n]*\n", b"", data.replace(b"\r", b""))


if __name__ == '__main__':
    if sys.argv[1:] == ["--test"]:
        wanted = b'posture: fail= pass=90 {"tool":"posture","host":"new-host"}\n'
        split = b'posture: fail= pass=90 {"tool":"posture","[ 5.125] audit: syscall denied\r\nhost":"new-host"}\r\n'
        assert clean(split) == wanted
        assert clean(wanted) == wanted
        assert clean(b'ordinary [1, 2] data\n') == b'ordinary [1, 2] data\n'
        key = b'{"event":"host-key","key":"/run/svc/sshd/host-key","fingerprint":"SHA256:abc123","detail":"kept in /data"}\n'
        split = key.replace(b'abc123', b'abc[    1.551356] audit: type=1423 blockers=fs.write_file path=\r\n123')
        assert clean(split) == key
        print("pass   cloud-console: kernel interleaving preserves complete userspace records")
    else:
        sys.stdout.buffer.write(clean(sys.stdin.buffer.read()))
