#!/usr/bin/env python3
"""Manually enrolled bhyve firmware must reject a changed native UKI."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

from ab_providers import Provider

howl, fixture_path = sys.argv[1:]
fixture = json.loads(Path(fixture_path).read_text())
if fixture['arch'] != 'x86_64' or fixture['mode'] != 'secure':
    sys.exit('bhyve refusal test requires a signed x86_64 fixture')
logs = Path(os.environ.get('CHECK', 'build/ipe-check')) / 'bhyve-secureboot'
logs.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='ww-ab-refused-', dir='/tmp') as temporary:
    work = Path(temporary)
    machine = None
    try:
        raw = work / 'tampered.img'
        subprocess.run(['qemu-img', 'convert', '-f', 'qcow2', '-O', 'raw', fixture['disk'], str(raw)], check=True)
        uki = work / 'uki.efi'
        subprocess.run(['mcopy', '-i', str(raw) + '@@1048576', '::/werewolf/a/uki.efi', str(uki)], check=True)
        data = bytearray(uki.read_bytes())
        data[len(data) // 2] ^= 1
        uki.write_bytes(data)
        subprocess.run(['mcopy', '-o', '-i', str(raw) + '@@1048576', str(uki), '::/werewolf/a/uki.efi'], check=True)
        disk = work / 'tampered.qcow2'
        subprocess.run(['qemu-img', 'convert', '-f', 'raw', '-O', 'qcow2', str(raw), str(disk)], check=True)
        fixture = dict(fixture, disk=str(disk))
        machine = Provider('bhyve', fixture, work, str(Path(howl).resolve()))
        machine.start()
        until = time.monotonic() + 120
        while time.monotonic() < until:
            console = machine.console()
            if 'stage0:' in console or 'handing over to runit' in console:
                raise AssertionError('changed UKI reached stage0')
            if 'access denied' in console.lower() or 'security violation' in console.lower():
                print('pass   bhyve-secureboot: enrolled firmware refused the changed UKI before stage0')
                break
            time.sleep(2)
        else:
            raise AssertionError('missing explicit firmware rejection; see console.raw.log')
    finally:
        try:
            if machine is not None:
                machine.stop()
        finally:
            for path in work.glob('*.log'):
                shutil.copyfile(path, logs / path.name)
