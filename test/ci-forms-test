#!/usr/bin/env python3
"""Exercise inventory coverage and cleanup boundaries without starting guests."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest import mock

ROOT = Path(__file__).resolve().parent.parent

loader = importlib.machinery.SourceFileLoader('ci_forms', str(Path(__file__).with_name('ci-forms')))
spec = importlib.util.spec_from_loader(loader.name, loader)
ci = importlib.util.module_from_spec(spec)
loader.exec_module(ci)


class Coverage(unittest.TestCase):
    def setUp(self):
        self.original = Path.cwd()
        self.temp = tempfile.TemporaryDirectory()
        os.chdir(self.temp.name)
        self.addCleanup(self.restore)
        self.build = Path('build/aarch64')

    def restore(self):
        os.chdir(self.original)
        self.temp.cleanup()

    def write(self, path, data='retained'):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(data)

    def invoke(self, group, fail=None):
        commands = []

        def make(command, **kwargs):
            commands.append(command)
            name = next((t.removeprefix('check-').removeprefix('shellfree-')
                         for t in command if t.startswith('check-')), None)
            if name:
                temporary = (self.build / 'tmp' / name).resolve()
                self.assertEqual(kwargs['env']['TMPDIR'], str(temporary))
                self.write(temporary / 'apko-root/readonly/payload')
                (temporary / 'apko-root/readonly').chmod(0o555)
                self.write(self.build / name / 'slot/root.erofs')
                self.write(self.build / 'oci/layer')
                self.write(self.build / 'check' / (name + '.img'))
            return subprocess.CompletedProcess(command, 7 if name == fail else 0)

        with mock.patch.object(ci.subprocess, 'run', side_effect=make), \
             mock.patch.object(ci.subprocess, 'check_output', return_value='alpha\nbeta\ngamma\n'):
            code = ci.run(group, 'aarch64', '')
        return code, commands

    def test_shards_are_disjoint_and_cover_every_form(self):
        names = ['gamma', 'alpha', 'beta', 'delta', 'epsilon']
        for count in (3, 4):
            shards = [ci.selected(names, str(n) + '/' + str(count)) for n in range(1, count + 1)]
            self.assertEqual(sorted(names), sorted(n for shard in shards for n in shard))
            self.assertEqual(shards[0], sorted(names)[::count])

    def test_invalid_inventory_or_shard_is_rejected(self):
        for names, shard in [([], ''), (['alpha', 'alpha'], ''), (['../outside'], ''),
                             (['alpha'], '2/1'), (['alpha'], '0/3')]:
            with self.assertRaises(ValueError):
                ci.selected(names, shard)

    def test_all_runs_both_targets_and_records_complete_inventory(self):
        code, commands = self.invoke('all')
        self.assertEqual(code, 0)
        for name in ('alpha', 'beta', 'gamma'):
            self.assertTrue(any(c[-2:] == ['check-' + name, 'check-shellfree-' + name] for c in commands))
            self.assertFalse((self.build / name).exists())
            self.assertFalse((self.build / 'tmp' / name).exists())
            self.assertFalse((self.build / 'check' / (name + '.img')).exists())
        result = json.loads((self.build / 'check/ci-forms-all.json').read_text())
        self.assertTrue(result['complete'])
        self.assertEqual(result['inventory'], [r['form'] for r in result['results']])

    def test_failure_keeps_images_and_stops_before_next_form(self):
        code, commands = self.invoke('forms', fail='beta')
        self.assertEqual(code, 7)
        self.assertFalse((self.build / 'alpha').exists())
        self.assertTrue((self.build / 'beta/slot/root.erofs').exists())
        self.assertTrue((self.build / 'oci/layer').exists())
        self.assertTrue((self.build / 'tmp/beta/apko-root/readonly/payload').exists())
        self.assertFalse(any('check-gamma' in c for c in commands))
        result = json.loads((self.build / 'check/ci-forms-forms.json').read_text())
        self.assertFalse(result['complete'])
        self.assertEqual(result['results'][-1]['exit'], 7)

    def test_cleanup_keeps_transcripts_results_and_shared_inputs(self):
        for path in ('check/alpha-native/data.img', 'check/alpha-native/config/data.key',
                     'check/alpha-native/seed.tar', 'check/alpha-native/verify.tar',
                     'check/alpha-native/results.json', 'check/alpha-native/seed.log',
                     'kernel/rootfs.tar', 'programs/init/init', 'minimal/slot/root.erofs'):
            self.write(self.build / path)
        ci.clean(self.build, 'alpha')
        for part in ('results.json', 'seed.log'):
            self.assertTrue((self.build / 'check/alpha-native' / part).exists())
        self.assertFalse((self.build / 'check/alpha-native/data.img').exists())
        for path in ('kernel/rootfs.tar', 'programs/init/init', 'minimal/slot/root.erofs'):
            self.assertTrue((self.build / path).exists())

    def test_cleanup_can_remove_read_only_generated_directories(self):
        path = self.build / 'alpha/rootfs/readonly'
        self.write(path / 'payload')
        path.chmod(0o555)
        ci.clean(self.build, 'alpha')
        self.assertFalse((self.build / 'alpha').exists())

    def test_redirected_temporary_root_is_refused(self):
        outside = Path('outside')
        self.write(outside / 'evidence')
        self.build.mkdir(parents=True)
        (self.build / 'tmp').symlink_to(outside.resolve(), target_is_directory=True)
        with self.assertRaisesRegex(ValueError, 'redirected temporary'):
            self.invoke('all')
        self.assertEqual((outside / 'evidence').read_text(), 'retained')

    def test_cleanup_unlinks_redirect_without_following_it(self):
        outside = Path('outside')
        self.write(outside / 'evidence')
        self.build.mkdir(parents=True)
        (self.build / 'alpha').symlink_to(outside.resolve(), target_is_directory=True)
        ci.clean(self.build, 'alpha')
        self.assertTrue((outside / 'evidence').exists())
        self.assertFalse((self.build / 'alpha').exists())


class PlatformInputs(unittest.TestCase):
    def test_generated_forms_do_not_also_run_unconfigured_base_form(self):
        env = {key: value for key, value in os.environ.items()
               if key not in {'MAKEFLAGS', 'MFLAGS', 'MAKELEVEL', 'GNUMAKEFLAGS', 'MAKEFILES'}}
        for name in ('bastion', 'people'):
            with self.subTest(form=name):
                result = subprocess.run(['make', '-n', 'MAKE=echo', 'check-' + name],
                                        cwd=ROOT, env=env, text=True, capture_output=True, check=True)
                self.assertIn('test/' + name + '-form ', result.stdout)
                self.assertIn('/' + name + '-check image', result.stdout)
                self.assertNotIn('FORM=' + name + ' image', result.stdout)
                self.assertNotIn('FORM=' + name + ' _check-form', result.stdout)

    def test_nodata_reuses_native_prod_disk_without_its_key(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'check/prod-native').mkdir(parents=True)
            (root / 'check/prod-native/data.img').write_bytes(b'LUKS-test-ciphertext')
            (root / 'check/prod-native/data.key').write_bytes(b'must-not-be-passed')
            (root / 'test').mkdir()
            boot = root / 'test/boot'
            boot.write_text('#!/bin/sh\nprintf "%s\\n" "$@" > boot-args\n')
            boot.chmod(0o755)
            env = dict(os.environ, CHECK=str(root / 'check'), OUT='/image',
                       KERNEL='/kernel', CMDLINE='console=ttyS0')
            subprocess.run(['sh', str(ROOT / 'test/check-nodata'), 'qemu'],
                           cwd=root, env=env, check=True)
            self.assertEqual((root / 'check/nodata.img').read_bytes(), b'LUKS-test-ciphertext')
            args = (root / 'boot-args').read_text()
            self.assertIn('nodata.img,format=raw,if=virtio', args)
            self.assertEqual(args.count('-drive'), 1)
            self.assertNotIn('data.key', args)
            self.assertNotIn('prod-native', args)


if __name__ == '__main__':
    unittest.main()
