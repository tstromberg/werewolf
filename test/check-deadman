#!/bin/sh
# check-deadman QEMU... boots minimal's native test image as slot a and
# never commits it (make check-deadman). stage0's deadman, cut to 20 s by
# werewolf.deadman, which it takes from a test image alone, must say why
# and reset the machine, which then ends (test/console.zig, CONSOLE_ENDS).
# No loader is named, so nothing commits. make passes CHECK_ENV (Makefile).
set -eu
d=$CHECK/deadman
rm -rf "$d" "$d.img" && mkdir -p "$d/slot/a"
cp "$OUT/slot/root.erofs" "$d/slot/a/"
mke2fs -q -F -t ext4 -U "$SLOTS" -d "$d" "$d.img" 128M && rm -r "$d"
# Match production's numeric owners instead of the host builder's UID/GID.
for path in /slot /slot/a /slot/a/root.erofs; do
	for field in uid gid; do
		printf 'sif %s %s 0\n' "$path" "$field"
	done
done >"$CHECK/deadman-ownership.debugfs"
"$DEBUGFS" -w -f "$CHECK/deadman-ownership.debugfs" "$d.img" >"$CHECK/deadman-ownership.log" 2>&1
cat >"$CHECK/deadman.checks" <<'EOF'
seen    deadman-taken  stage0: the deadman waits 20s
seen    deadman-says   stage0: slot a did not commit in 20s; rebooting into the last good slot
unseen  powered-off    reboot: Power down
unseen  committed      slot-keep: healthy
EOF
CONSOLE_ENDS=1 CONSOLE_TIMEOUT=180 build/host/console deadman "$CHECK/deadman.checks" \
	"$CHECK/deadman.log" "$@" -kernel "$OUT/slot/vmlinuz" -initrd "$OUT/slot/stage0.zst" \
	-append "$CMDLINE init=/init werewolf.slot=a werewolf.slots=$SLOTS werewolf.deadman=20" \
	-drive "file=$d.img,format=raw,if=virtio"
