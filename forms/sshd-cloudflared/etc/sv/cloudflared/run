#!/bin/sh
# Without a token there is no tunnel to run: park the service rather than
# let runit restart it every second. The token travels in the environment,
# not argv, so it is not in `ps`.
exec 2>&1
token=/run/config/cloudflared/token
if [ ! -r "$token" ]; then
	echo "cloudflared: no $token, staying down"
	exec sv down .
fi
TUNNEL_TOKEN=$(cat "$token")
export TUNNEL_TOKEN
exec /usr/bin/cloudflared --no-autoupdate tunnel run
