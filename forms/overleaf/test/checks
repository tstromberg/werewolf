# The rest is native (tests.yaml). These need what its steps cannot yet
# say: projects compiled from uploads. Overleaf starts slowly, slower
# still emulated, and each check has 180 s: wait, in three windows.
ok  overleaf-wait      e=$(($(date +%s) + 165)); until curl -skf -m 10 -o /dev/null https://localhost/login; do [ "$(date +%s)" -lt $e ] || break; sleep 1; done; true
ok  overleaf-wait-more e=$(($(date +%s) + 165)); until curl -skf -m 10 -o /dev/null https://localhost/login; do [ "$(date +%s)" -lt $e ] || break; sleep 1; done; true
# The attack: the administrator's project, whose main.tex runs a command
# with \write18 and reads a file outside it, compiles to a PDF, served
# through Caddy by clsi's nginx, without either: TeX Live refuses the
# command (shell escape restricted), clsi-confine the file, and no
# file is made.
ok  overleaf-write18   e=$(($(date +%s) + 60)); until curl -skf -m 10 -o /dev/null https://localhost/login; do [ "$(date +%s)" -lt $e ] || { echo "no /login"; exit 1; }; sleep 1; done; rm -f /tmp/ol.jar; t=$(curl -sk -c /tmp/ol.jar -b /tmp/ol.jar https://localhost/login | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p'); [ -n "$t" ] && curl -sk -c /tmp/ol.jar -b /tmp/ol.jar -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"admin@example.com","password":"werewolf-check-pass-1"}' https://localhost/login | grep -q '"redir"' && d=$(mktemp -d) && printf '%s\n' '\documentclass{article}' '\begin{document}' '\immediate\write18{touch pwned-overleaf}' '\IfFileExists{/etc/hostname}{\typeout{werewolf-readable}}{\typeout{werewolf-refused}}' 'werewolf' '\end{document}' >$d/main.tex && (cd $d && zip -q p.zip main.tex) && t=$(curl -sk -b /tmp/ol.jar https://localhost/project | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p') && p=$(curl -sk -b /tmp/ol.jar -H "X-Csrf-Token: $t" -F name=check.zip -F qqfile=@$d/p.zip https://localhost/project/new/upload | sed -n 's/.*"project_id":"\([0-9a-f]*\)".*/\1/p') && [ -n "$p" ] && r=$(curl -sk -m 100 -b /tmp/ol.jar -H "X-Csrf-Token: $t" -H 'Content-Type: application/json' -d '{"draft":false,"check":"silent","incrementalCompilesEnabled":false}' https://localhost/project/$p/compile) && echo "$r" | grep -q '"status":"success"' && echo "$r" | grep -q 'output\.pdf' && u=$(echo "$r" | grep -o '"url":"[^"]*/output\.log"' | cut -d'"' -f4) && l=$(curl -skf -b /tmp/ol.jar "https://localhost$u") && echo "$l" | grep -q 'runsystem(touch pwned-overleaf)\.\.\.disabled' && echo "$l" | grep -q werewolf-refused && [ -z "$(find /data/svc/clsi /run/svc/clsi -name 'pwned-overleaf*' 2>/dev/null)" ]
# Projects are apart: project A, whose secret.tex its main.tex inputs,
# compiles, and its file stays in its compile's directory; project B,
# whose main.tex names that file by path, compiles too, but TeX finds
# nothing there (clsi-confine) and B's log holds nothing of A's.
ok  overleaf-cross-project  e=$(($(date +%s) + 30)); until curl -skf -m 10 -o /dev/null https://localhost/login; do [ "$(date +%s)" -lt $e ] || { echo "no /login"; exit 1; }; sleep 1; done; j=/tmp/ox.jar; rm -f $j; t=$(curl -sk -c $j -b $j https://localhost/login | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p'); [ -n "$t" ] && curl -sk -c $j -b $j -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"admin@example.com","password":"werewolf-check-pass-1"}' https://localhost/login | grep -q '"redir"' && t=$(curl -sk -b $j https://localhost/project | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p') && [ -n "$t" ] && up() { curl -sk -b $j -H "X-Csrf-Token: $t" -F name=$1.zip -F qqfile=@$2 https://localhost/project/new/upload | sed -n 's/.*"project_id":"\([0-9a-f]*\)".*/\1/p'; } && build() { curl -sk -m 70 -b $j -H "X-Csrf-Token: $t" -H 'Content-Type: application/json' -d '{"draft":false,"check":"silent","incrementalCompilesEnabled":false}' https://localhost/project/$1/compile; } && d=$(mktemp -d) && mkdir $d/a $d/b && printf '%s\n' '\documentclass{article}' '\begin{document}' '\input{secret}' '\end{document}' >$d/a/main.tex && echo werewolf-secret-kept-apart >$d/a/secret.tex && (cd $d/a && zip -q ../a.zip main.tex secret.tex) && a=$(up a $d/a.zip) && [ -n "$a" ] && r=$(build $a) && echo "$r" | grep -q '"status":"success"' && u=$(echo "$r" | grep -o '"url":"/project/[0-9a-f]*/user/[0-9a-f]*/' | head -n 1 | cut -d/ -f5) && [ -n "$u" ] && s=/var/lib/overleaf/data/compiles/$a-$u/secret.tex && [ -n "$(find /data/svc/clsi -path "*$s")" ] && printf '%s\n' '\documentclass{article}' '\begin{document}' "\\IfFileExists{$s}{\\typeout{werewolf-leaked}\\input{$s}}{\\typeout{werewolf-kept}}" 'werewolf' '\end{document}' >$d/b/main.tex && (cd $d/b && zip -q ../b.zip main.tex) && b=$(up b $d/b.zip) && [ -n "$b" ] && r=$(build $b) && echo "$r" | grep -q '"status":"success"' && l=$(curl -skf -b $j "https://localhost$(echo "$r" | grep -o '"url":"[^"]*/output\.log"' | cut -d'"' -f4)") && echo "$l" | grep -q werewolf-kept && ! echo "$l" | grep -q -e werewolf-leaked -e werewolf-secret-kept-apart
