# Overleaf answers through Caddy over HTTPS, with a certificate from
# Caddy's own CA for localhost, once overleaf-start has migrated and made
# the administrator. Its ten services start slowly, slower still on an
# emulated machine: wait, in two windows.
ok  overleaf-starting  i=0; until curl -skf -o /dev/null https://localhost/login; do i=$((i + 1)); [ $i -le 170 ] || break; sleep 1; done; true
ok  overleaf-up        i=0; until curl -skf -o /dev/null https://localhost/login; do i=$((i + 1)); [ $i -le 170 ] || { echo "no /login in 340 s"; exit 1; }; sleep 1; done
# The administrator is the config's: it signs in, and reaches the admin
# pages.
ok  overleaf-admin     rm -f /tmp/ol.jar; t=$(curl -sk -c /tmp/ol.jar -b /tmp/ol.jar https://localhost/login | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p'); [ -n "$t" ] && curl -sk -c /tmp/ol.jar -b /tmp/ol.jar -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"admin@example.com","password":"werewolf-check-pass-1"}' https://localhost/login | grep -q '"redir"' && [ "$(curl -sk -b /tmp/ol.jar -o /dev/null -w '%{http_code}' https://localhost/admin)" = 200 ]
# Nobody claims the machine: /launchpad, which makes the first
# administrator, sends a stranger to sign in, and refuses to make one; and
# nobody signs up, as Overleaf takes no registration.
ok  overleaf-no-claim  rm -f /tmp/ev.jar; [ "$(curl -sk -c /tmp/ev.jar -b /tmp/ev.jar -o /dev/null -w '%{http_code} %{redirect_url}' https://localhost/launchpad)" = "302 https://localhost/login" ] && t=$(curl -sk -c /tmp/ev.jar -b /tmp/ev.jar https://localhost/login | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p') && [ -n "$t" ] && c=$(curl -sk -c /tmp/ev.jar -b /tmp/ev.jar -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"evil@example.com","password":"werewolf-evil-pass-1"}' -o /dev/null -w '%{http_code}' https://localhost/launchpad/register_admin) && case $c in 2*) exit 1;; esac && [ "$(curl -sk -c /tmp/ev.jar -b /tmp/ev.jar -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"evil@example.com","password":"werewolf-evil-pass-1"}' -o /dev/null -w '%{http_code}' https://localhost/register)" = 404 ] && ! curl -sk -c /tmp/ev.jar -b /tmp/ev.jar -H 'Content-Type: application/json' -H "X-Csrf-Token: $t" -d '{"email":"evil@example.com","password":"werewolf-evil-pass-1"}' https://localhost/login | grep -q '"redir"'
# Compiles are apart: clsi runs as a user of its own, holding none of the
# secrets Overleaf's services share, which only they may read.
ok  overleaf-apart     o=$(grep '^_oci-overleaf:' /etc/passwd | cut -d: -f3); c=$(grep '^_oci-clsi:' /etc/passwd | cut -d: -f3); [ -n "$o" ] && [ -n "$c" ] && [ "$o" != "$c" ] && [ "$(stat -c %u:%a /data/svc/overleaf/var/lib/overleaf/secrets.json)" = "$o:600" ] && [ "$(stat -c %a /data/svc/overleaf)" = 700 ] && p=$(head -n 1 /run/cgroup/svc/clsi/cgroup.procs) && grep -q "^Uid:[[:space:]]*$c[[:space:]]" /proc/$p/status && ! tr '\0' '\n' </proc/$p/environ | grep -q -e SECRET -e PASSWORD -e MONGO
# The attack: a project whose main.tex runs a command with \write18, and
# reads a file outside it, compiles to a PDF, served through Caddy by
# clsi's nginx, without either: TeX Live refuses the command (shell
# escape restricted) and the file (openin_any p), and no file is made.
ok  overleaf-write18   d=$(mktemp -d) && printf '%s\n' '\documentclass{article}' '\begin{document}' '\immediate\write18{touch pwned-overleaf}' '\IfFileExists{/etc/hostname}{\typeout{werewolf-readable}}{\typeout{werewolf-refused}}' 'werewolf' '\end{document}' >$d/main.tex && (cd $d && zip -q p.zip main.tex) && t=$(curl -sk -b /tmp/ol.jar https://localhost/project | sed -n 's/.*name="ol-csrfToken" content="\([^"]*\)".*/\1/p') && p=$(curl -sk -b /tmp/ol.jar -H "X-Csrf-Token: $t" -F name=check.zip -F qqfile=@$d/p.zip https://localhost/project/new/upload | sed -n 's/.*"project_id":"\([0-9a-f]*\)".*/\1/p') && [ -n "$p" ] && r=$(curl -sk -m 170 -b /tmp/ol.jar -H "X-Csrf-Token: $t" -H 'Content-Type: application/json' -d '{"draft":false,"check":"silent","incrementalCompilesEnabled":false}' https://localhost/project/$p/compile) && echo "$r" | grep -q '"status":"success"' && echo "$r" | grep -q 'output\.pdf' && u=$(echo "$r" | grep -o '"url":"[^"]*/output\.log"' | cut -d'"' -f4) && l=$(curl -skf -b /tmp/ol.jar "https://localhost$u") && echo "$l" | grep -q 'runsystem(touch pwned-overleaf)\.\.\.disabled' && echo "$l" | grep -q werewolf-refused && [ -z "$(find /data/svc/clsi /run/svc/clsi -name 'pwned-overleaf*' 2>/dev/null)" ]
