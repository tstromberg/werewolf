#!/bin/sh
# forms/overleaf/test/config DIR: the overleaf form's config for make
# check, in DIR: its base URL, https://localhost, for which Caddy's own CA
# signs, its administrator, whose password tests.yaml signs in with, and a
# project the compile case uploads. The project's main.tex tries what a
# document should not: a command through \write18, and a read of a file
# outside its own directory. clsi-confine and shell_escape refuse both.
# \pdffiledump reads as \input does but yields nothing when the open is
# refused, where \openin and \input stop TeX; its read of main.tex shows
# that it reads at all.
set -eu
mkdir -p "$1/overleaf" "$1/caddy" "$1/tests/overleaf"
umask 077
printf '%s' werewolf-check-pass-1 >"$1/overleaf/admin-password"
echo '{"base-url":"https://localhost","admin-email":"admin@example.com"}' >"$1/overleaf/settings.json"
echo '{"base-url":"https://localhost"}' >"$1/caddy/settings.json"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cat >"$work/main.tex" <<'TEX'
\documentclass{article}
\begin{document}
\immediate\write18{touch pwned-overleaf}
\edef\own{\pdffiledump length 16 {main.tex}}
\ifx\own\empty\else\typeout{werewolf-own-read}\fi
\edef\leak{\pdffiledump length 64 {/etc/hostname}}
\ifx\leak\empty
  \typeout{werewolf-outside-refused}
\else
  \typeout{werewolf-outside-read=\leak}
\fi
werewolf
\end{document}
TEX
zip -q -X -j "$1/tests/overleaf/project.zip" "$work/main.tex"
