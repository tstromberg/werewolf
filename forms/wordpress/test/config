#!/bin/sh
# forms/wordpress/test/config DIR: the wordpress form's config for make check, in
# DIR, as an operator would make one (forms/wordpress/README.md): the site's
# address and name, its admin, and the admin's bcrypt password hash, of
# "werewolf-check", which forms/wordpress/test/checks logs in with; no mail
# relay, so mail is off and says so.
set -eu
d=$1/wordpress
mkdir -p "$d"
umask 077
printf '%s' '$2y$10$nWqdaG5ayjvw7wEKz/savO5m4DJl9OSz9aeKEdKl.e05GIwwFAzIq' >"$d/admin-password-hash"
echo '{"url":"http://localhost","title":"werewolf check site","admin-user":"admin","admin-email":"admin@example.test"}' >"$d/settings.json"
