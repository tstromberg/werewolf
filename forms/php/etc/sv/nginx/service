# nginx, as its own user: it may bind :80 and no other port, read its
# configuration and the image, connect to php-fpm's socket, and run only
# itself.
exec    /usr/bin/nginx -e stderr
before  /usr/bin/nginx -e stderr -t -q
user    nginx
pledge  stdio rpath wpath proc unix inet listen connect aio sendfile
listen  tcp/80
read    /etc/nginx
