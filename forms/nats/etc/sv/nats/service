# nats-server, as its own user: it may bind :4222, and :8222 on loopback
# for monitoring (which fence lets no one outside reach), read its
# configuration and the image, and write only its own directories. It
# reaches nothing on the network. Its certificate, key and the users'
# file come from the machine's config: missing, the service parks with a
# line naming the file.
exec    /usr/bin/nats-server -c /etc/nats/nats-server.conf
user    nats
pledge  stdio rpath wpath inet unix listen proc
listen  tcp/4222 tcp/8222
read    /etc/nats
config  tls-cert /run/config/nats/tls.crt
config  tls-key /run/config/nats/tls.key
config  users /run/config/nats/users.conf
memory  512
nofile  65536
env     HOME=/run/svc/nats
env     GOMEMLIMIT=384MiB
