# OpenBao, as its own user: it may bind :8200, and :8201 on loopback for
# raft's cluster listener, which fence lets no one outside reach; read
# its configuration and the image; and write only its own directories,
# raft's storage being /data/svc/openbao itself. It reaches nothing on
# the network.
exec    /usr/bin/bao server -config=/run/svc/openbao/config.json -config=/etc/openbao/openbao.hcl
user    openbao
pledge  stdio rpath wpath inet unix connect listen proc
listen  tcp/8200 tcp/8201
read    /etc/openbao
# The unseal key (32 random bytes), the API's certificate and key, and
# the admin's first password, from the machine's config: missing, the
# service parks with a line naming the file.
config  unseal-key /run/config/openbao/unseal.key
config  tls-cert /run/config/openbao/tls.crt
config  tls-key /run/config/openbao/tls.key
config  admin-password /run/config/openbao/admin_password
# The address clients reach it at, into the image's configuration.
config  settings /run/config/openbao/settings.json
setting api-addr url required as api_addr
setting unseal-key-id string as seal.static.current_key_id
render  json config.json from /etc/openbao/config.json
memory  768
nofile  65536
env     HOME=/run/svc/openbao
env     GOMEMLIMIT=512MiB
