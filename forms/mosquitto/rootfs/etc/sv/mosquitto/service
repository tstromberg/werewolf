# Mosquitto, as its own user: it may bind :8883 and no other port, read
# its configuration and the image, and write only its own directories.
# It reaches nothing on the network. Its certificate, users and ACLs come
# from the machine's config: missing, the service parks with a line
# naming the file.
exec    /usr/bin/mosquitto -c /etc/mosquitto/mosquitto.conf
user    mosquitto
pledge  stdio rpath wpath inet unix listen proc
listen  tcp/8883
read    /etc/mosquitto
config  tls-cert /run/config/mosquitto/tls.crt
config  tls-key /run/config/mosquitto/tls.key
config  passwords /run/config/mosquitto/passwords
config  acls /run/config/mosquitto/acls
memory  128
nofile  4096
