#!/bin/sh
# forms/mosquitto/test/config DIR: the mosquitto form's config for make check, in
# DIR: a certificate for localhost, a user check with the password
# werewolf-check (hashed as mosquitto_passwd hashes it, PBKDF2-SHA512)
# allowed test/# alone, and a user other allowed nothing.
set -eu
d=$1/mosquitto
mkdir -p "$d"
umask 077
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 30 \
	-subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' \
	-keyout "$d/tls.key" -out "$d/tls.crt" 2>/dev/null
python3 -I - "$d/passwords" <<'PY'
import base64, hashlib, os, sys
def entry(user, password):
	salt = os.urandom(12)
	dk = hashlib.pbkdf2_hmac('sha512', password.encode(), salt, 101, dklen=64)
	return '%s:$7$101$%s$%s' % (user, base64.b64encode(salt).decode(), base64.b64encode(dk).decode())
open(sys.argv[1], 'w').write(entry('check', 'werewolf-check') + '\n' + entry('other', 'werewolf-other') + '\n')
PY
printf 'user check\ntopic readwrite test/#\n' >"$d/acls"
