#!/bin/sh
# forms/mosquitto/test/config DIR: the mosquitto form's config for make check, in
# DIR: a certificate for localhost, a user check with the password
# werewolf-check (hashed as mosquitto_passwd hashes it, PBKDF2-SHA512)
# allowed test/# alone, other allowed other/#, and admin seeds the forbidden
# retained message and checks delivery order across all three scopes.
set -eu
d=$1/mosquitto
mkdir -p "$d"
umask 077
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 30 \
	-subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' \
	-keyout "$d/tls.key" -out "$d/tls.crt" 2>/dev/null
# passwords holds each user's PBKDF2-SHA512 hash, as mosquitto_passwd writes it.
cp "${0%/*}/passwords" "$d/passwords"
printf 'user check\ntopic readwrite test/#\nuser other\ntopic readwrite other/#\nuser admin\ntopic readwrite admin/#\ntopic read test/#\ntopic read other/#\n' >"$d/acls"
