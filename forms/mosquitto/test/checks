# Mosquitto takes a message from a user and delivers it to that user's
# subscriber, over TLS, and refuses anonymous clients, a wrong password,
# plain MQTT, and topics the ACL does not allow; its keys and passwords
# are the broker's alone, 0600, and its state is on /data.
ok  mqtt-user        p=$(head -n 1 /run/cgroup/svc/mosquitto/cgroup.procs); u=$(grep '^mosquitto:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  mqtt-round-trip  c='-h localhost -p 8883 --cafile /run/config/mosquitto/tls.crt'; i=0; until mosquitto_pub $c -u check -P werewolf-check -t test/ping -m ready 2>/dev/null; do i=$((i + 1)); [ $i -le 60 ] || { echo "no broker"; exit 1; }; sleep 1; done; mosquitto_sub $c -u check -P werewolf-check -t test/x -C 1 -W 10 >/tmp/mqtt.out & sleep 1; mosquitto_pub $c -u check -P werewolf-check -t test/x -m hello; wait; [ "$(cat /tmp/mqtt.out)" = hello ]
ok  mqtt-no-anonymous c='-h localhost -p 8883 --cafile /run/config/mosquitto/tls.crt'; mosquitto_pub $c -t test/x -m x 2>&1 | grep -qi 'not authori'
ok  mqtt-wrong-password c='-h localhost -p 8883 --cafile /run/config/mosquitto/tls.crt'; mosquitto_pub $c -u check -P wrong -t test/x -m x 2>&1 | grep -qi 'not authori'
ok  mqtt-tls-only    ! netstat -ltn | grep -q ':1883 ' && ! mosquitto_pub -h localhost -p 8883 -u check -P werewolf-check -t test/x -m x 2>/dev/null
ok  mqtt-acl         c='-h localhost -p 8883 --cafile /run/config/mosquitto/tls.crt'; mosquitto_sub $c -u check -P werewolf-check -t 'admin/#' -C 1 -W 4 >/tmp/mqtt.acl 2>&1 & sleep 1; mosquitto_pub $c -u check -P werewolf-check -t admin/x -m leaked 2>/dev/null; wait; ! grep -q leaked /tmp/mqtt.acl && ! mosquitto_pub $c -u other -P werewolf-other -t test/x -m x 2>/dev/null; mosquitto_sub $c -u other -P werewolf-other -t 'test/#' -C 1 -W 4 >/tmp/mqtt.other 2>&1 & sleep 1; mosquitto_pub $c -u check -P werewolf-check -t test/x -m secret; wait; ! grep -q secret /tmp/mqtt.other
ok  mqtt-private     [ "$(stat -c '%u:%a' /run/svc/mosquitto/tls-key)" = "$(grep '^mosquitto:' /etc/passwd | cut -d: -f3):600" ] && [ "$(stat -c '%u:%a' /run/svc/mosquitto/passwords)" = "$(grep '^mosquitto:' /etc/passwd | cut -d: -f3):600" ] && [ -d /data/svc/mosquitto ]
