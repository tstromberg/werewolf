# Fixed policy precedes all configurable authentication settings.
ForceCommand export-v1
AllowUsers root
DisableForwarding yes
PermitTTY no
PermitUserRC no
PermitUserEnvironment no
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
PermitTunnel no
Compression no
PrintMotd no
Banner none
Include /etc/ssh/sshd_config.d/form.conf
Include /etc/ssh/sshd_config.d/werewolf.conf
