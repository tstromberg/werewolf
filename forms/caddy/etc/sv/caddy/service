# Caddy, as its own user: it may bind :80 and :443 and no other port,
# reach the ACME CA over HTTPS and a resolver over TCP (UDP is not a
# port Landlock names; fence holds it to 53), read its configuration and
# the site, and write only its own directories. The site's name comes
# from the machine's settings as DOMAIN, which the Caddyfile reads;
# without one it is :80, plain HTTP.
exec    /usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
before  /usr/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
user    caddy
pledge  stdio rpath wpath inet unix connect listen proc
listen  tcp/80 tcp/443
connect tcp/443 tcp/53
read    /etc/caddy /usr/share/caddy
config  settings /run/config/caddy/settings.json
setting domain hostname as DOMAIN
render  env site
memory  512
nofile  65536
# Certificates and the ACME account in /data; the running config's
# autosave, which Caddy insists on writing, in /run.
env     XDG_DATA_HOME=/data/svc/caddy
env     XDG_CONFIG_HOME=/run/svc/caddy
env     HOME=/run/svc/caddy
env     GOMEMLIMIT=384MiB
