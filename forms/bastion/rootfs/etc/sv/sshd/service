exec    /usr/bin/sshd -D -e -f /etc/ssh/sshd_config
user    bastion
pledge  stdio rpath wpath inet unix listen connect proc exec seccomp
listen  tcp/22
connect tcp/22
read    /etc/ssh
run     /usr/lib/ssh/sshd-auth /usr/lib/ssh/sshd-session /usr/bin/ssh-keygen
# Its host key, made on the first boot and kept in /data; without /data
# it stays down rather than change identity each boot.
before  /usr/lib/werewolf/ssh-host-key /data/svc/sshd/host-key
config  authorized-keys /run/config/bastion/authorized_keys
# Where it may forward to: sshd_config includes these before its PermitOpen none.
config  settings /run/config/bastion/settings.json
setting destinations addrport... as PermitOpen
render  conf destinations
memory  256
nofile  1024
