# SFTPGo, as its own user: it may bind :22 and no other port, read its
# configuration and the image, and write only its own directories, where
# its users' files, its database and its host key are. Before each start
# it loads the users the config brings, adding and updating, never
# removing: a user gone from the config is removed by a new config that
# says so (docs/sftpgo.md).
exec    /usr/bin/sftpgo serve --config-dir /etc/sftpgo --config-file sftpgo.json --log-file-path "" --log-level info
before  /usr/bin/sftpgo initprovider --config-dir /etc/sftpgo --config-file sftpgo.json --loaddata-from /run/svc/sftpgo/users --loaddata-mode 0
user    sftpgo
pledge  stdio rpath wpath inet unix listen proc
listen  tcp/22
read    /etc/sftpgo
config  users /run/config/sftpgo/users.json
memory  512
nofile  4096
env     HOME=/run/svc/sftpgo
env     GOMEMLIMIT=384MiB
