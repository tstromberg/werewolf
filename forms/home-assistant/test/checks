# Home Assistant answers through Caddy over HTTPS, with a certificate from
# Caddy's own CA for localhost, once it has started: a first start takes
# a while, so wait. It runs as its image's user, without capabilities.
ok  ha-user          p=$(head -n 1 /run/cgroup/svc/home-assistant/cgroup.procs); u=$(grep '^_oci-home-assistant:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  ha-up            i=0; until wget -q -T 5 --no-check-certificate -O /tmp/ha-front.html https://localhost/ && grep -q '<title>Home Assistant</title>' /tmp/ha-front.html; do i=$((i + 1)); [ $i -le 120 ] || { echo "no frontend in 120 s"; exit 1; }; sleep 1; done
# These are declared LAN listeners, so the shared listener check applies.
ok  ha-discovery-policy u=$(grep '^_oci-home-assistant:' /etc/passwd | cut -d: -f3); for p in 5353 1900; do grep -qx "listen $u udp $p lan" /usr/share/werewolf/net && grep -qx "connect $u udp $p lan" /usr/share/werewolf/net || exit 1; done
# A real legacy-unicast mDNS query for Home Assistant's advertised service.
# The query's id is 0x1234; require a response, not an echoed question.
ok  ha-mdns-answer   i=0; until { printf '\022\064\000\000\000\001\000\000\000\000\000\000\017_home-assistant\004_tcp\005local\000\000\014\000\001' | timeout 2 nc -u -w 1 10.0.2.15 5353 >/tmp/ha-mdns.reply; od -An -tx1 -N4 /tmp/ha-mdns.reply | grep -q '12 34 84 00' && grep -aq '_home-assistant' /tmp/ha-mdns.reply; }; do i=$((i + 1)); [ $i -lt 30 ] || { echo "no Home Assistant mDNS response"; exit 1; }; sleep 1; done
ok  ha-discovery-groups grep -q 'FB0000E0' /proc/net/igmp && grep -q 'FAFFFFEF' /proc/net/igmp
# Home Assistant itself listens on loopback alone.
ok  ha-loopback      ! grep -q ':1FBB 00000000:0000 0A' /proc/net/tcp6 && grep -q '0100007F:1FBB 00000000:0000 0A' /proc/net/tcp && ! grep -q '00000000:1FBB 00000000:0000 0A' /proc/net/tcp
# Completed onboarding is not registered as an HTTP endpoint. Verify the
# state too, so an unrelated 404 cannot stand in for completed setup.
ok  ha-onboarded     wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/api/onboarding 2>&1 | grep -q 'HTTP/1.1 404' && for s in user core_config analytics integration; do grep -q "\"$s\"" /data/svc/home-assistant/.storage/onboarding || exit 1; done
# HTTP is stable image policy, not a trial that reverts after five minutes.
ok  ha-http-stable   f=/data/svc/home-assistant/.storage/http; grep -Eq '"pending":[[:space:]]*null' $f && grep -Eq '"yaml_migration_done":[[:space:]]*true' $f && grep -Eq '"use_x_forwarded_for":[[:space:]]*true' $f && grep -q '127.0.0.1/32' $f
# The API answers no one without a token.
ok  ha-api-locked    wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/api/ 2>&1 | grep -q 'HTTP/1.1 401'
# The owner logs in with the config's password, gets a token, and the API
# answers it; the location is the settings', and network discovery is loaded.
ok  ha-login         c=https://localhost/; f=$(wget -q -T 10 --no-check-certificate -O - --header 'Content-Type: application/json' --post-data "{\"client_id\":\"$c\",\"handler\":[\"homeassistant\",null],\"redirect_uri\":\"$c?auth_callback=1\"}" ${c}auth/login_flow | sed -n 's/.*"flow_id":"\([0-9a-zA-Z]*\)".*/\1/p') && [ -n "$f" ] && r=$(wget -q -T 30 --no-check-certificate -O - --header 'Content-Type: application/json' --post-data "{\"client_id\":\"$c\",\"username\":\"owner\",\"password\":\"werewolf-check-owner\"}" ${c}auth/login_flow/$f | sed -n 's/.*"result":"\([0-9a-zA-Z]*\)".*/\1/p') && [ -n "$r" ] && wget -q -T 10 --no-check-certificate -O /tmp/ha.token --post-data "grant_type=authorization_code&code=$r&client_id=$c" ${c}auth/token && t=$(sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p' /tmp/ha.token) && wget -q -T 5 --no-check-certificate -O - --header "Authorization: Bearer $t" ${c}api/ | grep -q 'API running' && wget -q -T 5 --no-check-certificate -O /tmp/ha.config --header "Authorization: Bearer $t" ${c}api/config && grep -q '"time_zone":"Europe/Berlin"' /tmp/ha.config && grep -q '"country":"DE"' /tmp/ha.config && grep -q '"zeroconf"' /tmp/ha.config && grep -q '"ssdp"' /tmp/ha.config && grep -q '"network"' /tmp/ha.config && ! grep -Eq '"(dhcp|bluetooth|usb)"' /tmp/ha.config
# A wrong password gets no code.
ok  ha-wrong-password c=https://localhost/; f=$(wget -q -T 10 --no-check-certificate -O - --header 'Content-Type: application/json' --post-data "{\"client_id\":\"$c\",\"handler\":[\"homeassistant\",null],\"redirect_uri\":\"$c?auth_callback=1\"}" ${c}auth/login_flow | sed -n 's/.*"flow_id":"\([0-9a-zA-Z]*\)".*/\1/p') && [ -n "$f" ] && wget -q -T 30 --no-check-certificate -O - --header 'Content-Type: application/json' --post-data "{\"client_id\":\"$c\",\"username\":\"owner\",\"password\":\"wrong-password-1\"}" ${c}auth/login_flow/$f | grep -q 'invalid_auth'
# The owner is the one home-assistant-setup made; its files are the
# service's alone, and leash's copy of the password is gone.
ok  ha-private       u=$(grep '^_oci-home-assistant:' /etc/passwd | cut -d: -f3); d=/data/svc/home-assistant; grep -q '"is_owner": true' $d/.storage/auth && [ "$(stat -c '%u:%a' $d)" = "$u:700" ] && [ "$(stat -c '%u:%a' $d/.storage/auth_provider.homeassistant)" = "$u:600" ] && [ ! -e /run/svc/home-assistant/owner-password ]
# The attack: a visitor, as the first one to reach a new Home Assistant,
# tries to make themselves its owner through onboarding, and is refused.
ok  ha-onboarding-closed wget -q -T 10 --no-check-certificate -S -O /dev/null --header 'Content-Type: application/json' --post-data '{"client_id":"https://localhost/","name":"Mallory","username":"mallory","password":"mallory-password-1","language":"en"}' https://localhost/api/onboarding/users 2>&1 | grep -Eq 'HTTP/1.1 (403|404)' && ! grep -q mallory /data/svc/home-assistant/.storage/auth_provider.homeassistant
