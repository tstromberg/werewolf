# Caddy, as its own user, for Mastodon: it may bind :80 and :443 and no
# other port, reach the ACME CA over HTTPS and a resolver over TCP, Puma
# and the streaming server on loopback, read its configuration, the image
# and Mastodon's media, and write only its own directories. The domain
# comes from the machine's settings, the same --domain Mastodon's web
# takes, as DOMAIN, which the Caddyfile reads.
exec    /usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
before  /usr/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
user    caddy
pledge  stdio rpath wpath inet unix connect listen proc
listen  tcp/80 tcp/443
connect tcp/443 tcp/53 tcp/3000 tcp/4000
read    /etc/caddy /data/svc/mastodon/system
config  settings /run/config/caddy/settings.json
setting domain hostname as DOMAIN
render  env site
memory  512
nofile  65536
env     XDG_DATA_HOME=/data/svc/caddy
env     XDG_CONFIG_HOME=/run/svc/caddy
env     HOME=/run/svc/caddy
env     GOMEMLIMIT=384MiB
