# Mastodon's jobs, Sidekiq, as mastodon-jobs, of the web's group: federation in and out, mail,
# remote media and link previews. It reaches public addresses only
# (form.yaml), its database and queue by their sockets, and the media
# nginx serves. What Paperclip runs on a stranger's media, through
# /bin/sh, runs by its narrow link: no network, its own pledge, the media
# alone.
exec    /usr/bin/ruby -C /usr/lib/mastodon /usr/bin/bundle exec sidekiq -c 5
user    mastodon-jobs
# Valkey's group, for its socket.
group   valkey
# netlink: glibc's resolver lists the host's addresses before a lookup.
pledge  stdio rpath wpath inet unix netlink connect proc exec landlock seccomp
connect tcp/443 tcp/80 tcp/587 tcp/53 /run/svc/postgres/.s.PGSQL.5432 /run/svc/valkey/valkey.sock
# Its secrets, which the web's secrets.rb made (/usr/lib/mastodon/.env.production).
read    /data/svc/mastodon/env
write   /data/svc/mastodon/system
run     /usr/bin/file /usr/bin/ffprobe /usr/bin/ffmpeg
narrow  /usr/bin/file pledge stdio rpath
narrow  /usr/bin/file read /data/svc/mastodon-jobs /data/svc/mastodon/system
narrow  /usr/bin/ffprobe pledge stdio rpath proc
narrow  /usr/bin/ffprobe read /data/svc/mastodon-jobs /data/svc/mastodon/system
narrow  /usr/bin/ffmpeg pledge stdio rpath wpath proc
narrow  /usr/bin/ffmpeg read /data/svc/mastodon-jobs /data/svc/mastodon/system
narrow  /usr/bin/ffmpeg write /data/svc/mastodon-jobs
narrow  /usr/bin/ffmpeg memory 512
memory  1024
# Background work: half a share of contended CPUs, so a federation flood
# cannot starve the web or nginx.
cpu     50
env     RAILS_ENV=production
env     BUNDLE_GEMFILE=/usr/lib/mastodon/Gemfile
env     RAILS_LOG_LEVEL=warn
env     DB_HOST=/run/svc/postgres
env     DB_PORT=5432
env     DB_USER=mastodon-jobs
env     DB_NAME=mastodon
env     REDIS_URL=unix:///run/svc/valkey/valkey.sock
env     PAPERCLIP_ROOT_PATH=/data/svc/mastodon/system
env     PAPERCLIP_ROOT_URL=/system
env     TMPDIR=/data/svc/mastodon-jobs
env     HOME=/run/svc/mastodon-jobs
env     BOOTSNAP_READONLY=true
env     MALLOC_CONF=narenas:2,background_thread:true,thp:never,dirty_decay_ms:1000,muzzy_decay_ms:0
env     PATH=/etc/sv/mastodon-jobs/narrow:/usr/bin
env     FFMPEG_BINARY=/etc/sv/mastodon-jobs/narrow/ffmpeg
env     FFPROBE_BINARY=/etc/sv/mastodon-jobs/narrow/ffprobe
