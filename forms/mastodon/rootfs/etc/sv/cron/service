# supercronic, as mastodon-cron, of the web's group, starts Mastodon's cleanup on its schedule
# (etc/cron/crontab): tootctl, through sh-shim, under this leash. It reads
# Mastodon's secrets, reaches its database and queue by their sockets,
# and removes the media it no longer keeps; it reaches nothing else.
exec    /usr/bin/supercronic -json -no-reap /etc/cron/crontab
user    mastodon-cron
# Valkey's group, for its socket.
group   valkey
pledge  stdio rpath wpath unix connect proc exec
connect /run/svc/postgres/.s.PGSQL.5432 /run/svc/valkey/valkey.sock
run     /usr/bin/ruby
read    /etc/cron /data/svc/mastodon/env
write   /data/svc/mastodon/system
memory  768
cpu     25
env     RAILS_ENV=production
env     BUNDLE_GEMFILE=/usr/lib/mastodon/Gemfile
env     RAILS_LOG_LEVEL=warn
env     DB_HOST=/run/svc/postgres
env     DB_PORT=5432
env     DB_USER=mastodon-cron
env     DB_NAME=mastodon
env     REDIS_URL=unix:///run/svc/valkey/valkey.sock
env     PAPERCLIP_ROOT_PATH=/data/svc/mastodon/system
env     PAPERCLIP_ROOT_URL=/system
env     HOME=/run/svc/cron
env     BOOTSNAP_READONLY=true
