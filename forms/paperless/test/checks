# Paperless answers through Caddy over HTTPS, with a certificate from
# Caddy's own CA for localhost, once its migrations have run and its
# administrator is made: wait.
ok  pl-up            i=0; until wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/ 2>&1 | grep -q 'HTTP/1.1 302'; do i=$((i + 1)); [ $i -le 180 ] || { echo "no login redirect in 180 s"; exit 1; }; sleep 1; done
# Plain HTTP is sent to HTTPS.
ok  pl-https         wget -q -T 5 -S -O /dev/null http://localhost/ 2>&1 | grep -qi 'Location: https://localhost/'
# A stranger gets no document list. Sign-up has no password field.
ok  pl-anon          code=$(curl -sk -o /dev/null -w '%{http_code}' https://localhost/api/documents/); [ "$code" = 401 ] || [ "$code" = 403 ]
ok  pl-signup        body=$(curl -sfk https://localhost/accounts/signup/) || { echo "signup did not answer"; exit 1; }; printf '%s' "$body" | grep -q 'name="password1"' && { echo "signup is open"; exit 1; }; true
# A wrong password gets no token. The administrator, the config's, does,
# and the document list answers with it.
ok  pl-wrong         [ "$(curl -sk -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d '{"username":"admin","password":"wrong"}' https://localhost/api/token/)" = 400 ]
ok  pl-login         curl -sfk -H 'Content-Type: application/json' -d '{"username":"admin","password":"werewolf-check-password"}' https://localhost/api/token/ | grep -o '"token":"[^"]*"' | cut -d'"' -f4 >/tmp/pl-token && [ -s /tmp/pl-token ] && curl -sfk -H "Authorization: Token $(cat /tmp/pl-token)" https://localhost/api/documents/ | grep -q '"count"'
# The library is on /data, and paperless's.
ok  pl-data          u=$(grep '^paperless:' /etc/passwd | cut -d: -f3); [ "$(stat -c %u /data/svc/paperless)" = "$u" ]

# PostgreSQL is local and Paperless has one peer-authenticated identity.
ok  pl-postgres ps=$(chpst -u postgres psql -h /run/svc/postgres -d postgres -Atc "SELECT count(*) FROM paperless.django_migrations"); [ "$ps" -gt 0 ] && [ ! -e /data/svc/paperless/db.sqlite3 ]
ok  pl-shared-user for s in paperless paperless-consumer paperless-worker paperless-beat; do p=$(head -n 1 "/run/cgroup/svc/$s/cgroup.procs"); u=$(id -u paperless); grep -q "^Uid:[[:space:]]*$u[[:space:]]" "/proc/$p/status" && grep -q '^shared-user true$' "/etc/sv/$s/service" || exit 1; done
ok  pl-peer-refusal ! chpst -u caddy psql -h /run/svc/postgres -U paperless -d postgres -c 'SELECT 1' >/tmp/pl-peer-refusal 2>&1
ok  pl-no-preload ! grep -q 'LD_PRELOAD' /etc/sv/paperless/service /etc/sv/paperless-consumer/service /etc/sv/paperless-worker/service /etc/sv/paperless-beat/service && [ ! -e /usr/lib/werewolf/paperless-group.so ]
ok  pl-no-tcp ! netstat -lnt | grep -q ':5432 '

# Exercise an application write through the web process and its task worker.
ok  pl-document-upload printf 'Werewolf PostgreSQL integration document.\n' >/tmp/pl-document.txt; curl -sfk -H "Authorization: Token $(cat /tmp/pl-token)" -F document=@/tmp/pl-document.txt -F title=werewolf-postgres-check https://localhost/api/documents/post_document/ >/tmp/pl-upload && [ -s /tmp/pl-upload ]
ok  pl-document-worker i=0; until curl -sfk -H "Authorization: Token $(cat /tmp/pl-token)" 'https://localhost/api/documents/?title__iexact=werewolf-postgres-check' | grep -q '"count":1'; do i=$((i + 1)); [ "$i" -le 90 ] || { cat /tmp/pl-upload; exit 1; }; sleep 1; done
ok  pl-no-oom for s in paperless paperless-consumer paperless-worker paperless-beat; do grep -qx 'oom_kill 0' "/run/cgroup/svc/$s/memory.events" || exit 1; done
