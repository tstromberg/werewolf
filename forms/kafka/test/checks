# Kafka answers once kafka-setup has formatted its log directory, to the
# admin over TLS and SCRAM-SHA-512. Its clients here are Kafka's own,
# java run directly as the service runs it, from /tmp/kafka.sh; each
# user's login is a properties file trusting the test's certificate.
ok  kafka-up          printf '%s\n' 'exec java -Xmx96m -XX:-UsePerfData -XX:TieredStopAtLevel=1 -Dlog4j2.configurationFile=/usr/lib/kafka/config/tools-log4j2.yaml -cp "/usr/lib/kafka/libs/*" "$@"' >/tmp/kafka.sh; t='ssl.truststore.type=PEM\nssl.truststore.location=/run/config/kafka/tls.crt\n'; printf "security.protocol=SSL\n$t" >/tmp/kafka-anon.properties; for u in ops:admin ops:wrong-password app:app stranger:stranger; do n=${u%%:*}; p=werewolf-check-${u#*:}; f=/tmp/kafka-$n.properties; [ ${u#*:} = wrong-password ] && f=/tmp/kafka-wrong.properties; printf "security.protocol=SASL_SSL\nsasl.mechanism=SCRAM-SHA-512\nsasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username=\"$n\" password=\"$p\";\n$t" >$f; done; i=0; until sh /tmp/kafka.sh org.apache.kafka.tools.TopicCommand --bootstrap-server localhost:9093 --command-config /tmp/kafka-ops.properties --list >/dev/null 2>&1; do i=$((i + 1)); [ $i -le 60 ] || { echo "no broker in 60 tries"; exit 1; }; sleep 2; done
# The admin makes a topic and lets app produce to it and consume it, in
# the group check; app's message comes back.
ok  kafka-acl-user    k='sh /tmp/kafka.sh'; b='--bootstrap-server localhost:9093'; $k org.apache.kafka.tools.TopicCommand $b --command-config /tmp/kafka-ops.properties --create --topic orders --partitions 1 --replication-factor 1 >/dev/null && $k org.apache.kafka.tools.AclCommand $b --command-config /tmp/kafka-ops.properties --add --allow-principal User:app --producer --topic orders >/dev/null && $k org.apache.kafka.tools.AclCommand $b --command-config /tmp/kafka-ops.properties --add --allow-principal User:app --consumer --topic orders --group check >/dev/null && echo werewolf-order | $k org.apache.kafka.tools.ConsoleProducer $b --topic orders --command-config /tmp/kafka-app.properties && [ "$($k org.apache.kafka.tools.consumer.ConsoleConsumer $b --topic orders --group check --from-beginning --max-messages 1 --timeout-ms 30000 --command-config /tmp/kafka-app.properties 2>/dev/null)" = werewolf-order ]
# kafka-setup wrote the configuration, 0600 and the kafka user's, with no
# user's password in it; the controller listens on loopback alone; the log
# directory, formatted once, is on /data; Kafka writes no log file.
ok  kafka-setup       u=$(grep '^kafka:' /etc/passwd | cut -d: -f3); for f in server.properties tls.pem; do [ "$(stat -c '%u:%a' /run/svc/kafka/$f)" = "$u:600" ] || { echo "$f: not $u:600"; exit 1; }; done; ! grep -q werewolf-check /run/svc/kafka/server.properties && grep -q '^super.users=User:ops;User:_node$' /run/svc/kafka/server.properties && netstat -ltn | grep -q ' 127\.0\.0\.1:9094 ' && ! netstat -ltn | grep -q '0\.0\.0\.0:9094 ' && grep -q '^cluster.id=' /data/svc/kafka/log/meta.properties && [ -z "$(find /data/svc/kafka /run/svc/kafka -name '*.log' ! -path '*/log/*-[0-9]*/*')" ]
# A client with no login is refused, over TLS or not, and so is the admin
# with a wrong password. ConsoleProducer exits 0 whatever becomes of its
# messages, so what it says is checked; that nothing reached the topic,
# kafka-no-acl's count.
ok  kafka-no-login    k='sh /tmp/kafka.sh org.apache.kafka.tools.ConsoleProducer --bootstrap-server localhost:9093 --topic orders --command-property max.block.ms=10000'; e='Error when sending message to topic orders'; echo leaked | $k --command-config /tmp/kafka-anon.properties 2>&1 | grep -q "$e" && echo leaked | $k 2>&1 | grep -q "$e" && echo leaked | $k --command-config /tmp/kafka-wrong.properties 2>&1 | grep -q 'Authentication failed during authentication due to invalid credentials with SASL mechanism SCRAM-SHA-512'
# A user who logs in, but whom no ACL names, is denied a produce, and the
# authorizer says so on the console; the topic holds app's one message.
ok  kafka-no-acl      k='sh /tmp/kafka.sh'; b='--bootstrap-server localhost:9093'; echo stolen | $k org.apache.kafka.tools.ConsoleProducer $b --topic orders --command-property max.block.ms=10000 --command-config /tmp/kafka-stranger.properties 2>&1 | grep -q 'Not authorized to access topics: \[orders\]' && [ "$($k org.apache.kafka.tools.GetOffsetShell $b --command-config /tmp/kafka-ops.properties --topic orders 2>/dev/null)" = orders:0:1 ]
