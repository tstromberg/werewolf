# Grafana answers through Caddy over HTTPS, with a certificate from Caddy's
# own CA for localhost, once its migrations have run and its administrator
# is made: wait.
ok  grafana-health   i=0; until wget -q -T 5 --no-check-certificate -O - https://localhost/api/health 2>/dev/null | grep -q '"database": *"ok"'; do i=$((i + 1)); [ $i -le 180 ] || { echo "no /api/health in 180 s"; exit 1; }; sleep 1; done
ok  grafana-user     p=$(head -n 1 /run/cgroup/svc/grafana/cgroup.procs); u=$(grep '^_oci-grafana:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
# Plain HTTP is sent to HTTPS.
ok  grafana-https    wget -q -T 5 -S -O /dev/null http://localhost/ 2>&1 | grep -qi 'Location: https://localhost/'
# The administrator is the config's, and signs in with its password.
ok  grafana-admin    wget -q -T 5 --no-check-certificate -O - --header "Authorization: Basic $(printf %s admin:werewolf-check-pass-1 | base64)" https://localhost/api/user | grep -q '"isGrafanaAdmin": *true'
# Its secret key is its own, made once by grafana-setup: 256 bits as hex,
# _oci-grafana's alone. Its links use the base URL Caddy serves.
ok  grafana-key      k=/data/svc/grafana/secret-key; [ "$(stat -c '%u:%a' $k)" = "$(grep '^_oci-grafana:' /etc/passwd | cut -d: -f3):600" ] && grep -qxE '[0-9a-f]{64}' $k
ok  grafana-root-url wget -q -T 5 --no-check-certificate -O - --header "Authorization: Basic $(printf %s admin:werewolf-check-pass-1 | base64)" https://localhost/api/admin/settings | grep -q '"root_url": *"https://localhost/\{0,1\}"'
# Nothing is sent home: the settings in effect say so.
ok  grafana-quiet    s=$(wget -q -T 5 --no-check-certificate -O - --header "Authorization: Basic $(printf %s admin:werewolf-check-pass-1 | base64)" https://localhost/api/admin/settings) && for k in reporting_enabled check_for_updates check_for_plugin_updates; do echo "$s" | grep -q "\"$k\": *\"false\"" || { echo "$k is not false"; exit 1; }; done && echo "$s" | grep -q '"preinstall_disabled": *"true"'
# A data source's backend, a program of the image's, starts: a Prometheus
# with nothing behind it fails its health check in the plugin (400), not
# for want of a plugin that could not run (404, plugin.notRegistered).
ok  grafana-plugin   a="Authorization: Basic $(printf %s admin:werewolf-check-pass-1 | base64)"; wget -q -T 10 --no-check-certificate -O /dev/null --header "$a" --header 'Content-Type: application/json' --post-data '{"name":"check","uid":"check","type":"prometheus","access":"proxy","url":"http://127.0.0.1:9090"}' https://localhost/api/datasources && wget -q -T 30 --no-check-certificate -S -O /dev/null --header "$a" https://localhost/api/datasources/uid/check/health 2>&1 | grep -q 'HTTP/1.1 400'
# Its database is on /data, and _oci-grafana's.
ok  grafana-data     [ "$(stat -c %u /data/svc/grafana/grafana.db)" = "$(grep '^_oci-grafana:' /etc/passwd | cut -d: -f3)" ]
# A stranger gets nothing: no dashboard without signing in, a wrong
# password is refused, and no one may sign up.
ok  grafana-anon     wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/api/search 2>&1 | grep -q 'HTTP/1.1 401'
ok  grafana-wrong    wget -q -T 5 --no-check-certificate -S -O /dev/null --header "Authorization: Basic $(printf %s admin:wrong-password | base64)" https://localhost/api/user 2>&1 | grep -q 'HTTP/1.1 401'
ok  grafana-signup   ! wget -q -T 5 --no-check-certificate -O /dev/null --header 'Content-Type: application/json' --post-data '{"email":"stranger@example.test"}' https://localhost/api/user/signup 2>/dev/null
