# The JDK's static server serves the verified www tree, not the VM's root.
ok  java-site wget -q -T 5 -O - http://127.0.0.1:8080/ | grep -q "the JDK's web server is serving this page"
ok  java-not-found wget -q -T 5 -S -O /dev/null http://127.0.0.1:8080/missing.html 2>&1 | grep -q 'HTTP/1.[01] 404'
ok  java-head printf 'HEAD / HTTP/1.0\r\nHost: localhost\r\n\r\n' | nc -w 5 127.0.0.1 8080 >/tmp/java-head; grep -q '^HTTP/1.[01] 200' /tmp/java-head && tr -d '\r' </tmp/java-head | awk 'body && length($0) > 0 { bad=1 } /^$/ { body=1 } END { exit !(body && !bad) }'
ok  java-method-refused wget -q -T 5 -S -O /dev/null --post-data 'changed' http://127.0.0.1:8080/ 2>&1 | grep -q 'HTTP/1.[01] 405'
ok  java-traversal printf 'GET /../../etc/passwd HTTP/1.0\r\nHost: localhost\r\n\r\n' | nc -w 5 127.0.0.1 8080 >/tmp/java-traversal; grep -Eq '^HTTP/1.[01] (400|403|404)' /tmp/java-traversal && ! grep -q 'root:x:0:0' /tmp/java-traversal
