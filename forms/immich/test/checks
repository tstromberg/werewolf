# Immich answers through Caddy over HTTPS, with a certificate from Caddy's
# own CA for localhost, once immich-setup has made its admin from the
# config: Caddy opens only then, after Immich's first migrations and its
# geodata import. Wait.
ok  immich-up        i=0; until wget -q -T 5 --no-check-certificate -O - https://localhost/api/server/ping 2>/dev/null | grep -q pong; do i=$((i + 1)); [ $i -le 900 ] || { echo "no ping in 900 s"; exit 1; }; sleep 1; done
ok  immich-user      p=$(head -n 1 /run/cgroup/svc/immich/cgroup.procs); u=$(grep '^_oci-immich:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
# The admin is the config's, and Immich's defaults are werewolf's: no
# version check, no machine learning, the base URL for shared links.
ok  immich-admin     t=$(wget -q -T 10 --no-check-certificate -O - --header 'Content-Type: application/json' --post-data '{"email":"admin@example.com","password":"werewolf-check-pass-1"}' https://localhost/api/auth/login | sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p') && [ -n "$t" ] && echo "$t" >/tmp/immich.token && wget -q -T 10 --no-check-certificate -O - --header "Authorization: Bearer $t" https://localhost/api/users/me | grep -q '"isAdmin":true'
ok  immich-defaults  c=$(wget -q -T 10 --no-check-certificate -O - --header "Authorization: Bearer $(cat /tmp/immich.token)" https://localhost/api/system-config) && echo "$c" | grep -q '"newVersionCheck":{"enabled":false}' && echo "$c" | grep -q '"externalDomain":"https://localhost"' && echo "$c" | grep -q '"machineLearning":{"enabled":false'
# A photo uploads, and Immich reads its EXIF (exiftool), and makes its
# thumbnail (sharp, libvips): its own programs, run in its image.
ok  immich-upload    t=$(cat /tmp/immich.token); b=werewolfcheck; { printf '%s\r\n' "--$b" 'Content-Disposition: form-data; name="fileCreatedAt"' '' 2001-02-03T04:05:06.000Z "--$b" 'Content-Disposition: form-data; name="fileModifiedAt"' '' 2001-02-03T04:05:06.000Z "--$b" 'Content-Disposition: form-data; name="assetData"; filename="check.jpg"' 'Content-Type: image/jpeg' ''; echo '' | base64 -d; printf '\r\n%s\r\n' "--$b--"; } >/tmp/immich.body && id=$(wget -q -T 30 --no-check-certificate -O - --header "Authorization: Bearer $t" --header "Content-Type: multipart/form-data; boundary=$b" --post-file /tmp/immich.body https://localhost/api/assets | sed -n 's/.*"id":"\([0-9a-f-]*\)".*/\1/p') && [ -n "$id" ] && echo "$id" >/tmp/immich.asset
ok  immich-exif      t=$(cat /tmp/immich.token); i=0; until wget -q -T 10 --no-check-certificate -O - --header "Authorization: Bearer $t" https://localhost/api/assets/$(cat /tmp/immich.asset) | grep -q '"make":"werewolf"'; do i=$((i + 1)); [ $i -le 120 ] || { echo "no EXIF in 120 s"; exit 1; }; sleep 1; done
ok  immich-thumbnail t=$(cat /tmp/immich.token); i=0; until wget -q -T 10 --no-check-certificate -O - --header "Authorization: Bearer $t" https://localhost/api/assets/$(cat /tmp/immich.asset) | grep -q '"thumbhash":"'; do i=$((i + 1)); [ $i -le 120 ] || { echo "no thumbnail in 120 s"; exit 1; }; sleep 1; done && [ -n "$(find /data/svc/immich/thumbs -name '*.webp' | head -n 1)" ]
# The library is Immich's alone, on /data.
ok  immich-library   u=$(grep '^_oci-immich:' /etc/passwd | cut -d: -f3); [ "$(stat -c %u /data/svc/immich/upload)" = "$u" ] && [ -n "$(find /data/svc/immich/upload -type f -name '*.jpg' | head -n 1)" ]
# Immich reaches its database and queue on loopback, and nothing beyond
# the machine: fence holds no other line for it.
ok  immich-offline   u=$(grep '^_oci-immich:' /etc/passwd | cut -d: -f3); [ "$(grep "^connect $u " /usr/share/werewolf/net)" = "$(printf 'connect %s tcp 5432\nconnect %s tcp 6379' $u $u)" ]
# The attack: a stranger tries to become the admin, through Caddy and on
# loopback, as if Caddy had been bypassed. Both are refused, and the
# config's admin is still the only user.
ok  immich-signup-closed  s='{"email":"stranger@example.com","password":"stranger-pass-1","name":"x"}'; wget -q -T 5 --no-check-certificate -S -O /dev/null --header 'Content-Type: application/json' --post-data "$s" https://localhost/api/auth/admin-sign-up 2>&1 | grep -q 'HTTP/1.1 403' && wget -q -T 5 -S -O /dev/null --header 'Content-Type: application/json' --post-data "$s" http://127.0.0.1:2283/api/auth/admin-sign-up 2>&1 | grep -q 'HTTP/1.1 400' && [ "$(wget -q -T 10 --no-check-certificate -O - --header "Authorization: Bearer $(cat /tmp/immich.token)" https://localhost/api/admin/users | grep -o '"email":"[^"]*"' | sort -u)" = '"email":"admin@example.com"' ]
