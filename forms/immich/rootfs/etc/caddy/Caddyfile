# Caddy for the immich form: HTTPS at the machine's base URL (BASE_URL;
# howl --base-url), with a certificate Caddy gets itself, and :80 sent
# there; without one, plain HTTP on :80. Immich is behind it on loopback.
# leash starts Caddy (etc/sv/caddy/service) as caddy, after immich-setup.
{
	# werewolf's configuration is in the image: no admin API, no :2019.
	admin off
	log {
		output stderr
		format json
	}
	# Certificates and the ACME account, kept across boots.
	storage file_system /data/svc/caddy
	servers {
		# Against slowloris; no body timeout, which would cut off a video's
		# upload on a slow line.
		timeouts {
			read_header 10s
			idle 2m
		}
		# HTTP/3 is UDP, which fence does not serve yet.
		protocols h1 h2
	}
}

{$BASE_URL::80} {
	header -Server
	# immich-setup made the admin on loopback before Caddy opened: nobody
	# signs up as one through it, even if a later setup failed.
	respond /api/auth/admin-sign-up 403
	reverse_proxy 127.0.0.1:2283
}
