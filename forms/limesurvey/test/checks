# LimeSurvey was installed from the settings before it served, into
# MariaDB, once MariaDB answered (forms/limesurvey/test/config): the site
# answers with its name, its tables are MariaDB's, and the role php holds
# its database alone.
ok  ls-installed     i=0; until wget -q -T 10 -O /tmp/ls.html http://localhost/ 2>/dev/null; do i=$((i + 1)); [ $i -le 120 ] || { echo "the site does not answer"; exit 1; }; sleep 1; done; grep -q 'werewolf check surveys' /tmp/ls.html
ok  ls-in-mariadb    m="mariadb -S /run/svc/mariadb/mariadb.sock -N"; [ "$($m -e "select users_name from limesurvey.lime_users")" = admin ] && g=$($m -e "show grants for 'php'@'localhost'") && echo "$g" | grep -q 'unix_socket' && echo "$g" | grep -q 'ALL PRIVILEGES ON `limesurvey`' && ! echo "$g" | grep 'ON \*\.\*' | grep -qv 'GRANT USAGE'
# /tmp/ls-http METHOD PATH COOKIE [TYPE FILE]: one request to nginx, the
# answer as it came, headers and all, never following a redirect.
ok  ls-http          printf '%s\n' '#!/bin/sh' 'm=$1 p=$2 c=$3 t=$4 f=$5' '{ printf "%s %s HTTP/1.0\r\nHost: localhost\r\nCookie: %s\r\n" "$m" "$p" "$c"; [ -z "$f" ] || printf "Content-Type: %s\r\nContent-Length: %d\r\n" "$t" "$(wc -c <"$f")"; printf "\r\n"; [ -z "$f" ] || cat "$f"; sleep 3; } | nc localhost 80 | tr -d "\r"' >/tmp/ls-http
# The admin is the config's: it signs in with the password whose hash the
# config carries, and its session reaches the plugin manager. The session
# and CSRF token are kept for the checks after.
ok  ls-login         r=$(sh /tmp/ls-http GET /index.php/admin/authentication/sa/login ''); t=$(echo "$r" | sed -n 's/^Set-Cookie: YII_CSRF_TOKEN=\([^;]*\).*/\1/p'); s=$(echo "$r" | sed -n 's/^Set-Cookie: \(PHPSESSID=[^;]*\).*/\1/p'); printf 'YII_CSRF_TOKEN=%s&authMethod=Authdb&user=admin&password=werewolf-check&loginlang=default&action=login&width=1280&login_submit=login' "$t" >/tmp/ls-body; p=$(sh /tmp/ls-http POST /index.php/admin/authentication/sa/login "$s; YII_CSRF_TOKEN=$t" application/x-www-form-urlencoded /tmp/ls-body); n=$(echo "$p" | sed -n 's/^Set-Cookie: \(PHPSESSID=[^;]*\).*/\1/p' | tail -n 1); echo "${n:-$s}; YII_CSRF_TOKEN=$t" >/tmp/ls-cookie; echo "$t" >/tmp/ls-token; d=$(sh /tmp/ls-http GET /index.php/admin/pluginmanager/sa/index "$(cat /tmp/ls-cookie)"); echo "$d" | grep -q '^HTTP/1.1 200' && echo "$d" | grep -q 'authentication/sa/logout' || { echo "$p" | head -20; echo ---; echo "$d" | head -20; exit 1; }
# A plugin is PHP: the admin's plugin upload is refused, nothing of the
# archive lands on the machine, and its code never runs.
ok  ls-plugin-upload php -r '$z = new ZipArchive; $z->open("/tmp/Evil.zip", ZipArchive::CREATE | ZipArchive::OVERWRITE); $z->addFromString("config.xml", "<?xml version=\"1.0\"?><config><metadata><name>Evil</name><type>plugin</type><version>1</version></metadata><compatibility><version>7.0</version></compatibility></config>"); $z->addFromString("Evil.php", "<?php file_put_contents(\"/run/svc/php-fpm/pwned\", \"x\"); class Evil extends PluginBase {}"); $z->close();' && { printf -- '--werewolf\r\nContent-Disposition: form-data; name="YII_CSRF_TOKEN"\r\n\r\n%s\r\n--werewolf\r\nContent-Disposition: form-data; name="the_file"; filename="Evil.zip"\r\nContent-Type: application/zip\r\n\r\n' "$(sed 's/%3D/=/g' /tmp/ls-token)"; cat /tmp/Evil.zip; printf '\r\n--werewolf--\r\n'; } >/tmp/ls-up && p=$(sh /tmp/ls-http POST /index.php/admin/pluginmanager/sa/upload "$(cat /tmp/ls-cookie)" 'multipart/form-data; boundary=werewolf' /tmp/ls-up) && d=$(sh /tmp/ls-http GET /index.php/admin/pluginmanager/sa/index "$(cat /tmp/ls-cookie)") && echo "$d" | grep -q 'Plugin upload is disabled' && [ -z "$(find /data/svc/php-fpm -name 'Evil*')" ] && [ ! -e /run/svc/php-fpm/pwned ] || { echo "$p" | head -20; exit 1; }
# A plugin someone managed to write under upload/ is not one: the plugin
# manager's scan never loads it, and it cannot be installed.
ok  ls-plugin-planted mkdir -p /data/svc/php-fpm/upload/plugins/Evil && unzip -o -q /tmp/Evil.zip -d /data/svc/php-fpm/upload/plugins/Evil && chown -R php:php /data/svc/php-fpm/upload/plugins && p=$(sh /tmp/ls-http GET /index.php/admin/pluginmanager/sa/scanFiles "$(cat /tmp/ls-cookie)") && echo "$p" | grep -q '^HTTP/1.1 [23]0' && [ ! -e /run/svc/php-fpm/pwned ] && [ "$(mariadb -S /run/svc/mariadb/mariadb.sock -N -e "select count(*) from limesurvey.lime_plugins where name='Evil'")" = 0 ] || { echo "$p" | head -30; false; }; r=$?; rm -rf /data/svc/php-fpm/upload/plugins; exit $r
# What LimeSurvey's .htaccess files refuse, nginx refuses: its code and
# configuration, libraries, the installer, translations, the cache, the
# release stamp, participants' uploaded files, and any .php but its own.
ok  ls-hidden        for u in application/config/config.php application/config/security.php application/config/version.php vendor/autoload.php installer/create-database.php setdebug.php locale/limesurvey.pot tmp/release tmp/runtime/x index.php/installer/welcome upload/surveys/1/files/fu_x upload/x.php assets/packages/kcfinder/core/autoload.php plugins/Authdb/Authdb.php; do wget -q -T 10 -S -O /dev/null http://localhost/$u 2>&1 | grep -q 'HTTP/1.1 404' || { echo "served: $u"; exit 1; }; done
# Uploads are data, never code: a .php planted there is a 404, an SVG is
# sandboxed; and the assets LimeSurvey published are served.
ok  ls-uploads-data  printf '<?php echo "ran"; ?>' >/data/svc/php-fpm/upload/global/x.php && printf '<svg xmlns="http://www.w3.org/2000/svg"><script>alert(1)</script></svg>' >/data/svc/php-fpm/upload/global/x.svg && wget -q -T 10 -S -O /dev/null http://localhost/upload/global/x.php 2>&1 | grep -q 'HTTP/1.1 404' && wget -q -T 10 -S -O /dev/null http://localhost/upload/global/x.svg 2>&1 | grep -qi 'Content-Security-Policy: sandbox' && a=$(grep -o '/tmp/assets/[^"]*\.css' /tmp/ls.html | head -n 1) && [ -n "$a" ] && wget -q -T 10 -O /dev/null "http://localhost$a"; r=$?; rm -f /data/svc/php-fpm/upload/global/x.php /data/svc/php-fpm/upload/global/x.svg; exit $r
# A request naming another host is refused, so no link in mail can be
# aimed elsewhere.
ok  ls-host          u=/index.php/admin/authentication/sa/forgotpassword; for h in localhost:200 evil.example:400; do (printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' $u ${h%:*}; sleep 3) | nc localhost 80 | head -n 1 | grep -q "^HTTP/1.1 ${h#*:} " || { echo "Host ${h%:*}: not ${h#*:}"; exit 1; }; done
# php cannot change LimeSurvey's code, and what is secret is php's alone.
ok  ls-private       u=$(id -u php); ! chpst -u php touch /usr/share/limesurvey/plugins/x 2>/dev/null && [ "$(stat -c '%u:%a' /run/svc/php-fpm/admin-password-hash)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/php-fpm/security.json)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/php-fpm/tmp/runtime)" = $u:700 ] && [ ! -e /run/svc/php-fpm/smtp-password ]
# A wrong password signs no one in. Last, as LimeSurvey locks an address
# out after a few.
ok  ls-wrong-password r=$(sh /tmp/ls-http GET /index.php/admin/authentication/sa/login ''); t=$(echo "$r" | sed -n 's/^Set-Cookie: YII_CSRF_TOKEN=\([^;]*\).*/\1/p'); s=$(echo "$r" | sed -n 's/^Set-Cookie: \(PHPSESSID=[^;]*\).*/\1/p'); printf 'YII_CSRF_TOKEN=%s&authMethod=Authdb&user=admin&password=werewolf-wrong&loginlang=default&action=login&width=1280&login_submit=login' "$t" >/tmp/ls-body; p=$(sh /tmp/ls-http POST /index.php/admin/authentication/sa/login "$s; YII_CSRF_TOKEN=$t" application/x-www-form-urlencoded /tmp/ls-body); n=$(echo "$p" | sed -n 's/^Set-Cookie: \(PHPSESSID=[^;]*\).*/\1/p' | tail -n 1); d=$(sh /tmp/ls-http GET /index.php/admin/pluginmanager/sa/index "${n:-$s}; YII_CSRF_TOKEN=$t"); ! echo "$d" | grep -q 'authentication/sa/logout'
