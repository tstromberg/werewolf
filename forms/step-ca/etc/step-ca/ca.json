{
  "root": "/run/svc/step-ca/root-cert",
  "crt": "/run/svc/step-ca/intermediate-cert",
  "key": "/run/svc/step-ca/intermediate-key",
  "address": ":443",
  "dnsNames": [],
  "logger": { "format": "json" },
  "db": {
    "type": "badgerv2",
    "dataSource": "/data/svc/step-ca/db"
  },
  "authority": {
    "enableAdmin": false,
    "disableIssuedAtCheck": false,
    "claims": {
      "minTLSCertDuration": "5m",
      "maxTLSCertDuration": "24h",
      "defaultTLSCertDuration": "24h",
      "disableRenewal": false
    },
    "policy": {
      "x509": {
        "allow": { "dns": [] },
        "allowWildcardNames": false
      }
    },
    "provisioners": [
      {
        "type": "ACME",
        "name": "acme",
        "challenges": ["http-01", "tls-alpn-01", "dns-01"],
        "forceCN": false
      }
    ]
  },
  "tls": {
    "cipherSuites": [
      "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
      "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
      "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    ],
    "minVersion": 1.2,
    "maxVersion": 1.3,
    "renegotiation": false
  }
}
