# step-ca, as its own user: it may bind :443 and no other port, reach a
# requester's :80 for ACME's http-01 and a resolver to find it, read its
# configuration and the image, and write only its own directories. The
# CA's names and the names ACME may issue for come from the machine's
# settings, into the image's ca.json.
exec    /usr/bin/step-ca --password-file /run/svc/step-ca/password /run/svc/step-ca/ca.json
user    step
pledge  stdio rpath wpath inet unix connect listen proc
listen  tcp/443
connect tcp/80 tcp/53
read    /etc/step-ca
# The root's certificate, the intermediate's certificate and key, and the
# key's password, from the machine's config: missing, the service parks
# with a line naming the file.
config  root-cert /run/config/step-ca/root.crt
config  intermediate-cert /run/config/step-ca/intermediate.crt
config  intermediate-key /run/config/step-ca/intermediate.key
config  password /run/config/step-ca/password
config  settings /run/config/step-ca/settings.json
setting names hostname... required as dnsNames
setting domains hostname... required as authority.policy.x509.allow.dns
render  json ca.json from /etc/step-ca/ca.json
memory  512
nofile  65536
env     HOME=/run/svc/step-ca
env     STEPPATH=/run/svc/step-ca
env     GOMEMLIMIT=384MiB
