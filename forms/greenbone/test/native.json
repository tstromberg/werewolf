{
  "format": "werewolf-native-tests/1",
  "legacy": true,
  "packages": [
    "postgresql-17-client"
  ],
  "drivers": [
    {
      "name": "test-greenbone-database",
      "source": "driver.zig",
      "mode": "database",
      "user": "postgres",
      "pledge": "stdio rpath unix connect proc exec",
      "read": [
        "/run/svc/postgres"
      ],
      "connect": [
        "/run/svc/postgres/.s.PGSQL.5432"
      ],
      "run": [
        "/usr/bin/psql"
      ],
      "cases": {
        "seed": [
          "ordinary-database-roles",
          "database-owner-role",
          "database-extensions"
        ],
        "verify": [
          "ordinary-database-roles",
          "database-owner-role",
          "database-extensions"
        ]
      }
    },
    {
      "name": "test-greenbone-valkey",
      "source": "driver.zig",
      "mode": "valkey",
      "user": "_oci-openvas",
      "pledge": "stdio rpath inet connect proc exec",
      "read": [],
      "connect": [
        "tcp/6379"
      ],
      "run": [
        "/usr/bin/valkey-cli"
      ],
      "cases": {
        "seed": [
          "config-get-databases",
          "config-set-refused"
        ],
        "verify": [
          "config-get-databases",
          "config-set-refused"
        ]
      }
    },
    {
      "name": "test-greenbone-scanner",
      "source": "driver.zig",
      "mode": "scanner",
      "user": "_oci-gvmd",
      "pledge": "stdio rpath unix connect",
      "read": [
        "/data/share/gvm/ospd"
      ],
      "connect": [
        "/data/share/gvm/ospd/ospd.sock"
      ],
      "run": [],
      "groups": [
        "_oci-openvas"
      ],
      "cases": {
        "seed": [
          "osp-version",
          "shared-mount-modes"
        ],
        "verify": [
          "osp-version",
          "shared-mount-modes"
        ]
      }
    },
    {
      "name": "test-greenbone-scanner-denied",
      "source": "driver.zig",
      "mode": "scanner-denied",
      "user": "nobody",
      "pledge": "stdio rpath unix connect",
      "read": [
        "/data/share/gvm/ospd"
      ],
      "connect": [
        "/data/share/gvm/ospd/ospd.sock"
      ],
      "run": [],
      "groups": [],
      "cases": {
        "seed": [
          "socket-refused"
        ],
        "verify": [
          "socket-refused"
        ]
      }
    },
    {
      "name": "test-greenbone-manager",
      "source": "driver.zig",
      "mode": "manager",
      "user": "_oci-gvmd",
      "pledge": "stdio rpath inet unix connect",
      "read": [
        "/run/svc/gvmd/run"
      ],
      "connect": [
        "/run/svc/gvmd/run/gvmd.sock"
      ],
      "run": [],
      "config": {
        "password": "/run/config/gvmd/admin-password"
      },
      "cases": {
        "seed": [
          "configured-login",
          "create-target",
          "persisted-target",
          "scanner-configured",
          "scanner-verified",
          "default-password-refused",
          "wrong-password-refused",
          "private-port-5432",
          "private-port-6379",
          "private-port-9391",
          "private-port-9392"
        ],
        "verify": [
          "configured-login",
          "persisted-target",
          "scanner-configured",
          "scanner-verified",
          "default-password-refused",
          "wrong-password-refused",
          "private-port-5432",
          "private-port-6379",
          "private-port-9391",
          "private-port-9392"
        ]
      }
    },
    {
      "name": "test-greenbone-bridge",
      "source": "driver.zig",
      "mode": "bridge",
      "user": "_oci-gsad",
      "pledge": "stdio rpath unix connect",
      "read": [
        "/run/svc/gsad/run"
      ],
      "connect": [
        "/run/svc/gsad/run/manager.sock"
      ],
      "run": [],
      "config": {
        "password": "/run/config/gvmd/admin-password"
      },
      "cases": {
        "seed": [
          "configured-login",
          "persisted-target",
          "default-password-refused",
          "wrong-password-refused"
        ],
        "verify": [
          "configured-login",
          "persisted-target",
          "default-password-refused",
          "wrong-password-refused"
        ]
      }
    },
    {
      "name": "test-greenbone-denied",
      "source": "driver.zig",
      "mode": "denied",
      "user": "nobody",
      "pledge": "stdio rpath unix connect",
      "read": [
        "/run/svc/gvmd/run"
      ],
      "connect": [
        "/run/svc/gvmd/run/gvmd.sock"
      ],
      "run": [],
      "cases": {
        "seed": [
          "socket-refused"
        ],
        "verify": [
          "socket-refused"
        ]
      }
    }
  ]
}
