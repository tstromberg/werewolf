# What the greenbone form, booted as it ships, without a config, must say
# on its console (make check-shellfree-greenbone; test/console.zig). Given no
# administrator's password, gvmd parks before it migrates. With no
# domain, so does Caddy. make check-greenbone boots it with its config.

seen    gvmd-needs-password  leash: \{"event":"down","service":"gvmd","why":"config admin-password: FileNotFound"\}
seen    caddy-needs-domain   service-config: \{"event":"settings","service":"caddy","setting":"domain","why":"required"\}
seen    caddy-parked         leash: \{"event":"down","service":"caddy","why":"settings refused; service-config said why"\}
