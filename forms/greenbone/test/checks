# The login page answers through Caddy. gsad is on loopback. 9392 is
# 0x24B0. gvmd is a Unix socket, mode 0660, group _oci-gvmd.
ok  greenbone-login  i=0; until wget -q -T 5 --no-check-certificate -O /tmp/gb.html https://localhost/login; do i=$((i + 1)); [ $i -le 300 ] || { echo "no login in 300 s"; exit 1; }; sleep 1; done; grep -qi password /tmp/gb.html
ok  greenbone-gvmd   p=$(awk '$2=="(gvmd)"{print $1; exit}' /proc/[0-9]*/stat); u=$(grep '^_oci-gvmd:' /etc/passwd | cut -d: -f3); [ -n "$p" ] && [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  greenbone-bind   g=$(awk -F: '$1=="_oci-gvmd"{print $3}' /etc/group); grep -qi '0100007F:24B0 ' /proc/net/tcp && ! grep -qi '00000000:24B0 ' /proc/net/tcp && [ "$(stat -c %a /run/svc/gvmd/run/gvmd.sock)" = 660 ] && [ "$(stat -c %g /run/svc/gvmd/run/gvmd.sock)" = "$g" ] && [ "$(stat -c %a /run/svc/gsad/run/manager.sock)" = 660 ]
ok  greenbone-link   p=$(awk '$2=="(gvm-link)"{print $1; exit}' /proc/[0-9]*/stat); u=$(grep '^_glink:' /etc/passwd | cut -d: -f3); g=$(awk -F: '$1=="_oci-gvmd"{print $3}' /etc/group); [ -n "$p" ] && [ "$(grep '^Uid:' /proc/$p/status | awk '{print $2}')" = "$u" ] && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep '^Groups:' /proc/$p/status | grep -qw "$g"
ok  greenbone-published  wget -q -T 10 --no-check-certificate -S -O /dev/null --post-data 'username=admin&password=admin' https://localhost/login 2>&1 | grep -Eq 'HTTP/[^ ]* (200|401|403)'
ok  greenbone-scanner  p=""; for d in /proc/[0-9]*; do tr '\0' ' ' <"$d/cmdline" 2>/dev/null | grep -q ospd-openvas && p=${d#/proc/}; done; u=$(awk -F: '$1=="_oci-openvas"{print $3}' /etc/passwd); [ -n "$p" ] && [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000003000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  greenbone-feed     p=""; for d in /proc/[0-9]*; do tr '\0' ' ' <"$d/cmdline" 2>/dev/null | grep -q feed-run && p=${d#/proc/}; done; u=$(awk -F: '$1=="_oci-feed"{print $3}' /etc/passwd); [ -n "$p" ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status
ok  greenbone-cache    u=$(awk -F: '$1=="_oci-feed"{print $3}' /etc/passwd); g=$(awk -F: '$1=="_oci-gvmd"{print $3}' /etc/passwd); m=$(stat -c %a /data/share/gvm/vt); case $m in *0) ;; *) echo "other bits $m"; exit 1 ;; esac; [ "$(stat -c %u /data/share/gvm/vt)" = "$u" ] && [ "$g" != "$u" ]
ok  greenbone-caps     grep -q '^caps net_raw net_admin$' /etc/sv/openvas/service && ! grep -q '^caps ' /etc/sv/gvmd/service /etc/sv/gsad/service /etc/sv/feed/service /etc/sv/caddy/service /etc/sv/postgres/service /etc/sv/valkey/service
ok  greenbone-posture  grep -q '^network-fence-unbypassable ' /usr/share/werewolf/weaknesses
ok  greenbone-redis    grep -qi '0100007F:18EB ' /proc/net/tcp && ! grep -qi '00000000:18EB ' /proc/net/tcp && n=0; for f in /etc/sv/*/service; do grep '^connect ' "$f" | grep -q 6379 && { n=$((n + 1)); echo "$f" | grep -q /openvas/ || { echo "$f connects to redis"; exit 1; }; }; done; [ "$n" = 1 ]
ok  greenbone-alone    fg=$(awk -F: '$1=="_oci-feed"{print $3}' /etc/group); p=$(awk '$2=="(gsad)"{print $1; exit}' /proc/[0-9]*/stat); [ -n "$p" ] && ! grep '^Groups:' /proc/$p/status | grep -qw "$fg"
