# greenbone-run: bash, inside the gvmd image, as _oci-gvmd
# (forms/greenbone/form.yaml). One script. It refuses a short password
# and admin, migrates, sets the administrator, and replaces itself with
# gvmd. It does not run gosu. The socket is mode 0660, so only
# _oci-gvmd's group can open it. umask 007 keeps a create from masking
# the group write that listen-mode asks for.
set -eu
pw=$(cat /tmp/admin-password)
rm -f /tmp/admin-password
case $pw in
*" "*|*"'"*|*'"'*|*'\'*|*$'\n'*|admin)
	echo "greenbone-run: refusing that password" >&2
	exit 1
	;;
esac
[ "${#pw}" -ge 12 ] || {
	echo "greenbone-run: password shorter than 12" >&2
	exit 1
}
i=0
until /usr/local/sbin/gvmd --migrate; do
	i=$((i + 1))
	[ "$i" -le 90 ] || {
		echo "greenbone-run: postgres did not answer" >&2
		exit 1
	}
	sleep 1
done
if /usr/local/sbin/gvmd --get-users --verbose | grep -q '^admin '; then
	/usr/local/sbin/gvmd --user=admin --new-password="$pw"
else
	/usr/local/sbin/gvmd --create-user=admin --password="$pw"
fi
# The scanner listens on loopback. Recording it fails open: the UI
# comes up either way. The type is the second word.
/usr/local/sbin/gvmd --get-scanners | while read -r uuid type _; do
	case $type in
	OpenVAS)
		/usr/local/sbin/gvmd --modify-scanner="$uuid" \
			--scanner-host=127.0.0.1 --scanner-port=9391 ||
			echo "greenbone-run: scanner not recorded" >&2
		;;
	esac
done || echo "greenbone-run: scanners not listed" >&2
umask 007
exec /usr/local/sbin/gvmd -f --listen=/run/gvmd.sock --listen-mode=660
