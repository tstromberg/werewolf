# The webshell, as the app user. It may bind :8080 and nothing more, and
# `run` names the programs it may exec. Landlock grants exec per file, and
# Wolfi's coreutils is one multi-call binary (cat, dd, chroot ... all
# symlinks to /usr/bin/coreutils), so naming id or cat allows every
# coreutils applet; they run as app and gain nothing, held by the read and
# write floor, the dropped capabilities and the empty network. net-tools
# ships separate files, so hostname runs and ifconfig and route, unnamed,
# are refused at the exec. There is no shell to run. No `connect`, so the
# app reaches nothing on the network. One worker, so every visitor sees the
# same history, but threaded: a sync worker blocks on a browser's idle
# preconnect until its timeout kills it, and every other request waits.
exec    /usr/bin/python3 -m gunicorn --bind 0.0.0.0:8080 --workers 1 --worker-class gthread --threads 8 --worker-tmp-dir /run/svc/app --no-control-socket --pythonpath /usr/lib/app webshell:app
user    app
pledge  stdio rpath wpath proc unix inet listen exec
# The programs this RCE may exec: who and where it runs, and read-only
# tools. They can read only what the leash's floor grants -- /etc/passwd
# prints, /etc/shadow is refused -- and change nothing. Everything else in
# the image (cp, dd, chroot, ifconfig, a shell) is refused by Landlock.
run     /usr/bin/hostname /usr/bin/id /usr/bin/uname /usr/bin/whoami /usr/bin/nproc
run     /usr/bin/cat /usr/bin/ls /usr/bin/head /usr/bin/tail /usr/bin/wc /usr/bin/echo /usr/bin/date /usr/bin/env /usr/bin/pwd
memory  512
listen  tcp/8080
env     PYTHONDONTWRITEBYTECODE=1
env     PYTHONUNBUFFERED=1
