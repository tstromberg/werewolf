# Continuwuity answers through Caddy once the first start has created
# the administrator. Registration stays closed.
ok  continuwuity-up   i=0; until wget -q -T 5 --no-check-certificate -O - https://localhost/_matrix/client/versions 2>/dev/null | grep -q '"versions"'; do i=$((i + 1)); [ $i -le 180 ] || { echo "no /versions in 180 s"; exit 1; }; sleep 1; done
ok  continuwuity-https wget -q -T 5 -S -O /dev/null http://localhost/_matrix/client/versions 2>&1 | grep -qi 'Location: https://localhost/'
# A stranger cannot register. The endpoint refuses the attempt.
ok  continuwuity-closed ! wget -q -T 10 --no-check-certificate -O /dev/null --post-data '{"username":"eve","password":"werewolf-check-pass-1"}' --header 'Content-Type: application/json' https://localhost/_matrix/client/v3/register
# The administrator from the config can sign in.
ok  continuwuity-admin i=0; until wget -q -T 5 --no-check-certificate -O - --post-data '{"type":"m.login.password","identifier":{"type":"m.id.user","user":"alice"},"password":"werewolf-check-pass-1"}' --header 'Content-Type: application/json' https://localhost/_matrix/client/v3/login 2>/dev/null | grep -q access_token; do i=$((i + 1)); [ $i -le 60 ] || { echo "alice could not sign in"; exit 1; }; sleep 1; done

# Authentication failures must be protocol errors, not a successful session.
ok  continuwuity-unauth wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/_matrix/client/v3/account/whoami 2>&1 | grep -q 'HTTP/1.1 401'
ok  continuwuity-wrong-password wget -q -T 5 --no-check-certificate -S -O /dev/null --post-data '{"type":"m.login.password","identifier":{"type":"m.id.user","user":"alice"},"password":"wrong-password"}' --header 'Content-Type: application/json' https://localhost/_matrix/client/v3/login 2>&1 | grep -q 'HTTP/1.1 403'
