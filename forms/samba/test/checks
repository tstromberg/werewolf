# Samba answers SMB3 on 445. Alice can write her share. A guest cannot,
# and Bob cannot use Alice's share.
ok  samba-up     echo hello >/tmp/samba-in; i=0; until smbclient //127.0.0.1/alice -m SMB3 --client-protection=encrypt -U 'alice%werewolf-check-password' -c 'put /tmp/samba-in hi.txt' >/tmp/samba-put 2>&1; do i=$((i + 1)); [ $i -le 60 ] || { echo "no share"; cat /tmp/samba-put; exit 1; }; sleep 1; done
ok  samba-round  smbclient //127.0.0.1/alice -m SMB3 --client-protection=encrypt -U 'alice%werewolf-check-password' -c 'get hi.txt /tmp/samba-out' && [ "$(cat /tmp/samba-out)" = hello ]
ok  samba-guest  ! smbclient //127.0.0.1/alice -m SMB3 --client-protection=encrypt -N -c 'ls' >/tmp/samba-guest 2>&1
ok  samba-other  ! smbclient //127.0.0.1/alice -m SMB3 --client-protection=encrypt -U 'bob%werewolf-other-password' -c 'get hi.txt /tmp/samba-bob' >/tmp/samba-other 2>&1
ok  samba-network  smbclient //10.0.2.15/bob -m SMB3 --client-protection=encrypt -U 'bob%werewolf-other-password' -c 'ls'
ok  samba-wrong    ! smbclient //10.0.2.15/alice -m SMB3 --client-protection=encrypt -U 'alice%incorrect-password' -c 'ls' >/tmp/samba-wrong 2>&1
ok  samba-smb2     ! smbclient //10.0.2.15/alice -m SMB2 -U 'alice%werewolf-check-password' -c 'ls' >/tmp/samba-smb2 2>&1
