#!/bin/sh
# forms/zot/test/config DIR: the zot form's config for make check, in DIR:
# its domain, localhost, for which Caddy's own CA signs, and two users,
# alice, who pushes, and bob, who only pulls; their passwords are
# werewolf-check-alice and werewolf-check-bob (htpasswd -nbBC 10 made
# these lines), which the tests sign in with, and the image they push: one
# layer, its config and its manifest, whose digests tests.yaml names.
set -eu
mkdir -p "$1/zot" "$1/caddy"
umask 077
cat >"$1/zot/htpasswd" <<'EOT'
alice:$2y$10$WHaTihtCoj3daOppvsT9NeF1qDXAeH9hoTVlakFoH4LaNOX3L0ctG
bob:$2y$10$6jXCPv0yPt30HkBJAcHQ8uzDWhts1sX/QWDQkJgZWycVloBkKF6nG
EOT
echo '{"pushers":["alice"]}' >"$1/zot/settings.json"
echo '{"domain":"localhost"}' >"$1/caddy/settings.json"

mkdir -p "$1/tests"
for user in alice bob; do
	printf '%s' "$user:werewolf-check-$user" | base64 | tr -d '\n' >"$1/tests/zot-$user-auth"
done
t=$(dirname "$0")
cp "$t/layer.tar.gz" "$1/tests/zot-layer"
cp "$t/evil.tar.gz" "$1/tests/zot-evil"
cp "$t/image-config.json" "$1/tests/zot-config"
cp "$t/image-manifest.json" "$1/tests/zot-manifest"
