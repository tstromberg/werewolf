# MariaDB answers on its socket once mariadb-init has made its data, to
# root as itself (unix_socket): wait.
ok  mariadb-socket   s=/run/svc/mariadb/mariadb.sock; i=0; until mariadb -S $s -N -e 'select 1' 2>/dev/null | grep -qx 1; do i=$((i + 1)); [ $i -le 60 ] || { echo "no answer in 60 s"; exit 1; }; sleep 1; done
# It serves no TCP: networking off, nothing on 3306.
ok  mariadb-no-tcp   [ "$(mariadb -S /run/svc/mariadb/mariadb.sock -N -e 'select @@skip_networking')" = 1 ] && ! netstat -ltn | grep -q ':3306 '
# A client cannot read or write the machine's files: no LOAD DATA LOCAL;
# the server's own files only in an empty directory none may write, even
# for root's FILE privilege.
ok  mariadb-no-files m="mariadb -S /run/svc/mariadb/mariadb.sock -N"; [ "$($m -e 'select @@local_infile')" = 0 ] && [ "$($m -e 'select @@secure_file_priv')" = /var/empty/ ] && ! $m -e "select 1 into outfile '/tmp/werewolf-check'" 2>/dev/null && [ ! -e /tmp/werewolf-check ] && [ "$($m -e "select load_file('/etc/passwd') is null")" = 1 ]
# Its data was made once, on /data, and is the service user's alone.
ok  mariadb-data     [ -d /data/svc/mariadb/data/mysql ] && [ -e /data/svc/mariadb/data-made ] && [ "$(stat -c '%a %U' /data/svc/mariadb/data)" = '700 mariadb' ]
# forms/mariadb/example/shop.sql, the migration fixture, applied twice:
# a form's SQL runs before every start, so a second time must not add rows.
ok  mariadb-migrate  m="mariadb -S /run/svc/mariadb/mariadb.sock"; sql="CREATE DATABASE IF NOT EXISTS shop CHARACTER SET utf8mb4; CREATE USER IF NOT EXISTS 'app'@'localhost' IDENTIFIED VIA unix_socket; GRANT ALL PRIVILEGES ON shop.* TO 'app'@'localhost'; CREATE TABLE IF NOT EXISTS shop.items (sku VARCHAR(32) PRIMARY KEY, name VARCHAR(64) NOT NULL); INSERT IGNORE INTO shop.items (sku, name) VALUES ('bolt', 'M8 bolt'); INSERT IGNORE INTO shop.items (sku, name) VALUES ('nut', 'M8 nut');"; $m -e "$sql"; $m -e "$sql"; [ "$($m -N -e 'select count(*) from shop.items')" = 2 ] && [ "$($m -N -e "select name from shop.items where sku='bolt'")" = 'M8 bolt' ]
