# What the iris form, booted as it ships, without a config, must say on
# its console (make check-shellfree-iris; test/console.zig). Given no
# administrator's password, IRIS parks before it serves. With no domain,
# so does Caddy. make check-iris boots it with its config.

seen    iris-needs-password  leash: \{"event":"down","service":"iris","why":"config admin-password: FileNotFound"\}
seen    caddy-needs-domain   service-config: \{"event":"settings","service":"caddy","setting":"domain","why":"required"\}
seen    caddy-parked         leash: \{"event":"down","service":"caddy","why":"settings refused; service-config said why"\}
