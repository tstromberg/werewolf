#!/bin/sh
# Stage 3: stop the services, then put /data down before the power goes.
# Without this a stop is a power cut, and ext4 loses its last few seconds of
# writes. runit kills whatever is left, syncs, and powers off (or reboots,
# if `reboot` asked) once this exits.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
exec 2>&1 </dev/null

say() { echo "werewolf: $*"; }

say "stopping services"
sv -w 30 force-stop /etc/sv/*
sv exit /etc/sv/*

sync
if umount /data 2>/dev/null; then
	say "/data unmounted"
else
	mount -o remount,ro /data 2>/dev/null && say "/data busy; remounted read-only"
fi
if [ -e /dev/mapper/data ]; then
	cryptsetup close data && say "/data closed"
fi
# The victim's root filesystem, which /data was bound from, and which may
# hold the root itself (a slot's root.erofs, held open by a loop device, so
# it is never wholly unmounted). GRUB reads it without the journal: a
# read-only remount of the filesystem itself, not this one mount, writes
# everything the journal holds into place, so the next boot's GRUB sees what
# this one wrote. Allowed with the loop open, since it is open read-only.
if mountpoint -q /victim; then
	mount -o remount,ro /victim 2>/dev/null &&
		say "/victim's filesystem is read-only, its journal written in place"
	if umount /victim 2>/dev/null; then
		say "/victim unmounted"
	else
		mount -o remount,ro /victim 2>/dev/null && say "/victim busy; remounted read-only"
	fi
fi
