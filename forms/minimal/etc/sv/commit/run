#!/bin/sh
# A new slot boots on probation, chosen for this boot only; the next reset
# goes back to the slot (or, after bite, the distro) that was good. Once
# every running service has stayed up for a minute, and /data is there, make
# this slot good, and leave /run/werewolf/committed for stage0's deadman,
# which otherwise reboots the machine after ten minutes.
#
# Two loaders choose slots:
#   werewolf.grubenv=UUID:PATH   a distro's GRUB, after bite: saved_entry in
#                                GRUB's environment block, which
#                                /usr/lib/werewolf/grubenv rewrites in place
#   werewolf.esp=UUID            systemd-boot, on werewolf's own disk
#                                (design/native-boot.md): the entry is renamed
#                                from werewolf-a+N-M.conf, which counts tries,
#                                to werewolf-a.conf, which is good for good
exec 2>&1
slot=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^werewolf\.slot=//p')
esp=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^werewolf\.esp=//p')
entry=werewolf-${slot:-a}
if [ -s /run/werewolf/grubenv ]; then
	env=$(cat /run/werewolf/grubenv)
	uuid=${env%%:*}
	path=${env#*:}
elif [ -z "$esp" ] || [ -z "$slot" ]; then
	exec sv down .
fi

say() { echo "commit: $*"; }

healthy() {
	for s in /etc/sv/*; do
		[ "$s" = /etc/sv/commit ] && continue
		st=$(sv status "$s")
		# Running for a minute, or down because it asked to be (a service
		# that parks itself); not down while wanted up, between crashes.
		case "$st" in
		run:*)
			up=$(echo "$st" | sed -n 's/^run: [^ ]* (pid [0-9]*) \([0-9]*\)s.*/\1/p')
			[ "${up:-0}" -ge 60 ] || return 1
			;;
		*"want up"*) return 1 ;;
		esac
	done
}
until healthy; do
	sleep 15
done

# systemd-boot: the EFI partition, mounted apart for as long as the rename
# takes. FAT is never probed, so it is named.
if [ -n "$esp" ] && [ ! -s /run/werewolf/grubenv ]; then
	dev=$(blkid -c /dev/null -l -o device -t UUID="$esp")
	e=/run/werewolf/esp
	mkdir -p "$e"
	if [ -z "$dev" ] || ! /usr/lib/werewolf/mount -t vfat -o nosuid,nodev,noexec "$dev" "$e"; then
		say "no EFI partition $esp; not committing"
		exec sv down .
	fi
	d=$e/loader/entries
	tried=
	for f in "$d/$entry+"*.conf; do
		[ -f "$f" ] && tried=$f && break
	done
	if [ -f "$d/$entry.conf" ]; then
		say "$entry is already good"
		touch /run/werewolf/committed
	elif [ -e /run/werewolf/nodata ]; then
		say "/data is unavailable ($(cat /run/werewolf/nodata)); not committing"
	elif [ -n "$tried" ] && mv "$tried" "$d/$entry.conf" && sync; then
		touch /run/werewolf/committed
		say "healthy for a minute; $entry is good"
	else
		say "no entry for $entry in $d; not committing"
	fi
	umount "$e"
	exec sv down .
fi

# The block is on the victim's root filesystem (Debian), its /boot partition
# (Ubuntu, Rocky) or its /boot subvolume (Fedora). Either way it is mounted
# here, apart and writable, for as long as the write takes: /victim, if it is
# the same filesystem, is read-only.
dev=$(blkid -c /dev/null -l -o device -t UUID="$uuid")
dir=
if [ -n "$dev" ]; then
	mkdir -p /run/werewolf/boot
	/usr/lib/werewolf/mount -o nosuid,nodev,noexec "$dev" /run/werewolf/boot && dir=/run/werewolf/boot
fi
f=$dir$path
if [ -z "$dir" ] || [ ! -f "$f" ]; then
	say "no GRUB environment block at $uuid:$path; not committing"
	exec sv down .
fi

if grep -a -q "^saved_entry=$entry\$" "$f"; then
	say "$entry is already GRUB's default"
	touch /run/werewolf/committed
elif [ -e /run/werewolf/nodata ]; then
	# A slot that cannot reach the machine's data is not healthy, whatever
	# its services say. Leaving it uncommitted lets the deadman take the
	# machine back to the slot that last could.
	say "/data is unavailable ($(cat /run/werewolf/nodata)); not committing"
elif /usr/lib/werewolf/grubenv "$f" saved_entry "$entry"; then
	touch /run/werewolf/committed
	say "healthy for a minute; $entry is now GRUB's default"
else
	say "not committing"
fi
[ "$dir" = /run/werewolf/boot ] && umount /run/werewolf/boot
exec sv down .
