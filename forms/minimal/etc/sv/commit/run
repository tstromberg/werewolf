#!/bin/sh
# A new slot boots on probation: GRUB chose it for this boot only, and the
# next reset goes back to the slot (or, after bite, the distro) that was
# GRUB's default. Once every running service has stayed up for a minute,
# make this slot the default, and leave /run/werewolf/committed for stage0's
# deadman, which otherwise reboots the machine after ten minutes.
#
# werewolf.grubenv=UUID:PATH names GRUB's environment block, which
# /usr/lib/werewolf/grubenv rewrites in place.
exec 2>&1
[ -s /run/werewolf/grubenv ] || exec sv down .
env=$(cat /run/werewolf/grubenv)
uuid=${env%%:*}
path=${env#*:}
slot=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^werewolf\.slot=//p')
entry=werewolf-${slot:-a}

say() { echo "commit: $*"; }

healthy() {
	for s in /etc/sv/*; do
		[ "$s" = /etc/sv/commit ] && continue
		st=$(sv status "$s")
		# Running for a minute, or down because it asked to be (a service
		# that parks itself); not down while wanted up, between crashes.
		case "$st" in
		run:*)
			up=$(echo "$st" | sed -n 's/^run: [^ ]* (pid [0-9]*) \([0-9]*\)s.*/\1/p')
			[ "${up:-0}" -ge 60 ] || return 1
			;;
		*"want up"*) return 1 ;;
		esac
	done
}
until healthy; do
	sleep 15
done

# The block is on the victim's root filesystem (Debian), its /boot partition
# (Ubuntu, Rocky) or its /boot subvolume (Fedora). Either way it is mounted
# here, apart and writable, for as long as the write takes: /victim, if it is
# the same filesystem, is read-only.
dev=$(blkid -c /dev/null -l -o device -t UUID="$uuid")
dir=
if [ -n "$dev" ]; then
	mkdir -p /run/werewolf/boot
	mount -o nosuid,nodev,noexec "$dev" /run/werewolf/boot && dir=/run/werewolf/boot
fi
f=$dir$path
if [ -z "$dir" ] || [ ! -f "$f" ]; then
	say "no GRUB environment block at $uuid:$path; not committing"
	exec sv down .
fi

if grep -a -q "^saved_entry=$entry\$" "$f"; then
	say "$entry is already GRUB's default"
	touch /run/werewolf/committed
elif /usr/lib/werewolf/grubenv "$f" saved_entry "$entry"; then
	touch /run/werewolf/committed
	say "healthy for a minute; $entry is now GRUB's default"
else
	say "not committing"
fi
[ "$dir" = /run/werewolf/boot ] && umount /run/werewolf/boot
exec sv down .
