# Zeek captures eth0 as its image's user, with only the packet
# capabilities. The logs land on /data.
ok  zeek-user     p=$(head -n 1 /run/cgroup/svc/zeek/cgroup.procs); u=$(grep '^_oci-zeek:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000003000$' /proc/$p/status && grep -q '^CapBnd:[[:space:]]*0000000000003000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  zeek-caps     grep -q '^caps net_raw net_admin$' /etc/sv/zeek/service
ok  zeek-started  i=0; until [ -s /data/svc/zeek/reporter.log ] || [ -s /data/svc/zeek/conn.log ]; do i=$((i + 1)); [ $i -le 90 ] || { echo "no zeek log in 90 s"; find /data/svc/zeek /run/svc/zeek -type f 2>/dev/null | head -n 40; exit 1; }; sleep 1; done

# Generate a real DNS transaction and verify both protocol parsing and
# connection accounting. The reserved .invalid name must not resolve.
ok  zeek-dns-log chpst -u _oci-zeek nslookup werewolf-integration.invalid 10.0.2.3 >/tmp/zeek-lookup 2>&1; i=0; until grep -q 'werewolf-integration.invalid' /data/svc/zeek/dns.log; do i=$((i + 1)); [ $i -le 30 ] || exit 1; sleep 1; done; grep 'werewolf-integration.invalid' /data/svc/zeek/dns.log | grep -q '"rcode_name":"NXDOMAIN"'
ok  zeek-connection-log i=0; until grep -q '"id.resp_p":53' /data/svc/zeek/conn.log; do i=$((i + 1)); [ $i -le 45 ] || exit 1; sleep 1; done; grep '"id.resp_p":53' /data/svc/zeek/conn.log | grep -q '"id.orig_h":"10.0.2.15"'
