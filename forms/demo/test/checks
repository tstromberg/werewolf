# The scan, grype over the image, takes a quarter share of contended CPUs
# (its service's `cpu 25`), so a scan cannot starve the page or nginx.
ok  scan-cpu-share   i=0; until [ -f /run/cgroup/svc/scan/cpu.weight ]; do i=$((i + 1)); [ $i -le 30 ] || { echo "no scan cgroup"; exit 1; }; sleep 1; done; grep -qx 25 /run/cgroup/svc/scan/cpu.weight

# Read the rendered page, its actual logo and the public HTTP policy.
ok  demo-page i=0; until wget -q -T 5 -O /tmp/demo.html http://127.0.0.1/ && grep -q 'Security' /tmp/demo.html && grep -q 'kernel' /tmp/demo.html; do i=$((i + 1)); [ $i -le 90 ] || exit 1; sleep 1; done
ok  demo-logo wget -q -T 5 -O /tmp/demo-logo.png http://127.0.0.1/logo.png && cmp /tmp/demo-logo.png /usr/share/werewolf-demo/logo.png
ok  demo-headers h=$(wget -q -T 5 -S -O /dev/null http://127.0.0.1/ 2>&1); echo "$h" | grep -qi 'X-Content-Type-Options: nosniff' && echo "$h" | grep -qi 'Content-Security-Policy:.*form-action' && echo "$h" | grep -qi 'Referrer-Policy: no-referrer'
ok  demo-hidden wget -q -T 5 -S -O /dev/null http://127.0.0.1/scan.json 2>&1 | grep -q 'HTTP/1.1 404'
ok  demo-readonly wget -q -T 5 -S -O /dev/null --post-data 'changed' http://127.0.0.1/ 2>&1 | grep -q 'HTTP/1.1 403'
