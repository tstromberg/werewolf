# The demo's page, as its own user: it reads what the other services keep
# and the machine's state, writes only its own directory, and reaches
# nothing on the network.
exec    /usr/lib/werewolf/status-page
user    status
pledge  stdio rpath wpath unix connect
read    /data/svc/scan /data/svc/autoupdate /run/werewolf
# nginx serves its page, /data/svc/status/www.
share   shared
