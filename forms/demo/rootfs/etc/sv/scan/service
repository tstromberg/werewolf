# grype over the image, hourly, as its own user, the only one that may
# fetch (forms/demo/form.yaml): it reads everything, writes only its own
# directory, and runs nothing but grype.
exec    /usr/lib/werewolf/status-page scan
run     /usr/bin/grype
user    grype
pledge  stdio rpath wpath proc exec inet unix connect
connect tcp/443 tcp/53
read    /
# status reads its findings.
share   shared
# A quarter share of contended CPUs, so a scan cannot starve the page.
cpu     25
