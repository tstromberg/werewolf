#!/bin/sh
# forms/valkey-tcp/test/config DIR: the password and a 64 MiB cap, which
# forms/valkey-tcp/test/tests.yaml reads back. The password has no newline.
set -eu
mkdir -p "$1/valkey"
umask 077
printf '%s' werewolf-check-password >"$1/valkey/password"
printf '%s' '{"maxmemory":64}' >"$1/valkey/settings.json"
