# What the prometheus form, booted as it ships, without a shell and
# without a config, must say on its console (make
# check-shellfree-prometheus; test/boot; forms/demo/test/console has the
# format). Given no password, Prometheus parks before prometheus-setup
# writes anything or Prometheus binds a port, and says why. make
# check-prometheus boots it with its config, and checks it scrapes.

seen    prom-needs-config  leash: \{"event":"down","service":"prometheus","why":"config admin-password: FileNotFound"\}
unseen  setup-ran          prometheus-setup: prometheus\.yml
