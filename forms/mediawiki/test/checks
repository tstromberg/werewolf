# MediaWiki was installed from the settings before it served
# (forms/mediawiki/test/config): the API answers, a stranger reads
# nothing, and the main page is the wiki's to an account; the
# administrator logs in with the config's password, and a wrong one does
# not. The attacks: a stranger's edit and a stranger's sign-up are
# refused, and neither leaves a trace; uploads of an SVG, of HTML with a
# script, and of the same named .png are refused even from the
# administrator, while a PDF is taken and handed out by img_auth.php to
# accounts alone (busybox wget posts no NUL bytes, so no PNG); the code is
# not served; and guessing the password is throttled, the right one refused
# too, once it starts. Each login keeps its cookies in /tmp/mw.cookie.
ok  mw-user          p=$(pidof php-fpm | cut -d' ' -f1); u=$(id -u php); grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  mw-installed     i=0; until wget -q -T 10 -O /tmp/mw.json 'http://localhost/api.php?action=query&meta=siteinfo&format=json' 2>/dev/null; do i=$((i + 1)); [ $i -le 180 ] || { echo "the wiki does not answer"; exit 1; }; sleep 1; done; grep -q '"code":"readapidenied"' /tmp/mw.json || { cat /tmp/mw.json; exit 1; }
ok  mw-login         r=$(wget -q -T 10 -S -O /tmp/mw.tok 'http://localhost/api.php?action=query&meta=tokens&type=login&format=json' 2>&1); c1=$(echo "$r" | sed -n 's/^ *Set-Cookie: \([^;]*\);.*/\1/p'); t=$(sed -n 's/.*"logintoken":"\([^"]*\)".*/\1/p' /tmp/mw.tok | sed 's/\\\\/%5C/; s/+/%2B/'); r=$(wget -q -T 30 -S -O /tmp/mw.login --header "Cookie: $(echo $c1 | sed 's/ /; /g')" --post-data "action=login&format=json&lgname=Admin&lgpassword=werewolf-check-pass-1&lgtoken=$t" http://localhost/api.php 2>&1); grep -q '"result":"Success"' /tmp/mw.login || { cat /tmp/mw.tok /tmp/mw.login; exit 1; }; c2=$(echo "$r" | sed -n 's/^ *Set-Cookie: \([^;]*\);.*/\1/p'); printf '%s\n%s\n' "$c1" "$c2" | awk -F= 'NF && $2 != "deleted" { v[$1] = $0 } END { s = ""; for (k in v) s = s v[k] "; "; printf "%s", s }' >/tmp/mw.cookie
ok  mw-main-page     wget -q -T 30 -O /tmp/mw.html --header "Cookie: $(cat /tmp/mw.cookie)" http://localhost/wiki/ && grep -q 'Werewolf check wiki' /tmp/mw.html && grep -q 'MediaWiki has been installed' /tmp/mw.html
ok  mw-wrong-password r=$(wget -q -T 10 -S -O /tmp/mw.tok 'http://localhost/api.php?action=query&meta=tokens&type=login&format=json' 2>&1); c=$(echo "$r" | sed -n 's/^ *Set-Cookie: \([^;]*\);.*/\1/p' | sed 's/$/;/' | tr '\n' ' '); t=$(sed -n 's/.*"logintoken":"\([^"]*\)".*/\1/p' /tmp/mw.tok | sed 's/\\\\/%5C/; s/+/%2B/'); wget -q -T 30 -O /tmp/mw.login --header "Cookie: $c" --post-data "action=login&format=json&lgname=Admin&lgpassword=werewolf-wrong-pass&lgtoken=$t" http://localhost/api.php; grep -q '"result":"Failed"' /tmp/mw.login || { cat /tmp/mw.login; exit 1; }
ok  mw-anon-edit     wget -q -T 30 -O /tmp/mw.edit --post-data 'action=edit&format=json&title=Werewolf_attack&text=pwned&createonly=1&token=%2B%5C' http://localhost/api.php; grep -q '"error"' /tmp/mw.edit || { cat /tmp/mw.edit; exit 1; }; wget -q -T 10 -O /tmp/mw.q --header "Cookie: $(cat /tmp/mw.cookie)" 'http://localhost/api.php?action=query&titles=Werewolf_attack&format=json'; grep -q '"missing"' /tmp/mw.q || { cat /tmp/mw.q; exit 1; }
ok  mw-anon-signup   r=$(wget -q -T 10 -S -O /tmp/mw.tok 'http://localhost/api.php?action=query&meta=tokens&type=createaccount&format=json' 2>&1); c=$(echo "$r" | sed -n 's/^ *Set-Cookie: \([^;]*\);.*/\1/p' | sed 's/$/;/' | tr '\n' ' '); t=$(sed -n 's/.*"createaccounttoken":"\([^"]*\)".*/\1/p' /tmp/mw.tok | sed 's/\\\\/%5C/; s/+/%2B/'); wget -q -T 30 -O /tmp/mw.signup --header "Cookie: $c" --post-data "action=createaccount&format=json&username=Mallory&password=mallory-pass-123456&retype=mallory-pass-123456&createreturnurl=http://localhost/&createtoken=${t:-%2B%5C}" http://localhost/api.php; ! grep -q '"status":"PASS"' /tmp/mw.signup || { cat /tmp/mw.signup; exit 1; }; wget -q -T 10 -O /tmp/mw.q --header "Cookie: $(cat /tmp/mw.cookie)" 'http://localhost/api.php?action=query&list=allusers&format=json'; grep -q '"name":"Admin"' /tmp/mw.q && ! grep -q Mallory /tmp/mw.q || { cat /tmp/mw.signup /tmp/mw.q; exit 1; }
ok  mw-upload-banned k=$(cat /tmp/mw.cookie); t=$(wget -q -T 10 -O - --header "Cookie: $k" 'http://localhost/api.php?action=query&meta=tokens&format=json' | sed -n 's/.*"csrftoken":"\([^"]*\)".*/\1/p' | sed 's/\\\\/\\/'); [ -n "$t" ] || { echo "no csrf token"; exit 1; }; for f in x.svg:filetype-banned:'<svg xmlns="http://www.w3.org/2000/svg"><rect width="1" height="1"/></svg>' x.html:verification-error:'<html><script>alert(document.cookie)</script></html>' x.png:verification-error:'<html><script>alert(document.cookie)</script></html>'; do n=${f%%:*} r=${f#*:}; e=${r%%:*} b=${r#*:}; printf -- '--B\r\nContent-Disposition: form-data; name="action"\r\n\r\nupload\r\n--B\r\nContent-Disposition: form-data; name="format"\r\n\r\njson\r\n--B\r\nContent-Disposition: form-data; name="ignorewarnings"\r\n\r\n1\r\n--B\r\nContent-Disposition: form-data; name="filename"\r\n\r\n%s\r\n--B\r\nContent-Disposition: form-data; name="token"\r\n\r\n%s\r\n--B\r\nContent-Disposition: form-data; name="file"; filename="%s"\r\nContent-Type: image/png\r\n\r\n%s\r\n--B--\r\n' $n "$t" $n "$b" >/tmp/mw.body; wget -q -T 30 -O /tmp/mw.up --header "Cookie: $k" --header 'Content-Type: multipart/form-data; boundary=B' --post-file /tmp/mw.body http://localhost/api.php; grep -q "\"code\":\"$e\"" /tmp/mw.up || { echo "$n, not $e:"; cat /tmp/mw.up; exit 1; }; done; ! ls /data/svc/php-fpm/images | grep -qi '^x\.'
ok  mw-upload-pdf    k=$(cat /tmp/mw.cookie); t=$(wget -q -T 10 -O - --header "Cookie: $k" 'http://localhost/api.php?action=query&meta=tokens&format=json' | sed -n 's/.*"csrftoken":"\([^"]*\)".*/\1/p' | sed 's/\\\\/\\/'); printf -- '--B\r\nContent-Disposition: form-data; name="action"\r\n\r\nupload\r\n--B\r\nContent-Disposition: form-data; name="format"\r\n\r\njson\r\n--B\r\nContent-Disposition: form-data; name="ignorewarnings"\r\n\r\n1\r\n--B\r\nContent-Disposition: form-data; name="filename"\r\n\r\nWerewolf.pdf\r\n--B\r\nContent-Disposition: form-data; name="token"\r\n\r\n%s\r\n--B\r\nContent-Disposition: form-data; name="file"; filename="Werewolf.pdf"\r\nContent-Type: application/pdf\r\n\r\n%%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/MediaBox[0 0 3 3]/Parent 2 0 R>>endobj\ntrailer<</Root 1 0 R>>\n%%%%EOF\n\r\n--B--\r\n' "$t" >/tmp/mw.body; wget -q -T 30 -O /tmp/mw.up --header "Cookie: $k" --header 'Content-Type: multipart/form-data; boundary=B' --post-file /tmp/mw.body http://localhost/api.php; grep -q '"result":"Success"' /tmp/mw.up || { cat /tmp/mw.up; exit 1; }; u=$(sed 's/\\\//\//g' /tmp/mw.up | sed -n 's/.*"url":"http:\/\/localhost\([^"]*\)".*/\1/p'); [ -n "$u" ] || { cat /tmp/mw.up; exit 1; }; wget -q -T 10 -O /tmp/mw.pdf --header "Cookie: $k" "http://localhost$u" || { echo "the administrator cannot get $u"; exit 1; }; [ "$(head -c 5 /tmp/mw.pdf)" = %PDF- ] || { echo "not the pdf: $u"; exit 1; }; ! wget -q -T 10 -O /dev/null "http://localhost$u" 2>/dev/null || { echo "a stranger got $u"; exit 1; }
ok  mw-code-hidden   for u in LocalSettings.php includes/Defines.php maintenance/run.php vendor/autoload.php composer.json cache/ images/ mw-config/index.php extensions/OATHAuth/extension.json; do wget -q -T 10 -S -O /dev/null "http://localhost/$u" 2>&1 | grep -q 'HTTP/1.1 404' || { echo "served: $u"; exit 1; }; done
ok  mw-private       u=$(id -u php); [ "$(stat -c '%u:%a' /run/svc/php-fpm/admin-password)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/php-fpm/secrets.php)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/php-fpm/images)" = $u:700 ] && [ -s /data/svc/php-fpm/database/wiki.sqlite ] && [ ! -e /data/svc/php-fpm/database.new ] && [ ! -e /run/svc/php-fpm/LocalSettings.php ]
ok  mw-throttled     n=0; for i in 1 2 3 4 5 6 7; do r=$(wget -q -T 10 -S -O /tmp/mw.tok 'http://localhost/api.php?action=query&meta=tokens&type=login&format=json' 2>&1); c=$(echo "$r" | sed -n 's/^ *Set-Cookie: \([^;]*\);.*/\1/p' | sed 's/$/;/' | tr '\n' ' '); t=$(sed -n 's/.*"logintoken":"\([^"]*\)".*/\1/p' /tmp/mw.tok | sed 's/\\\\/%5C/; s/+/%2B/'); [ $i = 7 ] && p=werewolf-check-pass-1 || p=werewolf-guess-$i; wget -q -T 30 -O /tmp/mw.login --header "Cookie: $c" --post-data "action=login&format=json&lgname=Admin&lgpassword=$p&lgtoken=$t" http://localhost/api.php; done; grep -qi 'too many' /tmp/mw.login && ! grep -q '"result":"Success"' /tmp/mw.login || { cat /tmp/mw.login; exit 1; }
# After an update of the image the setup updates the database once: a
# schema record that differs from the image's, then a restart, runs
# update.php inside php-fpm's leash, which writes the record back. Last, as
# a restart empties APCu, and the login throttle with it.
ok  mw-update        f=/data/svc/php-fpm/database/schema; w=$(cat $f); echo '1.43.10 stale' >$f; sv restart /etc/sv/php-fpm; i=0; until [ "$(cat $f)" = "$w" ]; do i=$((i + 1)); [ $i -le 180 ] || { echo "schema still: $(cat $f)"; exit 1; }; sleep 1; done; i=0; until wget -q -T 10 -O /tmp/mw.json 'http://localhost/api.php?action=query&meta=siteinfo&format=json' 2>/dev/null; do i=$((i + 1)); [ $i -le 60 ] || { echo "the wiki does not answer"; exit 1; }; sleep 1; done; grep -q '"code":"readapidenied"' /tmp/mw.json && [ "$(stat -c '%u:%a' $f)" = "$(id -u php):600" ]
