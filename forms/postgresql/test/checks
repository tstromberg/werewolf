# PostgreSQL always reaches the static adapter, including DEV builds.
ok  postgres-shim       [ "$(readlink /usr/bin/sh)" = /usr/lib/werewolf/sh-shim ] && [ ! -e /usr/lib/werewolf/popen-shim.so ] && grep -qx 'run /usr/lib/werewolf/sh-shim' /etc/sv/postgres/service && grep -qx 'run /usr/bin/locale' /etc/sv/postgres/service
# Descriptor discards work; a real file target fails before creating it.
ok  postgres-redirs     n=/usr/lib/werewolf/sh-shim; [ "$($n -c 'busybox echo keep')" = keep ] && [ -z "$($n -c 'busybox echo discard > /dev/null 2>&1')" ] && [ -z "$($n -c 'busybox cat < /dev/null')" ] && { $n -c 'busybox echo refused > /run/pg-shim-created' 2>/dev/null; [ $? -eq 126 ]; } && [ ! -e /run/pg-shim-created ]
# Query through peer authentication; preserve UTF-8 data and the C locale.
ok  postgres-sql        q() { chpst -u postgres psql -h /run/svc/postgres -d postgres -Atqc "$1"; }; [ "$(q "SELECT current_setting('server_encoding') || '/' || datcollate || '/' || datctype FROM pg_database WHERE datname = current_database()")" = UTF8/C/C ] && [ "$(q "CREATE TABLE werewolf_shim_check(value text); INSERT INTO werewolf_shim_check VALUES ('h' || chr(233) || 'llo'); SELECT encode(convert_to(value, 'UTF8'), 'hex') FROM werewolf_shim_check")" = 68c3a96c6c6f ]
ok  postgres-peer       ! chpst -u nobody psql -h /run/svc/postgres -U postgres -d postgres -Atqc 'SELECT 1' 2>/dev/null

# A rolled-back write must not survive inside the same database.
ok  postgres-rollback [ "$(chpst -u postgres psql -h /run/svc/postgres -d postgres -Atqc "BEGIN; INSERT INTO werewolf_shim_check VALUES ('rolled-back'); ROLLBACK; SELECT count(*) FROM werewolf_shim_check WHERE value='rolled-back';")" = 0 ]
ok  postgres-local ! netstat -ltn | grep -q ':5432 '
