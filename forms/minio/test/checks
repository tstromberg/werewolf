# MinIO answers S3 with the root credentials: a bucket, an object up and
# back as it went, on /data; an anonymous request is refused, the console
# is nowhere, and the credentials are root's files, not the service's.
ok  minio-user       p=$(head -n 1 /run/cgroup/svc/minio/cgroup.procs); grep -q '^Uid:[[:space:]]*217[[:space:]]' /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  minio-live       i=0; until wget -q -T 5 -S -O /dev/null http://127.0.0.1:9000/minio/health/live 2>&1 | grep -q 'HTTP/1.1 200'; do i=$((i + 1)); [ $i -le 90 ] || { echo "not live"; exit 1; }; sleep 1; done
ok  minio-anonymous  wget -q -T 5 -S -O /dev/null http://127.0.0.1:9000/ 2>&1 | grep -q 'HTTP/1.1 403'
ok  minio-round-trip export HOME=/tmp MC_CONFIG_DIR=/tmp/mc; mc --quiet alias set w http://127.0.0.1:9000 werewolf-check werewolf-check-password >/dev/null && mc --quiet mb w/check >/dev/null && printf 'kept\n' >/tmp/minio.in && mc --quiet cp /tmp/minio.in w/check/x >/dev/null && [ "$(mc cat w/check/x)" = kept ] && [ -d /data/svc/minio/check/x ]
ok  minio-object-private wget -q -T 5 -S -O /dev/null http://127.0.0.1:9000/check/x 2>&1 | grep -q 'HTTP/1.1 403'
ok  minio-no-console ! netstat -ltn | grep -q ':9001 ' && wget -q -T 5 -S -O /dev/null http://127.0.0.1:9000/login 2>&1 | grep -q 'HTTP/1.1 4'
ok  minio-private    [ "$(stat -c '%u:%a' /run/config/minio/root_password)" = 0:600 ] && ! chpst -u minio cat /run/config/minio/root_password >/dev/null 2>&1
