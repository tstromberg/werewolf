# MinIO, as its own user: it may bind :9000 and no other port, read the
# image, and write only its own directories, where the objects are. It
# reaches nothing on the network. The root user and password come from
# the config into its environment; missing, the service parks with a
# line naming the file.
exec    /usr/bin/minio server --address :9000 --quiet /data/svc/minio
user    minio
# netlink: it lists the host's addresses at start, as Go's net.Interfaces does.
pledge  stdio rpath wpath inet unix netlink listen proc sendfile
listen  tcp/9000
secret  MINIO_ROOT_USER /run/config/minio/root_user
secret  MINIO_ROOT_PASSWORD /run/config/minio/root_password
memory  768
nofile  65536
env     HOME=/run/svc/minio
# No console (the API is the interface, mc its client), no update
# check, TLS in front.
env     MINIO_BROWSER=off
env     MINIO_UPDATE=off
env     MINIO_API_ROOT_ACCESS=on
env     GOMEMLIMIT=512MiB
