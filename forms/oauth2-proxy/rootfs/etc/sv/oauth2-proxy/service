# oauth2-proxy, as its own user: it may bind :4180 and no other port,
# reach the provider over HTTPS and the upstream over HTTP, read its
# configuration and the image, and write only its own directory. The
# provider, client and who may enter come from the machine's settings as
# its own environment variables; its two secrets from the config.
exec    /usr/bin/oauth2-proxy --config /etc/oauth2-proxy/oauth2-proxy.cfg
user    oauth2-proxy
pledge  stdio rpath wpath inet unix connect listen proc
listen  tcp/4180
connect tcp/443 tcp/80 tcp/53
read    /etc/oauth2-proxy
secret  OAUTH2_PROXY_CLIENT_SECRET /run/config/oauth2-proxy/client_secret
secret  OAUTH2_PROXY_COOKIE_SECRET /run/config/oauth2-proxy/cookie_secret
config  settings /run/config/oauth2-proxy/settings.json
setting provider-url url required as OAUTH2_PROXY_OIDC_ISSUER_URL
setting client-id string required as OAUTH2_PROXY_CLIENT_ID
setting redirect-url url required as OAUTH2_PROXY_REDIRECT_URL
setting email-domains hostname... as OAUTH2_PROXY_EMAIL_DOMAINS
setting allowed-groups hostname... as OAUTH2_PROXY_ALLOWED_GROUPS
# For a provider without discovery, or one the machine cannot reach at
# start: its endpoints by hand.
setting skip-discovery bool as OAUTH2_PROXY_SKIP_OIDC_DISCOVERY
setting login-url url as OAUTH2_PROXY_LOGIN_URL
setting redeem-url url as OAUTH2_PROXY_REDEEM_URL
setting jwks-url url as OAUTH2_PROXY_OIDC_JWKS_URL
render  env provider
memory  256
nofile  4096
env     HOME=/run/svc/oauth2-proxy
env     GOMEMLIMIT=192MiB
