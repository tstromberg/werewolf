# BloodHound answers through Caddy. Neo4j is Bolt on loopback and has no
# HTTP. The published passwords are not accepted.
ok  bh-health   i=0; until out=$(wget -q -T 5 --no-check-certificate -S -O - https://localhost/api/v2/self 2>&1); printf '%s\n' "$out" | grep -Eq 'HTTP/1.1 (401|403)|\{"data":null\}'; do i=$((i + 1)); [ $i -le 120 ] || { printf 'no API in 120 s: %s\n' "$out"; exit 1; }; sleep 1; done
ok  bh-user     p=$(head -n 1 /run/cgroup/svc/bloodhound/cgroup.procs); u=$(grep '^_oci-bloodhound:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  neo4j-user  p=$(head -n 1 /run/cgroup/svc/neo4j/cgroup.procs); u=$(grep '^neo4j:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status
ok  neo4j-bolt  grep -qi '0100007F:1E07 ' /proc/net/tcp && ! grep -qi '00000000:1E07 ' /proc/net/tcp && ! grep -qi ':1D32 ' /proc/net/tcp
ok  bh-bind     grep -qi '0100007F:1F90 ' /proc/net/tcp && ! grep -qi '00000000:1F90 ' /proc/net/tcp
ok  bh-anon     out=$(wget -q -T 15 --no-check-certificate -S -O - https://localhost/api/v2/self 2>&1); printf '%s\n' "$out" | grep -Eq 'HTTP/1.1 (401|403)|\{"data":null\}' || { printf '%s\n' "$out"; exit 1; }
ok  bh-wrong    wget -q -T 30 --no-check-certificate -S -O /dev/null --header 'Content-Type: application/json' --post-data '{"login_method":"secret","username":"admin","secret":"bloodhoundcommunityedition"}' https://localhost/api/v2/login 2>&1 | grep -Eq 'HTTP/1.1 (401|403|400)'
ok  bh-admin    wget -q -T 30 --no-check-certificate -S -O /dev/null --header 'Content-Type: application/json' --post-data '{"login_method":"secret","username":"admin","secret":"werewolf-check-pass-1"}' https://localhost/api/v2/login 2>&1 | grep -q 'HTTP/1.1 200'
