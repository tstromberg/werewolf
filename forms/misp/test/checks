# The login page answers through Caddy. PHP is on loopback. 8080 is
# 0x1F90. 9001 is 0x2329 and 9002 is 0x232A: the supervisor port and
# the image's public FastCGI, neither of which is open. 3306 is
# 0x0CEA and 6379 is 0x18EB, both loopback.
ok  misp-login   i=0; until wget -q -T 5 --no-check-certificate -O /tmp/misp-login.html https://localhost/users/login; do i=$((i + 1)); [ $i -le 300 ] || { echo "no login in 300 s"; exit 1; }; sleep 1; done; grep -qi password /tmp/misp-login.html
ok  misp-user    p=$(head -n 1 /run/cgroup/svc/misp/cgroup.procs); u=$(grep '^_oci-misp:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  misp-bind    grep -qi '0100007F:1F90 ' /proc/net/tcp && ! grep -qi '00000000:1F90 ' /proc/net/tcp && ! grep -qi ':2329 ' /proc/net/tcp && ! grep -qi ':232A ' /proc/net/tcp
ok  misp-db      grep -qi '0100007F:0CEA ' /proc/net/tcp && ! grep -qi '00000000:0CEA ' /proc/net/tcp && grep -qi '0100007F:18EB ' /proc/net/tcp
ok  misp-serve   found=0; for p in $(cat /run/cgroup/svc/misp/cgroup.procs); do c=$(cat /proc/$p/comm); case $c in python*|supervisord) echo "unexpected $c"; exit 1;; esac; [ "$c" = misp-serve ] && found=1; done; [ "$found" = 1 ]
seen misp-secrets misp-serve: .*"event":"start".*"local-credentials":true,"passwords-private":true
ok  misp-published  password=admin; for email in admin@admin.test admin@localhost; do j=/tmp/misp-jar; curl -sfk --max-time 10 -c $j -o /tmp/misp-form.html https://localhost/users/login && t=$(sed -n 's/.*name="data\[_Token\]\[key\]" value="\([^"]*\)".*/\1/p' /tmp/misp-form.html) && f=$(sed -n 's/.*name="data\[_Token\]\[fields\]" value="\([^"]*\)".*/\1/p' /tmp/misp-form.html) && [ -n "$t" ] && [ -n "$f" ] && [ "$(curl -sk --max-time 20 -b $j -c $j -e https://localhost/users/login --data-urlencode "data[_Token][key]=$t" --data-urlencode "data[_Token][fields]=$f" --data-urlencode 'data[_Token][unlocked]=' --data-urlencode "data[User][email]=$email" --data-urlencode "data[User][password]=$password" -o /tmp/misp-auth.html -w '%{http_code} %{redirect_url}' https://localhost/users/login)" = '200 ' ] && grep -qi password /tmp/misp-auth.html && ! grep -qi '/events/index' /tmp/misp-auth.html || exit 1; done
ok  misp-admin      email=admin@localhost; password=werewolf-check-pass-1; j=/tmp/misp-jar; curl -sfk --max-time 10 -c $j -o /tmp/misp-form.html https://localhost/users/login && t=$(sed -n 's/.*name="data\[_Token\]\[key\]" value="\([^"]*\)".*/\1/p' /tmp/misp-form.html) && f=$(sed -n 's/.*name="data\[_Token\]\[fields\]" value="\([^"]*\)".*/\1/p' /tmp/misp-form.html) && [ -n "$t" ] && [ -n "$f" ] && [ "$(curl -sk --max-time 20 -b $j -c $j -e https://localhost/users/login --data-urlencode "data[_Token][key]=$t" --data-urlencode "data[_Token][fields]=$f" --data-urlencode 'data[_Token][unlocked]=' --data-urlencode "data[User][email]=$email" --data-urlencode "data[User][password]=$password" -o /tmp/misp-auth.html -w '%{http_code} %{redirect_url}' https://localhost/users/login)" = '302 https://localhost/users/routeafterlogin' ] && [ "$(curl -sk --max-time 10 -b $j -o /dev/null -w '%{http_code} %{redirect_url}' https://localhost/users/view/me)" = '302 https://localhost/users/change_pw' ]
# The configured password authenticates, but MISP requires its first-login rotation.
# Complete that flow, including CSRF validation, before checking the user's profile.
ok  misp-password   j=/tmp/misp-jar; curl -sfk --max-time 10 -b $j -c $j -o /tmp/misp-password.html https://localhost/users/change_pw && t=$(sed -n 's/.*name="data\[_Token\]\[key\]" value="\([^"]*\)".*/\1/p' /tmp/misp-password.html) && f=$(sed -n 's/.*name="data\[_Token\]\[fields\]" value="\([^"]*\)".*/\1/p' /tmp/misp-password.html) && [ -n "$t" ] && [ -n "$f" ] && [ "$(curl -sk --max-time 20 -b $j -c $j -e https://localhost/users/change_pw --data-urlencode "data[_Token][key]=$t" --data-urlencode "data[_Token][fields]=$f" --data-urlencode 'data[_Token][unlocked]=' --data-urlencode 'data[User][password]=werewolf-check-pass-2' --data-urlencode 'data[User][confirm_password]=werewolf-check-pass-2' -o /tmp/misp-password-response.html -w '%{http_code}' https://localhost/users/change_pw)" = 302 ] && curl -sfk --max-time 10 -b $j https://localhost/users/view/me | grep -q 'admin@localhost'
