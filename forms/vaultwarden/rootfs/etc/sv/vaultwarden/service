# Vaultwarden, as its own user: it may bind :8080 and no other port, read
# the image, and write only its own directories, where the vault is. It
# reaches nothing on the network. The site's address comes from the
# machine's settings; the admin's Argon2 token from the config, read by
# Vaultwarden from leash's copy (ADMIN_TOKEN_FILE): missing, the service
# parks with a line naming the file.
exec    /usr/bin/vaultwarden
user    vaultwarden
pledge  stdio rpath wpath inet unix listen proc
listen  tcp/8080
config  admin-token /run/config/vaultwarden/admin_token
config  settings /run/config/vaultwarden/settings.json
setting domain url required as DOMAIN
render  env site
memory  256
nofile  4096
env     HOME=/run/svc/vaultwarden
env     ADMIN_TOKEN_FILE=/run/svc/vaultwarden/admin-token
env     DATA_FOLDER=/data/svc/vaultwarden
env     DATABASE_URL=sqlite:///data/svc/vaultwarden/db.sqlite3
env     ENABLE_DB_WAL=true
env     WEB_VAULT_FOLDER=/usr/share/vaultwarden/web-vault
env     ROCKET_ADDRESS=0.0.0.0
env     ROCKET_PORT=8080
# The admin page's settings are written nowhere: this file in the image,
# which does not exist, is where they would go, so the configuration is
# the image's and the machine's settings alone.
env     CONFIG_FILE=/etc/vaultwarden/config.json
# No one signs up; the admin invites. No hint is kept or shown.
env     SIGNUPS_ALLOWED=false
env     INVITATIONS_ALLOWED=true
env     PASSWORD_HINTS_ALLOWED=false
env     SHOW_PASSWORD_HINT=false
# Nothing fetched: an icon download is a request to every site a user
# saves, from the machine, on their behalf.
env     DISABLE_ICON_DOWNLOAD=true
env     ICON_SERVICE=internal
# Behind caddy, which says who the client is.
env     IP_HEADER=X-Forwarded-For
env     LOG_LEVEL=info
env     EXTENDED_LOGGING=true
env     USE_SYSLOG=false
