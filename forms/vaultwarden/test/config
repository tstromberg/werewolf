#!/bin/sh
# forms/vaultwarden/test/config DIR: the vaultwarden form's config for make check, in
# DIR: the site's address and the admin token, an Argon2id PHC string of
# werewolf-check-admin, which forms/vaultwarden/test/checks logs in with
# (vaultwarden hash makes the same on a machine that has it).
set -eu
d=$1/vaultwarden
mkdir -p "$d"
umask 077
openssl rand -out "$d/.salt" 16
hash=$(openssl kdf -keylen 32 -kdfopt pass:werewolf-check-admin \
	-kdfopt hexsalt:"$(od -An -tx1 "$d/.salt" | tr -d ' \n')" -kdfopt iter:3 -kdfopt memcost:65536 \
	-kdfopt lanes:4 -binary ARGON2ID | openssl base64 -A | tr -d '=')
salt=$(openssl base64 -A -in "$d/.salt" | tr -d '=')
rm "$d/.salt"
printf '$argon2id$v=19$m=65536,t=3,p=4$%s$%s' "$salt" "$hash" >"$d/admin-token"
echo '{"domain":"http://127.0.0.1:8080"}' >"$d/settings.json"
