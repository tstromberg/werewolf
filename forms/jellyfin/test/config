#!/bin/sh
# forms/jellyfin/test/config DIR: the jellyfin form's config for make
# check, in DIR: its domain, localhost, for which Caddy's own CA signs, and
# the administrator and password the wizard is completed with, which
# test/checks signs in as.
set -eu
mkdir -p "$1/caddy"
umask 077
printf '%s' werewolf-check-pass-1 >"$1/caddy/jellyfin-password"
echo '{"domain":"localhost","jellyfin-admin":"admin"}' >"$1/caddy/settings.json"
