#!/bin/sh
# forms/open-webui/test/config DIR: the open-webui form's config for make
# check, in DIR: its base URL, https://localhost, for which Caddy's own CA
# signs, and its administrator and password, which test/checks signs in
# with.
set -eu
mkdir -p "$1/open-webui" "$1/caddy"
umask 077
printf '%s' werewolf-check-pass-1 >"$1/open-webui/admin-password"
echo '{"base-url":"https://localhost","admin-email":"admin@example.test"}' >"$1/open-webui/settings.json"
echo '{"base-url":"https://localhost"}' >"$1/caddy/settings.json"
