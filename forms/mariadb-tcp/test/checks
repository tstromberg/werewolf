# Port 3306 is open, and the socket still answers. The client is
# mariadb-local's dev package.
ok  mariadb-tcp      m="mariadb -S /run/svc/mariadb/mariadb.sock -N"; i=0; until $m -e 'select 1' 2>/dev/null | grep -qx 1; do i=$((i + 1)); [ $i -le 60 ] || { echo "no answer in 60 s"; exit 1; }; sleep 1; done; [ "$($m -e 'select @@skip_networking')" = 0 ] && [ "$($m -e 'select @@port')" = 3306 ] && netstat -ltn | grep -q ':3306 '

# Make a scoped password account through the local administrative socket,
# then use the network protocol for the application's write and read.
ok  mariadb-tcp-roundtrip mariadb -S /run/svc/mariadb/mariadb.sock -e "CREATE DATABASE integration; CREATE USER 'network_check'@'127.0.0.1' IDENTIFIED BY 'werewolf-network-pass-1'; GRANT ALL ON integration.* TO 'network_check'@'127.0.0.1';" && [ "$(mariadb --protocol=TCP -h 127.0.0.1 -u network_check -pwerewolf-network-pass-1 -N integration -e "CREATE TABLE items (id INT PRIMARY KEY, value VARCHAR(64)); INSERT INTO items VALUES (1, 'network-roundtrip'); SELECT value FROM items WHERE id=1;")" = network-roundtrip ]
ok  mariadb-tcp-wrong-password e=$(mariadb --protocol=TCP -h 127.0.0.1 -u network_check -pwrong-password -N -e 'SELECT 1' 2>&1); r=$?; [ $r -ne 0 ] && echo "$e" | grep -q 'ERROR 1045'
ok  mariadb-tcp-root-refused e=$(mariadb --protocol=TCP -h 127.0.0.1 -u root -N -e 'SELECT 1' 2>&1); r=$?; [ $r -ne 0 ] && echo "$e" | grep -Eq 'ERROR (1045|1698)'
ok  mariadb-tcp-role e=$(mariadb --protocol=TCP -h 127.0.0.1 -u network_check -pwerewolf-network-pass-1 -N -e 'SELECT * FROM mysql.user' 2>&1); r=$?; [ $r -ne 0 ] && echo "$e" | grep -q 'ERROR 1142'
