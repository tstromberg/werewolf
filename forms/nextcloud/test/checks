# Nextcloud was installed from the config before it served
# (forms/nextcloud/test/config): it answers through Caddy over HTTPS, with
# a certificate from Caddy's own CA for localhost, installed, out of
# maintenance and current; wait, as the first start installs it. The
# administrator signs in with the config's password and a wrong one is
# refused; a file goes up and comes back over WebDAV and lands on /data.
# Its code is the image's: the web updater, the code's insides and every
# script but Nextcloud's entry points are 404, and nextcloud cannot write
# the code. Nobody signs up, and nothing is installed by a stranger. The
# background jobs run by cron, as nextcloud-cron; what is secret is
# nextcloud's alone.
ok  nc-installed     i=0; until wget -q -T 10 --no-check-certificate -O /tmp/nc.status https://localhost/status.php 2>/dev/null && grep -q '"installed":true' /tmp/nc.status; do i=$((i + 1)); [ $i -le 600 ] || { echo "not installed in 600 s"; cat /tmp/nc.status; exit 1; }; sleep 1; done; grep -q '"maintenance":false' /tmp/nc.status && grep -q '"needsDbUpgrade":false' /tmp/nc.status
ok  nc-user          p=$(head -n 1 /run/cgroup/svc/nextcloud/cgroup.procs); u=$(grep '^nextcloud:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  nc-https         wget -q -T 5 -S -O /dev/null http://localhost/ 2>&1 | grep -qi 'Location: https://localhost/'
ok  nc-no-installer  [ ! -e /usr/share/nextcloud/config/CAN_INSTALL ] && [ ! -e /data/svc/nextcloud/config/CAN_INSTALL ] && wget -q -T 20 --no-check-certificate -O /tmp/nc.login https://localhost/index.php/login && grep -q 'login' /tmp/nc.login && ! grep -qi 'admin account' /tmp/nc.login
ok  nc-login         wget -q -T 20 --no-check-certificate -O - --header 'OCS-APIRequest: true' --header "Authorization: Basic $(printf %s admin:werewolf-check-Pass-1x | base64)" 'https://localhost/ocs/v2.php/cloud/user?format=json' | grep -q '"id":"admin"'
ok  nc-webdav        php -r '$a = base64_encode("admin:werewolf-check-Pass-1x"); $t = ["ssl" => ["verify_peer" => false, "verify_peer_name" => false]]; $u = "https://localhost/remote.php/dav/files/admin/werewolf-check.txt"; @file_get_contents($u, false, stream_context_create($t + ["http" => ["method" => "PUT", "header" => "Authorization: Basic $a", "content" => "werewolf check\n", "ignore_errors" => true]])); if (!preg_match("/ 20[14] /", $http_response_header[0] ?? "")) { echo "PUT: ", $http_response_header[0] ?? "no answer", "\n"; exit(1); } exit(file_get_contents($u, false, stream_context_create($t + ["http" => ["header" => "Authorization: Basic $a"]])) === "werewolf check\n" ? 0 : 1);' && f=/data/svc/nextcloud/data/admin/files/werewolf-check.txt && [ "$(cat $f)" = "werewolf check" ] && [ "$(stat -c %u $f)" = "$(id -u nextcloud)" ]
ok  nc-hidden        for u in config/config.php data/ occ console.php cron.php .htaccess .user.ini 3rdparty/autoload.php lib/base.php core/register_command.php apps/files/lib/AppInfo/Application.php custom_apps/.htaccess; do wget -q -T 10 --no-check-certificate -S -O /dev/null https://localhost/$u 2>&1 | grep -q 'HTTP/1.1 404' || { echo "served: $u"; exit 1; }; done
ok  nc-no-web-update for u in updater/ updater/index.php; do wget -q -T 10 --no-check-certificate -S -O /dev/null https://localhost/$u 2>&1 | grep -q 'HTTP/1.1 404' || { echo "served: $u"; exit 1; }; done; grep -q "'upgrade.disable-web' => true" /data/svc/nextcloud/config/werewolf.config.php && ! chpst -u nextcloud touch /usr/share/nextcloud/werewolf-check 2>/dev/null
ok  nc-no-signup     [ ! -d /usr/share/nextcloud/apps/registration ] && [ ! -d /data/svc/nextcloud/apps/registration ] && wget -q -T 20 --no-check-certificate -S -O /dev/null https://localhost/index.php/apps/registration/ 2>&1 | grep -q 'HTTP/1.1 404'
ok  nc-public-only   u=$(id -u nextcloud) && grep -qx "connect $u tcp 443 public" /usr/share/werewolf/net && grep -qx "connect $u tcp 587 public" /usr/share/werewolf/net
ok  nc-private       u=$(id -u nextcloud); [ "$(stat -c '%u:%a' /run/svc/nextcloud/admin-password)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/nextcloud/config/config.php)" = $u:640 ] && stat -c %a /data/svc/nextcloud/data | grep -q '770$'
ok  nc-wrong-password wget -q -T 20 --no-check-certificate -S -O /dev/null --header 'OCS-APIRequest: true' --header "Authorization: Basic $(printf %s admin:werewolf-wrong | base64)" 'https://localhost/ocs/v2.php/cloud/user?format=json' 2>&1 | grep -q 'HTTP/1.1 401'
# The jobs run every five minutes, as nextcloud-cron, and Nextcloud records
# in its own table when they last ran. A line has 180 s, so the wait for
# the first run is two.
ok  nc-cron-wait     i=0; until [ "$(chpst -u postgres php -r '$d = new PDO("pgsql:host=/run/svc/postgres;dbname=nextcloud", "postgres"); $s = $d->prepare("SELECT configvalue FROM oc_appconfig WHERE appid = ? AND configkey = ?"); $s->execute(["core", $argv[1]]); echo $s->fetchColumn();' lastcron 2>/dev/null)" -gt 0 ] 2>/dev/null; do i=$((i + 1)); [ $i -le 170 ] || exit 0; sleep 1; done
ok  nc-cron          i=0; until [ "$(chpst -u postgres php -r '$d = new PDO("pgsql:host=/run/svc/postgres;dbname=nextcloud", "postgres"); $s = $d->prepare("SELECT configvalue FROM oc_appconfig WHERE appid = ? AND configkey = ?"); $s->execute(["core", $argv[1]]); echo $s->fetchColumn();' lastcron 2>/dev/null)" -gt 0 ] 2>/dev/null; do i=$((i + 1)); [ $i -le 170 ] || { echo "no background jobs in 340 s"; exit 1; }; sleep 1; done; [ "$(chpst -u postgres php -r '$d = new PDO("pgsql:host=/run/svc/postgres;dbname=nextcloud", "postgres"); $s = $d->prepare("SELECT configvalue FROM oc_appconfig WHERE appid = ? AND configkey = ?"); $s->execute(["core", $argv[1]]); echo $s->fetchColumn();' backgroundjobs_mode)" = cron ]
