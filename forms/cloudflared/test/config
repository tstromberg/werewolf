#!/bin/sh
# forms/cloudflared/test/config DIR: the cloudflared form's config for make check, in
# DIR: a tunnel token of the right shape (base64 JSON: account, tunnel
# id, secret), which the check's machine, given no way out, keeps trying
# to use. A real token is Cloudflare's to give (forms/cloudflared/README.md).
set -eu
mkdir -p "$1/cloudflared"
umask 077
printf '{"a":"%s","t":"%s","s":"%s"}' \
	"$(openssl rand -hex 16)" 0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0 "$(openssl rand -base64 32 | tr -d '\n')" |
	openssl base64 -A >"$1/cloudflared/token"
echo >>"$1/cloudflared/token"
