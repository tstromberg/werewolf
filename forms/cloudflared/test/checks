# cloudflared opens no port on the network: its metrics answer on loopback
# alone, and the tunnel, given no way out (the check's machine has none),
# keeps trying to reach Cloudflare's edge rather than giving up or
# listening for something else.
ok  cloudflared-user p=$(head -n 1 /run/cgroup/svc/cloudflared/cgroup.procs); u=$(grep '^cloudflared:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  cloudflared-metrics i=0; until wget -q -T 5 -O - http://127.0.0.1:2000/metrics 2>/dev/null | grep -q cloudflared; do i=$((i + 1)); [ $i -le 60 ] || { echo "no metrics on loopback"; exit 1; }; sleep 1; done; ! wget -q -T 5 -O /dev/null http://10.0.2.15:2000/metrics 2>/dev/null
ok  cloudflared-trying i=0; until wget -q -T 5 -O - http://127.0.0.1:2000/metrics | grep -q '^cloudflared_tunnel_'; do i=$((i + 1)); [ $i -le 30 ] || exit 1; sleep 1; done; sv status /etc/sv/cloudflared | grep -q '^run:'
ok  cloudflared-private [ "$(stat -c '%u:%a' /run/config/cloudflared/token)" = 0:600 ] && ! chpst -u cloudflared cat /run/config/cloudflared/token >/dev/null 2>&1
