#!/bin/sh
# cves OLD NEW SECDB: the CVEs fixed between two apk installed databases, as
# "origin: CVE-a CVE-b; origin: ...".
#
# SECDB is Wolfi's security.json (Alpine's secdb format): for each source
# package, the version that fixed each CVE. A CVE counts when that version is
# newer than the package's old version and no newer than its new one. Version
# "0" lists CVEs that never applied, and is skipped. A versioned stream
# (openssl-4.0) is looked up under its base name (openssl) too; the version
# window keeps other streams' fixes out.
set -eu
old=$1 new=$2 secdb=$3

origins() { # origins INSTALLED: "origin version" for each source package
	awk '/^P:/ { p = substr($0, 3) } /^V:/ { v = substr($0, 3) } /^o:/ { o = substr($0, 3) }
		/^$/ { if (p != "") print (o != "" ? o : p), v; p = v = o = "" }
		END { if (p != "") print (o != "" ? o : p), v }' "$1" | sort -u
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
origins "$old" >"$tmp/old"
origins "$new" >"$tmp/new"
jq -r '.packages[] | .pkg.name as $n | (.pkg.secfixes // {}) | to_entries[]
	| select(.key != "0") | .key as $v | .value[] | select(startswith("CVE-"))
	| "\($n) \($v) \(.)"' "$secdb" >"$tmp/fixes"

sep=''
awk 'NR == FNR { old[$1] = $2; next } ($1 in old) && old[$1] != $2 { print $1, old[$1], $2 }' \
	"$tmp/old" "$tmp/new" | while read -r o a b; do
	base=$(echo "$o" | sed 's/-[0-9][0-9.]*$//')
	list=$(awk -v o="$o" -v b="$base" '$1 == o || $1 == b' "$tmp/fixes" | while read -r _ v c; do
		if [ "$(apk version -t "$v" "$a")" = ">" ] && [ "$(apk version -t "$v" "$b")" != ">" ]; then
			echo "$c"
		fi
	done | sort -u | tr '\n' ' ')
	if [ -n "$list" ]; then
		printf '%s%s: %s' "$sep" "$o" "${list% }"
		sep='; '
	fi
done
echo
