#!/bin/sh
# At boot, once this slot has committed, and every 20 hours after: ask
# Wolfi and Alpine for anything newer, and if there is, build and boot the
# other slot (/usr/lib/werewolf/update). A form may check more often: it
# names the seconds between checks in /etc/werewolf/update-every (demo's
# says 3600). Only a machine booted from a slot can do any of this;
# elsewhere this parks itself.
exec 2>&1
# A slot boots from a distro's GRUB (bite: werewolf.grubenv) or from
# werewolf's own disk under systemd-boot (werewolf.esp=).
if ! grep -q 'werewolf\.slot=' /proc/cmdline ||
	{ [ ! -s /run/werewolf/grubenv ] && ! grep -q 'werewolf\.esp=' /proc/cmdline; }; then
	echo "autoupdate: not booted from a slot, staying down"
	exec sv down .
fi
until [ -e /run/werewolf/committed ]; do
	sleep 10
done
every=$(cat /etc/werewolf/update-every 2>/dev/null)
case $every in
'' | *[!0-9]*) every=72000 ;;
esac
/usr/lib/werewolf/update outcome
while :; do
	/usr/lib/werewolf/update check || true
	sleep "$every"
done
