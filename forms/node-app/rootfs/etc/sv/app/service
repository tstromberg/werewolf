# The application, as its own user: it may bind :8080 and no other port,
# read the image, and run only node. Down until server.js is there: this
# form ships none.
exec    /usr/bin/node /usr/lib/app/server.js
user    app
requires /usr/lib/app/server.js
pledge  stdio rpath wpath proc inet listen
memory  1024
listen  tcp/8080
env     NODE_ENV=production
