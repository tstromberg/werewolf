#!/bin/sh
# forms/postdoc-server/test/config DIR: the postdoc-server form's config for
# make check, in DIR: cloudflared's (forms/cloudflared/test/config) and
# postdoc's API token. No hopper: verdicts stay on the machine.
set -eu
"$(dirname "$0")/../../cloudflared/test/config" "$1"
mkdir -p "$1/postdoc"
umask 077
openssl rand -hex 32 >"$1/postdoc/api-token"
