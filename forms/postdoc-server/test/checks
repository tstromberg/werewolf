# postdoc answers on loopback alone, where the tunnel reaches it, once it
# has downloaded its rules and model. Every route but /_/health wants the
# API token; with it, an upload is analyzed and its verdict remembered.
ok  postdoc-user     p=$(head -n 1 /run/cgroup/svc/postdoc/cgroup.procs); u=$(grep '^postdoc:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  postdoc-healthy  i=0; until wget -q -T 5 -O - http://127.0.0.1:49999/_/health 2>/dev/null | grep -q '"status":"ok"'; do i=$((i + 1)); [ $i -le 900 ] || { echo "not healthy in 900 s"; exit 1; }; sleep 1; done
ok  postdoc-loopback ! wget -q -T 5 -O /dev/null http://10.0.2.15:49999/_/health 2>/dev/null
ok  postdoc-unauth   wget -q -T 5 -S -O /dev/null http://127.0.0.1:49999/_/info 2>&1 | grep -q 'HTTP/1.1 401'
ok  postdoc-wrong-token wget -q -T 5 -S -O /dev/null --header 'Authorization: Bearer 0123456789abcdef0123456789abcdef' http://127.0.0.1:49999/_/info 2>&1 | grep -q 'HTTP/1.1 401'
ok  postdoc-info     t=$(cat /run/config/postdoc/api-token); wget -q -T 5 -O - --header "Authorization: Bearer $t" http://127.0.0.1:49999/_/info | grep -q '"version"'

# A benign script, uploaded, is analyzed and allowed; asked for again by
# its digest, the answer comes from the server's own index.
ok  postdoc-analyzes t=$(cat /run/config/postdoc/api-token); f=/tmp/postdoc-check.js; printf 'module.exports = function add(a, b) { return a + b; };\n' >$f; wget -q -T 300 -O - --header "Authorization: Bearer $t" --header 'X-Filename: add.js' --post-file $f http://127.0.0.1:49999/v1/analyze | grep -q '"decision":"allow"'
ok  postdoc-remembers t=$(cat /run/config/postdoc/api-token); s=$(sha256sum /tmp/postdoc-check.js | cut -d' ' -f1); wget -q -T 30 -O - --header "Authorization: Bearer $t" "http://127.0.0.1:49999/v1/lookup?sha256=$s" | grep -q '"decision":"allow"'
ok  postdoc-pledged  u=$(grep '^postdoc:' /etc/passwd | cut -d: -f3); ! dmesg | grep 'type=1326' | grep " uid=$u "
ok  postdoc-private  [ "$(stat -c '%u:%a' /run/config/postdoc/api-token)" = 0:600 ] && ! chpst -u postdoc cat /run/config/postdoc/api-token >/dev/null 2>&1 && ! chpst -u cloudflared cat /run/svc/postdoc/api-token >/dev/null 2>&1

# Operators come in by security key on port 22; the tunnel's metrics
# answer on loopback alone.
ok  sshd-listens     awk '$4 == "0A" && $2 ~ /:0016$/ { f = 1 } END { exit !f }' /proc/net/tcp $(test ! -e /proc/net/tcp6 || echo /proc/net/tcp6)
ok  cloudflared-metrics i=0; until wget -q -T 5 -O - http://127.0.0.1:2000/metrics 2>/dev/null | grep -q cloudflared; do i=$((i + 1)); [ $i -le 60 ] || { echo "no metrics on loopback"; exit 1; }; sleep 1; done
