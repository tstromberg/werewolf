# Work on disposable guest disks under /data; no external guest image is needed.
ok  qemu-disk mkdir -p /data/qemu-check && qemu-img create -f qcow2 /data/qemu-check/guest.qcow2 1M && qemu-img info --output=json /data/qemu-check/guest.qcow2 | grep -q '"format": "qcow2"'
ok  qemu-roundtrip printf 'werewolf-guest-disk' >/data/qemu-check/source.raw && truncate -s 1M /data/qemu-check/source.raw && qemu-img convert -f raw -O qcow2 /data/qemu-check/source.raw /data/qemu-check/copied.qcow2 && qemu-img convert -f qcow2 -O raw /data/qemu-check/copied.qcow2 /data/qemu-check/returned.raw && cmp /data/qemu-check/source.raw /data/qemu-check/returned.raw
ok  qemu-snapshot qemu-img snapshot -c integration /data/qemu-check/copied.qcow2 && qemu-img snapshot -l /data/qemu-check/copied.qcow2 | grep -q integration && qemu-img snapshot -d integration /data/qemu-check/copied.qcow2 && ! qemu-img snapshot -l /data/qemu-check/copied.qcow2 | grep -q integration
ok  qemu-resize qemu-img resize /data/qemu-check/copied.qcow2 2M && qemu-img info --output=json /data/qemu-check/copied.qcow2 | grep -q '"virtual-size": 2097152' && qemu-img compare /data/qemu-check/source.raw /data/qemu-check/copied.qcow2
ok  qemu-corrupt printf 'not-a-qcow2' >/data/qemu-check/corrupt.qcow2; e=$(qemu-img check -f qcow2 /data/qemu-check/corrupt.qcow2 2>&1); r=$?; [ $r -ne 0 ] && echo "$e" | grep -qi 'not in qcow2 format'
