#!/bin/sh
# Deterministic disk contents; never replace the harness's encryption key.
set -eu
mkdir -p "$1/tests"
# A 1 MiB raw disk that starts with a marker, zeros after it.
printf 'werewolf-guest-disk' >"$1/tests/qemu-source"
dd if=/dev/zero of="$1/tests/qemu-source" bs=1 count=1 seek=1048575 conv=notrunc 2>/dev/null
printf 'not-a-qcow2' >"$1/tests/qemu-corrupt"
