# What the ruby-app form, booted as it ships, without a shell, must say on its
# console (make check-shellfree-ruby-app; test/boot; forms/demo/test/console has the
# format). It ships no application, so its service stays down and says why.

seen    app-waits         leash: \{"event":"down","service":"app","why":"requires /usr/lib/app/main\.rb, which is not there"\}
unseen  app-leashed       leash: \{"event":"start","service":"app"
unseen  app-retried       leash: \{"event":"retry","service":"app"
