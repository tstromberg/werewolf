# What the dependency-track form, booted as it ships, without a config,
# must say on its console (make check-shellfree-dependency-track;
# test/console.zig). Given no administrator's password, Caddy parks before it
# opens, so the published admin/admin never faces the network. make
# check-dependency-track boots it with its config.

seen    caddy-needs-password  leash: \{"event":"down","service":"caddy","why":"config admin-password: FileNotFound"\}
unseen  dtrack-down           leash: \{"event":"down","service":"dtrack"
