# The API answers through Caddy once admin/admin has been replaced.
ok  dtrack-health  i=0; until wget -q -T 5 --no-check-certificate -O /dev/null https://localhost/api/version; do i=$((i + 1)); [ $i -le 300 ] || { echo "no API in 300 s"; exit 1; }; sleep 1; done
ok  dtrack-user    p=$(head -n 1 /run/cgroup/svc/dtrack/cgroup.procs); u=$(grep '^dtrack:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  dtrack-bind    grep -qi '0100007F:1F90 ' /proc/net/tcp && ! grep -qi '00000000:1F90 ' /proc/net/tcp
ok  dtrack-anon    wget -q -T 5 --no-check-certificate -S -O /dev/null https://localhost/api/v1/project 2>&1 | grep -q 'HTTP/1.1 401'
ok  dtrack-published  wget -q -T 5 --no-check-certificate -S -O /dev/null --header 'Content-Type: application/x-www-form-urlencoded' --post-data 'username=admin&password=admin' https://localhost/api/v1/user/login 2>&1 | grep -Eq 'HTTP/1.1 (401|403)'
ok  dtrack-admin   wget -q -T 5 --no-check-certificate -O - --header 'Content-Type: application/x-www-form-urlencoded' --post-data 'username=admin&password=werewolf-check-pass-1' https://localhost/api/v1/user/login | grep -q '^eyJ'
