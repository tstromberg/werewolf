# Moodle was installed from the config before it served
# (forms/moodle/test/config). The first start makes some 500 tables, longer
# than one check may wait (test/boot's 180 s): wait for the schema to fill,
# then for the installer to mark the site configured (rolesactive), then
# for it to answer through Caddy over HTTPS, with a certificate from
# Caddy's own CA for localhost, with the site's name.
ok  moodle-tables    q() { chpst -u postgres psql -h /run/svc/postgres -d postgres -tAc "$1" 2>/dev/null; }; i=0; until [ "$(q "SELECT count(*) FROM pg_tables WHERE schemaname = 'moodle'")" -gt 0 ] 2>/dev/null; do i=$((i + 1)); [ $i -le 165 ] || { echo "no tables in the schema moodle in 165 s"; exit 1; }; sleep 1; done
ok  moodle-install   q() { chpst -u postgres psql -h /run/svc/postgres -d postgres -tAc "$1" 2>/dev/null; }; i=0; until [ "$(q "SELECT value FROM moodle.mdl_config WHERE name = 'rolesactive'")" = 1 ]; do i=$((i + 1)); [ $i -le 165 ] || { echo "not installed in 165 s more: $(q "SELECT count(*) FROM pg_tables WHERE schemaname = 'moodle'") tables"; exit 1; }; sleep 1; done
ok  moodle-installed i=0; until wget -q -T 10 --no-check-certificate -O /tmp/moodle.html https://localhost/ 2>/dev/null && grep -q 'werewolf check school' /tmp/moodle.html; do i=$((i + 1)); [ $i -le 160 ] || { echo "the site does not answer with its name in 160 s"; exit 1; }; sleep 1; done
ok  moodle-user      p=$(head -n 1 /run/cgroup/svc/moodle/cgroup.procs); u=$(grep '^moodle:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  moodle-https     wget -q -T 5 -S -O /dev/null http://localhost/ 2>&1 | grep -qi 'Location: https://localhost/'
# The administrator signs in with the config's password; a wrong one, and
# the guest account, are refused: Moodle's login page, its token and
# session cookie, then the redirect a good login gets (testsession).
ok  moodle-login     php -r 'function get($u, $o = []) { $c = stream_context_create(["ssl" => ["verify_peer" => false, "verify_peer_name" => false], "http" => $o + ["follow_location" => 0, "ignore_errors" => true, "timeout" => 60]]); $r = file_get_contents("https://localhost$u", false, $c); return [$r, implode("\n", $http_response_header ?? [])]; } function login($u, $p) { [$h, $hd] = get("/login/index.php"); preg_match("/MoodleSession=([^;]+)/", $hd, $s); preg_match("/name=\"logintoken\" value=\"([^\"]+)\"/", $h, $t); [, $hd] = get("/login/index.php", ["method" => "POST", "header" => "Cookie: MoodleSession=$s[1]\r\nContent-Type: application/x-www-form-urlencoded", "content" => http_build_query(["username" => $u, "password" => $p, "logintoken" => $t[1] ?? ""])]); return preg_match("/^Location: \S*testsession=/mi", $hd) && preg_match("/MoodleSession=([^;]+)/", $hd, $n) ? $n[1] : null; } if (!login("admin", "werewolf-check-Pass-1x")) { echo "the administrator cannot sign in\n"; exit(1); } if (login("admin", "werewolf-wrong") !== null) { echo "a wrong password signs in\n"; exit(1); } if (login("guest", "guest") !== null) { echo "a guest signs in\n"; exit(1); }'
# Nobody signs up, and there is no guest.
ok  moodle-no-signup wget -q -T 20 --no-check-certificate -O /tmp/moodle.signup https://localhost/login/signup.php 2>/dev/null; grep -q 'may not use this page' /tmp/moodle.signup && wget -q -T 20 --no-check-certificate -O /tmp/moodle.login https://localhost/login/index.php && grep -q logintoken /tmp/moodle.login && ! grep -q 'loginguest' /tmp/moodle.login
# The attacks of an administrator's stolen session: a path to a program in
# Moodle's settings (Ghostscript's, run on PDFs) is refused, its page saying
# so, and the setting keeps its default; the plugin installer is off; and
# moodle cannot write the code in any case.
ok  moodle-no-exec   php -r 'function get($u, $o = []) { $c = stream_context_create(["ssl" => ["verify_peer" => false, "verify_peer_name" => false], "http" => $o + ["follow_location" => 0, "ignore_errors" => true, "timeout" => 60]]); $r = file_get_contents("https://localhost$u", false, $c); return [$r, implode("\n", $http_response_header ?? [])]; } [$h, $hd] = get("/login/index.php"); preg_match("/MoodleSession=([^;]+)/", $hd, $s); preg_match("/name=\"logintoken\" value=\"([^\"]+)\"/", $h, $t); [, $hd] = get("/login/index.php", ["method" => "POST", "header" => "Cookie: MoodleSession=$s[1]\r\nContent-Type: application/x-www-form-urlencoded", "content" => http_build_query(["username" => "admin", "password" => "werewolf-check-Pass-1x", "logintoken" => $t[1]])]); preg_match("/MoodleSession=([^;]+)/", $hd, $n); $ck = "Cookie: MoodleSession=$n[1]"; [$h] = get("/admin/settings.php?section=systempaths", ["header" => $ck]); if (!str_contains($h, "Setting executable and local paths disabled in config.php")) { echo "the paths page does not refuse\n"; exit(1); } preg_match("/\"sesskey\":\"([^\"]+)\"/", $h, $k); get("/admin/settings.php", ["method" => "POST", "header" => "$ck\r\nContent-Type: application/x-www-form-urlencoded", "content" => http_build_query(["section" => "systempaths", "sesskey" => $k[1], "return" => "", "s__pathtogs" => "/usr/bin/php"])]); [$h] = get("/admin/tool/installaddon/index.php", ["header" => $ck]); if (str_contains($h, "zipfile")) { echo "the plugin installer serves its form\n"; exit(1); }' && [ "$(chpst -u postgres psql -h /run/svc/postgres -d postgres -tAc "SELECT value FROM moodle.mdl_config WHERE name = 'pathtogs'")" = /usr/bin/gs ] && ! chpst -u moodle touch /usr/share/moodle/public/local/werewolf-check 2>/dev/null
# The web installer and Moodle's insides are not served.
ok  moodle-hidden    for u in install.php install/lang/en/install.php admin/environment.xml lib/db/install.xml mod/upgrade.txt pix/.cvsignore; do wget -q -T 10 --no-check-certificate -S -O /dev/null https://localhost/$u 2>&1 | grep -q 'HTTP/1.1 404' || { echo "served: $u"; exit 1; }; done
ok  moodle-public    u=$(id -u moodle) && c=$(id -u moodle-cron) && grep -qx "connect $u tcp 443 public" /usr/share/werewolf/net && grep -qx "connect $c tcp 443 public" /usr/share/werewolf/net
ok  moodle-private   u=$(id -u moodle); [ "$(stat -c '%u:%a' /run/svc/moodle/admin-password)" = $u:600 ] && [ "$(stat -c '%u:%a' /data/svc/moodle/site.json)" = $u:640 ] && stat -c %a /data/svc/moodle/data | grep -q '770$' && [ -z "$(find /data/svc/moodle -perm -o+w ! -type l)" ]
# Cron runs every minute, as moodle-cron: wait for its first run, which
# Moodle records.
ok  moodle-cron      i=0; until [ "$(chpst -u postgres psql -h /run/svc/postgres -d postgres -tAc "SELECT value FROM moodle.mdl_config_plugins WHERE plugin = 'tool_task' AND name = 'lastcronstart'" 2>/dev/null)" -gt 0 ] 2>/dev/null; do i=$((i + 1)); [ $i -le 165 ] || { echo "no cron run in 165 s"; exit 1; }; sleep 1; done
