# What the moodle form, booted as it ships, without a shell and without a
# config, must say on its console (make check-shellfree-moodle;
# test/boot; forms/demo/test/console has the format). Moodle, given no
# administrator's password, parks before it installs or serves anything,
# and says why; PostgreSQL, Caddy and cron run. make check-moodle boots it
# with its config, and checks it serves.

seen    moodle-needs-config  leash: \{"event":"down","service":"moodle","why":"config admin-password: FileNotFound"\}
unseen  others-down          leash: \{"event":"down","service":"(caddy|postgres|cron)"
unseen  installed            moodle-setup: installed
