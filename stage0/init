#!/bin/sh
# stage0: PID 1 on every werewolf machine. It loads the modules, mounts the
# form's root.erofs read-only, directly at /, and hands over to its /init.
# Nothing can write the root: what the running system writes goes to /run,
# /tmp, /var/tmp or /data, and the root is the image, byte for byte, on every
# boot.
#
# The image is a slot's on a machine bite took over, found on the victim's
# filesystem:
#
#   werewolf.victim=UUID:DIR   the filesystem, and the directory holding a/ and b/
#   werewolf.slot=a|b          which slot this boot is
#
# or, booted directly (QEMU, Lima), /root.erofs in this initramfs, which the
# build appends.
#
# Getting back to a slot that works is the kernel's and GRUB's job. GRUB
# boots a new slot once; if anything here fails, stage0 exits, the kernel
# panics, panic=10 reboots it, and GRUB boots the slot that last committed.
# A slot that boots but never commits is caught by the deadman below.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
exec </dev/null

say() { echo "stage0: $*"; }
fail() {
	say "$*; panicking, so the machine reboots into the last good slot"
	exit 1
}

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

victim='' slot=''
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	werewolf.victim=*) victim=${arg#*=} ;;
	werewolf.slot=*) slot=${arg#*=} ;;
	esac
done
case "${victim:+victim}${slot:+slot}" in
victim | slot) fail "werewolf.victim and werewolf.slot come together" ;;
esac

# Lockdown at integrity before any module: the kernel then loads only those
# signed by its key, and refuses the rest. It only rises; the root's init
# finds it raised.
mount -t securityfs securityfs /sys/kernel/security
echo integrity >/sys/kernel/security/lockdown || fail "cannot raise lockdown"

# Every module the form needs, then the loader closes for good: the root
# that follows finds it closed and loads nothing (modules/modules.zig).
/usr/lib/werewolf/modules || say "not every module loaded; see above"

mkdir -p /root
if [ -n "$slot" ]; then
	dev=$(blkid -c /dev/null -l -o device -t UUID="${victim%%:*}") || fail "no filesystem ${victim%%:*}"
	mkdir -p /victim
	mount -o nosuid,nodev,noexec "$dev" /victim || fail "cannot mount $dev"
	img=/victim${victim#*:}/$slot/root.erofs
else
	img=/root.erofs
fi
# Read-only, and nothing over it: no overlay to write into.
mount -t erofs -o ro,nodev,loop "$img" /root || fail "cannot mount $img"
say "${slot:+slot $slot: }$img, read-only, is the root"

# The deadman outlives this initramfs: sleep starts now, and what follows it
# is shell builtins, so nothing needs a file from here once it wakes. It
# looks through PID 1's root for the mark commit leaves, and without it
# reboots at once; GRUB has spent this slot's one boot, so the machine comes
# back on the slot that last committed. Its own /proc keeps it a way in.
mkdir -p /deadman
mount -t proc proc /deadman
[ -z "$slot" ] || (
	sleep 600
	if [ ! -e /deadman/1/root/run/werewolf/committed ]; then
		echo "stage0: slot $slot did not commit in 10 minutes; rebooting into the last good slot" >/dev/console
		echo b >/deadman/sysrq-trigger
	fi
) &

# The root is read-only, so its mount points are in the image already.
for m in dev proc sys ${slot:+victim}; do
	mount --move "/$m" "/root/$m" || fail "cannot move /$m into the root"
done
# What switch_root does, with what is here: put the new root over / and
# start its init inside it.
cd /root || fail "cannot enter /root"
mount --move . /
exec chroot . /init
