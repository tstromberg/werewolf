#!/usr/bin/env python3
"""Run a build with a verified private key filename, accepting a CI PEM secret."""
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile


def run(argv, environment):
    supplied = environment.get('WEREWOLF_BOOT_KEY', '')
    if not supplied:
        raise ValueError('WEREWOLF_BOOT_KEY is required; unsigned release builds are refused')
    certificate = Path(environment.get('WEREWOLF_BOOT_CRT', 'release/boot.crt')).resolve()
    with tempfile.TemporaryDirectory(prefix='ww-release-signing-') as temporary:
        key = Path(temporary) / 'boot.key'
        key.touch(mode=0o600)
        if supplied.startswith('-----BEGIN '):
            key.write_text(supplied)
        else:
            key.write_bytes(Path(supplied).read_bytes())
        # Capture diagnostics: malformed PEM can otherwise expose input text.
        public = subprocess.run(['openssl', 'pkey', '-in', str(key), '-pubout'],
                                capture_output=True, check=False)
        pinned = subprocess.run(['openssl', 'x509', '-in', str(certificate), '-pubkey', '-noout'],
                                capture_output=True, check=False)
        if public.returncode or pinned.returncode or public.stdout != pinned.stdout:
            raise ValueError('boot key does not match the release certificate')
        env = dict(environment, WEREWOLF_BOOT_KEY=str(key), WEREWOLF_BOOT_CRT=str(certificate))
        child = subprocess.Popen(argv, env=env)
        try:
            return child.wait()
        finally:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()


def interrupted(signum, frame):
    raise KeyboardInterrupt


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, interrupted)
    try:
        if len(sys.argv) < 2:
            raise ValueError('usage: release/with-boot-key COMMAND [ARG...]')
        sys.exit(run(sys.argv[1:], os.environ))
    except (OSError, ValueError):
        # Do not echo the supplied secret or subprocess arguments.
        print('with-boot-key: missing/invalid signing input or key/certificate mismatch', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
