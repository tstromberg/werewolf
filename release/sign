#!/bin/sh
# sign: stamp each manifest with SERIAL, sign it with the image key as
# MANIFEST.sig, and check that signature against release/image.pub.
#
# A manifest does not expire: the next release supersedes it. It still
# carries an "expires", at the end of 9999, because updaters from before
# 2026-10-08 require one and refuse a release past it.
#
#   WEREWOLF_IMAGE_KEY=<PEM> release/sign SERIAL MANIFEST...
#
# The signature is RSA PKCS#1 v1.5 over the sha256 of the file, as
#   openssl dgst -sha256 -verify release/image.pub -signature M.sig M
# checks it. See docs/releases.md.
set -eu

[ $# -ge 2 ] || { echo "usage: release/sign SERIAL MANIFEST..." >&2; exit 2; }
[ -n "${WEREWOLF_IMAGE_KEY:-}" ] || { echo "release/sign: WEREWOLF_IMAGE_KEY is not set" >&2; exit 1; }
pub=$(dirname "$0")/image.pub
[ -f "$pub" ] || { echo "release/sign: no $pub" >&2; exit 1; }
serial=$1
shift
case $serial in
[0-9][0-9][0-9][0-9][0-1][0-9][0-3][0-9]T[0-2][0-9][0-5][0-9][0-5][0-9]Z) ;;
*) echo "release/sign: $serial is not a serial, such as 20261007T140000Z" >&2; exit 1 ;;
esac
expires=9999-12-31T23:59:59Z

key=$(mktemp) # mode 0600
trap 'rm -f "$key"' EXIT
printf '%s\n' "$WEREWOLF_IMAGE_KEY" >"$key"

for m; do
	awk -v s="$serial" -v e="$expires" '
		/^  "(serial|expires)": / { next }
		{ print }
		/^  "arch": / { printf "  \"serial\": \"%s\",\n  \"expires\": \"%s\",\n", s, e }' "$m" >"$m.new"
	mv "$m.new" "$m"
	openssl dgst -sha256 -sign "$key" -out "$m.sig" "$m"
	openssl dgst -sha256 -verify "$pub" -signature "$m.sig" "$m" >/dev/null
	echo "signed ${m##*/}: serial $serial"
done
