#!/bin/sh
# tiers builds the CVE tiers feed (tools/cve-tiers.zig) for what werewolf
# installs (release/origins) and for the kernel Alpine ships now. It signs
# the feed (release/sign-tiers), commits it as cve-tiers.json and
# cve-tiers.json.sig to FEED, a checkout of the feed's repository
# (werewolf-linux/cve-feed), and pushes. Machines fetch the feed from there
# (docs/design/update-policy.md). CACHE keeps NVD's scores between runs, so
# a run asks NVD only for what changed since the last one.
#
#   release/tiers CACHE FEED
#
# It needs NVD_API_KEY and WEREWOLF_TIERS_KEY (PEM), and runs from the top
# of werewolf's tree with Zig, apko and git. The feed repository's workflow
# runs it hourly and pushes with that repository's token, which can write
# nowhere else.
#
# tiers commits only when a tier changed, or when the published feed is a
# day old, to renew its three-day expiry. So the repository's history is the
# feed's history, and an auditor reads each change as a diff. Whoever can
# push to the feed repository can change or remove the feed, but cannot sign
# it. The worst they can do is withhold the feed, and then a machine counts
# every fix as High.
set -eu

[ $# -eq 2 ] || { echo "usage: release/tiers CACHE FEED" >&2; exit 2; }
cache=$1
feed=$2
for v in NVD_API_KEY WEREWOLF_TIERS_KEY; do
	eval "[ -n \"\${$v:-}\" ]" || { echo "tiers: $v is not set" >&2; exit 1; }
done
[ -d "$feed/.git" ] || { echo "tiers: $feed is not a checkout of the feed's repository" >&2; exit 1; }
release=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Cover what werewolf installs and the kernel Alpine ships now.
"$release/origins" "$work/origins"
# Lock into this run's directory; the tree's locks belong to its builds.
(cd boot && apko lock --arch x86_64 --output "$work/kernel.lock.json" kernel.yaml >/dev/null)
make --no-print-directory build/host/cve-tiers
kernel=$(sed -n 's|.*"url": "[^"]*/x86_64/\(linux-virt-[^/]*\)\.apk".*|\1|p' "$work/kernel.lock.json")
[ -n "$kernel" ] || { echo "tiers: the kernel lock names no linux-virt" >&2; exit 1; }
build/host/cve-tiers "$kernel" "$work/origins" "$cache" "$work/in" "$work/cve-tiers.json"

# If only the stamp changed and the feed is less than a day old, publish nothing.
unstamped() { grep -v -E '^  "(serial|expires)": ' "$1" 2>/dev/null || true; }
digits() { echo "$1" | tr -d 'TZ'; } # a serial, as a number
if [ -f "$feed/cve-tiers.json" ] &&
	[ "$(unstamped "$feed/cve-tiers.json" | cksum)" = "$(unstamped "$work/cve-tiers.json" | cksum)" ]; then
	last=$(sed -n 's/^  "serial": "\(.*\)",$/\1/p' "$feed/cve-tiers.json")
	day_ago=$(date -u -d '-1 day' +%Y%m%dT%H%M%SZ 2>/dev/null || date -u -v-1d +%Y%m%dT%H%M%SZ)
	if [ -n "$last" ] && [ "$(digits "$day_ago")" -lt "$(digits "$last")" ]; then
		echo "tiers: unchanged since $last"
		exit 0
	fi
fi

serial=$(date -u +%Y%m%dT%H%M%SZ)
"$release/sign-tiers" "$serial" "$work/cve-tiers.json"
cp "$work/cve-tiers.json" "$work/cve-tiers.json.sig" "$feed/"
cd "$feed"
git add cve-tiers.json cve-tiers.json.sig
git -c user.name="werewolf tiers" -c user.email="tiers@users.noreply.github.com" \
	commit -q -m "tiers $serial, for $kernel" -m "$(grep -c '"cve":' cve-tiers.json) entries"
git push -q origin HEAD
[ "$(git ls-remote origin HEAD | cut -f1)" = "$(git rev-parse HEAD)" ] ||
	{ echo "tiers: the push did not take" >&2; exit 1; }
echo "tiers: published $serial for $kernel"
