#!/usr/bin/env python3
"""Resolve, independently build, test and publish all supported form/architecture pairs."""
import argparse
import datetime
import gzip
import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile

sys.dont_write_bytecode = True
import image_catalog as catalog
import image_notes as notes

HOWL = Path('build/host/howl').resolve()
FORM = Path('build/host/form').resolve()
resolver = importlib.machinery.SourceFileLoader('form_input_resolver', 'release/protected-inputs').load_module()
builder = importlib.machinery.SourceFileLoader('form_security_builder', 'tools/local-prerequisites').load_module()


def run(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def query(*args):
    return subprocess.check_output([str(FORM), *args], text=True).splitlines()


def write(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(catalog.encode(value))


def native(arch):
    if platform.system() != 'Linux' or platform.machine() != arch:
        raise ValueError('form image builds and release tests require a native Linux runner')


def forms():
    return sorted(p.parent.name for p in Path('forms').glob('*/form.yaml') if catalog.NAME.fullmatch(p.parent.name))


def source_identity(form, chain):
    # Unrelated forms and prose do not invalidate this form. Common programs,
    # build tools, tests, trust, examples and publication policy are inputs.
    roots = ['Makefile', 'files.zig', 'boot', 'cmd', 'lib', 'tools', 'test', 'release', '.github', 'examples']
    roots += ['forms/' + name for name in chain]
    tree = subprocess.check_output(['git', 'ls-tree', '-rz', 'HEAD', '--', *roots])
    return resolver.source_identity(tree)


def resolved_identity(form, arch, snapshot, chain):
    locks = {p.name: json.loads(p.read_text()) for p in
             [*snapshot.parent.glob('*.lock.json'), *snapshot.glob('*.lock.json')]}
    packages = resolver.identity(source_identity(form, chain), arch, locks)
    images = [json.loads(p.read_text())['werewolf']['images'] for p in sorted(snapshot.glob(form + '*.lock.json'))]
    versions = json.loads((snapshot / 'tools.json').read_text())
    return hashlib.sha256(catalog.encode(dict(packages=packages, images=images, tools=versions))).hexdigest()


def lock_recipe(recipe, arch, output):
    contents = {}
    for field in ('Repositories', 'Keyring', 'Packages'):
        template = '{{ range .Environment.Contents.' + field + ' }}{{ println . }}{{ end }}'
        lines = subprocess.check_output(['melange', 'query', recipe, template], text=True).splitlines()
        if not lines:
            raise ValueError('empty Melange environment: ' + recipe)
        contents[field.lower()] = lines
    config = output.with_name(output.name + '.apko.json')
    write(config, dict(contents=contents, archs=[arch]))
    resolver.resolve(config.name, output, arch, output.parent)
    config.unlink()


def shared_inputs(arch, output):
    for name in ('kernel', 'boot'):
        resolver.resolve(name + '.yaml', output / (name + '.lock.json'), 'aarch64,x86_64', 'boot')
    for name, recipe in [('kernel-builder', 'boot/ipe-kernel.melange.yaml'),
                         ('stub-builder', 'boot/tpm-stub.melange.yaml')]:
        lock_recipe(recipe, arch, output / (name + '.lock.json'))
    write(output / 'tools.json', tool_versions())


def tool_versions(extra=()):
    commands = [('zig', 'version'), ('apko', 'version'), ('melange', 'version'),
                ('qemu-img', '--version'), ('mkfs.erofs', '--version'), ('osslsigncode', '--version')]
    versions = {}
    for command in [*commands, *extra]:
        result = subprocess.run(command, check=True, capture_output=True, text=True)
        versions[' '.join(command)] = (result.stdout + result.stderr).strip()
    return versions


def compiler(form):
    return {'go-example': [('go', 'version')], 'rust-example': [('rustc', '--version')],
            'aspnet-example': [('dotnet', '--version')]}.get(form, [])


def resolve(arch, shard, shards, output):
    output = Path(output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    selected = forms()[shard - 1::shards]
    shared_inputs(arch, output)
    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
    serial = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    plan = dict(format='werewolf-form-plan/1', arch=arch, shard=shard, shards=shards, targets=[])
    for form in selected:
        target = dict(form=form, arch=arch, status='resolution failed')
        plan['targets'].append(target)
        try:
            if arch not in query('archs', form):
                target['status'] = 'unsupported architecture'
                continue
            snapshot = output / form
            snapshot.mkdir()
            chain = query('names', form)
            for suffix, flags in [('', []), ('-dev', ['--dev'])]:
                lock = Path('build/lock') / (form + suffix + '.lock.json')
                lock.unlink(missing_ok=True)
                run([HOWL, '_build', '--with', form, '--arch', arch, *flags, 'lock'])
                shutil.copyfile(lock, snapshot / lock.name)
            recipes = sorted({str(p) for name in chain for p in Path('forms', name, 'melange').glob('*.yaml')})
            mapping = {}
            for recipe in recipes:
                filename = 'melange-' + hashlib.sha256(recipe.encode()).hexdigest()[:16] + '.lock.json'
                lock_recipe(recipe, arch, snapshot / filename)
                mapping[recipe] = filename
            write(snapshot / 'melange.json', mapping)
            versions = tool_versions(compiler(form))
            write(snapshot / 'tools.json', versions)
            digest = resolved_identity(form, arch, snapshot, chain)
            target.update(inputs=digest, commit=commit, serial=serial)
            previous = catalog.read_public(form, arch, 'release/boot.crt')
            target['status'] = 'unchanged' if previous and previous['inputs'] == digest and \
                os.environ.get('FORM_IMAGES_FORCE') != '1' else 'build'
            write(snapshot / 'input.json', dict(chain=chain,
                  **{k: target[k] for k in ('form', 'arch', 'inputs', 'commit', 'serial')}))
        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            print('form-images: %s/%s resolution failed: %s' % (form, arch, error), file=sys.stderr, flush=True)
        write(output / 'plan.json', plan)
    write(output / 'plan.json', plan)


def install_locks(snapshot):
    lockdir = Path('build/lock')
    lockdir.mkdir(parents=True, exist_ok=True)
    for root in (snapshot.parent, snapshot):
        for path in root.glob('*.lock.json'):
            if not path.name.startswith('melange-'):
                shutil.copyfile(path, lockdir / path.name)


def prerequisites(arch, snapshot):
    key = Path(os.environ['WEREWOLF_BOOT_KEY']).resolve()
    cert = Path('release/boot.crt').resolve()
    cache = Path('build/form-image-security').resolve()
    cache.mkdir(parents=True, exist_ok=True)
    base = cache / 'base.tar'
    # Each job starts without compiled artifacts. Forms in that job share only
    # these pinned prerequisites; the other copy builds on an independent runner.
    if not base.exists():
        pins = [a for p in builder.package_pins(snapshot / 'kernel.lock.json', arch) for a in ('-p', p)]
        run(['apko', '--workdir', 'boot', 'build-minirootfs', '--build-arch', arch,
             *pins, 'kernel.yaml', base])
    return builder.build(Path.cwd(), cache, arch, base, key, cert)


def archive_inputs(snapshot, output):
    # Keep original apko declaration locks for rebuilds, including OCI digests.
    paths = [(p.name, p) for p in sorted(snapshot.parent.glob('*.json')) if p.name != 'plan.json']
    paths += [(snapshot.name + '/' + p.name, p) for p in sorted(snapshot.glob('*.json'))]
    with output.open('wb') as stream, gzip.GzipFile(filename='', mode='wb', fileobj=stream, mtime=0) as compressed:
        with tarfile.open(mode='w', fileobj=compressed) as archive:
            for name, path in paths:
                info = tarfile.TarInfo(name)
                info.size, info.mode, info.mtime = path.stat().st_size, 0o644, 0
                with path.open('rb') as data:
                    archive.addfile(info, data)


def local_packages(snapshot, arch, package_dir=Path('build/vendor/packages')):
    # The same main/subpackages that howl's Melange overlay installs. Read the
    # built APK metadata so a same-version payload rebuild is visible too.
    packages = []
    template = '{{.Package.Name}}-{{.Package.Version}}-r{{.Package.Epoch}}' + \
        '{{$v := print "-" .Package.Version "-r" .Package.Epoch}}' + \
        '{{range .Subpackages}} {{.Name}}{{$v}}{{end}}'
    for recipe in sorted(json.loads((snapshot / 'melange.json').read_text())):
        names = subprocess.check_output(['melange', 'query', recipe, template], text=True).split()
        if not names:
            raise ValueError('empty built package inventory: ' + recipe)
        for name in names:
            metadata = subprocess.check_output(['bsdtar', '-xzOf',
                package_dir / arch / (name + '.apk'), '.PKGINFO'], text=True)
            fields = dict(line.split(' = ', 1) for line in metadata.splitlines() if ' = ' in line)
            if fields['arch'] != arch:
                raise ValueError('built package has the wrong architecture')
            packages.append(dict(name=fields['pkgname'], version=fields['pkgver'], checksum=fields['datahash']))
    return packages


def build_one(target, snapshot, security, output):
    form, arch = target['form'], target['arch']
    chain = json.loads((snapshot / 'input.json').read_text())['chain']
    if resolved_identity(form, arch, snapshot, chain) != target['inputs']:
        raise ValueError('source, package or OCI inputs changed after resolution')
    if json.loads((snapshot / 'tools.json').read_text()) != tool_versions(compiler(form)):
        raise ValueError('build tools changed after input resolution')
    install_locks(snapshot)
    key, cert = Path(os.environ['WEREWOLF_BOOT_KEY']).resolve(), Path('release/boot.crt').resolve()
    work = Path('build/form-image-work') / arch
    disk = (work / (form + '.raw')).resolve()
    env = dict(os.environ, SOURCE_DATE_EPOCH='0', UKI_STUB=str(security / 'linux.efi.stub'),
               WEREWOLF_FORM_INPUTS=str(snapshot), WEREWOLF_PROTECTED_INPUTS=str(snapshot.parent))
    run([HOWL, '_build', '--with', form, '--arch', arch, '--build', work,
         '--ipe-kernel', security / 'rootfs.tar', '--ipe-key', key, '--ipe-cert', cert,
         '--ipe-updates', catalog.PUBLIC + '/' + form, '--image-serial', target['serial'],
         '--boot-key', key, '--boot-cert', cert, '--boot-native', '--disk', disk,
         # Catalog disks carry no TPM enrollment yet (docs/releases.md); say so.
         '--disable=tpm',
         '--disk-args', 'console=' + ('ttyAMA0' if arch == 'aarch64' else 'ttyS0'), 'disk', 'prebuilt'], env=env)
    built = work / (form + '-ipe')
    if (built / 'meta/usr/share/werewolf/dev').exists():
        raise ValueError('development images cannot be published')
    output.mkdir(parents=True)
    run(['qemu-img', 'convert', '-c', '-f', 'raw', '-O', 'qcow2', disk, output / 'disk.qcow2'])
    run(['qemu-img', 'check', '-f', 'qcow2', output / 'disk.qcow2'])
    run(['qemu-img', 'compare', '-f', 'raw', '-F', 'qcow2', disk, output / 'disk.qcow2'])
    for name in ('vmlinuz', 'root.erofs', 'stage0.zst', 'cmdline', 'uki.efi'):
        shutil.copyfile(built / 'slot' / name, output / name)
    for name in ('latest.json', 'latest.json.sig'):
        shutil.copyfile(built / 'prebuilt' / arch / name, output / name)
    shutil.copyfile(cert, output / 'boot.crt')
    archive_inputs(snapshot, output / 'inputs.tar.gz')
    write(output / 'packages.json', notes.inventory(snapshot, form, arch, local_packages(snapshot, arch)))
    candidate = {k: target[k] for k in ('form', 'arch', 'inputs', 'commit', 'serial')}
    candidate.update(format='werewolf-form-image/1', profile='uefi-ipe/1',
                     files={name: catalog.record(output / name) for name in sorted(catalog.ASSETS)})
    write(output / 'candidate.json', candidate)
    catalog.verify_candidate(output, cert)
    # These are disposable build outputs, never machine enrollment or caches
    # shared with another job. Keep each shard within the runner's disk budget.
    disk.unlink()
    shutil.rmtree(built)
    shutil.rmtree(work / 'oci', ignore_errors=True)


def build(snapshot, output):
    snapshot, output = Path(snapshot).resolve(), Path(output).resolve()
    plan = json.loads((snapshot / 'plan.json').read_text())
    native(plan['arch'])
    os.environ['SOURCE_DATE_EPOCH'] = '0'
    output.mkdir(parents=True, exist_ok=False)
    results = []
    try:
        os.environ['WEREWOLF_PROTECTED_INPUTS'] = str(snapshot)
        if json.loads((snapshot / 'tools.json').read_text()) != tool_versions():
            raise ValueError('security build tools changed after input resolution')
        security = prerequisites(plan['arch'], snapshot) if any(t['status'] == 'build' for t in plan['targets']) else None
        for target in plan['targets']:
            result = dict(target)
            results.append(result)
            if target['status'] != 'build':
                continue
            try:
                with (output / (target['form'] + '.log')).open('wb') as log:
                    # Child output is retained separately for each form.
                    with redirect(log):
                        build_one(target, snapshot / target['form'], security, output / target['form'])
                result['status'] = 'built'
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                result['status'] = 'build failed'
                print('form-images: %s build failed: %s' % (target['form'], error), file=sys.stderr, flush=True)
                shutil.rmtree(output / target['form'], ignore_errors=True)
                work = Path('build/form-image-work') / plan['arch']
                (work / (target['form'] + '.raw')).unlink(missing_ok=True)
                shutil.rmtree(work / (target['form'] + '-ipe'), ignore_errors=True)
                shutil.rmtree(work / 'oci', ignore_errors=True)
            write(output / 'results.json', results)
    finally:
        write(output / 'results.json', results)
    return any(t['status'] in ('build failed', 'resolution failed') for t in results)


class redirect:
    """Keep subprocess diagnostics in per-form logs without changing their APIs."""
    def __init__(self, stream):
        self.stream = stream

    def __enter__(self):
        sys.stdout.flush()
        sys.stderr.flush()
        self.saved = [os.dup(fd) for fd in (1, 2)]
        for fd in (1, 2):
            os.dup2(self.stream.fileno(), fd)

    def __exit__(self, *exc):
        sys.stdout.flush()
        sys.stderr.flush()
        for fd, saved in zip((1, 2), self.saved):
            os.dup2(saved, fd)
            os.close(saved)


def check_one(target, snapshot, first, second, output):
    one, _ = catalog.verify_candidate(first, 'release/boot.crt')
    two, _ = catalog.verify_candidate(second, 'release/boot.crt')
    if one != two or (first / 'candidate.json').read_bytes() != (second / 'candidate.json').read_bytes():
        raise ValueError('independent form image builds differ')
    if any(one[k] != target[k] for k in ('form', 'arch', 'inputs', 'commit', 'serial')):
        raise ValueError('candidate differs from resolved inputs')
    install_locks(snapshot)
    env = dict(os.environ, WEREWOLF_FORM_INPUTS=str(snapshot))
    run([sys.executable, 'test/form-coverage', '--form', target['form']], env=env)
    run([HOWL, 'test', '--with', target['form'], '--arch', target['arch']], env=env)
    with tempfile.TemporaryDirectory(prefix='ww-release-disk-') as temporary:
        dist = Path(temporary)
        prefix = target['form'] + '-' + target['arch']
        files = {}
        for name, original in [('disk.qcow2', 'disk.qcow2'), ('uki', 'uki.efi'), ('boot.crt', 'boot.crt')]:
            os.link(first / original, dist / (prefix + '-' + name))
            files[name] = one['files'][original]
        write(dist / (prefix + '.json'), dict(files=files))
        run(['make', '--no-print-directory', 'FORM=' + target['form'], 'ARCH=' + target['arch'],
             'IPE=1', 'DIST=' + str(dist), '_check-dist'], env=env)
    report = dict(format='werewolf-form-tests/1', candidate=catalog.sha(first / 'candidate.json'),
                  checks={name: True for name in sorted(catalog.CHECKS)},
                  **{k: target[k] for k in ('form', 'arch', 'inputs')})
    shutil.copytree(first, output)
    write(output.parent / (target['form'] + '-tests.json'), report)


def check(snapshot, first, second, output):
    snapshot, first, second, output = map(lambda p: Path(p).resolve(), (snapshot, first, second, output))
    plan = json.loads((snapshot / 'plan.json').read_text())
    native(plan['arch'])
    output.mkdir(parents=True, exist_ok=False)
    results = []
    for target in plan['targets']:
        result = dict(target)
        results.append(result)
        if target['status'] == 'build':
            try:
                with (output / (target['form'] + '.log')).open('wb') as log, redirect(log):
                    check_one(target, snapshot / target['form'], first / target['form'], second / target['form'],
                              output / target['form'])
                result['status'] = 'passed'
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                result['status'] = 'tests or reproducibility failed'
                print('form-images: %s verification failed: %s' % (target['form'], error), file=sys.stderr, flush=True)
                shutil.rmtree(output / target['form'], ignore_errors=True)
        write(output / 'results.json', results)
    return any(t['status'] in ('tests or reproducibility failed', 'resolution failed') for t in results)


def publish(snapshots, verified, store):
    snapshots, verified = Path(snapshots), Path(verified)
    if os.environ.get('GITHUB_REPOSITORY') != 'werewolf-linux/werewolf' or \
            not os.environ.get('GITHUB_RUN_ID', '').isdecimal():
        raise ValueError('form image publication requires canonical GitHub Actions provenance')
    key = Path(os.environ['WEREWOLF_BOOT_KEY'])
    certificate = Path('release/boot.crt')
    run_url = 'https://github.com/werewolf-linux/werewolf/actions/runs/' + os.environ['GITHUB_RUN_ID']
    commit = os.environ['GITHUB_SHA']
    rows, failures = [], False
    descriptions = catalog.descriptions()
    with tempfile.TemporaryDirectory(prefix='ww-image-catalog-') as temporary:
        work = Path(temporary)
        for plan_path in sorted(snapshots.glob('*/plan.json')):
            plan = json.loads(plan_path.read_text())
            name = 'verified-' + plan['arch'] + '-' + str(plan['shard'])
            result_path = verified / name / 'results.json'
            results = {t['form']: t for t in json.loads(result_path.read_text())} if result_path.exists() else {}
            for target in plan['targets']:
                form, arch = target['form'], target['arch']
                namespace = catalog.identity(form, arch)
                row = dict(form=form, arch=arch, status=results.get(form, target)['status'], run=run_url,
                           **descriptions.get(form, {}))
                if target['status'] == 'build' and row['status'] != 'passed':
                    row['status'] = 'build, tests or reproducibility failed'
                try:
                    if row['status'] == 'passed':
                        directory = verified / name / form
                        candidate = json.loads((directory / 'candidate.json').read_text())
                        if candidate['commit'] != commit or any(candidate[k] != target[k] for k in
                                                               ('form', 'arch', 'inputs', 'serial')):
                            raise ValueError('release inputs or source differ from this workflow')
                        report = json.loads((verified / name / (form + '-tests.json')).read_text())
                        catalog.publish(directory, report, store, key, certificate, run_url)
                        row['status'] = 'published'
                except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                    row['status'] = 'publication failed'
                    print('form-images: %s publication failed: %s' % (namespace, error), file=sys.stderr, flush=True)
                previous = work / 'previous'
                if store.fetch(namespace + '/current.json', previous):
                    row['latest'] = catalog.open_head(previous.read_bytes(), certificate, form, arch)
                elif row['status'] == 'unchanged':
                    row['status'] = 'published head missing; rebuild required'
                failures |= row['status'] not in ('published', 'unchanged', 'unsupported architecture')
                rows.append(row)
        expected = {(form, arch) for form in forms() for arch in catalog.ARCHES}
        seen = {(r['form'], r['arch']) for r in rows}
        if not seen <= expected or len(seen) != len(rows):
            raise ValueError('foreign or duplicate form catalog plan; previous index is retained')
        for form, arch in sorted(expected - seen):
            status = 'resolution or runner failed'
            try:
                if arch not in query('archs', form):
                    status = 'unsupported architecture'
            except (OSError, subprocess.SubprocessError):
                pass
            row = dict(form=form, arch=arch, status=status, run=run_url,
                       **descriptions.get(form, {}))
            if store.fetch(catalog.identity(form, arch) + '/current.json', work / 'previous'):
                row['latest'] = catalog.open_head((work / 'previous').read_bytes(), certificate, form, arch)
            rows.append(row)
            failures |= status != 'unsupported architecture'
        rows.sort(key=lambda r: (r['form'], r['arch']))
        write(work / 'index-data.json', dict(format='werewolf-form-catalog/1', forms=rows))
        (work / 'index.json').write_bytes(catalog.envelope(json.loads((work / 'index-data.json').read_text()), key))
        store.upload('index.json', work / 'index.json')
        for form in forms():
            page = work / 'form.html'
            page.write_text(catalog.page([r for r in rows if r['form'] == form], form + ' images'))
            store.upload(form + '/index.html', page)
        (work / 'index.html').write_text(catalog.page(rows))
        store.upload('index.html', work / 'index.html')
        if summary := os.environ.get('GITHUB_STEP_SUMMARY'):
            with Path(summary).open('a', encoding='utf-8') as stream:
                stream.write('### Form images\n\n| Form | Architecture | Latest attempt | Latest passing release |\n'
                             '| --- | --- | --- | --- |\n')
                for row in rows:
                    latest = row.get('latest')
                    link = '[Release notes](' + catalog.PUBLIC + '/' + latest['object'] + '/release-notes.html)' \
                        if latest else 'Not published'
                    stream.write('| %s | %s | %s | %s |\n' % (row['form'], row['arch'], row['status'], link))
    return failures


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    matrix = commands.add_parser('matrix')
    matrix.add_argument('--shards', type=int, default=8)
    resolve_parser = commands.add_parser('resolve')
    resolve_parser.add_argument('arch', choices=catalog.ARCHES)
    resolve_parser.add_argument('shard', type=int)
    resolve_parser.add_argument('shards', type=int)
    resolve_parser.add_argument('output')
    build_parser = commands.add_parser('build')
    build_parser.add_argument('snapshot')
    build_parser.add_argument('output')
    check_parser = commands.add_parser('check')
    for name in ('snapshot', 'first', 'second', 'output'):
        check_parser.add_argument(name)
    publish_parser = commands.add_parser('publish')
    publish_parser.add_argument('snapshots')
    publish_parser.add_argument('verified')
    args = parser.parse_args()
    if args.command == 'matrix':
        if not 1 <= args.shards <= 32:
            raise ValueError('use between 1 and 32 shards')
        print(json.dumps(dict(include=[dict(arch=arch, runner=runner, shard=shard, shards=args.shards)
            for arch, runner in [('x86_64', 'ubuntu-26.04'), ('aarch64', 'ubuntu-26.04-arm')]
            for shard in range(1, args.shards + 1)])))
    elif args.command == 'resolve':
        if not 1 <= args.shard <= args.shards <= 32:
            raise ValueError('invalid form image shard')
        resolve(args.arch, args.shard, args.shards, args.output)
    elif args.command == 'build':
        return build(args.snapshot, args.output)
    elif args.command == 'check':
        return check(args.snapshot, args.first, args.second, args.output)
    elif args.command == 'publish':
        return publish(args.snapshots, args.verified, catalog.Store(os.environ.get('IMAGES_BUCKET', 's3://werewolf/images/v1')))
    return False


if __name__ == '__main__':
    try:
        sys.exit(1 if main() else 0)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit('form-images: ' + str(error))
