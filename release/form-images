#!/usr/bin/env python3
"""Resolve every form, build its protected images twice, test, gate and publish them."""
import argparse
import datetime
import gzip
import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile

sys.dont_write_bytecode = True
import image_catalog as catalog
import image_notes as notes

HOWL = Path('build/host/howl').resolve()
FORM = Path('build/host/form').resolve()
TRUST = Path('release/protected').resolve()
# check-published-lifecycle drives a shell over ssh. Forms without one have
# no lifecycle gates yet (docs/design/image-release-testing.md).
GATED = ('playground',)
CHECKS = {'coverage', 'integration', 'reproducible'}
FOCUSED_TARGET = ('playground', 'qemu', 'x86_64')


def load(name, path):
    return importlib.machinery.SourceFileLoader(name, path).load_module()


resolver = load('form_input_resolver', 'release/protected-inputs')
builder = load('form_protected_builder', 'release/build-protected')
exporter = load('form_protected_export', 'release/export-protected')
publisher = load('form_protected_publisher', 'release/publish-protected')
mirror = load('form_protected_download', 'release/check-protected-download')


def run(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def query(*args):
    return subprocess.check_output([str(FORM), *args], text=True).splitlines()


def write(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(catalog.encode(value))


def native(arch):
    if platform.system() != 'Linux' or platform.machine() != arch:
        raise ValueError('form image builds and release tests require a native Linux runner')


def forms():
    return sorted(p.parent.name for p in Path('forms').glob('*/form.yaml') if catalog.NAME.fullmatch(p.parent.name))


def focused_target(value):
    if value not in ('all', '/'.join(FOCUSED_TARGET)):
        raise ValueError('target must be all or ' + '/'.join(FOCUSED_TARGET))
    return value != 'all'


def matrix(shards, focused=False):
    if not 1 <= shards <= 32:
        raise ValueError('use between 1 and 32 shards')
    if focused:
        return dict(include=[dict(arch='x86_64', runner='ubuntu-26.04', shard=1, shards=1)])
    return dict(include=[dict(arch=arch, runner=runner, shard=shard, shards=shards)
        for arch, runner in [('x86_64', 'ubuntu-26.04'), ('aarch64', 'ubuntu-26.04-arm')]
        for shard in range(1, shards + 1)])


def source_identity(form, chain):
    # Unrelated forms and prose do not invalidate this form. Common programs,
    # build tools, tests, trust, examples and publication policy are inputs.
    roots = ['Makefile', 'files.zig', 'boot', 'cmd', 'lib', 'tools', 'test', 'release', '.github', 'examples']
    roots += ['forms/' + name for name in chain]
    tree = subprocess.check_output(['git', 'ls-tree', '-rz', 'HEAD', '--', *roots])
    return resolver.source_identity(tree)


def resolved_identity(form, arch, snapshot, chain):
    locks = {p.name: json.loads(p.read_text()) for p in
             [*snapshot.parent.glob('*.lock.json'), *snapshot.glob('*.lock.json')]}
    packages = resolver.identity(source_identity(form, chain), arch, locks)
    images = [json.loads(p.read_text())['werewolf']['images'] for p in sorted(snapshot.glob(form + '*.lock.json'))]
    versions = json.loads((snapshot / 'tools.json').read_text())
    return hashlib.sha256(catalog.encode(dict(packages=packages, images=images, tools=versions))).hexdigest()


def lock_recipe(recipe, arch, output):
    contents = {}
    for field in ('Repositories', 'Keyring', 'Packages'):
        template = '{{ range .Environment.Contents.' + field + ' }}{{ println . }}{{ end }}'
        lines = subprocess.check_output(['melange', 'query', recipe, template], text=True).splitlines()
        if not lines:
            raise ValueError('empty Melange environment: ' + recipe)
        contents[field.lower()] = lines
    config = output.with_name(output.name + '.apko.json')
    write(config, dict(contents=contents, archs=[arch]))
    resolver.resolve(config.name, output, arch, output.parent)
    config.unlink()


def shared_inputs(arch, output):
    with tempfile.TemporaryDirectory() as temporary:
        configs = resolver.boot_configs(Path(temporary))
        for name in ('kernel', 'boot'):
            resolver.resolve(name + '.yaml', output / (name + '.lock.json'), 'aarch64,x86_64', configs)
    lock_recipe('boot/tpm-stub.melange.yaml', arch, output / 'stub-builder.lock.json')
    write(output / 'tools.json', tool_versions())


def tool_versions(extra=()):
    commands = [('zig', 'version'), ('apko', 'version'), ('melange', 'version'),
                ('qemu-img', '--version'), ('mkfs.erofs', '--version'), ('osslsigncode', '--version')]
    versions = {}
    for command in [*commands, *extra]:
        result = subprocess.run(command, check=True, capture_output=True, text=True)
        versions[' '.join(command)] = (result.stdout + result.stderr).strip()
    return versions


def compiler(form):
    return {'go-example': [('go', 'version')], 'rust-example': [('rustc', '--version')],
            'aspnet-example': [('dotnet', '--version')]}.get(form, [])


def resolve(arch, shard, shards, output, focused=False):
    if focused and (arch, shard, shards) != ('x86_64', 1, 1):
        raise ValueError('focused publication requires the single x86_64 shard')
    output = Path(output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    selected = [FOCUSED_TARGET[0]] if focused else forms()[shard - 1::shards]
    shared_inputs(arch, output)
    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
    serial = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    try:
        previous = catalog.read_index(TRUST / 'image.crt')
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        # Nothing is skipped on faith: without the signed index, rebuild.
        print('form-images: published index unreadable; rebuilding every form: %s' % error, file=sys.stderr, flush=True)
        previous = {}
    plan = dict(format='werewolf-form-plan/1', arch=arch, shard=shard, shards=shards, targets=[])
    for form in selected:
        target = dict(form=form, arch=arch, status='resolution failed')
        plan['targets'].append(target)
        try:
            if arch not in query('archs', form):
                target['status'] = 'unsupported architecture'
                continue
            snapshot = output / form
            snapshot.mkdir()
            chain = query('names', form)
            for suffix, flags in [('', []), ('-dev', ['--dev'])]:
                lock = Path('build/lock') / (form + suffix + '.lock.json')
                lock.unlink(missing_ok=True)
                run([HOWL, '_build', '--with', form, '--arch', arch, *flags, 'lock'])
                shutil.copyfile(lock, snapshot / lock.name)
            recipes = sorted({str(p) for name in chain for p in Path('forms', name, 'melange').glob('*.yaml')})
            mapping = {}
            for recipe in recipes:
                filename = 'melange-' + hashlib.sha256(recipe.encode()).hexdigest()[:16] + '.lock.json'
                lock_recipe(recipe, arch, snapshot / filename)
                mapping[recipe] = filename
            write(snapshot / 'melange.json', mapping)
            versions = tool_versions(compiler(form))
            write(snapshot / 'tools.json', versions)
            digest = resolved_identity(form, arch, snapshot, chain)
            target.update(inputs=digest, commit=commit, serial=serial)
            rows = [previous.get((form, provider, arch), {}) for provider in catalog.PROVIDERS[arch]]
            settled = all(r.get('inputs') == digest and r.get('status') in catalog.SETTLED for r in rows)
            target['status'] = 'unchanged' if settled and os.environ.get('FORM_IMAGES_FORCE') != '1' else 'build'
            write(snapshot / 'input.json', dict(chain=chain,
                  **{k: target[k] for k in ('form', 'arch', 'inputs', 'commit', 'serial')}))
        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            print('form-images: %s/%s resolution failed: %s' % (form, arch, error), file=sys.stderr, flush=True)
        write(output / 'plan.json', plan)
    write(output / 'plan.json', plan)


def bundles(target):
    """Each provider's bundle, plus the two updates a gated form's lifecycle installs."""
    start = datetime.datetime.strptime(target['serial'], '%Y%m%dT%H%M%SZ')
    for provider in catalog.PROVIDERS[target['arch']]:
        yield provider, provider, target['serial']
        if target['form'] in GATED:
            for n in (1, 2):
                later = (start + datetime.timedelta(seconds=n)).strftime('%Y%m%dT%H%M%SZ')
                yield '%s-update-%d' % (provider, n), provider, later


def install_locks(snapshot):
    lockdir = Path('build/lock')
    lockdir.mkdir(parents=True, exist_ok=True)
    for root in (snapshot.parent, snapshot):
        for path in root.glob('*.lock.json'):
            if not path.name.startswith('melange-'):
                shutil.copyfile(path, lockdir / path.name)


def archive_inputs(snapshot, output):
    # Keep original apko declaration locks for rebuilds, including OCI digests.
    paths = [(p.name, p) for p in sorted(snapshot.parent.glob('*.json')) if p.name != 'plan.json']
    paths += [(snapshot.name + '/' + p.name, p) for p in sorted(snapshot.glob('*.json'))]
    with output.open('wb') as stream, gzip.GzipFile(filename='', mode='wb', fileobj=stream, mtime=0) as compressed:
        with tarfile.open(mode='w', fileobj=compressed) as archive:
            for name, path in paths:
                info = tarfile.TarInfo(name)
                info.size, info.mode, info.mtime = path.stat().st_size, 0o644, 0
                with path.open('rb') as data:
                    archive.addfile(info, data)


def local_packages(snapshot, arch, package_dir=Path('build/vendor/packages')):
    # The same main/subpackages that howl's Melange overlay installs. Read the
    # built APK metadata so a same-version payload rebuild is visible too.
    packages = []
    template = '{{.Package.Name}}-{{.Package.Version}}-r{{.Package.Epoch}}' + \
        '{{$v := print "-" .Package.Version "-r" .Package.Epoch}}' + \
        '{{range .Subpackages}} {{.Name}}{{$v}}{{end}}'
    for recipe in sorted(json.loads((snapshot / 'melange.json').read_text())):
        names = subprocess.check_output(['melange', 'query', recipe, template], text=True).split()
        if not names:
            raise ValueError('empty built package inventory: ' + recipe)
        for name in names:
            metadata = subprocess.check_output(['bsdtar', '-xzOf',
                package_dir / arch / (name + '.apk'), '.PKGINFO'], text=True)
            fields = dict(line.split(' = ', 1) for line in metadata.splitlines() if ' = ' in line)
            if fields['arch'] != arch:
                raise ValueError('built package has the wrong architecture')
            packages.append(dict(name=fields['pkgname'], version=fields['pkgver'], checksum=fields['datahash']))
    return packages


def build_one(target, snapshot, output):
    form, arch = target['form'], target['arch']
    chain = json.loads((snapshot / 'input.json').read_text())['chain']
    if resolved_identity(form, arch, snapshot, chain) != target['inputs']:
        raise ValueError('source, package or OCI inputs changed after resolution')
    if json.loads((snapshot / 'tools.json').read_text()) != tool_versions(compiler(form)):
        raise ValueError('build tools changed after input resolution')
    install_locks(snapshot)
    os.environ['WEREWOLF_FORM_INPUTS'] = str(snapshot)
    output.mkdir(parents=True)
    for name, provider, serial in bundles(target):
        work = Path('build/protected-images') / (arch + '-' + provider) / form
        try:
            builder.build(form, provider, arch, serial, output / name)
            if (work / (form + '-ipe') / 'meta/usr/share/werewolf/dev').exists():
                raise ValueError('development images cannot be published')
        finally:
            # Disposable outputs: keep a shard within the runner's disk.
            shutil.rmtree(work, ignore_errors=True)
    archive_inputs(snapshot, output / 'inputs.tar.gz')
    write(output / 'packages.json', notes.inventory(snapshot, form, arch, local_packages(snapshot, arch)))
    keep(target, output)


def digests(root):
    files = {}
    for path in sorted(root.rglob('*')):
        if path.is_symlink():
            raise ValueError('form image builds must not hold links')
        if path.is_file():
            files[str(path.relative_to(root))] = catalog.record(path)
    return files


def keep(target, output):
    """Record every file of a build by digest; the copies compare records.
    Only the forms the lifecycle gates can be published, so the others keep
    just what later jobs read and their gigabytes never leave the runner."""
    write(output.parent / (target['form'] + '.files.json'), digests(output))
    if target['form'] in GATED:
        return
    for name, _, _ in bundles(target):
        descriptor = (output / name / 'boot.json').read_bytes()
        shutil.rmtree(output / name)
        (output / name).mkdir()
        (output / name / 'boot.json').write_bytes(descriptor)


def build(snapshot, output):
    snapshot, output = Path(snapshot).resolve(), Path(output).resolve()
    plan = json.loads((snapshot / 'plan.json').read_text())
    native(plan['arch'])
    # As release/build-protected runs: work trees hold signing inputs.
    os.umask(0o077)
    os.environ.update(SOURCE_DATE_EPOCH='0', WEREWOLF_PROTECTED_INPUTS=str(snapshot))
    output.mkdir(parents=True, exist_ok=False)
    results = []
    try:
        if json.loads((snapshot / 'tools.json').read_text()) != tool_versions():
            raise ValueError('security build tools changed after input resolution')
        for target in plan['targets']:
            result = dict(target)
            results.append(result)
            if target['status'] != 'build':
                continue
            try:
                # Child output is retained separately for each form.
                with (output / (target['form'] + '.log')).open('wb') as log, redirect(log):
                    build_one(target, snapshot / target['form'], output / target['form'])
                result['status'] = 'built'
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                result['status'] = 'build failed'
                print('form-images: %s build failed: %s' % (target['form'], error), file=sys.stderr, flush=True)
                shutil.rmtree(output / target['form'], ignore_errors=True)
            write(output / 'results.json', results)
    finally:
        write(output / 'results.json', results)
    return any(t['status'] in ('build failed', 'resolution failed') for t in results)


class redirect:
    """Keep subprocess diagnostics in per-form logs without changing their APIs."""
    def __init__(self, stream):
        self.stream = stream

    def __enter__(self):
        sys.stdout.flush()
        sys.stderr.flush()
        self.saved = [os.dup(fd) for fd in (1, 2)]
        for fd in (1, 2):
            os.dup2(self.stream.fileno(), fd)

    def __exit__(self, *exc):
        sys.stdout.flush()
        sys.stderr.flush()
        for fd, saved in zip((1, 2), self.saved):
            os.dup2(saved, fd)
            os.close(saved)


def same(form, first, second):
    """The copies match when their records do, and what the first still
    holds is what it recorded: the bytes later jobs read."""
    one, two = (json.loads(catalog.read(root.parent / (form + '.files.json'))) for root in (first, second))
    if one != two:
        raise ValueError('independent form image builds differ')
    held = digests(first)
    if any(one.get(name) != record for name, record in held.items()) or (form in GATED and held != one):
        raise ValueError('form image copy differs from its build record')


def check_one(target, snapshot, first, second, output, lifecycle):
    form, arch = target['form'], target['arch']
    same(form, first, second)
    descriptors = {}
    for name, _, serial in bundles(target):
        manifest = json.loads(catalog.read(first / name / 'boot.json'))
        if (manifest['form'], manifest['image']['arch'], manifest['image']['serial']) != (form, arch, serial):
            raise ValueError('bundle differs from its resolved target: ' + name)
        descriptors[name] = catalog.sha(first / name / 'boot.json')
    install_locks(snapshot)
    env = dict(os.environ, WEREWOLF_FORM_INPUTS=str(snapshot))
    run([sys.executable, 'test/form-coverage', '--form', form], env=env)
    run([HOWL, 'test', '--with', form, '--arch', arch], env=env)
    output.mkdir(parents=True)
    for name in ('inputs.tar.gz', 'packages.json'):
        shutil.copyfile(first / name, output / name)
    # The bundle descriptors bind this evidence to the exact bytes gated later.
    write(output / 'tests.json', dict(format='werewolf-form-tests/1', bundles=descriptors,
          checks={name: True for name in sorted(CHECKS)}, **{k: target[k] for k in ('form', 'arch', 'inputs')}))
    if form in GATED:
        for name, _, _ in bundles(target):
            shutil.copytree(first / name, lifecycle / form / name)


def check(snapshot, first, second, output, lifecycle):
    snapshot, first, second, output, lifecycle = map(lambda p: Path(p).resolve(),
                                                     (snapshot, first, second, output, lifecycle))
    plan = json.loads((snapshot / 'plan.json').read_text())
    native(plan['arch'])
    output.mkdir(parents=True, exist_ok=False)
    results = []
    for target in plan['targets']:
        result = dict(target)
        results.append(result)
        if target['status'] == 'build':
            try:
                with (output / (target['form'] + '.log')).open('wb') as log, redirect(log):
                    check_one(target, snapshot / target['form'], first / target['form'], second / target['form'],
                              output / target['form'], lifecycle)
                result['status'] = 'passed'
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                result['status'] = 'tests or reproducibility failed'
                print('form-images: %s verification failed: %s' % (target['form'], error), file=sys.stderr, flush=True)
                shutil.rmtree(output / target['form'], ignore_errors=True)
                shutil.rmtree(lifecycle / target['form'], ignore_errors=True)
        write(output / 'results.json', results)
    return any(t['status'] in ('tests or reproducibility failed', 'resolution failed') for t in results)


def gates(environ, focused=False):
    """Lifecycle runners by target. Self-hosted ones are repository variables
    holding a JSON list of runner labels; a target without one is not gated."""
    runners = {('qemu', 'x86_64'): '["ubuntu-26.04"]',
               ('qemu', 'aarch64'): environ.get('ARM64_KVM_RUNNER', ''),
               ('lima', 'aarch64'): environ.get('LIMA_RUNNER', '')}
    include = []
    for (provider, arch), value in runners.items():
        if focused and (provider, arch) != FOCUSED_TARGET[1:]:
            continue
        if not value:
            continue
        labels = json.loads(value)
        if not isinstance(labels, list) or not labels or not all(isinstance(v, str) and v for v in labels):
            raise ValueError('a gate runner is a JSON list of labels')
        include.append(dict(provider=provider, arch=arch, runner=labels))
    return dict(include=include)


def artifact_directories(root, pattern, marker):
    """download-artifact flattens a single match, even with merge-multiple false."""
    root = Path(root)
    directories = sorted(path.parent for path in root.glob(pattern + '/' + marker))
    if (root / marker).is_file():
        if directories:
            raise ValueError('mixed flat and named form image artifacts')
        return [root]
    return directories


def plans(snapshots):
    targets = {}
    directories = artifact_directories(snapshots, 'inputs-*', 'plan.json')
    if not directories:
        raise ValueError('form image plans are missing')
    for directory in directories:
        plan = json.loads((directory / 'plan.json').read_text())
        for target in plan['targets']:
            key = (target['form'], target['arch'])
            if key in targets or target['arch'] != plan['arch']:
                raise ValueError('foreign or duplicate form image plan')
            targets[key] = dict(target, shard=plan['shard'])
    return targets


def verified_results(verified):
    results = {}
    for directory in artifact_directories(verified, 'verified-*', 'results.json'):
        for result in json.loads((directory / 'results.json').read_text()):
            results[(result['form'], result['arch'])] = dict(result, directory=directory / result['form'])
    return results


def index(store):
    """The published rows, or none before the first publication."""
    with tempfile.TemporaryDirectory(prefix='ww-form-index-') as temporary:
        raw = Path(temporary) / 'index.json'
        if not store.fetch('index.json', raw):
            return {}
        return catalog.open_index(catalog.read(raw, 4 << 20), TRUST / 'image.crt')


def inventory(store, latest, work):
    """The package inventory a previous release signed, if it carried one."""
    names = ('downloads.json', 'downloads.json.sig', 'packages.json')
    for name in names[:2]:
        if not store.fetch(latest['object'] + '/' + name, work / name):
            raise ValueError('previous release manifest is missing')
    catalog.verify_signature(catalog.read(work / names[0], 4 << 20), catalog.read(work / names[1], 512),
                             TRUST / 'image.crt')
    signed = json.loads(catalog.read(work / names[0], 4 << 20))
    if signed['descriptor'] != latest['descriptor'] or 'packages.json' not in signed['files']:
        return None
    expected = signed['files']['packages.json']
    if not store.fetch(latest['object'] + '/packages.json', work / names[2]) or \
            catalog.record(work / names[2]) != dict(sha256=expected['sha256'], size=expected['size']):
        raise ValueError('previous release package inventory is missing or changed')
    return json.loads(catalog.read(work / names[2], 4 << 20))


def export_one(directory, targets, results, previous, store, assets):
    report = json.loads(catalog.read(directory / 'gates.json', 64 << 10))
    bundle = directory / 'bundle'
    manifest = json.loads(catalog.read(bundle / 'boot.json'))
    form, provider, arch = manifest['form'], report['provider'], manifest['image']['arch']
    key = catalog.namespace(form, provider, arch)
    target, result = targets[(form, arch)], results[(form, arch)]
    if target['commit'] != os.environ['GITHUB_SHA'] or result['status'] != 'passed':
        raise ValueError('gated bundle is not this workflow\'s verified build')
    verified = result['directory']
    tests = json.loads(catalog.read(verified / 'tests.json'))
    if tests['inputs'] != target['inputs'] or set(tests['checks']) != CHECKS or \
            any(v is not True for v in tests['checks'].values()) or \
            tests['bundles'].get(provider) != catalog.sha(bundle / 'boot.json'):
        raise ValueError('gated bundle differs from the verified build')
    with tempfile.TemporaryDirectory(prefix='ww-form-extras-') as temporary:
        work = Path(temporary)
        latest = previous.get((form, provider, arch), {}).get('latest')
        old = inventory(store, latest, work) if latest else None
        packages = json.loads(catalog.read(verified / 'packages.json', 4 << 20))
        release = notes.release(dict(form=form, provider=provider, arch=arch, serial=manifest['image']['serial'],
                                     commit=target['commit']), packages, latest if old else None, old)
        write(work / 'release-notes.json', release)
        (work / 'release-notes.html').write_text(notes.page(release), encoding='utf-8')
        extras = {name: verified / name for name in ('inputs.tar.gz', 'packages.json', 'tests.json')}
        extras.update({name: work / name for name in ('release-notes.json', 'release-notes.html')})
        output = assets / key.replace('/', '-')
        exporter.export(str(HOWL), bundle, report, provider, output, TRUST, publisher.preparation, extras)
    return dict(form=form, provider=provider, arch=arch, bundle=str(bundle.resolve()),
                gates=str((directory / 'gates.json').resolve()), assets=str(output))


def export(snapshots, verified, gated, store, assets, listing):
    """Sign release assets for every bundle that passed its lifecycle gates.
    A target that fails here is left out; publish records it as failed."""
    exporter.provenance()
    targets, results = plans(snapshots), verified_results(verified)
    previous = index(store)
    assets = Path(assets).resolve()
    assets.mkdir(parents=True, exist_ok=False)
    exported = []
    for directory in artifact_directories(gated, 'gated-*', 'gates.json'):
        try:
            exported.append(export_one(directory, targets, results, previous, store, assets))
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
            print('form-images: %s export failed: %s' % (directory.name, error), file=sys.stderr, flush=True)
    write(listing, exported)
    output(targets=len(exported))


def output(**values):
    if path := os.environ.get('GITHUB_OUTPUT'):
        with Path(path).open('a') as stream:
            stream.writelines('%s=%s\n' % item for item in values.items())


def publish(snapshots, verified, gated_targets, listing, store, focused=False):
    """Advance each exported target, then sign the catalog of every target."""
    provenance = exporter.provenance()
    key = os.environ['WEREWOLF_PROTECTED_IMAGE_KEY']
    targets, results = plans(snapshots), verified_results(verified)
    previous = index(store)
    exported = {catalog.namespace(t['form'], t['provider'], t['arch']): t
                for t in json.loads(Path(listing).read_text())}
    if focused and (set(targets) - {(FOCUSED_TARGET[0], FOCUSED_TARGET[2])} or
                    set(exported) - {catalog.namespace(*FOCUSED_TARGET)}):
        raise ValueError('focused publication contains an unrelated target')
    published = {}
    for name, target in sorted(exported.items()):
        try:
            report = json.loads(catalog.read(target['gates'], 64 << 10))
            assets = Path(target['assets'])
            publisher.publish(str(HOWL), Path(target['bundle']), report, target['provider'], store, TRUST, assets)
            if store.bucket.startswith('s3://'):
                mirror.check(str(HOWL), target['bundle'], target['provider'], assets)
            signed = json.loads(catalog.read(assets / (name.replace('/', '-') + '-downloads.json'), 4 << 20))
            published[name] = dict(serial=signed['serial'], commit=signed['provenance']['commit'],
                                   descriptor=signed['descriptor'], object=name + '/objects/' + signed['descriptor'],
                                   size=signed['files']['disk.qcow2']['size'])
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
            print('form-images: %s publication failed: %s' % (name, error), file=sys.stderr, flush=True)
    # The GitHub release carries every exported target, so it follows R2 only
    # when all of them are there.
    output(released=str(published.keys() == exported.keys()).lower())
    # A focused run has no evidence about other targets. Preserve their signed
    # rows, including failures, inputs and last publications, without relabeling.
    rows = [row for target, row in previous.items() if target != FOCUSED_TARGET] if focused else []
    attempted = []
    descriptions = catalog.descriptions()
    for form in [FOCUSED_TARGET[0]] if focused else forms():
        for arch in [FOCUSED_TARGET[2]] if focused else catalog.ARCHES:
            target = targets.get((form, arch))
            status = target['status'] if target else 'resolution or runner failed'
            if target is None:
                try:
                    if arch not in query('archs', form):
                        status = 'unsupported architecture'
                except (OSError, subprocess.SubprocessError):
                    pass
            for provider in catalog.PROVIDERS[arch]:
                name = catalog.namespace(form, provider, arch)
                last = previous.get((form, provider, arch), {})
                row = dict(form=form, provider=provider, arch=arch, status=status, run=provenance['run'],
                           **descriptions.get(form, {}))
                if 'latest' in last:
                    row['latest'] = last['latest']
                if status == 'unchanged':
                    row.update({k: last[k] for k in ('status', 'inputs', 'run') if k in last})
                elif status == 'build':
                    row['inputs'] = target['inputs']
                    result = results.get((form, arch), {}).get('status')
                    if result != 'passed':
                        row['status'] = 'build, tests or reproducibility failed'
                    elif name in published:
                        row.update(status=catalog.PUBLISHED, latest=published[name])
                    elif name in exported:
                        row['status'] = 'publication failed'
                    elif form not in GATED:
                        row['status'] = catalog.UNGATED
                    elif (provider, arch) not in gated_targets:
                        row['status'] = catalog.NO_RUNNER
                    else:
                        row['status'] = 'lifecycle gates or export failed'
                rows.append(catalog.validate(row))
                attempted.append(row)
    rows.sort(key=lambda row: (row['form'], row['arch'], row['provider']))
    with tempfile.TemporaryDirectory(prefix='ww-image-catalog-') as temporary:
        work = Path(temporary)
        (work / 'index.json').write_bytes(catalog.envelope(dict(format=catalog.FORMAT, forms=rows), key))
        catalog.open_index((work / 'index.json').read_bytes(), TRUST / 'image.crt')
        store.upload('index.json', work / 'index.json', False)
        for form in sorted(set(forms()) | {row['form'] for row in rows}):
            (work / 'form.html').write_text(catalog.page([r for r in rows if r['form'] == form], form + ' images'))
            store.upload(form + '/index.html', work / 'form.html', False)
        (work / 'index.html').write_text(catalog.page(rows))
        store.upload('index.html', work / 'index.html', False)
    if summary := os.environ.get('GITHUB_STEP_SUMMARY'):
        with Path(summary).open('a', encoding='utf-8') as stream:
            stream.write('### Form images\n\n| Form | Target | Latest attempt | Latest published |\n'
                         '| --- | --- | --- | --- |\n')
            for row in rows:
                latest = row.get('latest')
                link = '[%s](%s/%s/release-notes.html)' % (latest['serial'], catalog.PUBLIC, latest['object']) \
                    if latest else 'Not published'
                stream.write('| %s | %s/%s | %s | %s |\n' % (row['form'], row['provider'], row['arch'],
                                                            row['status'], link))
    return any(r['status'] not in catalog.SETTLED | {'unsupported architecture'} for r in attempted)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    matrix_parser = commands.add_parser('matrix')
    matrix_parser.add_argument('--shards', type=int, default=8)
    commands.add_parser('gates')
    resolve_parser = commands.add_parser('resolve')
    resolve_parser.add_argument('arch', choices=catalog.ARCHES)
    resolve_parser.add_argument('shard', type=int)
    resolve_parser.add_argument('shards', type=int)
    resolve_parser.add_argument('output')
    build_parser = commands.add_parser('build')
    build_parser.add_argument('snapshot')
    build_parser.add_argument('output')
    check_parser = commands.add_parser('check')
    for name in ('snapshot', 'first', 'second', 'output', 'lifecycle'):
        check_parser.add_argument(name)
    export_parser = commands.add_parser('export')
    for name in ('snapshots', 'verified', 'gated', 'assets', 'listing'):
        export_parser.add_argument(name)
    publish_parser = commands.add_parser('publish')
    for name in ('snapshots', 'verified', 'listing'):
        publish_parser.add_argument(name)
    args = parser.parse_args()
    focused = focused_target(os.environ.get('FORM_IMAGES_TARGET', 'all'))
    store = publisher.Store(os.environ.get('PROTECTED_BUCKET', 's3://werewolf/boot/v1'))
    if args.command == 'matrix':
        print(json.dumps(matrix(args.shards, focused)))
    elif args.command == 'gates':
        print(json.dumps(gates(os.environ, focused)))
    elif args.command == 'resolve':
        if not 1 <= args.shard <= args.shards <= 32:
            raise ValueError('invalid form image shard')
        resolve(args.arch, args.shard, args.shards, args.output, focused)
    elif args.command == 'build':
        return build(args.snapshot, args.output)
    elif args.command == 'check':
        return check(args.snapshot, args.first, args.second, args.output, args.lifecycle)
    elif args.command == 'export':
        export(args.snapshots, args.verified, args.gated, store, args.assets, args.listing)
    elif args.command == 'publish':
        gated = {(t['provider'], t['arch']) for t in json.loads(os.environ['FORM_IMAGES_GATES'])['include']}
        return publish(args.snapshots, args.verified, gated, args.listing, store, focused)
    return False


if __name__ == '__main__':
    try:
        sys.exit(1 if main() else 0)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit('form-images: ' + str(error))
