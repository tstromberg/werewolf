#!/usr/bin/env python3
"""Export one gated bundle for GitHub and R2, including an authenticated qcow2."""
import importlib.machinery
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

downloads = importlib.machinery.SourceFileLoader('export_downloads', 'tools/boot-download').load_module()
# The form pipeline adds what the bundle was built from and how it changed;
# the signed manifest covers them like every other asset.
EXTRAS = {'inputs.tar.gz', 'packages.json', 'tests.json', 'release-notes.json', 'release-notes.html'}


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def public_key(trust):
    return subprocess.check_output(['openssl', 'x509', '-in', str(Path(trust) / 'image.crt'), '-pubkey', '-noout'])


def sources(bundle, trust):
    bundle, trust = Path(bundle), Path(trust)
    arch = json.loads(downloads.read(bundle / 'boot.json', downloads.HEAD_LIMIT))['image']['arch']
    files = {name: bundle / 'slot' / name for name in downloads.FILES}
    files.update({name: bundle / name for name in ('boot.json', 'boot.json.sig', 'disk.img.zst')})
    files.update({name: bundle / 'prebuilt' / arch / name for name in ('latest.json', 'latest.json.sig')})
    files.update({name: trust / name for name in ('boot.crt', 'image.crt')})
    return files


def unpack(source, target, size):
    if type(size) is not int or not 512 << 20 <= size <= 16 << 30:
        raise ValueError('invalid authenticated raw disk size')
    with tempfile.TemporaryFile() as errors:
        process = subprocess.Popen(['zstd', '-q', '-dc', str(source)], stdout=subprocess.PIPE, stderr=errors)
        try:
            total = 0
            with target.open('xb') as output:
                while True:
                    block = process.stdout.read(1 << 20)
                    if not block:
                        break
                    total += len(block)
                    if total > size:
                        raise ValueError('raw disk exceeds its authenticated size')
                    if block.count(0) == len(block):
                        output.seek(len(block), 1)
                    else:
                        output.write(block)
                if process.wait(timeout=30) or total != size:
                    raise ValueError('raw disk differs from its authenticated size')
                output.truncate(size)
        finally:
            process.stdout.close()
            if process.poll() is None:
                process.kill()
                process.wait()


def compare(raw, qcow2, size):
    info = json.loads(subprocess.check_output(['qemu-img', 'info', '--output=json', '-f', 'qcow2', str(qcow2)]))
    if info['format'] != 'qcow2' or info['virtual-size'] != size or any(
            name in info for name in ('backing-filename', 'full-backing-filename', 'data-file')):
        raise ValueError('qcow2 must be a standalone disk of the authenticated size')
    if info.get('format-specific', {}).get('data', {}).get('data-file'):
        raise ValueError('qcow2 has an external data file')
    run(['qemu-img', 'check', '-f', 'qcow2', qcow2], capture_output=True)
    run(['qemu-img', 'compare', '-f', 'raw', '-F', 'qcow2', raw, qcow2], capture_output=True)


def provenance():
    repository, commit, run_id = [os.environ.get(name, '') for name in
                                  ('GITHUB_REPOSITORY', 'GITHUB_SHA', 'GITHUB_RUN_ID')]
    if repository != 'werewolf-linux/werewolf' or not re.fullmatch(r'[0-9a-f]{40}', commit) or not run_id.isdecimal():
        raise ValueError('protected release export requires GitHub Actions provenance')
    return dict(repository=repository, commit=commit,
                run='https://github.com/%s/actions/runs/%s' % (repository, run_id),
                attempt=os.environ.get('GITHUB_RUN_ATTEMPT', '1'))


def verify(directory, bundle, report, provider, trust):
    directory, bundle, trust = Path(directory), Path(bundle), Path(trust)
    manifest = json.loads(downloads.read(bundle / 'boot.json', downloads.HEAD_LIMIT))
    prefix = '%s-%s-%s' % (manifest['form'], provider, manifest['image']['arch'])
    head = directory / (prefix + '-downloads.json')
    signature = directory / (head.name + '.sig')
    with tempfile.TemporaryDirectory(prefix='ww-download-verify-') as temporary:
        key = Path(temporary) / 'image.pub'
        key.write_bytes(public_key(trust))
        if len(downloads.read(signature, 512)) not in (256, 512):
            raise ValueError('invalid downloads signature')
        run(['openssl', 'dgst', '-sha256', '-verify', key, '-signature', signature, head], capture_output=True)
        signed = json.loads(downloads.read(head, downloads.HEAD_LIMIT))
        expected = dict(format='werewolf-downloads/1', descriptor=downloads.sha(bundle / 'boot.json'),
                        form=manifest['form'], provider=provider, arch=manifest['image']['arch'],
                        serial=manifest['image']['serial'])
        if set(signed) != set(expected) | {'files', 'provenance'} or any(signed[name] != value for name, value in expected.items()):
            raise ValueError('download manifest describes another protected bundle')
        original = sources(bundle, trust)
        required = set(original) | {'disk.qcow2', 'gates.json'}
        if not required <= set(signed['files']) <= required | EXTRAS:
            raise ValueError('download manifest has incomplete or unexpected files')
        for name, record in signed['files'].items():
            if set(record) != {'asset', 'sha256', 'size'} or record['asset'] != prefix + '-' + name:
                raise ValueError('invalid release asset mapping')
            asset = directory / record['asset']
            if asset.is_symlink() or not asset.is_file() or asset.stat().st_size != record['size'] or downloads.sha(asset) != record['sha256']:
                raise ValueError('release asset differs from its signed digest')
            if name in original and downloads.sha(original[name]) != record['sha256']:
                raise ValueError('GitHub and R2 bundle bytes differ')
        if json.loads(downloads.read(directory / (prefix + '-gates.json'), 64 << 10)) != report:
            raise ValueError('release carries different lifecycle evidence')
        required_assets = {record['asset'] for record in signed['files'].values()} | {head.name, signature.name}
        if {path.name for path in directory.iterdir()} != required_assets:
            raise ValueError('unexpected files in protected release export')
        raw = Path(temporary) / 'disk.raw'
        unpack(bundle / 'disk.img.zst', raw, manifest['raw_size'])
        compare(raw, directory / (prefix + '-disk.qcow2'), manifest['raw_size'])
    return signed


def export(howl, bundle, report, provider, output, trust='release/protected', preparation=None, extras=None):
    if preparation is None:
        preparation = importlib.machinery.SourceFileLoader('export_preparation', 'release/prepare-protected').load_module()
    bundle, output, trust = Path(bundle).resolve(), Path(output).resolve(), Path(trust).resolve()
    if output.exists():
        raise ValueError('release export already exists')
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='protected-export-', dir=output.parent) as temporary:
        work = Path(temporary)
        # Authenticate code and exact-artifact runtime gates before deriving or signing anything.
        plan = preparation.prepare(howl, bundle, report, provider, work / 'admitted', trust)
        manifest = json.loads(downloads.read(bundle / 'boot.json', downloads.HEAD_LIMIT))
        prefix = '%s-%s-%s' % (plan['form'], provider, plan['arch'])
        staging = work / 'assets'
        staging.mkdir()
        originals = sources(bundle, trust)
        if extras is not None:
            if not set(extras) <= EXTRAS:
                raise ValueError('unexpected release extras')
            originals.update(extras)
        for name, source in originals.items():
            shutil.copyfile(source, staging / (prefix + '-' + name))
        downloads.atomic(staging / (prefix + '-gates.json'), report)
        raw = work / 'disk.raw'
        unpack(bundle / 'disk.img.zst', raw, manifest['raw_size'])
        qcow2 = staging / (prefix + '-disk.qcow2')
        run(['qemu-img', 'convert', '-f', 'raw', '-O', 'qcow2', '-c', '-o',
             'compat=1.1,cluster_size=65536,lazy_refcounts=off,compression_type=zstd', raw, qcow2])
        compare(raw, qcow2, manifest['raw_size'])
        files = {path.name[len(prefix) + 1:]: dict(asset=path.name, size=path.stat().st_size, sha256=downloads.sha(path))
                 for path in sorted(staging.iterdir())}
        signed = dict(format='werewolf-downloads/1', descriptor=plan['descriptor'], form=plan['form'],
                      provider=provider, arch=plan['arch'], serial=plan['serial'], files=files, provenance=provenance())
        head = staging / (prefix + '-downloads.json')
        downloads.atomic(head, signed)
        run(['openssl', 'dgst', '-sha256', '-sign', os.environ['WEREWOLF_PROTECTED_IMAGE_KEY'],
             '-out', str(head) + '.sig', head], capture_output=True)
        verify(staging, bundle, report, provider, trust)
        os.rename(staging, output)
    return signed


if __name__ == '__main__':
    os.umask(0o077)
    try:
        if len(sys.argv) != 6:
            raise ValueError('usage: export-protected HOWL BUNDLE GATES_JSON PROVIDER OUTPUT')
        howl, bundle, evidence, provider, output = sys.argv[1:]
        export(str(Path(howl).resolve()), bundle, json.loads(downloads.read(evidence, 64 << 10)), provider, output)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        sys.exit('export-protected: ' + str(error))
