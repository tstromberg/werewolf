#!/usr/bin/env python3
"""Build a protected vendor bundle using public-only compile inputs and host signing."""
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import sys
import tempfile


def published_kernel(arch, pins, output):
    """linux-werewolf from werewolf's kernel repository, as apko installs it."""
    loader = importlib.machinery.SourceFileLoader('protected_inputs', 'release/protected-inputs')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    resolver = importlib.util.module_from_spec(spec)
    loader.exec_module(resolver)
    with tempfile.TemporaryDirectory(dir=output.parent) as temporary:
        configs = resolver.boot_configs(Path(temporary))
        incoming = Path(temporary) / 'rootfs.tar'
        subprocess.run(['apko', '--workdir', configs, 'build-minirootfs', '--build-arch', arch,
                        *pins, 'kernel.yaml', incoming], check=True)
        os.replace(incoming, output)


def build(form, provider, arch, serial, index, output):
    if not re.fullmatch(r'[a-z][a-z0-9-]{0,63}', form) or provider not in ('lima', 'qemu'):
        raise ValueError('invalid protected form or provider')
    if arch not in ('aarch64', 'x86_64') or platform.machine() != arch or platform.system() != 'Linux':
        raise ValueError('CI builds require a native Linux runner for the requested architecture')
    if provider == 'lima' and arch != 'aarch64':
        raise ValueError('protected Lima currently requires arm64')
    index = int(index)
    if index < 1:
        raise ValueError('a release index is 1 or more')
    output = Path(output).resolve()
    if output.exists():
        raise ValueError('protected output already exists')
    output.parent.mkdir(parents=True, exist_ok=True)
    os.environ['SOURCE_DATE_EPOCH'] = '0'
    loader = importlib.machinery.SourceFileLoader('protected_builder', 'tools/local-prerequisites')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    builder = importlib.util.module_from_spec(spec)
    loader.exec_module(builder)
    tree, cache = Path.cwd(), Path('build/protected-cache').resolve()
    cache.mkdir(parents=True, exist_ok=True)
    # This command must be called through with-protected-keys. Key files remain
    # on this host; the stub's builder sees only public inputs.
    key = Path(os.environ['WEREWOLF_PROTECTED_IMAGE_KEY']).resolve()
    cert = Path(os.environ['WEREWOLF_PROTECTED_IMAGE_CRT']).resolve()
    boot_key = Path(os.environ['WEREWOLF_PROTECTED_BOOT_KEY']).resolve()
    boot_cert = Path(os.environ['WEREWOLF_PROTECTED_BOOT_CRT']).resolve()
    inputs = {name: tree / name for name in ('boot/kernel.yaml', 'release/packages.pub')}
    pins = []
    if snapshot := os.environ.get('WEREWOLF_PROTECTED_INPUTS'):
        inputs['package-lock'] = Path(snapshot) / 'kernel.lock.json'
        pins = [argument for package in builder.package_pins(inputs['package-lock'], arch)
                for argument in ('-p', package)]
    with (cache / 'build.lock').open('a+b') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        # The published kernel's IPE trusts the protected image certificate.
        # check-protected-qemu's disposable certificate needs a test kernel
        # (tools/test-kernel); howl refuses any whose IPE trusts another.
        if test := os.environ.get('WEREWOLF_PROTECTED_TEST_KERNEL'):
            kernel = Path(test).resolve()
        else:
            pin = builder.fingerprint(arch, inputs)
            kernel = builder.cached(cache / arch / ('kernel-' + pin), pin, 'rootfs.tar',
                                    lambda path: published_kernel(arch, pins, path))
        pin = builder.fingerprint(arch, builder.stub_files(tree))
        stub = builder.cached(cache / arch / ('stub-' + pin), pin, 'linux.efi.stub',
                              lambda path: builder.stub(tree, cache, arch, path))
    env = dict(os.environ, UKI_STUB=str(stub))
    # Machines follow the public mirror themselves (docs/design/independent-updates.md).
    trust = json.loads(Path('release/protected/trust.json').read_text())
    channel = '%s/%s/%s' % (trust['source'], form, provider)
    work = Path('build/protected-images').resolve() / (arch + '-' + provider) / form
    work.mkdir(mode=0o700, parents=True, exist_ok=True)
    disk = work / 'disk.raw'
    disk_args = 'console=ttyAMA0' if arch == 'aarch64' else 'console=ttyS0'
    if provider == 'qemu':
        disk_args += ' werewolf.ip=10.0.2.15/24 werewolf.gw=10.0.2.2 werewolf.dns=10.0.2.3'
    if provider == 'lima':
        disk_args += ' werewolf.ip=192.168.5.15/24 werewolf.gw=192.168.5.2 werewolf.dns=192.168.5.3'
    howl = str(Path('build/host/howl').resolve())
    args = [howl, '_build', '--with', form, '--arch', arch, '--build', str(work),
        '--ipe-kernel', str(kernel), '--ipe-key', str(key), '--ipe-cert', str(cert),
        '--ipe-updates', channel, '--image-serial', serial, '--image-index', str(index),
        '--boot-key', str(boot_key), '--boot-cert', str(boot_cert), '--boot-native', '--tpm',
        '--disk', str(disk), '--disk-args', disk_args, 'disk']
    subprocess.run(args, env=env, check=True)
    slot = work / (form + '-ipe')
    producer = dict(form=form, arch=arch, disk=str(disk), slot=str(slot / 'slot'),
        head=str(slot / 'prebuilt' / arch), output=str(output), image_key=str(key),
        image_certificate=str(cert), boot_certificate=str(boot_cert), channel=channel)
    config = work / 'seal.json'
    config.write_text(json.dumps(producer))
    try:
        subprocess.run([howl, '_boot-image', 'seal', str(config)], env=env, check=True)
    finally:
        config.unlink(missing_ok=True)
    # Candidate artifacts may be publicly readable. Withhold the signature that
    # admits a boot bundle until the trusted lifecycle/publication job passes.
    # Signed image heads and PE code alone cannot authorize the boot descriptor.
    (output / 'boot.json.sig').unlink()
    disk.unlink()


if __name__ == '__main__':
    os.umask(0o077)
    try:
        if len(sys.argv) != 7:
            raise ValueError('usage: build-protected FORM PROVIDER ARCH SERIAL INDEX OUTPUT')
        build(*sys.argv[1:])
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        sys.exit('build-protected: protected build failed; no unsigned output is published')
