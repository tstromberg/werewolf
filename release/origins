#!/bin/sh
# origins writes the source packages (Wolfi's "origins") of everything
# werewolf installs: every form in forms/ and the boot disk, as their locks
# resolve now, for both architectures. The CVE tiers feed
# (tools/cve-tiers.zig) covers these and the kernel, and nothing else,
# because a CVE in a package werewolf never installs tells no machine
# anything. A machine counts a package this list does not name, from a form
# built elsewhere, as Medium (docs/design/update-policy.md).
#
#   release/origins OUT
#
# Run it from the top of the tree, with apko, curl and build/host/form. It
# writes OUT, one origin per line, sorted; on failure it writes nothing.
set -eu

[ $# -eq 1 ] || { echo "usage: release/origins OUT" >&2; exit 2; }
out=$1
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# List every package each config installs, as apko resolves it now. make's
# form tool (FORM_TOOL, by default build/host/form) merges each form's chain
# into one config, as make does; the boot disk has its own config.
form_tool=${FORM_TOOL:-build/host/form}
for dir in forms/*/; do
	name=$(basename "$dir")
	"$form_tool" apko "$name" >"$work/$name.yaml" || { echo "origins: cannot read form $name" >&2; exit 1; }
done
for config in "$work"/*.yaml boot/boot.yaml; do
	name=$(basename "$config" .yaml)
	(cd "$(dirname "$config")" && apko lock --arch aarch64,x86_64 \
		--output "$work/$name.lock.json" "$(basename "$config")" >/dev/null 2>"$work/$name.err") ||
		{ cat "$work/$name.err" >&2; echo "origins: cannot lock $config" >&2; exit 1; }
done
sed -n 's|^ *"name": "\([^"]*\)",$|\1|p' "$work"/*.lock.json | LC_ALL=C sort -u >"$work/names"

# Map each package to its origin with Wolfi's index for each architecture.
# The index holds KEY:VALUE records (P the package, o its origin), with a
# blank line between records.
for arch in x86_64 aarch64; do
	curl -fsS --retry 5 --retry-all-errors --connect-timeout 20 --max-time 300 \
		"https://packages.wolfi.dev/os/$arch/APKINDEX.tar.gz" | tar -xzOf - APKINDEX |
		awk -F: '/^P:/ { p = $2 } /^o:/ { o = $2 } /^$/ { if (p != "" && o != "") print p, o; p = o = "" }'
done | LC_ALL=C sort -u >"$work/index"

awk 'NR == FNR { want[$1] = 1; next } ($1 in want) { print $2 }' "$work/names" "$work/index" |
	LC_ALL=C sort -u >"$work/origins"
# A list this short means a lock or the index was cut short, not that
# werewolf installs so little.
n=$(($(wc -l <"$work/origins")))
[ "$n" -ge 50 ] || { echo "origins: only $n origins: refusing" >&2; exit 1; }
mv "$work/origins" "$out"
echo "origins: $n, from $(($(wc -l <"$work/names"))) packages"
