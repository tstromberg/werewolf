#!/usr/bin/env python3
"""Create production trust once; retain private custody outside the source tree."""
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def create(private, public):
    private, public = Path(private).resolve(), Path(public).resolve()
    private.mkdir(mode=0o700, parents=True, exist_ok=True)
    private.chmod(0o700)
    public.mkdir(parents=True, exist_ok=True)
    with (private / 'identity.lock').open('a+b') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        names = ('boot.key', 'boot.crt', 'image.key', 'image.crt')
        existing = [name for name in names if (private / name).exists()]
        if existing and len(existing) != len(names):
            raise ValueError('partial protected identity; restore it instead of rotating trust')
        if not existing and any((public / name).exists() for name in ('boot.crt', 'image.crt')):
            raise ValueError('committed trust already exists; restore its private keys')
        if not existing:
            with tempfile.TemporaryDirectory(dir=private) as temporary:
                work = Path(temporary)
                for kind in ('boot', 'image'):
                    subprocess.run(['openssl', 'req', '-newkey', 'rsa:4096', '-nodes', '-x509', '-sha256',
                        '-days', '3650', '-subj', '/CN=werewolf-protected-' + kind,
                        '-keyout', work / (kind + '.key'), '-out', work / (kind + '.crt')],
                        check=True, capture_output=True)
                for name in names:
                    os.rename(work / name, private / name)
        for kind in ('boot', 'image'):
            key, cert = private / (kind + '.key'), private / (kind + '.crt')
            if key.stat().st_mode & 0o777 != 0o600:
                raise ValueError('protected private key permissions must be 0600')
            a = subprocess.check_output(['openssl', 'pkey', '-in', str(key), '-pubout'])
            b = subprocess.check_output(['openssl', 'x509', '-in', str(cert), '-pubkey', '-noout'])
            if a != b:
                raise ValueError('protected identity key/certificate mismatch')
            destination = public / (kind + '.crt')
            if destination.exists() and destination.read_bytes() != cert.read_bytes():
                raise ValueError('committed protected trust differs; refusing replacement')
            if not destination.exists():
                shutil.copyfile(cert, destination)
                destination.chmod(0o644)


if __name__ == '__main__':
    os.umask(0o077)
    try:
        if len(sys.argv) != 3:
            raise ValueError('usage: create-protected-trust PRIVATE_DIRECTORY PUBLIC_DIRECTORY')
        create(*sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError):
        sys.exit('create-protected-trust: invalid or partial identity; no automatic trust replacement')
