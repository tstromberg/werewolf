#!/usr/bin/env python3
"""Create one GitHub draft carrying the exact signed assets exported for R2."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parent))
import legacy_images
import image_profiles as profiles
import image_catalog as catalog


def command(args):
    return subprocess.run(args, check=True)


def draft(targets, trust='release/protected', legacy=()):
    """targets lists (assets, bundle, report, provider), one per exported bundle."""
    loader = importlib.machinery.SourceFileLoader('github_export', 'release/export-protected')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    exporter = importlib.util.module_from_spec(spec)
    loader.exec_module(exporter)
    manifests, assets = [], []
    legacy_changes = {}
    for directory, bundle, report, provider in targets:
        directory = Path(directory).resolve()
        manifest = exporter.verify(directory, bundle, report, provider, trust)
        profiles.identity(manifest['form'], manifest['arch'], 'secure-boot')
        provenance = manifest['provenance']
        if provenance['commit'] != os.environ['GITHUB_SHA'] or provenance['repository'] != os.environ['GITHUB_REPOSITORY']:
            raise ValueError('release provenance differs from this workflow')
        if not re.fullmatch(r'[0-9]{8}T[0-9]{6}Z', manifest['serial']):
            raise ValueError('invalid protected release serial')
        manifests.append(manifest)
        if manifest['form'] in profiles.BASE_FORMS:
            assets += sorted(directory.iterdir())
    for directory in legacy:
        manifest = legacy_images.verify(directory, Path(trust) / 'image.crt')
        if manifest['provenance']['commit'] != os.environ['GITHUB_SHA'] or \
                manifest['provenance']['repository'] != os.environ['GITHUB_REPOSITORY']:
            raise ValueError('legacy release provenance differs from this workflow')
        manifests.append(manifest)
        if manifest['form'] in profiles.BASE_FORMS:
            assets += sorted(Path(directory).iterdir())
        if 'release-notes.html' in manifest['files']:
            descriptor = catalog.sha(next(Path(directory).glob('*-downloads.json')))
            legacy_changes[(manifest['form'], manifest['arch'])] = '%s/legacy-boot/%s/%s/objects/%s/%s' % (
                catalog.PUBLIC, manifest['form'], manifest['arch'], descriptor,
                manifest['files']['release-notes.html']['asset'])
    if not manifests or len({m['provenance']['run'] for m in manifests}) != 1:
        raise ValueError('a release carries the bundles of one workflow run')
    serial = max(m['serial'] for m in manifests)
    tag = 'base-images-' + serial
    provenance = manifests[0]['provenance']
    lines = []
    for m in manifests:
        if m.get('boot_profile') == 'legacy-boot':
            changes = legacy_changes.get((m['form'], m['arch']))
            lines.append('- `%s-%s-legacy-boot`, serial %s: boots without Secure Boot, TPM or IPE.%s' % (
                m['form'], m['arch'], m['serial'], ' [Package changes](%s).' % changes if changes else ''))
            continue
        prefix = '%s-%s-%s' % (m['form'], m['provider'], m['arch'])
        mirror = 'https://dist.werewolf-linux.org/boot/v1/%s/%s/%s/objects/%s' % (
            m['form'], m['provider'], m['arch'], m['descriptor'])
        lines.append('- `%s`, serial %s: [R2 bundle](%s/boot.json), [package changes](%s/release-notes.html), evidence `%s-gates.json`, '
                     'manifest `%s-downloads.json`.' % (prefix, m['serial'], mirror, mirror, prefix, prefix))
    notes = ('Base images built from %s in [GitHub Actions](%s).\n\n%s\n\n'
             'Changed images (`minimal`, `prod-ssh`, `playground`) are attached here and listed in '
             '[the R2 catalog](https://dist.werewolf-linux.org/boot/v1/index.html). '
             'Each attached boot/image manifest and detached signature is byte-identical to its R2 bundle. '
             'Each standalone qcow2 has the same disk contents as the authenticated compressed raw disk; '
             'its size and SHA-256 are covered by the target\'s downloads manifest and RSA/SHA-256 signature.\n\n'
             'Secure-boot targets passed all fourteen exact-bundle lifecycle gates and require '
             'the matching Secure Boot certificate, TPM and host permit service. Legacy-boot targets '
             'passed independent-build comparison, integration and package-update tests, and exact-image UEFI/direct boots '
             'without Secure Boot or TPM. Their signed manifests identify the boot profile.\n\n'
             'Verify each download manifest against the committed `release/protected/image.crt`, '
             'then check asset digests. GitHub build provenance attestations also cover every asset.\n') % (
                 provenance['commit'], provenance['run'], '\n'.join(lines))
    with tempfile.TemporaryDirectory(prefix='ww-github-release-') as temporary:
        body = Path(temporary) / 'notes.md'
        body.write_text(notes)
        command(['gh', 'release', 'create', tag, '--draft', '--generate-notes', '--target', provenance['commit'],
                 '--title', 'Base images ' + serial, '--notes-file', str(body),
                 *[str(path) for path in assets]])
    with Path(os.environ['GITHUB_OUTPUT']).open('a') as output:
        output.write('tag=' + tag + '\n')
    return tag


if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise ValueError('usage: github-protected EXPORTED_JSON')
        listed = json.loads(Path(sys.argv[1]).read_text())
        for target in listed:
            profiles.identity(target['form'], target['arch'], target.get('boot_profile', 'secure-boot'))
        targets = [(t['assets'], t['bundle'], json.loads(Path(t['gates']).read_text()), t['provider'])
                   for t in listed if t.get('boot_profile', 'secure-boot') == 'secure-boot']
        legacy = [t['assets'] for t in listed if t.get('boot_profile') == 'legacy-boot']
        draft(targets, legacy=legacy)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        sys.exit('github-protected: ' + str(error))
