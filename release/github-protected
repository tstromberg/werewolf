#!/usr/bin/env python3
"""Create a GitHub draft carrying the exact signed assets exported for R2."""
import importlib.machinery
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def command(args):
    return subprocess.run(args, check=True)


def draft(directory, bundle, report, provider, trust='release/protected'):
    directory = Path(directory).resolve()
    exporter = importlib.machinery.SourceFileLoader('github_export', 'release/export-protected').load_module()
    exporter.verify(directory, bundle, report, provider, trust)
    manifests = list(directory.glob('*-downloads.json'))
    if len(manifests) != 1:
        raise ValueError('expected one protected release manifest')
    manifest = json.loads(manifests[0].read_text())
    serial = manifest['serial']
    if not re.fullmatch(r'[0-9]{8}T[0-9]{6}Z', serial):
        raise ValueError('invalid protected release serial')
    tag = 'protected-' + serial
    prefix = '%s-%s-%s' % (manifest['form'], manifest['provider'], manifest['arch'])
    provenance = manifest['provenance']
    if provenance['commit'] != os.environ['GITHUB_SHA'] or provenance['repository'] != os.environ['GITHUB_REPOSITORY']:
        raise ValueError('release provenance differs from this workflow')
    mirror = 'https://dist.werewolf-linux.org/boot/v1/%s/%s/%s/objects/%s' % (
        manifest['form'], manifest['provider'], manifest['arch'], manifest['descriptor'])
    notes = ('Protected %s image, serial %s.\n\nBuilt from %s in [GitHub Actions](%s).\n\n'
             'The boot/image manifests and detached signatures are byte-identical to [the R2 bundle](%s/boot.json). '
             'The standalone qcow2 has the same disk contents as the authenticated compressed raw disk. '
             'Its size and SHA-256 are covered by `%s-downloads.json` and its RSA/SHA-256 signature.\n\n'
             'All fourteen exact-bundle lifecycle gates passed; evidence is attached as `%s-gates.json`. '
             'Enrollments still require the matching Secure Boot certificate, TPM and host permit service.\n\n'
             'Verify the download manifest against the committed `release/protected/image.crt`, '
             'then check asset digests. GitHub build provenance attestations also cover every asset.\n') % (
                 prefix, serial, provenance['commit'], provenance['run'], mirror, prefix, prefix)
    with tempfile.TemporaryDirectory(prefix='ww-github-release-') as temporary:
        body = Path(temporary) / 'notes.md'
        body.write_text(notes)
        command(['gh', 'release', 'create', tag, '--draft', '--target', provenance['commit'],
                        '--title', 'Protected images ' + serial, '--notes-file', str(body),
                        *[str(path) for path in sorted(directory.iterdir())]])
    with Path(os.environ['GITHUB_OUTPUT']).open('a') as output:
        output.write('tag=' + tag + '\n')
    return tag


if __name__ == '__main__':
    try:
        if len(sys.argv) != 5:
            raise ValueError('usage: github-protected BUNDLE GATES_JSON PROVIDER RELEASE_ASSETS')
        bundle, evidence, provider, assets = sys.argv[1:]
        draft(assets, bundle, json.loads(Path(evidence).read_text()), provider)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        sys.exit('github-protected: ' + str(error))
