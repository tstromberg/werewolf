#!/usr/bin/env python3
"""Track publishing failures without opening an issue on every scheduled retry."""
import json
import os
from pathlib import Path
import subprocess
import tempfile


def gh(*args):
    return subprocess.check_output(['gh', *args], text=True)


def report(run):
    workflow = run['name']
    if workflow not in ('check', 'packages', 'release', 'protected-images', 'form-images'):
        raise ValueError('unexpected publishing workflow')
    title = 'Publishing blocked: ' + workflow
    issues = json.loads(gh('issue', 'list', '--state', 'open', '--search', '"' + title + '" in:title',
                          '--json', 'number,title'))
    issue = next((str(item['number']) for item in issues if item['title'] == title), None)
    # A delayed event must not reopen a failure after a newer successful run.
    runs = json.loads(gh('api', 'repos/' + os.environ['GH_REPO'] + '/actions/workflows/' +
                        str(run['workflow_id']) + '/runs?branch=main&status=completed&per_page=30'))['workflow_runs']
    runs = [item for item in runs if item['event'] != 'pull_request' and
            item['head_repository']['full_name'] == os.environ['GH_REPO']]
    if runs and runs[0]['run_number'] > run['run_number']:
        return
    if run['conclusion'] == 'success':
        if issue:
            gh('issue', 'close', issue, '--comment', 'Recovered: ' + run['html_url'])
        return
    body = ('The main-branch **' + workflow + '** workflow failed. Image publication needs this pipeline to recover.\n\n'
            '[Inspect the latest failure](' + run['html_url'] + ')\n\n'
            'Commit: `' + run['head_sha'] + '`\n\n'
            'This issue is updated on retries and closed automatically after a successful run.\n')
    with tempfile.TemporaryDirectory(prefix='ww-publishing-health-') as temporary:
        path = Path(temporary) / 'body.md'
        path.write_text(body)
        if issue:
            gh('issue', 'edit', issue, '--body-file', str(path))
        else:
            gh('issue', 'create', '--title', title, '--body-file', str(path))


if __name__ == '__main__':
    report(json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())['workflow_run'])
