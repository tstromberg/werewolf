#!/usr/bin/env python3
"""Upload admitted protected objects before signed heads, retaining a signed release floor."""
import importlib.machinery
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

loader = importlib.machinery.SourceFileLoader('protected_preparation', 'release/prepare-protected')
preparation = loader.load_module()
ENDPOINT = 'https://c860af766754fb92eec27bc723e6db5d.r2.cloudflarestorage.com'


class Store:
    def __init__(self, bucket):
        self.bucket = bucket.rstrip('/')

    def fetch(self, key, output):
        if not self.bucket.startswith('s3://'):
            source = Path(self.bucket) / key
            if not source.exists():
                return False
            shutil.copyfile(source, output)
            return True
        result = subprocess.run(['aws', 's3', 'cp', '--only-show-errors', '--endpoint-url', ENDPOINT,
            self.bucket + '/' + key, str(output)], capture_output=True,
            env=dict(os.environ, AWS_DEFAULT_REGION='auto'))
        if result.returncode:
            text = result.stderr.decode(errors='replace')
            if '(404)' in text or 'NoSuchKey' in text or 'Not Found' in text:
                return False
            raise ValueError('protected object store read failed')
        return True

    def upload(self, key, source, immutable):
        if self.bucket.startswith('s3://'):
            subprocess.run(['aws', 's3', 'cp', '--only-show-errors', '--endpoint-url', ENDPOINT,
                '--cache-control', 'public,max-age=31536000,immutable' if immutable else 'no-cache',
                str(source), self.bucket + '/' + key], check=True,
                env=dict(os.environ, AWS_DEFAULT_REGION='auto'))
        else:
            destination = Path(self.bucket) / key
            destination.parent.mkdir(parents=True, exist_ok=True)
            incoming = destination.with_name(destination.name + '.new')
            shutil.copyfile(source, incoming)
            os.replace(incoming, destination)


def publish(howl, bundle, report, provider, store, trust='release/protected'):
    downloads = preparation.downloads
    with tempfile.TemporaryDirectory(prefix='ww-protected-publication-') as temporary:
        work = Path(temporary)
        plan = preparation.prepare(howl, bundle, report, provider, work / 'public', trust)
        namespace = '/'.join([plan['form'], plan['provider'], plan['arch']])
        pins = Path(trust).resolve()
        metadata = json.loads((pins / 'trust.json').read_text())
        request = dict(source=metadata['source'], cache='unused', form=plan['form'], provider=provider,
            arch=plan['arch'], channel='https://%s:%d/%s' % ('192.168.5.2' if provider == 'lima' else '10.0.2.2', metadata['permit_port'], plan['form']),
            boot_certificate=str(pins / 'boot.crt'), image_certificate=str(pins / 'image.crt'))
        old = work / 'previous'
        old.mkdir()
        had_signature = store.fetch(namespace + '/latest/boot.json.sig', old / 'boot.json.sig')
        had_head = store.fetch(namespace + '/latest/boot.json', old / 'boot.json')
        current = downloads.native(howl, 'head', Path(bundle), request)
        # One atomic object retains the newest authenticated publication intent.
        # A cut between the two public head writes cannot lower this release floor.
        accepted = work / 'accepted'
        accepted.mkdir()
        if store.fetch(namespace + '/latest/accepted-head.json', accepted / 'receipt.json'):
            receipt = json.loads(downloads.read(accepted / 'receipt.json', 3 << 20))
            if set(receipt) != {'head', 'signature'}:
                raise ValueError('invalid protected publication receipt')
            (accepted / 'boot.json').write_text(receipt['head'])
            (accepted / 'boot.json.sig').write_bytes(bytes.fromhex(receipt['signature']))
            previous = downloads.native(howl, 'head', accepted, request)
            floor = dict(serial=previous['image']['serial'], build=previous['image']['build'],
                         descriptor=downloads.sha(accepted / 'boot.json'))
            downloads.freshness(current, plan['descriptor'], floor, time.time())
        if had_signature and not had_head:
            if (old / 'boot.json.sig').read_bytes() != (Path(bundle) / 'boot.json.sig').read_bytes():
                raise ValueError('incomplete boot publication is not this candidate')
            shutil.copyfile(Path(bundle) / 'boot.json', old / 'boot.json')
            had_head = True
        if had_head and not had_signature:
            raise ValueError('published boot head is missing its signature')
        if had_head:
            old_descriptor = downloads.sha(old / 'boot.json')
            # A prior interrupted JSON/signature update can be recovered only
            # with the signature for those exact bytes stored immutably earlier.
            try:
                previous = downloads.native(howl, 'head', old, request)
            except ValueError:
                if not store.fetch(namespace + '/objects/' + old_descriptor + '/boot.json.sig', old / 'boot.json.sig'):
                    raise ValueError('cannot authenticate the prior boot head')
                previous = downloads.native(howl, 'head', old, request)
            floor = dict(serial=previous['image']['serial'], build=previous['image']['build'],
                         descriptor=downloads.sha(old / 'boot.json'))
            downloads.freshness(current, plan['descriptor'], floor, time.time())
        # Check immutable collisions before changing any head. Overwriting a key
        # under the same content identity is refused, even with publication access.
        for entry in plan['files']:
            if not entry['immutable']:
                continue
            source = work / 'public' / entry['key']
            found = work / 'existing'
            if store.fetch(entry['key'], found):
                if found.stat().st_size != entry['size'] or downloads.sha(found) != entry['sha256']:
                    raise ValueError('immutable protected object collision')
            else:
                store.upload(entry['key'], source, True)
            found.unlink(missing_ok=True)
        # JSON/signature tears refuse in the downloader without lowering its floor.
        receipt = work / 'accepted-head.json'
        downloads.atomic(receipt, dict(head=(Path(bundle) / 'boot.json').read_text(),
                                       signature=(Path(bundle) / 'boot.json.sig').read_bytes().hex()))
        store.upload(namespace + '/latest/accepted-head.json', receipt, False)
        for name in ('boot.json.sig', 'boot.json'):
            key = namespace + '/latest/' + name
            store.upload(key, work / 'public' / key, False)
        return plan


if __name__ == '__main__':
    os.umask(0o077)
    try:
        if len(sys.argv) != 5:
            raise ValueError('usage: publish-protected HOWL BUNDLE GATES_JSON PROVIDER')
        howl, bundle, evidence, provider = sys.argv[1:]
        publish(str(Path(howl).resolve()), Path(bundle).resolve(),
            json.loads(preparation.downloads.read(evidence, 64 << 10)), provider,
            Store(os.environ.get('PROTECTED_BUCKET', 's3://werewolf/boot/v1')))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        sys.exit('publish-protected: admission, lifecycle gates, release floor or ordered upload failed')
