#!/usr/bin/env python3
"""Verify the actual public mirror serves the exact newly published protected bundle."""
import importlib.machinery
import json
from pathlib import Path
import sys
import tempfile

downloads = importlib.machinery.SourceFileLoader('protected_download_check', 'tools/boot-download').load_module()


def check(howl, expected, provider, assets):
    expected = Path(expected).resolve()
    trust = Path('release/protected').resolve()
    metadata = json.loads((trust / 'trust.json').read_text())
    image = json.loads(downloads.read(expected / 'boot.json', downloads.HEAD_LIMIT))
    with tempfile.TemporaryDirectory(prefix='ww-public-download-check-') as cache:
        request = dict(source=metadata['source'], cache=cache, form=image['form'], arch=image['image']['arch'],
            provider=provider, boot_certificate=str(trust / 'boot.crt'), image_certificate=str(trust / 'image.crt'),
            channel='https://%s:%d/%s' % ('192.168.5.2' if provider == 'lima' else '10.0.2.2', metadata['permit_port'], image['form']))
        bundle = downloads.download(request, lambda path: downloads.native(howl, 'head', path, request),
            lambda path: downloads.native(howl, 'verify', path, request), dict(validator='public-mirror-check'))
        if downloads.sha(bundle / 'boot.json') != downloads.sha(expected / 'boot.json'):
            raise ValueError('public mirror serves a different signed release')
        exporter = importlib.machinery.SourceFileLoader('public_export_check', 'release/export-protected').load_module()
        assets = Path(assets).resolve()
        prefix = '%s-%s-%s' % (image['form'], provider, image['image']['arch'])
        report = json.loads(downloads.read(assets / (prefix + '-gates.json'), 64 << 10))
        signed = exporter.verify(assets, expected, report, provider, trust)
        base = '%s/%s/%s/%s/objects/%s' % (metadata['source'].rstrip('/'), image['form'], provider,
                                           image['image']['arch'], signed['descriptor'])
        # Check every public object against the very bytes attached to GitHub,
        # including both signature pairs and the standalone qcow2.
        for name in list(signed['files']) + ['downloads.json', 'downloads.json.sig']:
            original = assets / (prefix + '-' + name)
            incoming = Path(cache) / ('check-' + name)
            record = dict(size=original.stat().st_size, sha256=downloads.sha(original))
            downloads.fetch(base + '/' + name, incoming, record['size'], record)


if __name__ == '__main__':
    try:
        if len(sys.argv) != 5:
            raise ValueError('usage: check-protected-download HOWL BUNDLE PROVIDER RELEASE_ASSETS')
        check(str(Path(sys.argv[1]).resolve()), sys.argv[2], sys.argv[3], sys.argv[4])
        print('pass: fresh public download matches the published signed bundle and complete native admission')
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.exit('check-protected-download: ' + str(error))
