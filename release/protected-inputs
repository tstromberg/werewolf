#!/usr/bin/env python3
"""Resolve one public package snapshot for independent protected-image builds."""
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
import time

FORMS = ('playground', 'prod', 'prod-ssh')


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def resolve(config, output, arch, workdir):
    for attempt in range(4):
        try:
            run(['apko', '--workdir', workdir, 'lock', '--arch', arch,
                 '--output', output.resolve(), config])
            return
        except subprocess.CalledProcessError:
            if attempt == 3:
                raise
            time.sleep(15 * (attempt + 1))


def identity(source, arch, locks):
    # Ignore resolver paths/order, but include authenticated package bytes,
    # versions, architecture, repository trust and the complete source identity.
    records = {}
    for name, lock in sorted(locks.items()):
        contents = lock['contents']
        packages = [p for p in contents['packages'] if p['architecture'] == arch]
        if not packages:
            raise ValueError('empty package snapshot: ' + name)
        records[name] = dict(packages=sorted(packages, key=lambda p: (p['name'], p['url'])),
                             keyring=contents['keyring'])
    data = dict(format='werewolf-protected-inputs/1', source=source, arch=arch, locks=records)
    return hashlib.sha256(json.dumps(data, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def prepare(howl, arch, output):
    if arch not in ('x86_64', 'aarch64'):
        raise ValueError('unsupported protected architecture')
    howl = Path(howl).resolve()
    output = Path(output).resolve()
    output.mkdir(parents=True, exist_ok=False)
    lockdir = Path('build/lock')
    lockdir.mkdir(parents=True, exist_ok=True)
    for form in FORMS:
        lock = lockdir / (form + '.lock.json')
        lock.unlink(missing_ok=True)
        run([howl, '_build', '--with', form, '--arch', arch, 'lock'])
    for name in ('kernel', 'boot'):
        resolve(name + '.yaml', lockdir / (name + '.lock.json'), 'aarch64,x86_64', 'boot')
    # Ask Melange for its own parsed environment; these are apko inputs too.
    for kind, recipe in [('kernel-builder', 'boot/ipe-kernel.melange.yaml'),
                         ('stub-builder', 'boot/tpm-stub.melange.yaml')]:
        contents = {}
        for field in ('Repositories', 'Keyring', 'Packages'):
            query = '{{ range .Environment.Contents.' + field + ' }}{{ println . }}{{ end }}'
            lines = subprocess.check_output(['melange', 'query', recipe, query], text=True).splitlines()
            if not lines or any(not line.strip() for line in lines):
                raise ValueError('incomplete Melange environment')
            contents[field.lower()] = lines
        config = output / (kind + '.json')
        config.write_text(json.dumps(dict(contents=contents, archs=[arch])) + '\n')
        resolve(config.name, output / (kind + '.lock.json'), arch, output)
    locks = {}
    for path in [*(lockdir / (name + '.lock.json') for name in (*FORMS, 'kernel', 'boot')),
                 *output.glob('*-builder.lock.json')]:
        locks[path.name] = json.loads(path.read_text())
        if path.parent != output:
            (output / path.name).write_bytes(path.read_bytes())
    version = re.search(r'^alpine_version=(.+)$', Path('boot/kernel-source').read_text(), re.M).group(1)
    kernel = locks['kernel.lock.json']['contents']['packages']
    if not any(p['name'] == 'linux-virt' and p['architecture'] == arch and p['version'] == version for p in kernel):
        raise ValueError('Alpine kernel changed; update boot/kernel-source before publishing')
    tree = subprocess.check_output(['git', 'ls-tree', '-rz', 'HEAD', '--', 'Makefile', 'files.zig',
        'boot', 'cmd', 'forms', 'lib', 'tools', 'release', 'test', '.github'])
    source = hashlib.sha256(b'\0'.join(row for row in tree.split(b'\0') if b'__pycache__/' not in row)).hexdigest()
    digest = identity(source, arch, locks)
    (output / 'inputs').write_text(digest + '\n')
    print('protected inputs: ' + digest)
    return digest


if __name__ == '__main__':
    try:
        if len(sys.argv) != 4:
            raise ValueError('usage: protected-inputs HOWL ARCH OUTPUT')
        prepare(*sys.argv[1:])
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit('protected-inputs: ' + str(error))
